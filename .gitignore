# ============================================================================
# rit-hms .gitignore
# ASP.NET MVC 5 / .NET Framework 4.5.2 solution + tooling
# ============================================================================

# --- .NET build output ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.pdb
*.dll.config
*.exe.config

# --- NuGet packages (restore from packages.config) ---
packages/
*.nupkg
.nuget/

# --- Visual Studio / Rider / VS Code ---
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.ncrunchproject
*.ncrunchsolution
*.dotsettings.user
*.DotSettings.user

# --- Compiled outputs ---
*.exe
*.msi
*.tlb
*.tli
*.tlh
*.tmp_proj

# --- Test results ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# --- Local config overrides (NEVER commit secrets) ---
Web.local.config
Web.*.local.config
App.local.config
appsettings.local.json
appsettings.Production.json
*.local.config
.env
.env.local
.env.*.local

# --- Aggregator / partner credentials (Sprint 2+) ---
secrets/
credentials/
*.pfx
*.p12
*.key
*.pem

# --- Customer-specific data (must never enter Git) ---
*.dbf
App_Data/ACTIVATIONKEY*
App_Data/*.mdf
App_Data/*.ldf
**/version upgrade*.sql
**/backup*.bak
**/*_BACKUP_*.sql

# --- Archives (use real package management instead) ---
*.rar
*.7z
*.zip
*.tar.gz

# --- Front-end deps (we will modernise this in Sprint 7+) ---
node_modules/
bower_components_local/
build/
dist/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor swap / backup ---
*.swp
*~
*.bak
*.orig

# --- Migration artefacts we don't want to track ---
# (Keep the Migrations/*.cs files — they ARE source.)
**/Migrations/_Scripts/

# --- Generated reports / exports ---
**/Reports/Generated/
**/Exports/

# --- ReSharper / R# ---
_ReSharper*/
*.suo
*.cache
