# ============================================================================
# Local development environment variables
# ============================================================================
# Copy this file to .env (gitignored) and fill in real values.
# A startup hook in src/HospitalityManagement/App_Start/EnvConfig.cs will
# substitute ${VAR} placeholders in Web.config at app start.
#
# In production, set these as IIS application settings, Windows env vars,
# or Azure Key Vault references — DO NOT commit real values to Git.
# ============================================================================

# --- Main HMS database (single-tenant mode) ---
HMS_DB_SERVER=localhost\SQLEXPRESS
HMS_DB_NAME=HMS
HMS_DB_USER=hms_app
HMS_DB_PASSWORD=

# --- Per-tenant DBs (Subscription mode) ---
HMS_TENANT1_SERVER=localhost\SQLEXPRESS
HMS_TENANT1_NAME=HMS_Lotus
HMS_TENANT1_USER=hms_app
HMS_TENANT1_PASSWORD=

HMS_TENANT2_SERVER=localhost\SQLEXPRESS
HMS_TENANT2_NAME=HMS_Lotus
HMS_TENANT2_USER=hms_app
HMS_TENANT2_PASSWORD=

# --- Login manager (Subscription mode controller DB) ---
HMS_LOGINMGR_SERVER=localhost\SQLEXPRESS
HMS_LOGINMGR_NAME=HMSLoginManager
HMS_LOGINMGR_USER=hms_app
HMS_LOGINMGR_PASSWORD=

# --- HMSOrderTaker (waiter app) DB ---
STOS_DB_SERVER=localhost\SQLEXPRESS
STOS_DB_NAME=SmartLink
STOS_DB_USER=hms_app
STOS_DB_PASSWORD=

# ============================================================================
# Sprint 2+ — Aggregator integrations (not yet implemented)
# ============================================================================

# --- Uber Eats (Eats Marketplace API) ---
UBEREATS_CLIENT_ID=
UBEREATS_CLIENT_SECRET=
UBEREATS_WEBHOOK_HMAC_SECRET=
UBEREATS_BASE_URL=https://api.uber.com/v2
UBEREATS_ENVIRONMENT=sandbox

# --- PickMe Food (Partner API) ---
PICKME_CLIENT_ID=
PICKME_CLIENT_SECRET=
PICKME_WEBHOOK_HMAC_SECRET=
PICKME_BASE_URL=https://partner.pickme.lk/api
PICKME_ENVIRONMENT=sandbox

# ============================================================================
# Logging / observability (Sprint 1+)
# ============================================================================
SERILOG_MIN_LEVEL=Information
SERILOG_SINK=console
# Optional: ship to Seq, Application Insights, Elastic, etc.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# SEQ_URL=http://localhost:5341
# SEQ_API_KEY=
