                {
                    var procount = 1;
                    foreach (var item in Model)
                    {
                        <span class="dot" onclick="currentSlide(@procount)"></span>
                        procount = procount + 1;
                    }

                }
            </div>
            <br>
            <div class="slideshow-container">

                @if (Model != null)
