                                                }
                                                </div>
                                                <div class="media-body">
                                                    <a href="javascript:ServingUnits(@pro.ProductId,@ViewBag.Catid,@ViewBag.deptid)"><h3>@pro.ProductName (@pro.ProductCode)</h3></a>                                                    
                                                    @*<p style="color:#b10400;font-family:Cantata One;">RS @pro.SellingPrice</p>*@

                                                    @*<div>
                                                        <a data-boolean="true" id="addtocartbtn_@pro.ProductId" class="read_mor_btn " href="javascript:AddProductToCart(@pro.ProductId)">Add To Cart</a>                                                       
                                                        <div class="qtybox number-input" id="qtybox_@pro.ProductId" style="float:right;border:none">
                                                            <button onclick="this.parentNode.querySelector('input[type=number]').stepDown(); MinusItems(@pro.ProductId)"></button>
                                                            <input id="ItemQty_@pro.ProductId" style="text-align:center;width:30px;" class="quantity" min="0" name="quantity" value="0" type="number">
                                                            <button onclick="this.parentNode.querySelector('input[type=number]').stepUp(); PlusItems(@pro.ProductId)" class="plus"></button>
                                                        </div>
                                                    </div>*@
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }

                <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
