        $.ajax({

            url: "/STOSOrder/SaveTabOrderDetails",
            type: "POST",
            //contentType: "application/json;charset=utf-8",
            //dataType: "json",
            data: { },
            success: function (data)
            {
                if (data.isRedirect)
                {
                    window.location.href = data.redirectUrl;
                }
                else
                {

                }
            }
        });
    }

    function removecartitem(uniid, locationid, orderid, itemnum)
    {

        $.ajax({
            url: "/STOSOrder/RemoveCartItem",
            type: "POST",
            //contentType: "application/json;charset=utf-8",
            //dataType: "json",
            data: { locationid: locationid, ordernumber: orderid, itemid: itemnum },
            success: function (data) {

                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                else {

                    var itemsubtotal = parseFloat($('#itemsubtotal_' + uniid).text());
                    var allitemsubtotal = parseFloat($('#allitemsubtotal').text());
                    var result = allitemsubtotal - itemsubtotal;

                    $('#allitemsubtotal').text(parseFloat(result).toFixed(2));
                    $('#totalamount').text(parseFloat(result).toFixed(2));
                    $('#sidetotalamount').text(parseFloat(result).toFixed(2));
                    $('#sidesubtotal').text(parseFloat(result).toFixed(2));
                    //$("#rowid_" + uniid).css("display", "none");
                    $("#rowid_" + uniid).remove()
                    var rowCount = $('#carttbl tbody tr').length;
                    if (rowCount == 0) {
                        $("#checkoutbtn").attr("disabled","disabled");
                    }
                }
            }

        });
    }
</script>
