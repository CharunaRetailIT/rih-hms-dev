<script>
    $('.btn-number').click(function (e) {

    debugger
        e.preventDefault();

        fieldName = $(this).attr('data-field');
        type = $(this).attr('data-type');
        var input = $("input[name='" + fieldName + "']");
        var currentVal = parseInt(input.val());
        if (!isNaN(currentVal)) {
            if (type == 'minus') {

                if (currentVal > input.attr('min')) {
                    input.val(currentVal - 1).change();
                }
                if (parseInt(input.val()) == input.attr('min')) {
                    $(this).attr('disabled', true);
                }

            } else if (type == 'plus') {

                if (currentVal < input.attr('max')) {
                    input.val(currentVal + 1).change();
                }
                if (parseInt(input.val()) == input.attr('max')) {
                    $(this).attr('disabled', true);
                }

            }
        } else {
            input.val(0);
        }
    });
    $('.input-number').focusin(function () {
        $(this).data('oldValue', $(this).val());
    });
    $('.input-number').change(function () {

        minValue = parseInt($(this).attr('min'));
        maxValue = parseInt($(this).attr('max'));
        valueCurrent = parseInt($(this).val());

        name = $(this).attr('name');
        if (valueCurrent >= minValue) {
            $(".btn-number[data-type='minus'][data-field='" + name + "']").removeAttr('disabled')
        } else {
            alert('Sorry, the minimum value was reached');
            $(this).val($(this).data('oldValue'));
        }
        if (valueCurrent <= maxValue) {
            $(".btn-number[data-type='plus'][data-field='" + name + "']").removeAttr('disabled')
        } else {
            alert('Sorry, the maximum value was reached');
            $(this).val($(this).data('oldValue'));
        }


    });
    $(".input-number").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 190]) !== -1 ||
            // Allow: Ctrl+A
            (e.keyCode == 65 && e.ctrlKey === true) ||
            // Allow: home, end, left, right
            (e.keyCode >= 35 && e.keyCode <= 39)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });
</script>

<script>

    $(document).ready(function () {
        $(window).on("load", function () {

            $('#sidetotalamount').text($('#totalamount').text());
            $('#sidesubtotal').text($('#totalamount').text());

            var rowCount = $('#carttbl tbody tr').length;

            if (rowCount == 0) {

                $("#checkoutbtn").attr("disabled","disabled");

            }

        });
    });

    function MinusItem(uniid,locationid,orderid,itemnum) {

        $.ajax({

            url: "/STOSOrder/UpdateSession",
            type: "POST",
            //contentType: "application/json;charset=utf-8",
            //dataType: "json",
            data: { locationid: locationid, ordernumber: orderid, itemnumber: itemnum,addormin:false },
            success: function (data) {



                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }

                else {

                    var itemprice = parseFloat($('#itemprice_' + uniid).text());
                    var itemsubtotal = parseFloat($('#itemsubtotal_' + uniid).text());
                    var result = itemsubtotal - itemprice;
                    $('#itemsubtotal_' + uniid).text(parseFloat(result).toFixed(2));


                    var allitemsubtotal = parseFloat($('#allitemsubtotal').text());
                    allitemsubtotal = allitemsubtotal - itemprice;
                    //alert(allitemsubtotal);
                    $('#allitemsubtotal').text(allitemsubtotal.toFixed(2));

                    $('#totalamount').text(allitemsubtotal.toFixed(2));
                    $('#sidetotalamount').text(allitemsubtotal.toFixed(2));
                    $('#sidesubtotal').text(allitemsubtotal.toFixed(2));
                }


            }

        });


    }

    function PlusItem(uniid, locationid, orderid, itemnum) 
    {
        $.ajax({

            url: "/STOSOrder/UpdateSession",
            type: "POST",
            //contentType: "application/json;charset=utf-8",
            //dataType: "json",
            data: { locationid: locationid, ordernumber: orderid, itemnumber: itemnum, addormin: true },
            success: function (data)
            {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                else
                {

                    var itemprice = parseFloat($('#itemprice_' + uniid).text());
                    var itemsubtotal = parseFloat($('#itemsubtotal_' + uniid).text());
                    var result = itemsubtotal + itemprice;
                    $('#itemsubtotal_' + uniid).text(parseFloat(result).toFixed(2));
                    var allitemsubtotal = parseFloat($('#allitemsubtotal').text());
                    allitemsubtotal = allitemsubtotal + itemprice;
                    //alert(allitemsubtotal);
                    $('#allitemsubtotal').text(allitemsubtotal.toFixed(2));
                    $('#totalamount').text(allitemsubtotal.toFixed(2));
                    $('#sidetotalamount').text(allitemsubtotal.toFixed(2));
                    $('#sidesubtotal').text(allitemsubtotal.toFixed(2));
                }
            }
        });
    }

