                                                </div>
                                                <div class="title_text">
                                                    <div class="feature_left"><a href="javascript:ProductDetails(@pro.ProductId)"><span style="font-size:10px;">@pro.ProductName</span></a></div>
                                                    <div class="restaurant_feature_dots"></div>
                                                    <div style="font-size:10px;" class="feature_right">Rs @pro.SellingPrice</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
                <a class="next" onclick="plusSlides(1)">&#10095;</a>

            </div>




        </div>
    </section>




