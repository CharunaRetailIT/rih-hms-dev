    <section class="most_popular_item_area menu_list_page">
        <div class="container">

            @if (Model != null)
            {
                var procount = 0;
                foreach (var item in Model)
                {
                    foreach (var pro in item.ProductList)
                    {
                        procount = procount + 1;
                    }
                }
                <div style="margin:10px;" class="s_black_title">
                    <h3 style="color:black;font-size:30px;">Product count - @procount</h3>

                </div>

            }


            <div style="text-align:center">
                @if (Model != null)
                {
                    var procount = 1;
                    foreach (var item in Model)
                    {
                        <span class="dot" onclick="currentSlide(@procount)"></span>
                        procount = procount + 1;
                    }
                }
            </div>
            <br>
            <div class="slideshow-container">

                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <div class="mySlides fades">
                            <div class="p_recype_item_main">
                                <div class="row p_recype_item_active">

                                    @foreach (var pro in item.ProductList)
