                        <a class="event_btn" href="#"><i class="fa fa-calendar" aria-hidden="true"></i>Book an Event</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="header_social">
                        <ul>
                            <li><a href="@Url.Action("LogOut", "STOSSysUser", new {Area = ""})">
                                <i class="fa fa-sign-out"></i>
                                </a>
                            </li>                       
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--================End Footer Area =================-->
    <!--================End Banner Area =================-->
