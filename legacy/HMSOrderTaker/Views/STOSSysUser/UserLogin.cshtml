@model RIT.HMS.HMSOrderTaker.Domain.ViewModels.vmAccount
@{
    ViewBag.Title = "Log In";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Smart Order Management System</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Font Awesome -->
    <link href="~/Content/STOS/Login/Style/all.min.css" rel="stylesheet" />
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- icheck bootstrap -->
    <link href="~/Content/STOS/Login/Style/icheck-bootstrap.min.css" rel="stylesheet" />
    <!-- Theme style -->
    <link href="~/Content/STOS/Login/Style/adminlte.min.css" rel="stylesheet" />
    <!-- Google Font: Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">




</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="login-logo">
            <a href="../../index2.html"><b>RIT</b>STOS</a>
        </div>
        <!-- /.login-logo -->
        <div class="card">
        @using (Html.BeginForm("UserLogin", "STOSSysUser", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post,
                                                                new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            <div class="card-body login-card-body">
                <p class="login-box-msg">Sign in to start your session</p>
                <form action="../../index3.html" method="post">
                    <div class="input-group mb-3 d-lg-none" style="display:none">
                        <input type="email" class="form-control" placeholder="Email">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-envelope"></span>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        @*<input type="password" class="form-control" placeholder="Password">*@
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter Password" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>                      
                    </div>
                    <div class="clearfix"></div>
                    <div class="row">
                        <p class="login-box-msg text-danger">@Convert.ToString(Session["MessageToUser"])</p>
                    </div>
                    <div class="clearfix"></div>
                    <div class="row">
                        <div class="col-8">
                            <div class="icheck-primary">
                                <input type="checkbox" id="remember">
                                <label for="remember">
                                    Remember Me
                                </label>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-4">
                            <input type="submit" value="Sign In" class="btn btn-primary btn-block" />
                            @*<button type="button" id="TestLogBtn"class="btn btn-primary btn-block">Sign In</button>*@
                        </div>
                        <!-- /.col -->
                    </div>
                </form>
                <div class="social-auth-links text-center mb-3">
                    <p>- OR -</p>
                    <a href="/Account/LogIn" class="btn btn-block btn-danger">
                        <i class="fab fa-google-plus mr-2"></i> Sign in to HMS
                    </a>

                </div>
                <!-- /.social-auth-links -->
                <p class="mb-1">
                    <a href="forgot-password.html">I forgot my password</a>
                </p>
                @*<p class="mb-0">
                        <a href="register.html" class="text-center">Register a new membership</a>
                    </p>*@
            </div>
        }
        </div>
    </div>
    <!-- /.login-box -->
    <!-- jQuery -->

    <script src="~/Content/STOS/Login/Script/jquery.js"></script>
    <script src="~/Content/STOS/Login/Script/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/Content/STOS/Login/Script/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/Content/STOS/Login/Script/adminlte.min.js"></script>


</body>
</html>

<script>
    $("#TestLogBtn").click(function () {

        window.location.href = '/STOSOrder/BookTable';
    });

</script>