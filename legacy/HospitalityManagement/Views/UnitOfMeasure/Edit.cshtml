@model RIT.HMS.Domain.UnitOfMeasure
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System </title>

</head>
@*<body class="nav-md">*@
<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm("Edit", "UnitOfMeasure", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.UnitOfMeasureId)
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @if (@ViewBag.Message == "1")
                            {
                                <div class="alert alert-success alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Unit of Measure</strong> modified successfully.
                                </div>
                            }
                            else if (@ViewBag.Message == "0")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Unit of Measure</strong> failed to modify.
                                </div>
                            }
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Unit of Measure - Edit</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                       
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <br />
                                    <form class="form-horizontal form-label-left">
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Unit of Measure Code</label>
                                            <div class="col-md-5 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.UnitOfMeasureCode,
                                               new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Unit of Measure Code",
                                                   MaxLength = 50,
                                                   @ewadonly=true

                                               })
                                                @Html.ValidationMessageFor(model => model.UnitOfMeasureCode, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Unit of Measure Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.UnitOfMeasureName, new { @class = "form-control", MaxLength = 50, Placeholder = "Unit of Measure Name" })
                                                @Html.ValidationMessageFor(model => model.UnitOfMeasureName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Remark</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Remark, new { @class = "form-control", MaxLength = 50, Placeholder = "Remark" })
                                                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                       
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">IsDelete</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                            </div>
                                        </div>


                                        @*<div class="ln_solid"></div>*@ <br />
                                        <div class="actionBar">
                                            <div class="msgBox">

                                                <div class="btn btn-primary pl_add btn-small pull-left">
                                                    @Html.ActionLink("Reset", "Edit", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                                <div class="btn btn-info pl_add btn-small pull-left">
                                                    @Html.ActionLink("View All", "ViewUnitOfMeasures", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                                <button type="submit" class="btn btn-success">Modify</button>

                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>



