                document.getElementById("TotalTax").value = 0;
                var cp = 0;
                var sp = 0;
                var tp = 0;

                for (var r = 0, n = table.rows.length; r < n; r++)
                {
                    var rowitemid =  table.rows[r].cells[1].innerHTML.match(regex)[1];
                    cp += Number(document.getElementById('GRNDetail[' + rowitemid + ']_CostValue').value);
                    tp += Number(document.getElementById('GRNDetail[' + rowitemid + ']_TotalTax').value);

                }

                document.getElementById("TotCostPrice").value = cp.toFixed(3);
                document.getElementById("TotalTax").value = tp.toFixed(3);
             //   debugger;
                var otherchargers=document.getElementById("OtherChargers").value;
                var disamt=document.getElementById("DiscountAmount").value;
                var disprc=document.getElementById("DiscountPercentage").value;
