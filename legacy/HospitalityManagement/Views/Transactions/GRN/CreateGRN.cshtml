@model RIT.HMS.Domain.Transactions.PurchaseHeader
@{
    ViewBag.Title = "Create GRN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm(null, null, FormMethod.Post, new
        {
            id = "CreateGRN",
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CompanyID)
            @Html.HiddenFor(model => model.LocationId)
            @*@Html.HiddenFor(@model => model.PurchaseHeaderId)
                @Html.HiddenFor(model => model.POID)
                @Html.HiddenFor(model => model.CreatedUser)
                @Html.HiddenFor(model => model.CreatedDate)*@


            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>GRN</strong> @ViewBag.GRNCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>GRN</strong> @ViewBag.GRNCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this Location</strong>
                        </div>
                    }

                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btnallClear" value=" Clear " onclick="location.href='@Url.Action("CreateGRN", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btnallView" value="View GRN(s)" onclick="location.href='@Url.Action("ViewAllGRN", null, new { })'" />
                            </div>
                            <button type="submit" formaction="CreateGRN" id="ButtonSubmit" class="btnallSubmit btn pull-left">Submit GRN</button>
                            <button type="submit" formaction="@Url.Action("TempSaveGRN", "GRN")" id="ButtonTempSaveGRN" class="btnallTemporary btn pull-left">Temporary Save GRN</button>
                        </div>
                    </div>



                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Good Received Note</h2>
                                    <br />
                                </div>
                                <div class="x_content">
                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-4">
                                                    <span class="step_no">4</span>
                                                    <span class="step_descr">
                                                        Step 4<br />
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>

                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>

                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            @if (@ViewBag.POMandatory == false)
                                                            {
                                                                <div class="pull-left">
                                                                    @Html.RadioButtonFor(m => m.GRNType, "Manual", new { @id = "Manual" })
                                                                    Manual
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="pull-left" style="visibility:hidden">
                                                                    @Html.RadioButtonFor(m => m.GRNType, "Manual", new { @id = "Manual" })
                                                                    Manual
                                                                </div>
                                                            }

                                                            <div class="clearfix"></div>

                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.GRNType, "POBased", new { @id = "Auto", @checked = true })
                                                                PO Based
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="SupplierId" class="form-control" name="SupplierId" required="required"></select>
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PO # <span class="required"></span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="POID" name="POID" class="form-control select2" size="1500"></select>
                                                            @Html.ValidationMessageFor(model => model.POID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier Invoice #
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            @Html.TextBoxFor(model => model.SupplierInvoiceNo, new
                                                            {
                                                               @class = "form-control col-md-6 col-xs-6",
                                                               min = 0,
                                                               MaxLength = 20,

                                                            })
                                                            @Html.ValidationMessageFor(model => model.SupplierInvoiceNo, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="GRNLocationId" class="form-control" name="GRNLocationId" required="required"></select>
                                                            @Html.ValidationMessageFor(model => model.GRNLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency  <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="CurrencyID" class="form-control" name="CurrencyID"></select>
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency Rate <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">

                                                            @Html.TextBoxFor(model => model.CurrencyRate, new
                                                       {
                                                           type = "number",
                                                           step = 0.01,
                                                           @class = "form-control",
                                                           value = "0",
                                                           min = "0",
                                                           onkeypress = "return event.charCode >= 46",
                                                           oninput = "javascript: if (this.value.length >6) this.value = this.value.slice(0, 5);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.CurrencyRate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Method <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentMethodId" class="form-control" name="PaymentMethodId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentMethodId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Term <span class="required"></span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentTermId" class="form-control" name="PaymentTermId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentTermID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    @if (@ViewBag.BackDateGRN == true)
                                                    {
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                GRN Date <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">

                                                                @Html.TextBoxFor(model => model.GRNDate, new
                                                           {
                                                               @class = "form-control col-md-6 col-xs-6",
                                                               @Type = "date",
                                                               @Value = Model.GRNDate.ToString("yyyy-MM-dd"),
                                                               Placeholder = "Expected Date"
                                                           })
                                                                @Html.ValidationMessageFor(model => model.GRNDate, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    }


                                                    @{ // Assume your session variable is named "ShowTOGSection" and it holds a boolean value
                                                        bool IsEventMandatory = Session["IsEventMandatory"] != null && (bool)Session["IsEventMandatory"];

                                                    }

                                                    @if (IsEventMandatory)
                                                    {


                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-group" style="display: none;">
                                                            <label class="control-label col-md-3 col-sm-6" style="display: none;">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12" style="display: none;">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>

                                                    }



                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div>  <br />
                                        <div id="step-2">
                                            <div id="trndetail" class="trn-detail">
                                                <div class="form-group">
                                                    <div id="buttons">
                                                        <table id="buttons" class="table table table-striped" style="background-color:#f5f5f5">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:10%">
                                                                        Item/Material (UOM)
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToGRN"], new
                                                                       {
                                                                           @class = "form-control select2",
                                                                           @style = "width:90%"
                                                                       })
                                                                        @*<select id="ItemId" class="form-control select2" style="width:90%" name="ItemId"></select>*@
                                                                    </td>
                                                                    <td style="width:10%">
                                                                        Quantity
                                                                    </td>
                                                                    <td style="width:20%">
                                                                        <input id="RecQty" name="RecQty" type="number" min='0' step="any" onkeypress='return event.charCode >= 46'
                                                                               @*onkeyup="checkProductQuantity()"*@
                                                                               oninput="javascript: if (this.value.length >9) this.value = this.value.slice(0, 5);"
                                                                               class="form-control col-md-2 col-xs-6">
                                                                        <font color="red"><label id="validateqty" name="validateqty" style="font:small-caption"></label></font>
                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddPOItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddReOrderItems">
                                                        @*<table id="buttons1" class="table table table-striped">
                                                                <thead>
                                                                    <tr>
                                                                        <th></th>
                                                                        <th></th>
                                                                        <th></th>
                                                                        <th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr>
                                                                        <td style="width:10%">
                                                                            Purchase Order
                                                                        </td>
                                                                        <td>
                                                                            <select id="POID" name="POID" class="form-control select2" style="width:90%"></select>
                                                                        </td>
                                                                        <td>
                                                                            <input type="button" id="btnAddGRNItem" class="btn btn-round btn-info" value="+" />
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>*@
                                                    </div>
                                                    <div id="btnAddRequestItems">

                                                    </div>
                                                    <br /><div class="text-info"><b>GRN Items</b></div>
                                                    <br />
                                                    <div>
                                                        <table id="tblRecepies" class="mstable">
                                                            <thead>
                                                                <tr>
                                                                    @*<th>idx</th>*@
                                                                    <th style="display:none">Item Id</th>
                                                                    <th style="display:none">Item Id</th>
                                                                    <th>Item</th>
                                                                    <th >PO Qty</th>
                                                                    <th>Unit</th>
                                                                    @*<th>Quantity</th>*@
                                                                    <th>GRN Quantity</th>
                                                                    <th>Free Qty</th>
                                                                    <th>
                                                                        Discount
                                                                        <br />
                                                                        <div class="small">
                                                                            Amount
                                                                            <input type="radio" checked id="amount" name="amount" value="amount" />
                                                                            <br />
                                                                            Per. %
                                                                            <input type="radio" id="prc" name="amount" value="prc" />
                                                                        </div>
                                                                    </th>
                                                                    <th>Cost Price (Unit)</th>
                                                                    <th>Cost Value</th>
                                                                    <th style="display:none">Selling Price (Unit)</th>
                                                                    <th>Tax</th>
                                                                    <th>Expiry Date</th>
                                                                    @*<th>Discount Type</th>*@
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="grnitems">
                                                                @if (Model.GRNDetail != null)
                                                                {
                                                                    foreach (var grnDetail in Model.GRNDetail)
                                                                    {

                                                                        <tr>
                                                                            <td style='display:none'><input name='GRNDetail.Index' id='GRNDetail[@grnDetail.ProductID]_Id' type='hidden' style="text-align:right" value=@grnDetail.ProductID /></td>
                                                                            <td style="display:none"><input id='GRNDetail[@grnDetail.ProductID]_ProductID' class='form-control' name='GRNDetail[@grnDetail.ProductID].ProductID' type='text' style="text-align:right" readonly value=@grnDetail.ProductID /></td>
                                                                            <td id='GRNDetail[@grnDetail.ProductID]_ProductName' name='GRNDetail[@grnDetail.ProductID].ProductName'>@grnDetail.ProductName</td>
                                                                            <td ><input id='GRNDetail[@grnDetail.ProductID]_OrderQty' typeof="hidden" class='form-control' name='GRNDetail[@grnDetail.ProductID].OrderQty' type='number' style="text-align:right" readonly value=@Convert.ToDecimal(grnDetail.POQuantity) /></td>
                                                                            <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_UOM' class='form-control' name='GRNDetail[@grnDetail.ProductID].UOM' type='text' style="text-align:center" readonly value=@grnDetail.UOM /></td>
                                                                            <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_GRNQuantity' class='form-control' name='GRNDetail[@grnDetail.ProductID].GRNQuantity' type='number' step="0.0001" min="0" onkeyup="checkGRNQty(@grnDetail.ProductID)" style="text-align:right" readonly value=@Convert.ToDecimal(grnDetail.GRNQuantity) /></td>
                                                                            <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_FreeQty' class='form-control' name='GRNDetail[@grnDetail.ProductID].FreeQty' type='number' step="0.0001" min="0" style="text-align:right" value=@Convert.ToDecimal(grnDetail.FreeQty) oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' /></td>
                                                                            <td><small>@grnDetail.DiscountType</small><input id='GRNDetail[@grnDetail.ProductID]_Discount' class='form-control' name='GRNDetail[@grnDetail.ProductID].Discount' step="0.0001" min="0" onkeyup='itemDiscount(@grnDetail.ProductID)' type='number' style="text-align:right" value=@Convert.ToDecimal(grnDetail.Discount) oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0,6);' /></td>
                                                                            @if (ViewBag.EditCostPriceOnGRN == "1")
                                                                            {
                                                                                if (Model.GRNType == "Manual")
                                                                                {
                                                                                    <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_CostPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPrice' step="0.001" min="0" type='text' style="text-align:right" onkeyup='SetCostValue(@grnDetail.ProductID)' value=@grnDetail.CostPrice /></td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_CostPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPrice' readonly step="0.001" min="0" type='text' style="text-align:right" onkeyup='SetCostValue(@grnDetail.ProductID)' value=@grnDetail.CostPrice /></td>
                                                                                }
                                                                            }
                                                                            else if (ViewBag.EditCostPriceOnGRN == "0")
                                                                            {
                                                                                <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_CostPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPrice' step="0.0001" min="0" type='text' readonly style="text-align:right" onkeyup='SetCostValue(@grnDetail.ProductID)' value=@grnDetail.CostPrice /></td>
                                                                            }
                                                                            <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_CostValue' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostValue' step="0.001" min="0" type='text' style="text-align:right" readonly value=@grnDetail.CostValue.ToString("F3") /></td>
                                                                            <td style="display:none"><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_SellingPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].SellingPrice' step="0.0001" min="0" type='text' style="text-align:right" onkeyup='SetTotalSellingValue(@grnDetail.ProductID)' value=@grnDetail.SellingPrice /></td>
                                                                            <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_TotalTax' class='form-control' name='GRNDetail[@grnDetail.ProductID].TotalTax' type='text' step="0.0001" min="0" readonly style="text-align:right" value=@grnDetail.TotalTax /></td>
                                                                            <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_SellingPriceHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID].SellingPriceHidden' type='number' step="0.0001" min="0" style="text-align:right" value=@grnDetail.SellingPrice /></td>
                                                                            <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_unitCostValueCellHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID].unitCostValueCellHidden' type='number' step="0.001" min="0" style="text-align:right" value=@grnDetail.CostValue.ToString("F3") /></td>
                                                                            <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_DiscountPercentage' class='form-control' name='GRNDetail[@grnDetail.ProductID].DiscountPercentage' type='text' value=@grnDetail.DiscountPercentage /></td>
                                                                            <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_DiscountAmount' class='form-control' name='GRNDetail[@grnDetail.ProductID].DiscountAmount' type='text' value=@grnDetail.DiscountAmount /></td>
                                                                            <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_DiscountType' class='form-control' name='GRNDetail[@grnDetail.ProductID].DiscountType' type='text' value=@grnDetail.DiscountType /></td>
                                                                            <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_CostPriceHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPriceHidden' step="0.0001" min="0" type='text' style="text-align:right" value=@grnDetail.CostPrice /></td>

                                                                            @if (grnDetail.IsExpiry == true)
                                                                            {

                                                                                if (grnDetail.ExpiryDate != null)
                                                                                {
                                                                                    <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_ExpiryDate' class='form-control' name='GRNDetail[@grnDetail.ProductID].ExpiryDate' type='date' value=@grnDetail.ExpiaryDate.ToString("yyyy-MM-dd") /></td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_ExpiryDate' class='form-control' name='GRNDetail[@grnDetail.ProductID].ExpiryDate' type='date' value='' /></td>
                                                                                }

                                                                            }
                                                                            else
                                                                            {
                                                                                if (grnDetail.ExpiryDate != null)
                                                                                {
                                                                                    <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_ExpiryDate' class='form-control' name='GRNDetail[@grnDetail.ProductID].ExpiryDate' type='date' readonly value=@grnDetail.ExpiaryDate.ToString("yyyy-MM-dd") /></td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td><small style="color:transparent">0</small><input id='GRNDetail[@grnDetail.ProductID]_ExpiryDate' class='form-control' name='GRNDetail[@grnDetail.ProductID].ExpiryDate' type='date' readonly value='' /></td>
                                                                                }

                                                                            }

                                                                            <td>
