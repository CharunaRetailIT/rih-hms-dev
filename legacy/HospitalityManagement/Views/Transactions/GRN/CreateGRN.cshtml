<script>
    function SetNetAmount() {
        //  debugger;
        var totalLineDis = document.getElementById('TotDiscounts').value;
        var grossAmount = document.getElementById('GrossAmount').value;
        var disAmount = document.getElementById('DiscountAmount').value;
        var disPer = document.getElementById('DiscountPercentage').value;
        var deduction = document.getElementById('Deductions').value;
        var otherCharges = document.getElementById('OtherChargers').value;
        var totalTax = document.getElementById('TotalTaxAmount').value;
        var netAmount = document.getElementById('NetAmount').value;
        var netDiscount = 0;
        var net = 0;

        if (disAmount > 0) {
            netDiscount = disAmount;
        }
        else if (disPer > 0) {
            netDiscount = Number((Number(grossAmount) * Number(disPer)) / 100).toFixed(3);
            // netDiscount = Number((Number(netAmount) * Number(disPer))/100).toFixed(3);
        }

        net = Number(grossAmount) - (Number(totalLineDis) + Number(netDiscount) + Number(deduction)) + (Number(otherCharges) + Number(totalTax));
        document.getElementById('NetAmount').value = parseFloat(net).toFixed(3);
    }
</script>
<script>
    function CheckMaximumDiscountAmount(i) {
        $.ajax({
            url: "@Url.Action("GetMaximumDiscountAmount", "GRN")",
            data: { ItemId: $("#ItemId").val(), GRNLocationId: $("#GRNLocationId").val() },
            type: "GET",
            dataType: "json",
            success: function (data) {
                if(data != null)
                {
                    var disAmount = document.getElementById('GRNDetail[' + i + ']_Discount').value;
                    if(document.getElementById('GRNDetail[' + i + ']_DiscountType').value = "Amt")
                    {
                        if(data < disAmount)
                        {
                            alert("Maximum Discount Amount Exceeding");
                            document.getElementById('GRNDetail[' + i + ']_Discount').value = 0;
                            SetCostValue(i);
                        }
                    }
                    else
                    {
                        alert(document.getElementById('GRNDetail[' + i + ']_DiscountType').value);
                    }

                }
                else
                {
                    alert("Something went wrong");
                }



            }
        });
    }

    function CheckMaximumDiscountPercentage(i) {
        $.ajax({
