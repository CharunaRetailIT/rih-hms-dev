<script>
    function calcTotal(table) {


        console.log("urf");
        // debugger;
        var totsp = 0.0;
        var totcp = 0.0;
        var totdis = 0.0;
        var tottax = 0.0;
        var sellingval = 0;
        var costval = 0.0;

        var rowitemid;
        var regex = /value="(\d+(\.\d)*)/i;


        console.log(table);



        for (var r = 0, n = table.rows.length; r < n; r++) {
            var rowitemid = table.rows[r].cells[1].innerHTML.match(regex)[1];

            var spvalue = document.getElementById('GRNDetail[' + rowitemid + ']_SellingPrice').value;
            totsp += Number(spvalue);

            var cpvalue = document.getElementById('GRNDetail[' + rowitemid + ']_CostPrice').value;
            totcp += Number(cpvalue);
            
            var costvalue = document.getElementById('GRNDetail[' + rowitemid + ']_CostValue').value;
            costval += Number(costvalue);
            console.log("costvalue" + Number(costvalue));



            var taxvalue = document.getElementById('GRNDetail[' + rowitemid + ']_TotalTax').value;
            tottax += Number(taxvalue);
            console.log("tottax" + Number(tottax));


            var qtyvalue = document.getElementById('GRNDetail[' + rowitemid + ']_GRNQuantity').value;
            sellingval += spvalue * qtyvalue;
            console.log("sellingval" + Number(sellingval));


            SetTotalSellingValue(rowitemid);
        }

        document.getElementById("TotSellingPrice").value = parseFloat(sellingval).toFixed(3);
        document.getElementById("TotCostPrice").value = parseFloat(costval).toFixed(3);
        document.getElementById("TotalTax").value = parseFloat(tottax).toFixed(3);

        //Added by pavithra to update the step 3 total taxes
        document.getElementById("TotalTaxAmount").value = parseFloat(tottax).toFixed(3);
        document.getElementById("GrossAmount").value = parseFloat(
            Number(document.getElementById("TotCostPrice").value)
        ).toFixed(3);

        //document.getElementById("NetAmount").value = parseFloat((tottax +
        //     Number(document.getElementById("TotCostPrice").value))
        //).toFixed(3);

        var otherchargers = document.getElementById("OtherChargers").value;
        var disamt = document.getElementById("DiscountAmount").value;
        var disprc = document.getElementById("DiscountPercentage").value;
        //var disprcamt=((Number(document.getElementById('NetAmount').value) * Number(disprc))/100);
        var disprcamt = ((Number(document.getElementById('GrossAmount').value) * Number(disprc)) / 100);

        document.getElementById("NetAmount").value = parseFloat(
            (tottax +
                Number(document.getElementById("TotCostPrice").value) +
                Number(otherchargers)) -
            Number(disamt) -
            Number(disprcamt)
        ).toFixed(3);

        //document.getElementById("NetAmountHidden").value = parseFloat(
        //    document.getElementById("NetAmount").value
        //    ).toFixed(3);

        document.getElementById("NetAmountHidden").value = parseFloat(
            (tottax +
                Number(document.getElementById("TotCostPrice").value) +
                Number(otherchargers)) -
            Number(disamt) -
            Number(disprcamt)

        ).toFixed(3);
    }
</script>
