<script>
    function SetTotalSellingValue(i) {
        // debugger;

        var sellingval = 0;
        var NetSelling = 0;
        var cost = 0;
        var sum = 0;
        var costval = 0;
        var discount = 0;

        var discountsum = 0;
        //var quantity = document.getElementById('GRNDetail' + i + '_GRNQuantity').value;
        //var selling = document.getElementById('GRNDetail' + i + '_SellingPrice').value;
        var table = document.getElementById("grnitems");

        var rowitemid;
        var regex = /value="(\d+(\.\d)*)/i;


        for (var x = 0; x < table.rows.length; x++) {
            var netdiscount = 0;
            rowitemid = table.rows[x].cells[1].innerHTML.match(regex)[1];
            //Total selling calculation
            quantity = document.getElementById('GRNDetail[' + rowitemid + ']_GRNQuantity').value;
            selling = document.getElementById('GRNDetail[' + rowitemid + ']_SellingPrice').value;
            sellingval = Number(selling) * Number(quantity);
            sum = sum + sellingval;
            document.getElementById("TotSellingPrice").value = parseFloat(sum).toFixed(3);

            //Discount calculation
            cost = document.getElementById('GRNDetail[' + rowitemid + ']_CostPrice').value;
            costval = cost * quantity;
            var tblCostVal = document.getElementById('GRNDetail[' + rowitemid + ']_CostValue').value;
            var discount = Number(costval) - Number(tblCostVal);
            discountsum = Number(discountsum) + Number(discount);


        }

        document.getElementById('TotDiscounts').value = parseFloat(discountsum).toFixed(3);
    }
</script>

