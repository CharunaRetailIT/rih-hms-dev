<script>
    function SetNetAmount() {
        //   debugger;
        var totalLineDis = document.getElementById('TotDiscounts').value;
        var grossAmount = document.getElementById('GrossAmount').value;
        var disAmount = document.getElementById('DiscountAmount').value;
        var disPer = document.getElementById('DiscountPercentage').value;
        var deduction = document.getElementById('Deductions').value;
        var otherCharges = document.getElementById('OtherChargers').value;
        //var totalTax = document.getElementById('TotalTaxAmount').value;
        var totalTax = document.getElementById('TotalTax').value;
        var netAmount = document.getElementById('NetAmount').value;
        var netDiscount = 0;
        var net = 0;

        if (disAmount > 0) {
            netDiscount = disAmount;
        }
        else if (disPer > 0) {
            netDiscount = ((Number(grossAmount) * Number(disPer)) / 100).toFixed(3);
        }

        net = (Number(grossAmount) - (Number(totalLineDis) + Number(netDiscount) + Number(deduction)) +
            (Number(otherCharges) + Number(totalTax))).toFixed(3);
        document.getElementById('NetAmount').value = parseFloat(net).toFixed(3);
        // debugger;
    }
</script>


@*Set Cost values*@
<script>
    function SetCostValue(i)
    {
       // debugger;

        var quantity = document.getElementById('GRNDetail[' + i + ']_GRNQuantity').value;

        var costprice = document.getElementById('GRNDetail[' + i + ']_CostPrice').value;
        var productid = document.getElementById('GRNDetail[' + i + ']_ProductID').value;
        var costpricehidden = document.getElementById('GRNDetail[' + i + ']_CostPriceHidden').value;
        document.getElementById('GRNDetail[' + i + ']_CostValue').value = (Number(quantity) * Number(costprice));
        var disAmount;

        if(costprice==0)
        {
            alert("Cost Price can not be 0 !");
            costprice=costpricehidden;
            document.getElementById('GRNDetail[' + i + ']_CostPrice').value=costpricehidden;
        }


        //Added by pavithra to correct the cost value with discount changing
        if(document.getElementById('amount').checked )
        {
            disAmount = document.getElementById('GRNDetail[' + i + ']_Discount').value;
        }
        else if(document.getElementById('prc').checked )
        {
            var disPer = document.getElementById('GRNDetail[' + i + ']_Discount').value;
            disAmount = ((costprice * disPer)/100);
        }


        //Commented below line and added new line to check the cost value with discount changing
        // document.getElementById('GRNDetail' + i + '_CostValue').value = (Number(quantity) * Number(costprice));
        document.getElementById('GRNDetail[' + i + ']_CostValue').value = (Number(quantity) * Number(costprice)) - Number(disAmount);

        //   document.getElementById('GRNDetail[' + i + ']_TotalTax').value = data.TaxAmount;

        $.ajax({
            url: "@Url.Action("ApplyNewTaxes", "PO")",
            data: { id: productid, qty: quantity, polocid: $("#GRNLocationId").val(), newcostprice: costprice },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {

                data = resp;

                document.getElementById('GRNDetail[' + i + ']_TotalTax').value = data.TaxAmount;

                var table = document.getElementById("grnitems");

                document.getElementById("TotCostPrice").value = 0;
                document.getElementById("TotSellingPrice").value = 0;
                document.getElementById("TotalTax").value = 0;
                var cp = 0;
                var sp = 0;
                var tp = 0;
                var rowitemid;
                var regex = /value="(\d+(\.\d)*)/i;
                for (var r = 0, n = table.rows.length; r < n; r++)
                {
                    rowitemid =  table.rows[r].cells[1].innerHTML.match(regex)[1];
                    cp += Number(document.getElementById('GRNDetail[' + rowitemid + ']_CostValue').value);
                    tp += Number(document.getElementById('GRNDetail[' + rowitemid + ']_TotalTax').value);

                }

                document.getElementById("TotCostPrice").value = cp;
                document.getElementById("TotalTax").value = tp;


                document.getElementById("GrossAmount").value = parseFloat(
                    Number(document.getElementById("TotCostPrice").value)
                    ).toFixed(3);


                document.getElementById("NetAmount").value = parseFloat((tp +
                     Number(document.getElementById("TotCostPrice").value))
                ).toFixed(3);

            }
        });






    }
</script>
