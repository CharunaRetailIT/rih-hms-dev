<script>
    function itemDiscount(i) {
        // debugger;
        var discounttype = document.getElementById('amount').checked;

        var costprice = Number(document.getElementById('GRNDetail[' + i + ']_CostPrice').value);
        var qty = Number(document.getElementById('GRNDetail[' + i + ']_GRNQuantity').value);
        var discounts = Number(document.getElementById('GRNDetail[' + i + ']_Discount').value)

        if (discounttype) {
            if (discounts <= costprice) {
                document.getElementById('GRNDetail[' + i + ']_CostValue').value = ((costprice * qty) - (discounts * qty)).toFixed(3);
                document.getElementById('GRNDetail[' + i + ']_DiscountAmount').value = discounts;
                document.getElementById('GRNDetail[' + i + ']_DiscountType').value = "Amt";
            } else {
                alert("Invalid Discount Amount..!");
                document.getElementById('GRNDetail[' + i + ']_Discount').value = 0;
                document.getElementById('GRNDetail[' + i + ']_CostValue').value = ((costprice * qty)).toFixed(3);
                document.getElementById('GRNDetail[' + i + ']_DiscountAmount').value = 0;
                document.getElementById('GRNDetail[' + i + ']_DiscountType').value = "Amt";
            }
        } else {
            if ((costprice * discounts / 100) <= costprice) {
                document.getElementById('GRNDetail[' + i + ']_CostValue').value = ((costprice * qty) - ((costprice * qty) * discounts / 100)).toFixed(3);
                document.getElementById('GRNDetail[' + i + ']_DiscountPercentage').value = ((costprice * qty) * discounts / 100).toFixed(3);
                document.getElementById('GRNDetail[' + i + ']_DiscountType').value = "Prc";
            } else {
                alert("Invalid Discount Prc..!");
                document.getElementById('GRNDetail[' + i + ']_Discount').value = 0;
                document.getElementById('GRNDetail[' + i + ']_CostValue').value = ((costprice * qty)).toFixed(3);
                document.getElementById('GRNDetail[' + i + ']_DiscountPercentage').value = 0;
                document.getElementById('GRNDetail[' + i + ']_DiscountType').value = "Prc";
            }
        }



        var table = document.getElementById("grnitems");

        var dis = 0;
        var costvalue = 0;
        var taxamount = 0;

        var rowitemid;
        var regex = /value="(\d+(\.\d)*)/i;

        for (var r = 0, n = table.rows.length; r < n; r++) {
            rowitemid = table.rows[r].cells[1].innerHTML.match(regex)[1];
            dis += Number(document.getElementById('GRNDetail[' + rowitemid + ']_DiscountAmount').value);
            dis += Number(document.getElementById('GRNDetail[' + rowitemid + ']_DiscountPercentage').value);
            costvalue += Number(document.getElementById('GRNDetail[' + rowitemid + ']_CostValue').value);
            taxamount += Number(document.getElementById('GRNDetail[' + rowitemid + ']_TotalTax').value);

            //Added by pavithra
            SetTotalSellingValue(rowitemid);

        }

        //   document.getElementById('TotSellingPrice').value = parseFloat(val1 + val2).toFixed(2);
        document.getElementById('TotDiscounts').value = parseFloat(dis).toFixed(3);
        document.getElementById('TotCostPrice').value = parseFloat(costvalue).toFixed(3);
        document.getElementById('TotalTax').value = parseFloat(taxamount).toFixed(3);

        document.getElementById('NetAmount').value = Number(document.getElementById('TotCostPrice').value) + Number(document.getElementById('TotalTax').value);



    }
</script>

