<script>
    function calcTotal(table) {
        debugger;

        var totsp = 0.0;
        var totcp = 0.0;
        var totdis = 0.0;
        var tottax = 0.0;
        var regex = /value="(\d+(\.\d)*)/i;
        var rowproductid=0;

        for (var r = 0, n = table.rows.length; r < n; r++) {

            rowproductid = table.rows[r].cells[1].innerHTML.match(regex)[1];
            var spvalue=document.getElementById('GRNDetail[' + rowproductid + ']_SellingPrice').value;
            totsp += Number(spvalue);

            var cpvalue=document.getElementById('GRNDetail[' + rowproductid + ']_CostPrice').value;
            totcp += Number(cpvalue);

            var disval=document.getElementById('GRNDetail[' + rowproductid + ']_Discount').value;
            totdis += Number(disval);


        }
        document.getElementById("TotDiscounts").value = parseFloat(totdis).toFixed(2);
        document.getElementById("TotSellingPrice").value = parseFloat(totsp).toFixed(2);
        document.getElementById("TotCostPrice").value = parseFloat(totcp).toFixed(2);
        document.getElementById("GrossAmount").value = parseFloat(
            Number(document.getElementById("TotSellingPrice").value)
        ).toFixed(2);

        //document.getElementById("NetAmount").value = parseFloat((tottax +
        //        Number(document.getElementById("TotSellingPrice").value))
        //).toFixed(2);

        document.getElementById("NetAmount").value = parseFloat((tottax +
              Number(document.getElementById("TotCostPrice").value) - 
              Number(document.getElementById("DiscountAmount").value) +
              Number(document.getElementById("TotalTax").value) 
              )).toFixed(2);

        document.getElementById("NetAmountHidden").value = parseFloat(document.getElementById("NetAmount").value).toFixed(2);
    }
</script>

