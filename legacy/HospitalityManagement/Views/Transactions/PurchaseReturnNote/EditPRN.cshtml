<script type="text/javascript">
    function checkProductQuantity()
    {
        debugger;
        document.getElementById('validateqty').innerHTML = '';

        if ($("#GRNLocationId").val() == 0 || $("#GRNLocationId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select a Location';

            return;
        }



        if ($("#ItemId").val() == 0 || $("#ItemId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select an Item';
            return;
        }

        //if ($("#RecQty").val() == 0 || $("#RecQty").val() == null) {
        //    document.getElementById('validateqty').innerHTML = 'Quantity can not be 0 or empty';
        //    return;

        //} else
        //{
        //    document.getElementById('validateqty').innerHTML = '';
        //}

        $.ajax({
            url: "@Url.Action("VaidateQuantityForReturn", "PO")",
            data: { id: $("#ItemId").val(), polocid: $("#GRNLocationId").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {
                debugger;
                data = resp;
                if($("#RecQty").val()=="0"){
                    document.getElementById('validateqty').innerHTML = 'available stock is ' + resp;
                    document.getElementById('RecQty').value = '0';
                }else{
                    if (resp < $("#RecQty").val()) {
                        document.getElementById('validateqty').innerHTML = 'available stock is ' + resp;
                        document.getElementById('RecQty').value = '0';
                    } else
                    {
                        document.getElementById('validateqty').innerHTML = '';
                    }
                }

            }
        });


    }
</script>

