@model RIT.HMS.Domain.Transactions.PurchaseHeader
@{
    ViewBag.Title = "EditPRN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Transactions.css" rel="stylesheet" />

@if (ViewBag.Message != null)
{
    <script>
        $(document).ready(function () {
            alert('@ViewBag.ErrorMessage');
        });
    </script>
}

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Edit", "PurchaseReturnNote", FormMethod.Post,
         new { id="EditPRN", @class = "form-horizontal", @enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CreatedDate);
            @Html.HiddenFor(model => model.CreatedUser);
            @Html.HiddenFor(model => model.GRNId)
            @Html.HiddenFor(model => model.PurchaseHeaderId);
            @Html.HiddenFor(model => model.LocationId);
            @Html.HiddenFor(model => model.CostCentreID);
            @Html.HiddenFor(model => model.DocumentStatus);
            @Html.HiddenFor(model => model.IsTempPRN);
            @Html.HiddenFor(model => model.CompanyID);
            @Html.HiddenFor(model => model.LocationId);
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PRN</strong> @ViewBag.PRNCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PRN</strong> @ViewBag.PRNCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PRN</strong> must have atleast one Product.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this Location</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please enter the reject reason !</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please enter the cancel reason !</strong>
                        </div>
                    }
                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btn btn-info pull-left" value=" Reset " onclick="location.href='@Url.Action("Edit", null, new { id = Model.PurchaseHeaderId })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btn btn-primary pull-left" value="New PRN" onclick="location.href='@Url.Action("CreatePRN", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btn btn-info pull-left" value="View PRN(s)" onclick="location.href='@Url.Action("ViewAllPRN", null, new { })'" />
                            </div>
                            @if (Model.IsTempPRN && Model.DocumentNo.Contains("T"))
                            {
                                <button type="submit" formaction="/PurchaseReturnNote/Edit" id="ButtonSubmitPRN" class="btn btn-success pull-left">Submit PRN</button>
                                <button type="submit" formaction="/PurchaseReturnNote/TempEdit" id="ButtonTempEdit" class="btn btn-warning pull-left">Temporary Save PRN</button>
                                <button type="submit" formaction="/PurchaseReturnNote/Cancel" id="ButtonCancel" class="btn btn-danger pull-left">Cancel</button>
                            }

                            @if (Convert.ToBoolean(Session["APPPRN"]) == true)
                            {
                                if (Model.DocumentStatus == 2 || Model.DocumentStatus == 6)
                                {
                                    <button type="submit" formaction="/PurchaseReturnNote/Approve" id="ButtonApprove" class="btn btn-success pull-left">Approve</button>
                                    <button type="submit" formaction="/PurchaseReturnNote/Reject" id="ButtonReject" class="btn btn-danger pull-left">Reject</button>
                                    <button type="submit" formaction="/PurchaseReturnNote/Cancel" id="ButtonCancel" class="btn btn-danger pull-left">Cancel</button>
                                    <button type="submit" formaction="/PurchaseReturnNote/ForcefullyClose" id="ButtonForcefullyClose" class="btn btn-danger pull-left">Forcefully Close</button>


                                }
                                if (Model.DocumentStatus == 4 || Model.DocumentStatus == 5)
                                {
                                    <button type="submit" formaction="/PurchaseReturnNote/ReOpene" id="ButtonReOpene" class="btn btn-success pull-left">Re Open</button>
                                }
                            }
                            
                        </div>
                    </div>

                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Purchase Return Note</h2>
                                    <h4 class="small">@Model.DocState </h4> 
                                    <br />

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>General</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Items</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Prices</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-4">
                                                    <span class="step_no">4</span>
                                                    <span class="step_descr">
                                                        Step 4<br />
                                                        <small>Details</small>
                                                    </span>
                                                </a>
                                            </li>

                                        </ul>

                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.PRNType, "Manual", new { @id = "Manual", @checked = true })
                                                                Manual

                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.PRNType, "GRNBased", new { @id = "Auto" })
                                                                GRN based

                                                            </div>
                                                            @*<div class="clearfix"></div>
                                                                <div class="pull-left">
                                                                    @Html.RadioButtonFor(m => m.PRNType, "RequestNoteBased", new { @id = "Request" })
                                                                    Request Note Based

                                                                </div>*@
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="SupplierId" class="form-control" name="SupplierId"></select>
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            GRN # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="GRNIdg" name="GRNIdg" class="form-control"></select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier Invoice No <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            @*@Html.TextBoxFor(model => model.SupplierInvoiceNo, new { type = "text", @class = "form-control", MaxLength = 20 })
                                                                @Html.ValidationMessageFor(model => model.SupplierInvoiceNo, "", new { @class = "text-danger" })*@

                                                            @Html.TextBoxFor(model => model.SupplierInvoiceNo, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           min = 0,
                                                           MaxLength = 20,
                                                           oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.SupplierInvoiceNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="GRNLocationId" class="form-control" name="GRNLocationId"></select>
                                                            @Html.ValidationMessageFor(model => model.GRNLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="form-horizontal col-md-6">

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency  <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="CurrencyId" class="form-control" name="CurrencyId"></select>
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>

                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency Rate <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">
                                                            @Html.TextBoxFor(model => model.CurrencyRate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           min = 0,
                                                           MaxLength = 5,
                                                           Type = "number",
                                                           decimals = "4",
                                                           step = "any",
                                                           oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.CurrencyRate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Method <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentMethodId" class="form-control" name="PaymentMethodId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentMethodId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Term <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentTermId" class="form-control" name="PaymentTermId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentTermID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PRN Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">

                                                            @Html.TextBoxFor(model => model.GRNDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.GRNDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.GRNDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Event<span class="required"></span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="EventId" class="form-control" Name="EventId"></select>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div> <br />
                                        <div id="step-2">
                                            <div class="trn-detail col-md-12">
                                                <br />
                                                <div class="form-group">

                                                    <div id="buttons">
                                                        <table id="buttons2" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:10%">
                                                                        Item/Material
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToPRN"], new
                                                                        {
                                                                            @class = "form-control select2",
                                                                            @style = "width:80%"
                                                                        })
                                                                        @*<select id="ItemId" class="form-control select2" style="width:80%" name="ItemId"></select>*@
                                                                    </td>
                                                                    <td style="width:10%">
                                                                        Quantity
                                                                    </td>
                                                                    <td style="width:20%">
                                                                        <input id="RecQty" name="RecQty" type="number" value="0"  min="0"
                                                                               step="any" onkeypress="return event.charCode >= 46"
                                                                               onkeyup="checkProductQuantity()"
                                                                               class="form-control col-md-2 col-xs-6">

                                                                        <font color="red">
                                                                            <label id="validateqty" name="validateqty" style="font:small-caption"></label>
                                                                        </font>

                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddTOGItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddRequestItems"></div>
                                                    <div id="btnAddReOrderItems">
                                                    </div>
                                                    <div class="text-info"><b>Purchase Returns</b></div>
                                                    <table id="tblRecepies" class="table table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th style="display:none">Item Id</th>
                                                                <th>Item</th>
                                                                <th>Quantity</th>
                                                                <th>Free Qty</th>
                                                                <th>Discount</th>
                                                                <th>Cost Value</th>
                                                                <th style="display:none">Selling Value</th>

                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="grnitems">
                                                            @if (Model.GRNDetail != null)
                                                        {
                                                            foreach (var grnDetail in Model.GRNDetail)
                                                            {
                                                                    <tr>
                                                                        <td style='display:none'><input name='GRNDetail.Index' type='hidden' value=@grnDetail.ProductID /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_ProductID' class='form-control' name='GRNDetail[@grnDetail.ProductID].ProductID' type='text' readonly value=@grnDetail.ProductID /></td>
                                                                        <td id='GRNDetail[@grnDetail.ProductID]_ProductName' name='GRNDetail[@grnDetail.ProductID].ProductName'>@grnDetail.ProductName</td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_GRNQuantity' class='form-control' name='GRNDetail[@grnDetail.ProductID].GRNQuantity' type='number' readonly value=@Convert.ToDecimal(grnDetail.OrderQty) /></td>
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_OrderQty' class='form-control' name='GRNDetail[@grnDetail.ProductID].OrderQty' type='number' readonly value=@Convert.ToDecimal(grnDetail.OrderQty) /></td>
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_FreeQty' class='form-control' name='GRNDetail[@grnDetail.ProductID].FreeQty' type='number' value=@Convert.ToDecimal(grnDetail.FreeQty) /></td>
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_Discount' class='form-control' name='GRNDetail[@grnDetail.ProductID].Discount' type='number' readonly value=@Convert.ToDecimal(grnDetail.Discount) />Discount Type=@grnDetail.DiscountType</td>
                                                                        @*<td><input id='GRNDetail[@grnDetail.ProductID]_Discount' class='form-control' name='GRNDetail[@grnDetail.ProductID].Discount' type='number' readonly onkeyup='itemDiscount(@grnDetail.ProductID)' value=@Convert.ToDecimal(grnDetail.Discount) />Discount Type=@grnDetail.DiscountType</td>*@
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_CostPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPrice' type='text' readonly value=@grnDetail.CostPrice /></td>
                                                                        <td style="display:none"><input id='GRNDetail[@grnDetail.ProductID]_SellingPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].SellingPrice' type='text' readonly value=@grnDetail.SellingPrice /></td>
                                                                        <td style='display:none'> <input id='GRNDetail[@grnDetail.ProductID]_SellingPriceHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID].SellingPriceHidden' type='text' readonly value=@grnDetail.SellingPrice /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_DiscountType' class='form-control' name='GRNDetail[@grnDetail.ProductID].DiscountType' type='text' readonly value=@grnDetail.DiscountType /></td>
                                                                        <td>
                                                                            <input id='btnAddPRNItem' type='button' value='-' class='btn btn-round btn-info' onclick='removeGRNRow(this);' />
                                                                        </td>
                                                                    </tr>
                                                            }
                                                        }
                                                        </tbody>
                                                    </table>
                                                </div>
                                               
                                                <div id="summary" class="col-lg-12">

                                                    <div class="col-md-3">
                                                        <div class="form-group" style="display:none">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Selling Price <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @Html.TextBoxFor(model => model.TotSellingPrice, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                                @Html.ValidationMessageFor(model => model.TotSellingPrice, "", new { @class = "text-danger" })

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Cost Price <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @Html.TextBoxFor(model => model.TotCostPrice, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                                @Html.ValidationMessageFor(model => model.TotCostPrice, "", new { @class = "text-danger" })

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Discounts <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @Html.TextBoxFor(model => model.TotDiscounts, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                                @Html.ValidationMessageFor(model => model.TotDiscounts, "", new { @class = "text-danger" })
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div> <br />
                                        <div class="trn-footer col-md-12">
                                            <br />
                                            <div id="step-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Gross Amount<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.GrossAmount, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                            @Html.ValidationMessageFor(model => model.GrossAmount, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Discount Amount<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            @Html.TextBoxFor(model => model.DiscountAmount, new
                                                           {
                                                               @class = "form-control",
                                                               min = 0,
                                                               MaxLength = 10,
                                                               Type = "number",
                                                               decimals = "4",
                                                               step = "any",
                                                               onkeyup = "checkdiscounts()",
                                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                           })
                                                            @Html.ValidationMessageFor(model => model.DiscountAmount, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Discount Percentage<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            @Html.TextBoxFor(model => model.DiscountPercentage, new
                                                           {
                                                               @class = "form-control",
                                                               min = 0,
                                                               MaxLength = 10,
                                                               Type = "number",
                                                               decimals = "4",
                                                               step = "any",
                                                               onkeyup = "checkdiscountpercentage()",
