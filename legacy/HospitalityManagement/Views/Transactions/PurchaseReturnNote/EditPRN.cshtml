                            document.getElementById('GRNDetail[' + indexval + ']_SellingPriceHidden').value=data.SellingPrice;

                        }

                    }

                    var table = document.getElementById("grnitems");

                    var totsp = 0.0;
                    var totcp = 0.0;
                    var totqty = 0;
                    var totdis=0;

                    var regex = /value="(\d+(\.\d)*)/i;
                    var rowproductid=0;


                    for (var r = 0, n = table.rows.length; r < n; r++)
                    {
                        rowproductid = table.rows[r].cells[1].innerHTML.match(regex)[1];

                        var spvalue=document.getElementById('GRNDetail[' + rowproductid + ']_SellingPrice').value;
                        totsp += Number(spvalue);
                        var cpvalue=document.getElementById('GRNDetail[' + rowproductid + ']_CostPrice').value;
                        totcp += Number(cpvalue);
                        var qtyvalue=document.getElementById('GRNDetail[' + rowproductid + ']_OrderQty').value;
                        totqty += Number(qtyvalue);
                        var disvalue=document.getElementById('GRNDetail[' + rowproductid + ']_Discount').value;
                        totdis += Number(disvalue);
                    }
                    document.getElementById("TotDiscounts").value = parseFloat(totdis).toFixed(2);
                    document.getElementById("TotSellingPrice").value = parseFloat(totsp).toFixed(2);
                    document.getElementById("TotCostPrice").value = totcp;

                    document.getElementById("GrossAmount").value = parseFloat(
                        Number(document.getElementById("TotCostPrice").value)
                    ).toFixed(2);

                    document.getElementById("NetAmount").value = parseFloat((
                            Number(document.getElementById("TotCostPrice").value))
                    ).toFixed(2);

                    SetNetAmount();  //kapila 9/6/2020

                },
                error: function (error) {
                    alert("Item data mapping error");
                }
            });

        });



</script>

<script type="text/javascript">
    function checkdiscounts() {

        var discountamount = document.getElementById('DiscountAmount').value;
        if(Number(discountamount)>Number(document.getElementById('NetAmountHidden').value))
        {
            alert("Invalid Discount Amount!");
            document.getElementById('DiscountAmount').value="0";
            document.getElementById('NetAmount').value=document.getElementById('NetAmountHidden').value;
            return;
        }
        if(discountamount != null)
        {
            if (discountamount != 0) {
                document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                                Number(discountamount));
            } else {
                document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                                Number(discountamount));
            }

            //Added by pavithra
            if(document.getElementById('DiscountAmount').value > 0)
            {
                document.getElementById('DiscountPercentage').value = 0;
            }
            else if(document.getElementById('DiscountPercentage').value > 0)
            {
                document.getElementById('DiscountAmount').value = 0;
            }

            SetNetAmount();
        }

    }

</script>

<script type="text/javascript">

    function checkdiscountpercentage() {

        var discountpercentage = document.getElementById('DiscountPercentage').value;
        var tempDis = 0;
        tempDis = ((Number(document.getElementById('GrossAmount').value) * Number(discountpercentage).toFixed(3))/100);
        var nt=Number(document.getElementById('NetAmount').value);

        if(parseFloat(Number(document.getElementById('GrossAmount').value)) < parseFloat(tempDis))
        {
            alert("Invalid Discount Percentage!");
            document.getElementById('DiscountPercentage').value="0";
            document.getElementById('NetAmount').value=document.getElementById('NetAmountHidden').value;

            return;
        }
        if( discountpercentage != null)
        {
            if (discountpercentage != 0) {
                tempDis = ((Number(document.getElementById('GrossAmount').value) * Number(discountpercentage))/100);
                document.getElementById('NetAmount').value = Number(document.getElementById('GrossAmount').value) - tempDis;
            }
            else
            {
                document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value));
            }

            if(document.getElementById('DiscountAmount').value > 0)
            {
                document.getElementById('DiscountPercentage').value = 0;
            }
            else if(document.getElementById('DiscountPercentage').value > 0)
            {
                document.getElementById('DiscountAmount').value = 0;
            }

            SetNetAmount();
        }


    }
</script>