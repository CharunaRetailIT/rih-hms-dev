@model RIT.HMS.Domain.Transactions.PurchaseHeader
@{
    ViewBag.Title = "CreatePRN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm(null, null, FormMethod.Post, new
        {
            id = "CreatePRN",
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CompanyID);
            @Html.HiddenFor(model => model.LocationId);

            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PRN</strong> @ViewBag.PRNCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PRN</strong> @ViewBag.PRNCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PRN</strong> must have atleast one Product.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this Location</strong>
                        </div>
                    }

                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btnallClear" value=" Clear "
                                       onclick="location.href='@Url.Action("CreatePRN", null, new { })'" />
                            </div>
                            <div class=" pull-left">
                                <input type="button" class="btnallView" value="View Temp PRN(s)"
                                       onclick="location.href='@Url.Action("ViewAllPRN", null, new { })'" />
                            </div>
                            <button type="submit" formaction="CreatePRN" id="ButtonCreatePRN" class="btnallSubmit btn pull-left">Submit PRN</button>
                            <button type="submit" formaction="TempSavePRN" id="ButtonTempSavePRN" class="btnallTemporary btn pull-left">Temporary Save PRN</button>
                        </div>
                    </div>


                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Purchase Return Note</h2>
                                    <br />
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        @*<small>Step 1 description</small>*@
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        @*<small>Step 2 description</small>*@
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        @*<small>Step 3 description</small>*@
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-4">
                                                    <span class="step_no">4</span>
                                                    <span class="step_descr">
                                                        Step 4<br />
                                                        @*<small>Step 4 description</small>*@
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>
                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.PRNType, "Manual", new { @id = "Manual" })
                                                                Manual
                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.PRNType, "GRNBased", new { @id = "Auto", @checked = true })
                                                                GRN based
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="SupplierId" class="form-control" name="SupplierId"></select>
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            GRN # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="GRNId" name="GRNId" class="form-control"></select>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier Invoice No <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            @Html.TextBoxFor(model => model.SupplierInvoiceNo, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           min = 0,

                                                           oninput = "javascript: if (this.value.length > 20) this.value = this.value.slice(0, 20);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.SupplierInvoiceNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="GRNLocationId" class="form-control" name="GRNLocationId"></select>
                                                            @Html.ValidationMessageFor(model => model.GRNLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency  <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="CurrencyID" class="form-control" name="CurrencyID"></select>
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency Rate <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">
                                                            @Html.TextBoxFor(model => model.CurrencyRate, new
                                                               {
                                                                   @class = "form-control col-md-6 col-xs-6",
                                                                   min = 0,
                                                                   MaxLength = 10,
                                                                   Type = "number",
                                                                   step = 0.01,
                                                                   decimals = "2"
                                                                   //oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                               })
                                                            @Html.ValidationMessageFor(model => model.CurrencyRate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Method <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentMethodId" class="form-control" name="PaymentMethodId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentMethodId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Term <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentTermId" class="form-control" name="PaymentTermId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentTermID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PRN Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">

                                                            @Html.TextBoxFor(model => model.GRNDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.GRNDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.GRNDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Event<span class="required"></span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="EventId" class="form-control" Name="EventId"></select>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div> <br />
                                        <div id="step-2">
                                            <div class="trn-detail col-md-12">
                                                <br />
                                                <div class="form-group">
                                                    @*Item Table*@
                                                    <div id="buttons">
                                                        <table id="buttons2" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:10%">
                                                                        Item/Material
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToPRN"], new
                                                                    {
                                                                        @class = "form-control select2",
                                                                        @style = "width:80%"
                                                                    })
                                                                        @*<select id="ItemId" class="form-control select2" style="width:80%" name="ItemId"></select>*@
                                                                    </td>
                                                                    <td style="width:10%">
                                                                        Quantity
                                                                    </td>
                                                                    <td style="width:20%">
                                                                        <input id="RecQty" name="RecQty" type="number" value="0" min="0"
                                                                               step="any" onkeypress="return event.charCode >= 46"
                                                                               onkeyup="checkProductQuantity()"
                                                                               class="form-control col-md-2 col-xs-6">

                                                                        <font color="red">
                                                                            <label id="validateqty" name="validateqty style="font:small-caption"></label>
                                                                        </font>

                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddTOGItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddRequestItems"></div>
                                                    <div id="btnAddReOrderItems">
                                                    </div>
                                                    <div class="text-info"><b>Purchase Returns</b></div>
                                                    <table id="tblRecepies" class="mstable">
                                                        <thead>
                                                            <tr>
                                                                <th style="display:none">Item Id</th>
                                                                <th>Item</th>
                                                                <th>Quantity</th>
                                                                <th>Free Qty</th>
                                                                <th>Discount</th>
                                                                <th>Cost Value</th>
                                                                <th style="display:none">Selling Value</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="grnitems">
                                                            @if (Model.GRNDetail != null)
                                                            {
                                                                foreach (var grnDetail in Model.GRNDetail)
                                                                {
                                                                    <tr>
                                                                        <td style='display:none'><input name='GRNDetail.Index' type='hidden' value=@grnDetail.ProductID /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_ProductID' class='form-control' name='GRNDetail[@grnDetail.ProductID].ProductID' type='text' readonly value=@grnDetail.ProductID /></td>
                                                                        <td id='GRNDetail[@grnDetail.ProductID]_ProductName' name='GRNDetail[@grnDetail.ProductID].ProductName'>@grnDetail.ProductName</td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_GRNQuantity' class='form-control' name='GRNDetail[@grnDetail.ProductID].GRNQuantity' type='number' readonly value=@Convert.ToDecimal(grnDetail.OrderQty) /><label class="small" style="color:white">.</label></td>
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_OrderQty' class='form-control' name='GRNDetail[@grnDetail.ProductID].OrderQty' type='number' onkeyup='checkGRNQty(@grnDetail.ProductID)' value=@Convert.ToDecimal(grnDetail.OrderQty) /><label class="small" style="color:white">.</label></td>
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_FreeQty' class='form-control' name='GRNDetail[@grnDetail.ProductID].FreeQty' type='number' value=@Convert.ToDecimal(grnDetail.FreeQty) /><label class="small" style="color:white">.</label></td>
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_Discount' class='form-control' name='GRNDetail[@grnDetail.ProductID].Discount' type='number' readonly value=@Convert.ToDecimal(grnDetail.Discount) /><label class="small">Discount Type=@grnDetail.DiscountType</label></td>
                                                                        <td style="display:none"><input id='GRNDetail[@grnDetail.ProductID]_DiscountHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID]_DiscountHidden' type='number' readonly value=@Convert.ToDecimal(grnDetail.Discount) /></td>
                                                                        @*<td><input id='GRNDetail[@grnDetail.ProductID]_Discount' class='form-control' name='GRNDetail[@grnDetail.ProductID].Discount' type='number' readonly onkeyup='itemDiscount(@grnDetail.ProductID)' value=@Convert.ToDecimal(grnDetail.Discount) /><label class="small">Discount Type=@grnDetail.DiscountType</label></td>*@
                                                                        <td><input id='GRNDetail[@grnDetail.ProductID]_CostPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPrice' type='text' readonly value=@grnDetail.CostPrice /><label class="small" style="color:white">.</label></td>
                                                                        <td style="display:none"><input id='GRNDetail[@grnDetail.ProductID]_SellingPrice' class='form-control' name='GRNDetail[@grnDetail.ProductID].SellingPrice' type='text' readonly value=@grnDetail.SellingPrice /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_SellingPriceHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID].SellingPriceHidden' type='text' readonly value=@grnDetail.SellingPrice /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_CostPriceHidden' class='form-control' name='GRNDetail[@grnDetail.ProductID].CostPriceHidden' type='text' readonly value=@grnDetail.CostPrice /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_CPPRN' class='form-control' name='GRNDetail[@grnDetail.ProductID].CPPRN' type='text' readonly value=@grnDetail.CostPrice /></td>
                                                                        <td style='display:none'><input id='GRNDetail[@grnDetail.ProductID]_DiscountType' class='form-control' name='GRNDetail[@grnDetail.ProductID].DiscountType' type='text' readonly value=@grnDetail.DiscountType /></td>
                                                                        <td>
                                                                            <input id='btnAddPRNItem' type='button' value='-' class='btn btn-round btn-info' onclick='removeGRNRow(this);' />
                                                                        </td>
                                                                        @*<td>@grnDetail.OrderQty</td>
                                                                            <td>@grnDetail.FreeQty</td>
                                                                            <td>@grnDetail.Discount</td>
                                                                            <td>@grnDetail.CostPrice</td>
                                                                            <td style="display:none">@grnDetail.SellingPrice</td>*@
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <hr />
                                                <div id="summary" class="col-lg-12">
                                                    <div class="col-md-3" style="display:none">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Selling Value <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                <input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0"
                                                                       class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Cost Value <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @*<input id="TotCostPrice" name="TotCostPrice" type="number" readonly="readonly" value="0" class="form-control">*@
                                                                @Html.TextBoxFor(model => model.TotCostPrice, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           min = 0,
                                                           MaxLength = 10,
                                                           Type = "number",
                                                           step = 0.01,
                                                           decimals = "2",
                                                           @readonly = true

                                                       })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Discounts <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @*<input id="TotDiscounts" name="TotDiscounts" type="number" readonly="readonly" value="0" class="form-control" >*@
                                                                @Html.TextBoxFor(model => model.TotDiscounts, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           min = 0,
                                                           MaxLength = 10,
                                                           Type = "number",
                                                           step = 0.01,
                                                           decimals = "2",
                                                           @readonly = true

                                                       })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div> <br />
                                        <div class="trn-footer col-md-12">
                                            <br />
                                            <div id="step-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Gross Amount<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.GrossAmount, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                            @Html.ValidationMessageFor(model => model.GrossAmount, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Discount Amount<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">


                                                            @Html.TextBoxFor(model => model.DiscountAmount, new
                                                       {
                                                           @class = "form-control",
                                                           min = 0,
                                                           MaxLength = 10,
                                                           Type = "number",
                                                           decimals = "4",
                                                           step = "any",
                                                           onkeyup = "checkdiscounts()",
                                                           oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.DiscountAmount, "", new { @class = "text-danger" })


                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Discount Percentage<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DiscountPercentage, new
                                                       {
                                                           @class = "form-control",
                                                           min = 0,
                                                           MaxLength = 10,
                                                           Type = "number",
                                                           decimals = "4",
                                                           step = "any",
                                                           onkeyup = "checkdiscountpercentage()",
                                                           oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.DiscountPercentage, "", new { @class = "text-danger" })


                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Other Charges<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.OtherChargers, new
                                                   {
                                                       @class = "form-control",
                                                       min = 0,
                                                       MaxLength = 10,
                                                       Type = "number",
                                                       decimals = "4",
                                                       step = "any",
                                                       oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);",
                                                       onkeyup = "checkOtherChargers()"
                                                   })
                                                            @Html.ValidationMessageFor(model => model.OtherChargers, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Total Tax Amount<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

