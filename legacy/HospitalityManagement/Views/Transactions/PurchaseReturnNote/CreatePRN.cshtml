<script>
    function SetNetAmount() {
        debugger;

        var totalLineDis = document.getElementById('TotDiscounts').value;
        var grossAmount = document.getElementById('GrossAmount').value;
        var disAmount = document.getElementById('DiscountAmount').value;
        var disPer = document.getElementById('DiscountPercentage').value;
        var otherCharges = document.getElementById('OtherChargers').value;
        var totalTax = document.getElementById('TotalTax').value;
        var netAmount = document.getElementById('NetAmount').value;
        var netDiscount = 0;
        var net = 0;

        if (disAmount > 0) {
            netDiscount = 0;
            netDiscount = disAmount;
            // alert("netDiscount" + netDiscount)
        }
        else if (disPer > 0) {
            netDiscount = 0;
            netDiscount = (Number(grossAmount) * Number(disPer)) / 100;
        }
        //- (Number(totalLineDis) //kapila 7/6/2020 remomoved
        net = Number(grossAmount) - Number(netDiscount) + (Number(otherCharges) + Number(totalTax));
        document.getElementById('NetAmount').value = parseFloat(net).toFixed(2);
    }
</script>

