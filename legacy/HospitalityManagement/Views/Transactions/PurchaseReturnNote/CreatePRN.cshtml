<script>
    function checkGRNQty(i) {
        debugger;
        var q1 = document.getElementById('GRNDetail[' + i + ']_GRNQuantity').value;
        var q2 = document.getElementById('GRNDetail[' + i + ']_OrderQty').value;

        if (q1 == "" || q1 == null) {
            q1 = 0;
        }

        if (Number(parseFloat(q1).toFixed(2)) < Number(parseFloat(q2).toFixed(2))) {
            alert("GRN QTY can only Reduce!");
            document.getElementById('GRNDetail[' + i + ']_OrderQty').value = q1;
            q2 = q1;
            //  return;
        }

        var costValue = document.getElementById('GRNDetail[' + i + ']_CostPrice').value;
        var costValueHidden = document.getElementById('GRNDetail[' + i + ']_CostPriceHidden').value * q2;
        var sellingVal = document.getElementById('GRNDetail[' + i + ']_SellingPrice').value;
        var costPrice = document.getElementById('GRNDetail[' + i + ']_CostPriceHidden').value;
        var sellingPrice = sellingVal / q1;

        var disType = document.getElementById('GRNDetail[' + i + ']_DiscountType').value;
        var disvalue = 0;

        if (disType == "Amt") {
            disvalue = (document.getElementById('GRNDetail[' + i + ']_DiscountHidden').value / q1) * q2;
        }
        else if (disType == "Prc") {
            //disvalue= (costValueHidden * Number(document.getElementById('GRNDetail[' + i + ']_Discount').value))/100;
            disvalue = (document.getElementById('GRNDetail[' + i + ']_DiscountHidden').value / q1) * q2;
        }

        //  var NewCost = (Number(costPrice) * Number(q2)) - Number(disvalue);

        //  var NewCost = (Number(costValue) * Number(q2));
        var NewCost = Number(costPrice * q2) - Number(disvalue);
        var NewSelling = Number(sellingPrice) * Number(q2);

        document.getElementById('GRNDetail[' + i + ']_CostPrice').value = NewCost.toFixed(2);
        document.getElementById('GRNDetail[' + i + ']_SellingPrice').value = NewSelling.toFixed(2);
        document.getElementById('GRNDetail[' + i + ']_Discount').value = Number(disvalue);
        var table = document.getElementById("grnitems");
        var totdis = 0;

        var regex = /value="(\d+(\.\d)*)/i;
        var priductid = 0;
        for (var r = 0, n = table.rows.length; r < n; r++) {

            priductid = table.rows[r].cells[1].innerHTML.match(regex)[1];
            //changed by pavithra
            var disType = document.getElementById('GRNDetail[' + priductid + ']_DiscountType').value;
            var disvalue1 = 0;

            // if(disType == "Amt")
            // {
            disvalue1 = Number(document.getElementById('GRNDetail[' + priductid + ']_Discount').value);
            //  }
            //  else if(disType == "Prc")
            // {
            //disvalue= (costValue * Number(document.getElementById('GRNDetail[' + priductid + ']_Discount').value))/100;
            //  disvalue1= Number(document.getElementById('GRNDetail[' + priductid + ']_Discount').value);
            //}

            totdis += Number(disvalue1);


        }

        document.getElementById("TotDiscounts").value = parseFloat(totdis).toFixed(2);
        calcTotal(table);
    }

</script>


