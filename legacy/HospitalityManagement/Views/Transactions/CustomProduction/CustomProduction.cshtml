        });

    function removeUnitRow(id) {
        debugger;
        if (confirm("Do you want to delete? ")) {
            var controlToBeRemoved = "#trreceipeitem" + id;
            $(controlToBeRemoved).remove();

            var table = document.getElementById("receipeitems");

          
            var totcp = 0;           
            var totqty = 0;
            for (var r = 0, n = table.rows.length; r < n; r++) {              
                var cpvalue = document.getElementById('CustomProductionNoteDetail[' + r + ']_MaterialCostPrice').value;             
                totcp += Number(cpvalue);
            }

            $("#TotalCostPrice").val(Number(totcp).toFixed(2));

            //for (var r = 0, n = table.rows.length; r < n; r++)
            //{
                
            //    var cpcell = table.rows[r].cells[7].innerHTML;
            //    var cpvalue = Number(cpcell.match(/value="(\d+(\.\d)*)/i)[1]).toFixed(2);
            //    totcp += Number(cpvalue);             
            //}
            //$("#TotalCostPrice").val(Number(totcp).toFixed(2));
          

        }

    }
</script>

<script>
    function SummerizeTable()
    {
        var table = document.getElementById("receipeitems");
        $(table).each(function () {
            $(table).find('td').each(function () {
                var $this = $(this);
                var col = $this.index();
                var html = $this.html();
                var row = $(this).parent()[0].rowIndex;
                var span = 1;
                var cell_above = $($this.parent().prev().children()[col]);
                while (cell_above.html() === html) {
                    span += 1;
                    cell_above_old = cell_above;
                    cell_above = $(cell_above.parent().prev().children()[col]);
                }
                if (span > 1) {
                    // console.log(span);
                    $(cell_above_old).attr('rowspan', span);
                    $this.hide();
                }

            });
        });
    }
</script>

