@model RIT.HMS.Domain.Transactions.StockAdjustmentHeader
@{
    
    ViewBag.Title = "Stock Adjustment Header";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />


<div class="container body" novalidate>
    <div class="main_container">

        @using (Html.BeginForm(null, "StockAdjustment", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(model=>model.CompanyID)
            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Stock Adjustment</strong> @ViewBag.PCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Stock Adjustment</strong> @ViewBag.PCode Temporary saved.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Stock Adjustment</strong> @ViewBag.PCode save failed..
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this Location</strong>
                        </div>
                    }
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Stock Adjustment</h2>
                                    <br />                                   
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small></small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small></small>
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>
                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-10">

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="StockLocationId" class="form-control" name="StockLocationId"></select>
                                                            @Html.ValidationMessageFor(model => model.StockLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Note <span class="required"></span>
                                                        </label>
                                                        <div class="col-md-9 col-sm-6 col-xs-12">

                                                            @Html.TextAreaFor(model => model.Remark, new { @class = "form-control", MaxLength = 200, Placeholder = "Note",style="resize:none" })
                                                            @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div><br />
                                        <div id="step-2" style="height: 300px;">
                                            <div class="col-md-12 trn-detail">
                                                <br />

                                                <div class="form-group">
                                                    <div class="col-md-12">
                                                        <div class="col-md-4">
                                                            <input type="radio" id="Add" name="BaseType" value="Add" checked /> Add
                                                        </div>
                                                        <div class="col-md-4">
                                                            <input type="radio" id="Reduce" name="BaseType" value="Reduce" />Reduce
                                                        </div>
                                                        <div class="col-md-4">
                                                            <input type="radio" id="Override" name="BaseType" value="Override" />Override
                                                        </div>
                                                    </div>
                                                    <div class="clearfix"></div><br />

                                                    <div class="col-md-12">
                                                        <div class="col-md-10">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-2 col-sm-6">
                                                                    Reason<span class="required"></span>
                                                                </label>
                                                                <div class="col-md-5 col-sm-6 col-xs-12">
                                                                    <select id="TypeId" class="form-control pull-left" style="width:100%" name="TypeId"></select>
                                                                    @Html.ValidationMessageFor(model => model.BaseType, "", new { @class = "text-danger" })
                                                                </div>                                                   
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-2">
                                                                    Date <span class="required"></span>
                                                                </label>
                                                                <div class="col-md-2 col-sm-6 col-xs-12">
                                                                    @Html.TextBoxFor(model => model.CreatedDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",                                                      
                                                           @Type = "date",
                                                           @Value = Model.CreatedDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                                </div>
                                                                </div>


                                                            </div>
                                                        <div class="col-md-2 pull-left">

                                                        </div>

                                                        <div class="clearfix"></div>

                                                        <div class="col-md-10">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-2 col-sm-6">
                                                                    Product<span class="required"></span>
                                                                </label>
                                                                <div class="col-md-5 col-sm-6 col-xs-12">
                                                                @Html.DropDownList("ProductId", (IEnumerable<SelectListItem>)Session["Products"], new
                                                                {
                                                                    @class = "form-control select2",
                                                                    @style = "width:100%"
                                                                })


                                                                    @*<select id="ProductId" class="form-control select2" style="width:100%" name="ProductId"></select>*@
                                                                </div>
                                                                <label class="control-label col-md-2">
                                                                    Quantity<span class="required"></span>
                                                                </label>
                                                                <div class="col-md-2 col-sm-6 col-xs-12">
                                                                    <input id="ProductQty" name="ProductQty" type="text" min='0' , onkeypress="validateInputForNumbers(event)" class="form-control col-md-2 col-xs-6">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2 pull-left">
                                                            <input type="button" id="btnAddAdjustment" class="btn btn-round btn-info pull-left" value="+" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <br />
                                                    <div class="clearfix"></div>
                                                    <div class="text-info"><b>Products</b></div>
                                                    <div class="text-info">@Html.ValidationMessageFor(model => model.StockAdjDetail, "", new { @class = "text-danger pull-left" })</div>

                                                    <table id="tblRecepies" class="mstable">
                                                        <thead>
                                                            <tr>

                                                                <th style='display:none'>Material Id</th>
                                                                <th style="width:30%">Material</th>
                                                                <th>Current Stock</th>
                                                                <th>Adjusted Stock</th>
                                                                <th>New Stock</th>
                                                                <th>Type</th>
                                                                <th>Reason</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="receipeitems">
                                                           
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <div class="btnallClear btn pull-left">                                               
                                                @Html.ActionLink("Clear", "Index", null, new
                                               {
                                                   @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode','Lucida Grande', Sans-Serif;text-decoration: none"
                                               })
                                            </div>                                          
                                            <button type="submit" id="1" formaction="SubmitAdjustment" class="btnallSubmit btn pull-left">Submit Adjustment</button>                                       
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="se-pre-con"></div>
                        <div id='myModal' class='modal'>
                            <div class="col-md-12">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div id='myModalContent'>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>   
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    $(document).ready(function SwitchWizard ()
    {
        if('@Convert.ToBoolean(Session["POWizadUI"])'=='False'){
            document.getElementById("wizard").className="";
            var e= document.getElementById("wizard");
            e.id = "plain";
            document.getElementById("wizardsteps").style = "display:none";
        }
    });
</script>

<script>
    if(@ViewBag.HeaderId!=null){

        var TeamDetailPostBackURL = '/StockAdjustment/Print';

        $(function () {
            debugger;
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var options = { "backdrop": "static", keyboard: true };
            $.ajax({
                type: "GET",
                url: TeamDetailPostBackURL,
                contentType: "application/json; charset=utf-8",
                data: { "id":@ViewBag.HeaderId,"printstatus":1 },
                datatype: "json",
                success: function (data) {

                    $('#myModalContent').html(data);
                    $('#myModal').modal(options);
                    $('#myModal').modal('show');

                },
                error: function () {
                    alert("Dynamic content load failed.");
                }
            });
        });
        $("#closbtn").click(function ()
        {
            $('#myModal').modal('hide');
        });
    }
</script> 

<script>
    function validateInputForNumbers(evt) {
        var theEvent = evt || window.event;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        } else {

            var key = theEvent.keyCode || theEvent.which;
            key = String.fromCharCode(key);
        }
        var regex = /[0-9]|\./;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }
</script>
