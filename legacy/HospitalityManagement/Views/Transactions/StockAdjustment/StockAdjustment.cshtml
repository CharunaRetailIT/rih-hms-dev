<script type="text/javascript">
    $("body").on("click",
        "#btnAddAdjustment",
        function () {

            if ($("#StockLocationId").val() == 0 || $("#StockLocationId").val() == null) {
                alert("Select a  location!");
                return;
            }

            if ($("#TypeId").val() == 0 || $("#TypeId").val() == null) {
                alert("Select the reason!");
                return;
            }

            if ($("#ProductId").val() == 0 || $("#ProductId").val() == null) {
                alert("Select a Product!");
                return;
            }

            if (document.getElementById('Add').checked) {
                rate_value = document.getElementById('Add').value;
            } else if (document.getElementById('Reduce').checked) {
                rate_value = document.getElementById('Reduce').value;
            } else if (document.getElementById('Override').checked) {
                rate_value = document.getElementById('Override').value;
            }

            var stock = $("#ProductQty").val();
            var locname = $("#StockLocationId option:selected").text();

            var Type = $("#TypeId option:selected").text();
            var itemId = $("#ProductId").val();

            $.ajax({
                url: "@Url.Action("GetAdjustmentData", "StockAdjustment")",
                data: {
                    productid: $("#ProductId").val(),
                    locid: $("#StockLocationId").val(),
                    adjStock: $("#ProductQty").val(),
                    type: rate_value
                },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    var tableStockAdj = document.getElementById("receipeitems");
                    var hasitem = '0';
                    // checking already exists
                    for (var r = 0, n = tableStockAdj.rows.length; r < n; r++) {
                        var itemidcell = tableStockAdj.rows[r].cells[1].innerHTML;
                        var regex = /value="(\d+(\.\d)*)/i;
                        var itemidex = itemidcell.match(regex)[1];
                        if (itemidex == itemId) {
                            hasitem = '1';
                        }
                    }
                    if (hasitem == '0') {
                        var unitindex = $("#receipeitems").children("tr").length;
                        var unitindexCell = "<td style='display:none'><input name='StockAdjDetail.Index' type='hidden' value='" +
                            unitindex + "' /></td>";

                        var unitIdCell = "<td style='display:none'><input id='StockAdjDetail" + unitindex + "_ProductId' class='form-control' name='StockAdjDetail[" +
                            unitindex + "].ProductId' type='text' readonly value='" + $("#ProductId").val() + "' /></td>";

                        var unitDescCell = "<td><input id='StockAdjDetail" + unitindex + "_ProductName'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].ProductName' type='text' readonly value='" + $("#ProductId option:selected").text().split('(')[0] + "' /></td>";

                        var unitCStockCell = "<td><input id='StockAdjDetail" + unitindex + "_CurrentStock'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].CurrentStock'  readonly value='" + data.CurrentStock + "' /></td>";

                        var unitAStockCell = "<td><input id='StockAdjDetail" + unitindex + "_AdjustStock'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].AdjustStock' type='text' readonly value='" + data.AdjustStock + "' /></td>";

                        var unitNewStockCell = "<td><input id='StockAdjDetail" + unitindex + "_NewStock'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].NewStock' type='text' readonly value='" + data.NewStock + "' /></td>";

                        var unitTypeCell = "<td><input id='StockAdjDetail" + unitindex + "_BaseType'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].BaseType' type='text' readonly value='" + rate_value + "' /></td>";

                        var unitReasonCell = "<td><input id='StockAdjDetail" + unitindex + "_Reason'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].Reason' type='text' readonly value='" + Type + "' /></td>";

                        var unitCPCell = "<td style='display:none'><input id='StockAdjDetail" + unitindex + "_CostPrice'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].CostPrice' type='hidden' readonly value='" + data.CostPrice + "' /></td>";

                        var unitSPCell = "<td style='display:none'><input id='StockAdjDetail" + unitindex + "_SellingPrice'  class='form-control'  name='StockAdjDetail[" +
                            unitindex + "].SellingPrice'  type='hidden' readonly value='" + data.SellingPrice + "' /></td>";

                        var unitRemoveCell = "<td><input id='btnRemoveReceipeItem' type='button' value='-' class='btn btn-round btn-info'  onclick='removeUnitRow(" +
                            unitindex + ");' /></td>";

                        var newUnitRow = "<tr id='trreceipeitem" + unitindex + "'>" +
                            unitindexCell +
                            unitIdCell +
                            unitDescCell +
                            unitCStockCell +
                            unitAStockCell +
                            unitNewStockCell +
                            unitTypeCell +
                            unitReasonCell +
                            unitCPCell +
                            unitSPCell +
                            unitRemoveCell + "</tr>";

                        $("#receipeitems").append(newUnitRow);

                        $("#ProductQty").val('');
                        //});

                        var table = document.getElementById("receipeitems");

                        var totsp = 0.0;
                        var totcp = 0.0;
                        var totqty = 0;

                        for (var r = 0, n = table.rows.length; r < n; r++) {
                            var spcell = table.rows[r].cells[5].innerHTML;
                            //alert(spcell);
                            var regex = /value="(\d+(\.\d)*)/i;
                            var spvalue = spcell.match(regex)[1];

                            // alert((spvalue));
                            totsp += Number(spvalue);

                            var cpcell = table.rows[r].cells[4].innerHTML;
                            var cpvalue = parseFloat(cpcell.match(/value="(\d+(\.\d)*)/i)[1]).toFixed(2);
                            totcp += Number(cpvalue);

                            var qtycell = table.rows[r].cells[3].innerHTML;
                            var qtyvalue = parseFloat(qtycell.match(/value="(\d+(\.\d)*)/i)[1]).toFixed(2);
                            totqty += Number(qtyvalue);
                        }
                        document.getElementById("StockLocationId").disabled = true;
                        //document.getElementById("ProductSellingPrice").value = parseFloat(totsp).toFixed(2);
                        //document.getElementById("ProductCostPrice").value = parseFloat(totcp).toFixed(2);
                        // document.getElementById("TotQty").value = parseFloat(totqty).toFixed(2);
                    }
                    else if (hasitem == '1') {
                        if (confirm("Do you want to Override item? ")) {
                            var orrtable = document.getElementById("receipeitems");
                            var regex = /value="(\d+(\.\d)*)/i;
                            var indexval;

                            for (var r = 0, n = orrtable.rows.length; r < n; r++) {
                                var idcell = orrtable.rows[r].cells[1].innerHTML;
                                var idval = idcell.match(regex)[1];
                                if (idval == itemId) {

                                    var indexcell = orrtable.rows[r].cells[0].innerHTML;
                                    indexval = indexcell.match(regex)[1];
                                }
                            }

                            var table = $("#receipeitems")[0];
                            table.deleteRow(indexval);

                            var unitindex = $("#receipeitems").children("tr").length;
                            var unitindexCell = "<td style='display:none'><input name='StockAdjDetail.Index' type='hidden' value='" +
                                unitindex + "' /></td>";

                            var unitIdCell = "<td style='display:none'><input id='StockAdjDetail" + unitindex + "_ProductId' class='form-control' name='StockAdjDetail[" +
                                unitindex + "].ProductId' type='text' readonly value='" + $("#ProductId").val() + "' /></td>";

                            var unitDescCell = "<td><input id='StockAdjDetail" + unitindex + "_ProductName'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].ProductName' type='text' readonly value='" + $("#ProductId option:selected").text().split('(')[0] + "' /></td>";

                            var unitCStockCell = "<td><input id='StockAdjDetail" + unitindex + "_CurrentStock'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].CurrentStock'  readonly value='" + data.CurrentStock + "' /></td>";

                            var unitAStockCell = "<td><input id='StockAdjDetail" + unitindex + "_AdjustStock'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].AdjustStock' type='text' readonly value='" + data.AdjustStock + "' /></td>";

                            var unitNewStockCell = "<td><input id='StockAdjDetail" + unitindex + "_NewStock'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].NewStock' type='text' readonly value='" + data.NewStock + "' /></td>";

                            var unitTypeCell = "<td><input id='StockAdjDetail" + unitindex + "_BaseType'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].BaseType' type='text' readonly value='" + rate_value + "' /></td>";

                            var unitReasonCell = "<td><input id='StockAdjDetail" + unitindex + "_Reason'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].Reason' type='text' readonly value='" + Type + "' /></td>";

                            var unitCPCell = "<td style='display:none'><input id='StockAdjDetail" + unitindex + "_CostPrice'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].CostPrice' type='hidden' readonly value='" + data.CostPrice + "' /></td>";

                            var unitSPCell = "<td style='display:none'><input id='StockAdjDetail" + unitindex + "_SellingPrice'  class='form-control'  name='StockAdjDetail[" +
                                unitindex + "].SellingPrice'  type='hidden' readonly value='" + data.SellingPrice + "' /></td>";

                            var unitRemoveCell = "<td><input id='btnRemoveReceipeItem' type='button' value='-' class='btn btn-round btn-info'  onclick='removeUnitRow(" +
                                unitindex + ");' /></td>";

                            var newUnitRow = "<tr id='trreceipeitem" + unitindex + "'>" +
                                unitindexCell +
                                unitIdCell +
                                unitDescCell +
                                unitCStockCell +
                                unitAStockCell +
                                unitNewStockCell +
                                unitTypeCell +
                                unitReasonCell +
                                unitCPCell +
                                unitSPCell +
