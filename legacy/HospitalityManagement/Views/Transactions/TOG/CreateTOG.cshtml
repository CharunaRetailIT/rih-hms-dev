<script type="text/javascript">
    function checkProductQuantity()
    {
        debugger;
        document.getElementById('validateqty').innerHTML = '';

        if ($("#FromLocationId").val() == 0 || $("#FromLocationId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select a Location';

            return;
        }

        if ($("#ItemId").val() == 0 || $("#ItemId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select an Item';
            return;
        }

      
        $.ajax({
            url: "@Url.Action("VaidateQuantityForTOG", "PO")",
            data: { id: $("#ItemId").val(), polocid: $("#FromLocationId").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {

                var stock = resp.Stock || 0;
                var holdStock = resp.Hold_Stock || 0;


                var recQty = $("#RecQty").val();

                if (recQty === "0" || recQty === "") {
                    $('#validateqty').html(
                        'Available stock is ' + stock + ' (Hold stock: ' + holdStock + ')'
                    );
                    $('#RecQty').val('0');
                }
                else {
                    if (parseFloat(stock) < parseFloat(recQty)) {
                        $('#validateqty').html(
                            'Available stock is ' + stock + ' (Hold stock: ' + holdStock + ')'
                        );
                        $('#RecQty').val('0');
                    } else {
                        $('#validateqty').html('');
                    }
                }
            }
        });
    }
</script>
