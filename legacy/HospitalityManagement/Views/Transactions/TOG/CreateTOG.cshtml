    function removeUnitRow(id) {

        if (confirm("Do you want to delete? ")) {
            var controlToBeRemoved = "#trTOGItem" + id;
            $(controlToBeRemoved).remove();

            var table = document.getElementById("togitems");

            var totsp = 0;
            var totcp = 0;
            var totqty = 0;

            var regex = /value="(\d+(\.\d)*)/i;
            var rowproductid=0;

            for (var r = 0, n = table.rows.length; r < n; r++)
            {
                rowproductid = table.rows[r].cells[1].innerHTML.match(regex)[1];

                var spvalue= document.getElementById('TOGDetail[' + rowproductid + ']_SellingPrice').value
                totsp += Number(spvalue);

                var cpvalue = document.getElementById('TOGDetail[' + rowproductid + ']_CostValue').value
                totcp += Number(cpvalue);
            }

            document.getElementById("TotSellingPrice").value = totsp;
            document.getElementById("TotCostPrice").value = totcp;
            // document.getElementById("TotQty").value = totqty;
            document.getElementById("GrossAmount").value = parseFloat(
                     Number(document.getElementById("TotSellingPrice").value)
                 ).toFixed(2);

            document.getElementById("NetAmount").value = parseFloat((
                    Number(document.getElementById("TotCostPrice").value))
            ).toFixed(2);
        }
    }
