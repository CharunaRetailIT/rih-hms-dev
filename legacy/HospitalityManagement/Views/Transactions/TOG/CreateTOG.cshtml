@model RIT.HMS.Domain.Transactions.TransferNoteHeader
@{
    ViewBag.Title = "CreateTOG";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body" novalidate>
    <div class="main_container">

        @using (Html.BeginForm("CreateTOG", null, FormMethod.Post,
                                            new
                                            {
                                                id="CreateTOG",
                                                @class = "form-horizontal",
                                                enctype = "multipart/form-data"
                                            }))
        {
            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode Temporary saved.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode save failed..
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please enter TOG details !.
                        </div>
                    }

                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this (From) Location</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "7")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this (To) Location</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "8")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selecte a Event</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "9")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>The Net Amount Must be Greater Than Zero.</strong>
                        </div>
                    }
                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btnallClear" value=" Clear " onclick="location.href='@Url.Action("CreateTOG", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btnallView" value=" View All " onclick="location.href='@Url.Action("ViewAllTOG", null, new { })'" />
                            </div>
                            <button type="submit" id="ButtonSubmit" formaction="CreateTOG" class="btnallSubmit btn pull-left">Submit TOG</button>
                            <button type="submit" id="ButtonTempSaveTOG" formaction="TempSaveTOG" class="btnallTemporary btn pull-left">Temporary Save TOG</button>
                        </div>
                    </div>

                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Transfer of Goods</h2>
                                    <br />
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>Step 1 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Step 2 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Step 3 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>
                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>

                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.TOGType, "Manual", new { @id = "Manual", @checked = true })
                                                                Manual

                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.TOGType, "GRNBased", new { @id = "Auto" })
                                                                GRN based

                                                            </div>
                                                            <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @{ // Retrieve the value from the session and convert it to a boolean
                                                                    bool RequestNoteBasedTOG = Convert.ToBoolean(Session["RequestNoteBasedTOG"]); }
                                                                @if (RequestNoteBasedTOG)
                                                                {


                                                                    <div class="pull-left">
                                                                        @Html.RadioButtonFor(m => m.TOGType, "RequestNoteBased", new { @id = "Request" })
                                                                        Request Note Based

                                                                    </div>
                                                                }


                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Stock <span class="required">*</span>
                                                        </label>

                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.StockTransferType, "StockIssue", new { @id = "StockIssue", @checked = true })
                                                                Issue

                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.StockTransferType, "StockReturn", new { @id = "StockReturn" })
                                                                Return

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-horizontal col-md-6">

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            From Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="FromLocationId" class="form-control" name="FromLocationId"></select>
                                                            @Html.ValidationMessageFor(m => m.FromLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            To Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="ToLocationId" class="form-control" name="ToLocationId"></select>
                                                            @Html.ValidationMessageFor(m => m.ToLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            TOG Date <span class="required">*</span>
                                                        </label>

                                                        @{ // Get the current date in the "yyyy-MM-dd" format
                                                            string todayDate = DateTime.Now.ToString("yyyy-MM-dd");
                                                            string maxDate = DateTime.Now.ToString("yyyy-MM-dd");


                                                        }


                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.TOGDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.TOGDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date",
                                                           min = todayDate,
                                                           max = maxDate,
                                                          // disabled = "disabled" // Disables the input field
                                                       })
                                                            @Html.ValidationMessageFor(model => model.TOGDate, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>


                                                    @{ // Assume your session variable is named "ShowTOGSection" and it holds a boolean value
                                                        bool IsEventMandatory = Session["IsEventMandatory"] != null && (bool)Session["IsEventMandatory"];

                                                    }

                                                    @if (IsEventMandatory)
                                                    {



                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-group" style="display: none;">
                                                            <label class="control-label col-md-3 col-sm-6" style="display: none;">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12" style="display: none;">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>

                                                    }


                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div><br />
                                        <div id="step-2" style="height: 300px;">
                                            <div class="trn-detail col-md-12">
                                                <br />
                                                <div class="form-group">
                                                    @*Item Table*@
                                                    <div id="buttons">
                                                        <table id="buttons1" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>Item/Material</th>
                                                                    <th>UOM</th>
                                                                    <th>Cost</th>
                                                                    <th>Quantity</th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:50%">
                                                                        @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToTOG"], new
                                                                       {
                                                                           @class = "form-control select2",
                                                                           @style = "width:80%"
                                                                       })
                                                                        @*<select id="ItemId" class="form-control select2" style="width:80%" name="ItemId"></select>*@
                                                                    </td>
                                                                    <td style="width:15%">
                                                                        <input id='UOM' class='form-control' name='UOM' type='text' readonly value='' />
                                                                    </td>
                                                                    <td style="width:15%"><input type="text" step="0.0001" min="0" onkeypress='return event.charCode >= 46' id="CostPrice" class="form-control" readonly /></td>
                                                                    <td style="width:20%">
                                                                        <input id="RecQty" name="RecQty" type="number" step="any"
                                                                               min="0" , onkeypress='validateInputForNumbers(event)'
                                                                               onkeyup="checkProductQuantity()"
                                                                               oninput="javascript: if (this.value.length >9) this.value = this.value.slice(0, 5);"
                                                                               class="form-control col-md-2 col-xs-6">


                                                                        <font color="red">
                                                                            <label id="validateqty" name="validateqty" style="font:small-caption"></label>
                                                                        </font>

                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddTOGItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddReOrderItems">
                                                        <table id="buttons1" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:10%">
                                                                        GRN
                                                                    </td>
                                                                    <td>
                                                                        <select id="GRNNo" class="form-control select2" style="width:100%" name="GRNNo"></select>
                                                                        @*<input id="GRNNo" type="text" name="GRNNo" placeholder="GRN Document Number" class="form-control">*@
                                                                        @*<input id="GRNId" type="number" name="GRNId" style="display:none">*@
                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddGRNItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>

                                                                @*<tr>

                                                                    <td style="width:10%">
                                                                        Request Note Details
                                                                    </td>
                                                                    <td>
                                                                        <input type="text" class="form-control" style="width:100%" value="@Session["RequestNoteDetails"]" />
                                                                           
                                                                    </td>
                                                                </tr>*@
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddRequestItems">
                                                        <table id="buttons1" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:10%">
                                                                        Request Notes
                                                                    </td>
                                                                    <td>
                                                                        <select id="RequestNoteId" class="form-control select2" style="width:100%" name="RequestNoteId"></select>
                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddRequestNoteItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="clearfix"></div>
                                                    <div class="text-info"><b>Transfer of Goods</b></div>
                                                    <table id="tblTOGs" class="mstable">
                                                        <thead>
                                                            <tr>
                                                                <th style='display:none'>Item Id</th>
                                                                <th style='display:none'>Item Id</th>

                                                                @{ // Retrieve the value from the session and convert it to a boolean
                                                                    bool TOGGridAdditionalColumn = Convert.ToBoolean(Session["TOGGridAdditionalColumn"]);

                                                                    bool DisablePriceRequestNote = Session["DisablePriceRequestNote"] != null && (bool)Session["DisablePriceRequestNote"];


                                                                }



                                                                @if (TOGGridAdditionalColumn)
                                                                {

                                                                    <th style='display:none'>Requestnote Hearder Id</th>
                                                                    <th>Request Note Date</th>
                                                                    <th>Request Note No </th>
                                                                }



                                                                <th>Item</th>
                                                                @if (TOGGridAdditionalColumn)
                                                                {
                                                                    <th> SIH </th>
                                                                }
                                                                <th>Quantity</th>
                                                                <th style='display:none'>Orginal Quantity</th>

                                                                @if (DisablePriceRequestNote)
                                                                {
                                                                    <th style="display: none;">Unit Cost Price</th>
                                                                    <th style="display: none;">Line Cost Value</th>
                                                                }
                                                                else
                                                                {
                                                                    <th>Unit Cost Price</th>
                                                                    <th>Line Cost Value</th>

                                                                }
                                                                <th style="display: none;">Unit SP</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="togitems">
                                                            @if (Model.TOGDetail != null)
                                                            {
                                                                foreach (var togDetail in Model.TOGDetail)
                                                                {
                                                            <tr>
                                                                <td style='display:none'><input name='TOGDetail.Index' type='hidden' value=@togDetail.ProductId /></td>
                                                                <td style='display:none'><input id='TOGDetail[@togDetail.ProductId]_ProductID' class='form-control' name='TOGDetail[@togDetail.ProductId].ProductID' type='text' readonly value=@togDetail.ProductId /></td>

                                                                @if (Convert.ToBoolean(Session["TOGGridAdditionalColumn"]))
                                                                {

                                                                    <td style='display:none'><input id='TOGDetail[@togDetail.ProductId]_RequestNoteHeaderID' class='form-control' name='TOGDetail[@togDetail.ProductId].RequestNoteHeaderID' type='text' readonly value=@togDetail.RequestNoteHeaderID /></td>

                                                                    <td><input id='TOGDetail[@togDetail.ProductId]_ReqNoteCreatedDate' class='form-control' name='TOGDetail[@togDetail.ProductId].ReqNoteCreatedDate' type='text' readonly value='@togDetail.ReqNoteCreatedDate.ToString("MM/dd/yyyy")' /></td>
                                                                    <td><input id='TOGDetail[@togDetail.ProductId]_RequestNoteDocumentNo' class='form-control' name='TOGDetail[@togDetail.ProductId].RequestNoteDocumentNo' type='text' readonly value='@togDetail.RequestNoteDocumentNo' /></td>

                                                                }
                                                                <td><input id='TOGDetail[@togDetail.ProductId]_ProductName' class='form-control' name='TOGDetail[@togDetail.ProductId].ProductName' type='text' readonly value='@togDetail.ProductName' /></td>
                                                                @*style="display:none"*@
                                                                @*<td><input id='TOGDetail[@togDetail.ProductId]_OrderQty' class='form-control' name='TOGDetail[@togDetail.ProductId].OrderQty' type='hidden' readonly value=@Convert.ToDecimal(togDetail.OrderQty) /></td>*@


                                                                @if (Convert.ToBoolean(Session["TOGGridAdditionalColumn"]))
                                                                {
                                                                    <td><input id='TOGDetail[@togDetail.ProductId]_SIH' class='form-control' name='TOGDetail[@togDetail.ProductId].SIH' readonly value=@Convert.ToDecimal(togDetail.SIH) /></td>

                                                                }




                                                                <td><input id='TOGDetail[@togDetail.ProductId]_OrderQty' class='form-control' name='TOGDetail[@togDetail.ProductId].OrderQty' readonly value=@Convert.ToDecimal(togDetail.OrderQty) /></td>

                                                                <td><input id='TOGDetail[@togDetail.ProductId]_OrderOrgQty' class='form-control' name='TOGDetail[@togDetail.ProductId].OrderQty' readonly value=@Convert.ToDecimal(togDetail.OrderQty) /></td>


                                                                @if (DisablePriceRequestNote)
                                                                {

                                                                    <td style="display: none;"><input id='TOGDetail[@togDetail.ProductId]_CostPrice' class='form-control' name='TOGDetail[@togDetail.ProductId].CostPrice' readonly value=@Convert.ToDecimal(togDetail.CostPrice) /></td>

                                                                    <td style="display: none;" ><input id='TOGDetail[@togDetail.ProductId]_CostValue' class='form-control' readonly name='TOGDetail[@togDetail.ProductId].CostValue' type='number' value=@Convert.ToDecimal(togDetail.CostValue) /></td>
                                                                }
                                                                else
                                                                {
                                                                    <td><input id='TOGDetail[@togDetail.ProductId]_CostPrice' class='form-control' name='TOGDetail[@togDetail.ProductId].CostPrice' readonly value=@Convert.ToDecimal(togDetail.CostPrice) /></td>

                                                                    <td><input id='TOGDetail[@togDetail.ProductId]_CostValue' class='form-control' readonly name='TOGDetail[@togDetail.ProductId].CostValue' type='number' value=@Convert.ToDecimal(togDetail.CostValue) /></td>

                                                                }

                                                                <td><input id='TOGDetail[@togDetail.ProductId]_UOM' class='form-control' name='TOGDetail[@togDetail.ProductId].UOM' type='text' readonly value=@togDetail.UOM></td>

                                                                <td style="display: none;"><input id='TOGDetail[@togDetail.ProductId]_SellingPrice' class='form-control' readonly name='TOGDetail[@togDetail.ProductId].SellingPrice' type='number' value=@Convert.ToDecimal(togDetail.SellingPrice) /></td>

                                                                <td>
                                                                    <input id='btnAddPOItem1' type='button' value='-' class='btn btn-round btn-info' onclick='removeTOGRow(this);' />
                                                                </td>
                                                            </tr>

                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <label id="lblerror"></label>
                                                <hr />
                                                <div id="summary" class="col-lg-12">
                                                    <div class="col-md-3" style="display:none">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-4 col-sm-6">
                                                                Total Qty <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="TotQty" name="TotQty" type="number" readonly="readonly" value="0" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3" style="display: none;">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Selling Price <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                <input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (DisablePriceRequestNote)
                                                    {

                                                        <div class="col-md-4" style="display: none;">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-5 col-sm-6">
                                                                    Total Cost Value <span class="required">*</span>
                                                                </label>
                                                                <div class="col-md-7 col-sm-6">
                                                                    @Html.TextBoxFor(model => model.TotCostPrice, new { @class = "form-control", @Type = "number", @readonly = true })
                                                                </div>

                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="col-md-4">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-5 col-sm-6">
                                                                    Total Cost Value <span class="required">*</span>
                                                                </label>
                                                                <div class="col-md-7 col-sm-6">
                                                                    @Html.TextBoxFor(model => model.TotCostPrice, new { @class = "form-control", @Type = "number", @readonly = true })
                                                                </div>

                                                            </div>
                                                        </div>

                                                    }

                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div><br />
                                        <div id="step-3">
                                            <div class="trn-footer col-md-12">
                                                <br />
                                                <div class="col-md-6" style="display: none;">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Gross Amount<span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.GrossAmount, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
