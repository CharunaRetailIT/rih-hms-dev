@using RIT.HMS.Domain
@model RIT.HMS.Domain.Transactions.TransferNoteHeader
@{
    ViewBag.Title = "EditTOG";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("EditTOG", "TOG", FormMethod.Post, new
        {
            id= "EditTOG",
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.TransferNoteHeaderId);
            @Html.HiddenFor(model => model.DocumentStatus);
            @Html.HiddenFor(model => model.ReferenceDocumentId);
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode already exists.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>TOG</strong> @ViewBag.TOGCode Temporary saved.
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please enter TOG details !.
                        </div>
                    }
                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Selected month is not open for this Location</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "7")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please enter the reject reason !</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "8")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please enter the cancel reason !</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "9")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Cannot Approve. Reject/Cancel reason available !</strong>
                        </div>
                    }


                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btn btn-success" value="Reset" onclick="location.href='@Url.Action("CreateTOG", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewAllTOG", null, new { })'" />
                            </div>

                            @if (Model.IsTempTOG && Model.DocumentNo.Contains("X"))
                            {
                                <button type="submit" id="ButtonTempEdit" formaction="/TOG/TempEdit" class="btn btn-info pull-left">Temporary Edit</button>
                                <button type="submit" formaction="/TOG/Cancel" id="ButtonCancel" class="btn btn-danger pull-left">Cancel</button>
                                <button type="submit" formaction="/TOG/EditTOG id="ButtonSubmit" class="pull-left btn btn-primary">Submit TOG</button>
                            }
                            @if (Convert.ToBoolean(Session["APPTOG"]) == true && Model.TOGType != "RequestNoteBased")
                            {
                                if (Model.DocumentStatus == 2 || Model.DocumentStatus == 6)
                                {
                                    <button type="submit" formaction="/TOG/Approve" id="ButtonApprove" class="btn btn-success pull-left">Approve</button>

                                    if (Convert.ToBoolean(Session["DisableTOGReject"]) == false)
                                    {
                                    <button type="submit" formaction="/TOG/Reject" id="ButtonReject" class="btn btn-danger pull-left">Reject</button>
                                    <button type="submit" formaction="/TOG/Cancel" id="ButtonCancel" class="btn btn-danger pull-left">Cancel</button>
                                    <button type="submit" formaction="/TOG/ForcefullyClose" id="ButtonForcefullyClose"  class="btn btn-danger pull-left">Forcefully Close</button>
                                    }

                                }
                                if (Model.DocumentStatus == 4 || Model.DocumentStatus == 5)
                                {
                                    <button type="submit" formaction="/TOG/Reopen" id="ButtonReopen" class="btn btn-success pull-left">Re Open</button>
                                }

                            }
                        </div>
                    </div>
                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Transfer Note of Goods - Edit</h2>
                                    <h4 class="small">@Model.DocState</h4>
                                    <br />                                
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>General</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Items</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Prices</small>
                                                    </span>
                                                </a>
                                            </li>
                                            
                                        </ul>
                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>

                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.TOGType, "Manual", new { @id = "Manual", @checked = true })
                                                                Manual

                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.TOGType, "GRNBased", new { @id = "Auto" })
                                                                GRN based

                                                            </div>
                                                            <div class="clearfix"></div>


                                                            @{ // Retrieve the value from the session and convert it to a boolean
                                                                bool RequestNoteBasedTOG = Convert.ToBoolean(Session["RequestNoteBasedTOG"]);
                                                                bool DisablePriceRequestNote = Session["DisablePriceRequestNote"] != null && (bool)Session["DisablePriceRequestNote"];
                                                                bool IsEventMandatory = Session["IsEventMandatory"] != null && (bool)Session["IsEventMandatory"];



                                                                }
                                                            @if (RequestNoteBasedTOG)
                                                            {
                                                                <div class="pull-left">
                                                                    @Html.RadioButtonFor(m => m.TOGType, "RequestNoteBased", new { @id = "Request" })
                                                                    Request Note Based

                                                                </div>
                                                            }
                                                            </div>
                                                    </div>
                                                </div>

                                                <div class="form-horizontal col-md-6">

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            From Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="FromLocationId" disabled class="form-control" name="FromLocationId"></select>
                                                            @Html.ValidationMessageFor(m => m.FromLocationId, "", new { @class = "text-danger" });
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            To Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="ToLocationId" disabled class="form-control" name="ToLocationId"></select>
                                                            @Html.ValidationMessageFor(m => m.ToLocationId, "", new { @class = "text-danger" });
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            TOG Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.TOGDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.TOGDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.TOGDate, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>
                                                    @if (IsEventMandatory)
                                                    {



                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-group" style="display: none;">
                                                            <label class="control-label col-md-3 col-sm-6" style="display: none;">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12" style="display: none;">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>

                                                    }
                                                    @*<div class="col-md-12">
            <div class="form-group">
                <label class="control-label col-md-3 col-sm-6">
                    Event<span class="required"></span>
                </label>
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <select id="EventId" class="form-control" Name="EventId"></select>
                </div>
            </div>
        </div>*@

                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div><br />
                                        <div id="step-2">
                                            <div class="trn-detail col-md-12">
                                                <br />
                                                <div class="form-group">
                                                    @*Item Table*@
                                                    <div id="buttons">
                                                        <table id="buttons1" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>Item/Material</th>
                                                                    <th>UOM</th>
                                                                    <th>Cost</th>
                                                                    <th>Quantity</th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:50%">
                                                                        @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToTOG"], new
                                                                   {
                                                                       @class = "form-control select2",
                                                                       @style = "width:80%"
                                                                   })
                                                                        @*<select id="ItemId" class="form-control select2" style="width:80%" name="ItemId"></select>*@
                                                                    </td>

                                                                    <td style="width:15%">
                                                                        <input id='UOM' class='form-control' name='UOM' type='text' readonly value='' />
                                                                    </td>
                                                                    <td style="width:15%"><input type="text" step="0.0001" min="0" onkeypress='return event.charCode >= 46' id="CostPrice" class="form-control" readonly /></td>
                                                                    <td style="width:20%">
                                                                        <input id="RecQty" name="RecQty" type="number"
                                                                               min="0" , onkeypress="return event.charCode >= 46"
                                                                               onkeyup="checkProductQuantity()"
                                                                               class="form-control col-md-2 col-xs-6">

                                                                        <font color="red">
                                                                            <label id="validateqty" name="validateqty" style="font:small-caption"></label>
                                                                        </font>
                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddTOGItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddReOrderItems">
                                                        <table id="buttons1" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>

                                                                @{ // Retrieve the value from the session and convert it to a boolean
                                                                    bool TOGGridAdditional = Convert.ToBoolean(Session["TOGGridAdditionalColumn"]);
                                                                   // bool DisablePriceRequestNote = Session["DisablePriceRequestNote"] != null && (bool)Session["DisablePriceRequestNote"];
                                                                }

                                                                @if (TOGGridAdditional)
                                                                {
                                                                    <tr>
                                                                        <td style="width:10%">
                                                                            GRN
                                                                        </td>
                                                                        <td>
                                                                            @*<select id="GRNId" class="form-control select2" style="width:100%" name="GRNId"></select>*@
                                                                            <input id="GRNNo" type="text" name="GRNNo"  readonly  placeholder="GRN Document Number" class="form-control">
                                                                            <input id="GRNId" type="number" name="GRNId" style="display:none">
                                                                        </td>
                                                                        <td>
                                                                           
                                                                        </td>
                                                                    </tr>
                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td style="width:10%">
                                                                            GRN
                                                                        </td>
                                                                        <td>
                                                                            @*<select id="GRNId" class="form-control select2" style="width:100%" name="GRNId"></select>*@
                                                                            <input id="GRNNo" type="text" name="GRNNo" placeholder="GRN Document Number" class="form-control">
                                                                            <input id="GRNId" type="number" name="GRNId" style="display:none">
                                                                        </td>
                                                                        <td>
                                                                            <input type="button" id="btnAddGRNItem" class="btn btn-round btn-info" value="+" />
                                                                        </td>
                                                                    </tr>
                                                                }




                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div id="btnAddRequestItems">
                                                        <table id="buttons1" class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:10%">
                                                                        Request Notes
                                                                    </td>
                                                                    <td>
                                                                        <select id="RequestNoteId" class="form-control select2" disabled style="width:100%" name="RequestNoteId"></select>
                                                                    </td>
                                                                    <td>
                                                                        <input type="button" id="btnAddRequestNoteItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <br />

                                                    <div class="clearfix"></div>
                                                    <div class="text-info"><b>Transfer of Goods</b></div>

                                                    <table id="tblTOGs" class="table table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                @*<th>idx</th>*@
                                                                <th style="display:none">Item Id</th>

                                                                @{ // Retrieve the value from the session and convert it to a boolean
                                                                    bool TOGGridAdditionalColumn = Convert.ToBoolean(Session["TOGGridAdditionalColumn"]);
                                                                    bool DisablePrice = Session["DisablePriceRequestNote"] != null && (bool)Session["DisablePriceRequestNote"];

                                                                }
                                                                @if (TOGGridAdditionalColumn)
                                                                {

                                                                    <th style='display:none'>Requestnote Hearder Id</th>
                                                                    <th>Request Note Date</th>
                                                                    <th>Request Note No </th>
                                                                }



                                                                <th>Item</th>
                                                                <th style="display:none">Quantity</th>
                                                                @if (TOGGridAdditionalColumn)
                                                                {
                                                                    <td>SIH</td>


                                                                    if (DisablePrice)
                                                                    {
                                                                        <td style="display:none">Cost Price</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>Cost Price</td>
                                                                    }


                                                                }
                                                                <th>Quantity</th>

                                                                @if (DisablePrice)
                                                                {


                                                                    <th style="display: none;">Line Cost Value</th>
                                                                }
                                                                else
                                                                {


                                                                    <th>Line Cost Value</th>

                                                                }
                                                                <th style="display: none;">Unit SP</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="togitems">
                                                            @if (Model.TOGDetail != null)
                                                        {


                                                            foreach (var togDetail in Model.TOGDetail)
                                                            {
                                                            <tr>
                                                                <td style='display:none'>

                                                                <td style='display:none'><input name='TOGDetail.Index' type='hidden' value=@togDetail.sequence /></td>
                                                                <td style='display:none'><input id='TOGDetail[@togDetail.sequence]_ProductId' class='form-control' name='TOGDetail[@togDetail.sequence].ProductId' type='text' readonly value=@togDetail.ProductId /></td>

                                                                @if (Convert.ToBoolean(Session["TOGGridAdditionalColumn"]))
                                                                {

                                                                    <td style='display:none'><input id='TOGDetail[@togDetail.sequence]_RequestNoteHeaderID' class='form-control' name='TOGDetail[@togDetail.sequence].RequestNoteHeaderID' type='text' readonly value=@togDetail.RequestNoteHeaderID /></td>

                                                                    <td><input id='TOGDetail[@togDetail.sequence]_ReqNoteCreatedDate' class='form-control' name='TOGDetail[@togDetail.sequence].ReqNoteCreatedDate' type='text' readonly value='@togDetail.ReqNoteCreatedDate.ToString("MM/dd/yyyy")' /></td>
                                                                    <td><input id='TOGDetail[@togDetail.sequence]_RequestNoteDocumentNo' class='form-control' name='TOGDetail[@togDetail.sequence].RequestNoteDocumentNo' type='text' readonly value='@togDetail.RequestNoteDocumentNo' /></td>

                                                                }





                                                                <td><input id='TOGDetail[@togDetail.sequence]_ProductName' class='form-control' name='TOGDetail[@togDetail.sequence].ProductName' type='text' readonly value='@togDetail.ProductName' /></td>

                                                                @if (TOGGridAdditionalColumn)
                                                                {
                                                                    <td><input id='TOGDetail[@togDetail.sequence]_SIH' class='form-control' name='TOGDetail[@togDetail.sequence].SIH' type='text' readonly value='@togDetail.SIH' /></td>


                                                                    if (DisablePrice)
                                                                    {
                                                                        <td style="display:none"><input id='TOGDetail[@togDetail.sequence]_CostPrice' class='form-control' name='TOGDetail[@togDetail.sequence].CostPrice' type='text' readonly value='@togDetail.CostPrice' /></td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td><input id='TOGDetail[@togDetail.sequence]_CostPrice' class='form-control' name='TOGDetail[@togDetail.sequence].CostPrice' type='text' readonly value='@togDetail.CostPrice' /></td>
                                                                    }

                                                                }


                                                                <td><input id='TOGDetail[@togDetail.sequence]_OrderQty' class='form-control' name='TOGDetail[@togDetail.sequence].OrderQty'  value=@Convert.ToDecimal(togDetail.OrderQty) /></td>


                                                                <td style="display:none"><input id='TOGDetail[@togDetail.sequence]_UOM' class='form-control' name='TOGDetail[@togDetail.sequence].UOM' type='text' readonly value=@togDetail.UOM></td>

                                                                @if (DisablePrice)
                                                                {

                                                                    <td style="display: none;"><input id='TOGDetail[@togDetail.sequence]_CostValue' class='form-control' readonly name='TOGDetail[@togDetail.sequence].CostValue' type='number' value=@Convert.ToDecimal(togDetail.CostValue) /></td>
                                                                }
                                                                else
                                                                {
                                                                    <td><input id='TOGDetail[@togDetail.sequence]_CostValue' class='form-control' readonly name='TOGDetail[@togDetail.sequence].CostValue' type='number' value=@Convert.ToDecimal(togDetail.CostValue) /></td>
                                                                }

                                                                <td style="display: none;"><input id='TOGDetail[@togDetail.sequence]_SellingPrice' class='form-control' readonly name='TOGDetail[@togDetail.sequence].SellingPrice' type='number' value=@Convert.ToDecimal(togDetail.SellingPrice) /></td>

                                                                <td>
                                                                    <input id='btnAddPOItem1' type='button' value='-' class='btn btn-round btn-info' onclick='removeTOGRow(this);' />
                                                                </td>
                                                            </tr>
                                                            }
                                                        }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div id="summary" class="col-lg-12">
                                                    <div class="col-md-3" style="display:none">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-4 col-sm-6">
                                                                Total Qty <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                @*<input id="TotQty" name="TotQty" type="number" readonly="readonly" value="0" class="form-control">*@
                                                                @Html.TextBoxFor(model => model.TotQty, new { id = "TotQty", type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                                @Html.ValidationMessageFor(model => model.TotQty, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3" style="display: none;">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Selling Price <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @*<input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0" class="form-control">*@
                                                                @Html.TextBoxFor(model => model.TotSellingPrice, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                                @Html.ValidationMessageFor(model => model.TotSellingPrice, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">

