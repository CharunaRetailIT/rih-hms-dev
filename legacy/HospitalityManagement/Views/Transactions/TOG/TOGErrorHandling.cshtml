@model IEnumerable< RIT.HMS.Domain.ViewModels.TOGViewModel>
@{
    ViewBag.Title = "CreateTOG";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
@*<html lang="en">*@

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>

</head>

<div class="container body" novalidate>
    <div class="main_container">
                
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>                 
                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                          
                            <div class="alert alert-warning alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>TOG</strong> @ViewBag.TOGCode Item Missmatch found.
                            </div>
                            <div class="clearfix"></div>
                            <br />
                            Details.
                            <div>
                                <table id="table-responsive"
                                       class="table table-striped table-bordered dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th>Availability</th>
                                            <th>Stock</th>
                                           
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => item.Message)</td>
                                                <td>@Html.DisplayFor(modelItem => item.StockMessage)</td>                                               

                                            </tr>
                                        }
                                    </tbody>

                                </table>
                                
                            </div>

                            <div class="actionBar">
                                <div class="msgBox">

                                    <div class="btn btn-primary pl_add btn-small pull-left">
                                        @Html.ActionLink("Back", "CreateTOG", null, new
                                           {
                                               @style = "font-size: 12px;color:white;" +
                                                         "font-family: 'Lucida Sans Unicode', " +
                                                         "'Lucida Grande', Sans-Serif;text-decoration: none"
                                           })
                                    </div>
                                 
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>        
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

