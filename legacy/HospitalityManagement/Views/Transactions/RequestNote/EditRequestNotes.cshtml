<script type="text/javascript">
    function checkProductQuantity() {

        debugger;
        document.getElementById('validateqty').innerHTML = '';

        if ($("#FromLocationId_").val() == 0 || $("#FromLocationId_").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select a location';

            return;
        }
        if ($("#ProductId").val() == 0 || $("#ProductId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select a product';
            return;
        }

         
        if ($("#Production").is(":checked") ||$("#PO").is(":checked")) {
            return;
        }

        $.ajax({
            url: "@Url.Action("VaidateQuantityForRequest", "PO")",
            data: { id: $("#ProductId").val(), polocid: $("#FromLocationId_").val() },
            type: "GET",
            dataType: "json",
            success: function (resp) {
                debugger;
                data = resp;
                if($("#RequestQuty").val()=="0"){
                    document.getElementById('validateqty').innerHTML = 'available stock is ' + resp;
                    document.getElementById('RequestQuty').value = '0';
                }else{

                    if (resp < $("#RequestQuty").val()) {
                        document.getElementById('validateqty').innerHTML = 'available stock is ' + resp;
                        document.getElementById('RequestQuty').value = '0';
                    } else {
                        document.getElementById('validateqty').innerHTML = '';
                    }
                }

            }
        });
    }
</script>

