                            unitIdCell +
                            unitDescCell + SIHCell +
                            unitQtyCell +
                            unitCostPriceCell + CostValueCell +
                            unitSellingPriceCell +

                            unitRemoveCell + "</tr>";

                        $("#togitems").append(newUnitRow);
                    });

                    var table = document.getElementById("togitems");

                    var totsp = 0.0;
                    var totcp = 0.0;
                    var totqty = 0;

                    for (var r = 0, n = table.rows.length; r < n; r++) {
                        var spcell = table.rows[r].cells[5].innerHTML;
                        //alert(spcell);
                        var regex = /value="(\d+(\.\d)*)/i;
                        var spvalue = spcell.match(regex)[1];

                        // alert((spvalue));
                        totsp += Number(spvalue);

                        var cpcell = table.rows[r].cells[4].innerHTML;
                        var cpvalue = parseFloat(cpcell.match(/value="(\d+(\.\d)*)/i)[1]).toFixed(2);
                        totcp += Number(cpvalue);

                        var qtycell = table.rows[r].cells[3].innerHTML;
                        var qtyvalue = parseFloat(qtycell.match(/value="(\d+(\.\d)*)/i)[1]).toFixed(2);
                        totqty += Number(qtyvalue);
                    }
                    document.getElementById("TotSellingPrice").value = parseFloat(totsp).toFixed(2);
                    document.getElementById("TotCostPrice").value = parseFloat(totcp).toFixed(2);
                    document.getElementById("TotQty").value = parseFloat(totqty).toFixed(2);

                    document.getElementById("GrossAmount").value = parseFloat(
                        Number(document.getElementById("TotSellingPrice").value)
                    ).toFixed(2);

                    document.getElementById("NetAmount").value = parseFloat((
                            Number(document.getElementById("TotSellingPrice").value))
                    ).toFixed(2);
                },
                error: function (error) {
                    alert("Item data mapping error");
                }
            });
        });
</script>

