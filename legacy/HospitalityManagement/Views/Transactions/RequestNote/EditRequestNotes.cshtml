
@model RIT.HMS.Domain.Transactions.RequestNoteHeader
@{
    ViewBag.Title = "Request Notes Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body" novalidate>
    <div class="main_container">
        
        @using (Html.BeginForm("ModifyRequestNote", "RequestNote", FormMethod.Post, new
        { id="EditRequestNote", @class = "form-horizontal",
            enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(model => model.RequestnoteHeaderId)
            @Html.HiddenFor(model => model.DocumentId)
            @Html.HiddenFor(model => model.DocumentStatus)
            @Html.AntiForgeryToken()

            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note</strong> @ViewBag.Code modified successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note</strong> @ViewBag.Code Temporary saved.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note</strong> @ViewBag.Code failed to modify.
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please enter Request details !.
                        </div>
                    }
                    else if (@ViewBag.Message == "6")
