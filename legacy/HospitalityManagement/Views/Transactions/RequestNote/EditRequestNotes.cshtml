                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    $("#togitems tr").remove();
                    $.each(data, function (i, item) {

                        @{
                        Model.RequestDetail.Add(new RIT.HMS.Domain.Transactions.RequestNoteDetail());
                        }

                        var unitindex = $("#togitems").children("tr").length;
                        var unitindexCell = "<td style='display:none'><input name='TOGDetail.Index' type='hidden' value='" +
                            unitindex + "' /></td>";

                        var unitIdCell = "<td><input id='TOGDetail" + unitindex + "_ProductID' class='form-control' name='TOGDetail[" +
                            unitindex + "].ProductID' type='text' readonly value='" + item.ItemId + "' /></td>";

                        var unitDescCell = "<td><input id='TOGDetail" + unitindex + "_ProductName'  class='form-control'  name='TOGDetail[" +
                            unitindex + "].ProductName' type='text' readonly value='" + item.ItemDesc + "' /></td>";



                        var SIHCell = "<td><input id='TOGDetail" + unitindex + "_SIH'  class='form-control'  name='TOGDetail[" +
                            unitindex + "].SIH' type='text' readonly value='" + item.SIH + "' /></td>";




                        var unitQtyCell = "<td><input id='TOGDetail" + unitindex + "_OrderQty'  class='form-control'  name='TOGDetail[" +
                            unitindex + "].OrderQty'   value='" + item.Qty + "' /></td>";

                        var unitSellingPriceCell = "<td style='display: none;'><input id='TOGDetail" + unitindex + "_SellingPrice'  class='form-control'  name='TOGDetail[" +
                            unitindex + "].SellingPrice' type='text' readonly value='" + item.SellingPrice + "' /></td>";

                        var unitCostPriceCell = "<td><input id='TOGDetail" + unitindex + "_CostPrice'  class='form-control'  name='TOGDetail[" +
                            unitindex + "].CostPrice' type='text' readonly value='" + item.CostPrice + "' /></td>";

                     
                        var CostValueCell = "<td><input id='TOGDetail" + unitindex + "_CostValue'  class='form-control'  name='TOGDetail[" +
                            unitindex + "].CostValue' type='text' readonly value='" + item.CostValue + "' /></td>";



                        var unitRemoveCell = "<td><input id='btnAddGRNItem' type='button' value='-' class='btn btn-round btn-info'  onclick='removeUnitRow(" +
                            unitindex + ");' /></td>";

                        var newUnitRow = "<tr id='trTOGItem" + unitindex + "'>" +
