<script type="text/javascript">
    $("body").on("click",
        "#btnAddGRNItem",
        function () {
            if ($("#FromLocationId").val() == 0 || $("#FromLocationId").val() == null) {
                alert("Select a From location!");
                return;
            }

            if ($("#ToLocationId").val() == 0 || $("#ToLocationId").val() == null) {
                alert("Select a To location!");
                return;
            }
            if ($("#GRNId").val() == 0 || $("#GRNId").val() == null) {
                alert("Select a GRN!");
                return;
            }

            $.ajax({
                url: "@Url.Action("GetGRNData", "TOG")",
