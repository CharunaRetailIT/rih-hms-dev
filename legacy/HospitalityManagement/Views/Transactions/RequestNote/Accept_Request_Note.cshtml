            if (!requestid) {
                requestid = '0'; // Default to zero

            }
            var requestidTo = document.getElementById("LocationIdTo").value;
            if (!requestidTo) {
                requestidTo = '0'; // Default to zero

            }


            var AppStatus = document.getElementById("drpStatus").value;

            if (!AppStatus) {
                AppStatus = '0'; // Default to zero

            }


            $.ajax({
                url: "@Url.Action("GetMergePORequestData", "Merge_PO_Request")",
                data: {
                    id: requestid,
                    requestidTo: requestidTo,
                    AppStatus: AppStatus,
                    from: $("#DateFrom").val(),
                    to: $("#DateTo").val()
                },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    $("#togitems tr").remove();

                    console.log(resp);
                    $.each(resp, function (i, item) {
                        $("#RequestType").val(item.RequestType);

                        var unitindex = $("#togitems").children("tr").length;

                        var unitindexCell = `<td style='display:none' id='${unitindex}_requestnoteheaderid' name='RequestNoteHeader[${unitindex}].requestnoteheaderid'>${item.requestnoteheaderid}</td>`;
                        var unitCreateDateCell = `<td style='width:15%' id='${unitindex}_CreateDate' name='RequestNoteHeader[${unitindex}].CreateDate'>${item.CreateDate}</td>`;

                        var ExpectedDeliveryDateCell = `<td style='width:15%' id='${unitindex}_ExpectedDeleveryDate' name='RequestNoteHeader[${unitindex}].ExpectedDeleveryDate'>${item.ExpectedDeleveryDate}</td>`;




                        var unitFromLocationCell = `<td style='width:15%' id='${unitindex}_Location' name='RequestNoteHeader[${unitindex}].Location'>${item.Location}</td>`;
                        var unitToLocationCell = `<td style='width:25%' id='${unitindex}_ToLocation' name='RequestNoteHeader[${unitindex}].ToLocation'>${item.ToLocation}</td>`;
                        var unitDocumentNoCell = `<td style='width:15%' id='${unitindex}_DocumentNo' name='RequestNoteHeader[${unitindex}].DocumentNo'>${item.DocumentNo}</td>`;
                        var unitDocumentStatusCell = `<td style='width:15%' id='${unitindex}_Approve' name='RequestNoteHeader[${unitindex}].Approve'>${item.Approve}</td>`;
            //            var unitEditCell = (item.Approve === "Approved" || item.Approve === "Canceled")
            //? `<td style='width:15%;  color: blue; font-weight: bold;'><span>Disable</span></td>`
            //: `<td style='width:15%;  color: blue; font-weight: bold;'><a href='#' onclick='editRow(${unitindex})'>Click</a></td>`;

                        var unitEditCell = `<td style='width:15%;  color: blue; font-weight: bold;'><a href='#' onclick='editRow(${unitindex})'>Click</a></td>`;

                        var newUnitRow = `<tr id='trreceipeitem${unitindex}'>${unitindexCell}${unitCreateDateCell} ${ExpectedDeliveryDateCell}      ${unitFromLocationCell}${unitToLocationCell}${unitDocumentNoCell}${unitDocumentStatusCell}${unitEditCell}</tr>`;

                        $("#togitems").append(newUnitRow);
                    });
                },
                error: function () {
                    alert("Item data mapping error");
                }
            });
        });



        /////







        // Define editRow function outside of AJAX success callback
        window.editRow = function (index) {
            var requestnoteHeaderId = $(`#${index}_requestnoteheaderid`).text();
            var createDate = $(`#${index}_CreateDate`).text();
            var location = $(`#${index}_Location`).text();
            var toLocation = $(`#${index}_ToLocation`).text();
            var documentNo = $(`#${index}_DocumentNo`).text();
            var documentStatus = $(`#${index}_DocumentStatus`).text();

            console.log("Editing row with index: " + index);
            console.log("Request Note Header ID: " + requestnoteHeaderId);
            console.log("Create Date: " + createDate);
            console.log("Location: " + location);
            console.log("To Location: " + toLocation);
            console.log("Document No: " + documentNo);
            console.log("Document Status: " + documentStatus);

            //window.location.href = `/RequestNote/EditPendingRequerst?documentNo=${documentNo}`;
            window.location.href = `/RequestNote/EditPendingRequerst?requestnoteHeaderId=${requestnoteHeaderId}`;

        };

        $("body").on("click", "#btnsubmit", function () {
            var POmodes = [];
            $("#tblTOGs tbody tr").each(function () {
                var row = $(this);
                var POMode = {};
                POMode.DocumentNo = row.find("td").eq(2).text(); // Assuming DocumentNo is in the third column (index 2)

                var isChecked = row.find("input[type='checkbox']").prop("checked");
                POMode.IsActive = isChecked;

                POmodes.push(POMode);
            });

            $.ajax({
                type: "POST",
                url: "/RequestNote/Create",
                data: JSON.stringify(POmodes),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (r) {
                    alert(r);
                    window.location.href = "/RequestNote/Accept_Request_Note";
                },
                error: function () {
                    alert("No Records Found");
                    window.location.href = "/RequestNote/Accept_Request_Note";
                }
            });
        });
    });
</script>

