<script>
    // Function to be executed when the page loads
    // Function to handle the event
    function handleStatusChange(event) {
        var selectedValue = event.target.value;
        console.log("Dropdown value changed to:", selectedValue);

        // Example: You can add additional logic here
        if (!selectedValue) {
            selectedValue = '0'; // Default to zero if no value is selected
            event.target.value = selectedValue;
        }
    }

    // Function to trigger the change event programmatically
    function triggerChangeEvent() {
        var statusElement = document.getElementById("drpStatus");
        var event = new Event('change');
        statusElement.dispatchEvent(event);
    }

    window.onload = function () {
        var statusElement = document.getElementById("drpStatus");

        // Add an event listener to handle the change event
        statusElement.addEventListener('change', handleStatusChange);

        // Trigger the change event programmatically
        triggerChangeEvent();
    };
</script>




