
@model RIT.HMS.Domain.Transactions.RequestNoteAccptanceHeader
@{
    ViewBag.Title = "Request Notes Acceptance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Transactions.css" rel="stylesheet" />


<div class="container body" novalidate>
    <div class="main_container">

        @using (Html.BeginForm("", "RequestNote", FormMethod.Post, new {id="AcceptRequestNotes", @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note Acceptance</strong> @ViewBag.Code saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please enter Request details !.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note Acceptance</strong> @ViewBag.Code save failed..
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-info alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note Acceptance</strong> @ViewBag.Code Rejected successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note Acceptance</strong> @ViewBag.Code Canceled successfully.
                        </div>
                    }

                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Request Note Acceptance</h2>
                                    <br />                               
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <div class="form-horizontal col-md-12 trn-header">
                                        <br />
                                        <div class="form-horizontal col-md-6">
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    Doc # <span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">

                                                    @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                    @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    Request Type<span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                    @Html.TextBoxFor(model => model.RequestType, new { @class = "form-control", @readonly = true})
                                                    @Html.ValidationMessageFor(model => model.RequestType, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    From Location <span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                    <select id="FromLocationId_" class="form-control" name="FromLocationId"></select>
                                                    @Html.ValidationMessageFor(model => model.FromLocationId, "", new { @class = "text-danger" })
                                                    @Html.HiddenFor(model => model.FromLocationId)
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    From Department <span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                    <select id="FromDepartmentId" class="form-control" name="FromDepartmentId"></select>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    Request Note <span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                    <select id="RequestNoteId" class="form-control" name="RequestNoteId"></select>
                                                </div>
                                            </div>
                                            <div class="clearfix"></div>
                                        </div>

                                        <div class="form-horizontal col-md-6">
                                            <br /><br />
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    Remark<span class="required"></span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">

                                                    @Html.TextAreaFor(model => model.Remark, new { type = "text", @class = "form-control", MaxLength = 200, style = "resize: none;" })
                                                    
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="clearfix"></div><br />
                                    <div class="trn-detail col-md-12">
                                        <br />
                                        <div class="form-group">
                                            <hr />
                                            <div class="text-info"><b>Items</b></div>

                                            @*<table id="tblTOGs" class="table table table-bordered">*@
                                            <table id="tblTOGs" class="mstable">
                                                <thead>
                                                    <tr>
                                                        <th style="display:none">Product Id</th>
                                                        <th style='width:25%'>Product</th>
                                                        <th style="display:none">Item Id</th>
                                                        <th style='width:25%'>Item</th>
                                                        <th>Request Quantity</th>
                                                        <th>Issue Qty</th>
                                                        <th>Cost Price</th>
                                                        <th style="display: none;">Selling Price</th>
                                                        <th>Requested By</th>
                                                        <th>Serving Unit</th>
                                                        <th style="display: none;">Serving Unit Id</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="togitems">
                                                 @*@if (Model.AcceptanceDetail != null)
                                                {
                                                    foreach (var requestdetail in Model.AcceptanceDetail)
                                                    {

                                                        <tr>
                                                            <td>@requestdetail.ProductId</td>
                                                            <td>@requestdetail.ProductName</td>
                                                            <td>@requestdetail.RequestQty</td>
                                                            <td>@requestdetail.UOM</td>
                                                            <td>@requestdetail.CostPrice</td>
                                                            <td>@requestdetail.SellingPrice</td>
                                                        </tr>

                                                    }
                                                }*@
                                                </tbody>
                                            </table>
                                            <hr />
                                            <div id="summary" class="col-lg-12">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-5 col-sm-6">
                                                            Total Cost Price <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-7 col-sm-6">
                                                            <input id="TotCostPrice" style="text-align:right;" name="TotCostPrice" type="number" readonly="readonly" value="0.00" class="form-control">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <div class="pull-left">
                                                <input type="button" class="btnallClear" value="Clear" onclick="location.href='@Url.Action("AcceptRequestNote", null, new { })'" />
                                            </div>
                                            <div id="RequestStatus2">
                                                <button type="submit" formaction="Reject" id="ButtonReject" class="btn btnallTemporary pull-left">Request Reject</button>
                                                <button type="submit" formaction="Cancel" id="ButtonCancel" class="btn btnallClear pull-left">Request Cancel</button>
                                                <button type="submit" formaction="AcceptRequestNote" id="ButtonAcceptRequestNote" class="btnallSubmit btn pull-left">Request Approve</button>
                                                <button type="submit" formaction="ForcefullyClose" id="ButtonForcefullyClose"  class="btnallClear btn pull-left">ForcefullyClose</button>
                                                
                                            </div>
                                            <div id="RequestStatus4">
                                                <button type="submit" formaction="ReOpen" id="ButtonReOpen" class="btn btnallView pull-left">Request Re-Open</button>
                                            </div>
                                            <div id="RequestStatus6">
                                                <button type="submit" formaction="AcceptRequestNote" id="ButtonAcceptRequestNote" class="btnallSubmit btn pull-left">Request Approve</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="se-pre-con"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>


<script>
    $(document).ready(function () {
        $('#ButtonReject').on('click',
            function (event) {
                $('#ButtonReject').text('Processing...');
                $('#ButtonReject').prop('disabled', true);
                $('#AcceptRequestNotes').attr('action', 'Reject');
                $('#AcceptRequestNotes').submit();
            });

        // -------------------------------------------------------
        $('#ButtonCancel').on('click',
            function (event) {
                $('#ButtonCancel').text('Processing...');
                $('#ButtonCancel').prop('disabled', true);
                $('#AcceptRequestNotes').attr('action', 'Cancel');
                $('#AcceptRequestNotes').submit();
            });
        //---------------------------------------------------------
        $('#ButtonAcceptRequestNote').on('click',
           function (event) {
               $('#ButtonAcceptRequestNote').text('Processing...');
               $('#ButtonAcceptRequestNote').prop('disabled', true);
               $('#AcceptRequestNotes').attr('action', 'AcceptRequestNote');
               $('#AcceptRequestNotes').submit();
           });
        //---------------------------------------------------------
        $('#ButtonForcefullyClose').on('click',
           function (event) {
               $('#ButtonForcefullyClose').text('Processing...');
               $('#ButtonForcefullyClose').prop('disabled', true);
               $('#AcceptRequestNotes').attr('action', 'ForcefullyClose');
               $('#AcceptRequestNotes').submit();
           });
        //---------------------------------------------------------
        $('#ButtonReOpen').on('click',
           function (event) {
               $('#ButtonReOpen').text('Processing...');
               $('#ButtonReOpen').prop('disabled', true);
               $('#AcceptRequestNotes').attr('action', 'ReOpen');
               $('#AcceptRequestNotes').submit();
           });
        //---------------------------------------------------------
        $('#ButtonAcceptRequestNote').on('click',
           function (event) {
               $('#ButtonAcceptRequestNote').text('Processing...');
               $('#ButtonAcceptRequestNote').prop('disabled', true);
               $('#AcceptRequestNotes').attr('action', 'AcceptRequestNote');
               $('#AcceptRequestNotes').submit();
           });

    });
</script>
<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var locationId = $("#FromLocationId_");

        locationId.empty();
        locationId.append("<option value='0'>-- Select a Location --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            locationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.locationId') {
            $('#FromLocationId_').val(@ViewBag.locationId).trigger("change");
            document.getElementById("FromLocationId_").disabled = true;
            document.getElementById("FromLocationId").value = @ViewBag.locationId;
        } else {
            $('#FromLocationId_').val(0).trigger("change");
            $("#FromLocationId").val('0');
        }
    });

    $.getJSON("@Url.Action("GetLocWiseDept", "RequestNote")", { locid: @ViewBag.locationId },
    function (data) {

        var FromDepartmentId = $("#FromDepartmentId");
        FromDepartmentId.empty();
        FromDepartmentId.append("<option value='0'>-- Select a department --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            FromDepartmentId.append($('<option />', { value: optionaldata.InterDepartmentId }).html(optionaldata.InterDepartmentName));
        });

        if ('@ViewBag.FromDepartmentId') {
            $('#FromDepartmentId').val(@ViewBag.FromDepartmentId).trigger("change");
        } else {
            $('#FromDepartmentId').val(0).trigger("change");
        }
    });

</script>
