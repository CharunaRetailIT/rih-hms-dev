<script>
    function removeUnitRow(id) {

        if (confirm("Do you want to delete? ")) {
            var controlToBeRemoved = "#trreceipeitem" + id;
            $(controlToBeRemoved).remove();
            TableSummery();
        }
    }
</script>

<script>
    function SummerizeTable()
    {
        var table = document.getElementById("togitems");
        $(table).each(function () {
            $(table).find('td').each(function () {
                var $this = $(this);

              //  var col = $this.index();
                var col =2;
                var html = $this.html();
                var row = $(this).parent()[0].rowIndex;
                var span = 1;
                var cell_above = $($this.parent().prev().children()[col]);

                while (cell_above.html() === html) {
                    span += 1;
                    cell_above_old = cell_above;
                    cell_above = $(cell_above.parent().prev().children()[col]);
                }
                if (span > 1) {

                    $(cell_above_old).attr('rowspan', span);
                    $this.hide();
                }
            });
        });
    }

    function TableSummery()
    {
        var tabletorem = document.getElementById("togitems");

        var totcp = 0.0;

        for (var r = 0, n = tabletorem.rows.length; r < n; r++)
        {
            var cpcell = tabletorem.rows[r].cells[9].innerHTML;
            var cpvalue = parseFloat(cpcell.match(/value="(\d+(\.\d)*)/i)[1]).toFixed(2);
            totcp += Number(cpvalue);
        }
        document.getElementById("TotCostPrice").value = parseFloat(totcp).toFixed(2);
    }

