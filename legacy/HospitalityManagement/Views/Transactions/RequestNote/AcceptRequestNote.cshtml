                        unitindex + "].MaterialId' type='text' readonly value='" + item.MaterialId + "' /></td>";

                    var unitDescCell = "<td style='width:25%'><input id='AcceptanceDetail" + unitindex + "_MaterialName' class='form-control' name='AcceptanceDetail[" +
                        unitindex + "].MaterialName' readonly value = '" + item.MaterialName + "'/></td>";

                    var unitQtyCell = "<td style='display:none'><input id='AcceptanceDetail" + unitindex + "_MaterialQty'  class='form-control' type='hidden'  name='AcceptanceDetail[" +
