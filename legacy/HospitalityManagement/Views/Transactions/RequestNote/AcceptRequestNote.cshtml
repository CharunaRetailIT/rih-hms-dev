                {
                    qtyvalue = oTextBox.value;
                    var cp_value = ((upvalue / qty_value) * qtyvalue).toFixed(2);
                    document.getElementById('AcceptanceDetail' + indexvalue + '_CostPrice').value = cp_value.toString();
             
                    document.getElementById('AcceptanceDetail' + indexvalue + '_IssueQty').value = qtyvalue;

                    //totcp = Number(cp_value) - Number(upvalue);
                  //  totcp += Number(cp_value)+Number(cpvalue);
                }
                else {
                    //document.getElementById('AcceptanceDetail' + indexvalue + '_CostPrice').value ="0.00";
                    document.getElementById('AcceptanceDetail' + indexvalue + '_IssueQty0').value = issueQty;

                    qtyvalue = oTextBox.value;
                    var cp_value = ((upvalue / qty_value) * qtyvalue).toFixed(2);
                    document.getElementById('AcceptanceDetail' + indexvalue + '_CostPrice').value = cp_value.toString();
             
                    document.getElementById('AcceptanceDetail' + indexvalue + '_IssueQty').value = qtyvalue;

                    alert("Can not increse the Issue Quantity");
                }
            }
            totcp += Number(document.getElementById('AcceptanceDetail' + indexvalue + '_CostPrice').value);
                //+Number(cpvalue);
        }
      //  totcp += Number(document.getElementById("TotCostPrice").value);
        document.getElementById("TotCostPrice").value = parseFloat(totcp).toFixed(2);
    }
</script>

<script>
    window.onload = function () {
        $('#RequestStatus2').hide();
        $('#RequestStatus4').hide();
        $('#RequestStatus6').hide();
    }

    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
</script>