              });

              if ('@ViewBag.FromDepartmentId') {
                  $('#FromDepartmentId').val(@ViewBag.FromDepartmentId).trigger("change");
              } else {
                  $('#FromDepartmentId').val(0).trigger("change");
              }
          });
    });
</script>
<script>

    $('#FromDepartmentId').change(function () {
        var frmdeptid = this.value;

        $.getJSON("@Url.Action("GetDeptWiseRequests", "RequestNote")", { deptid: frmdeptid, locid: $('#FromLocationId').val() },
          function (data) {

              var RequestNoteId = $("#RequestNoteId");
              RequestNoteId.empty();
              RequestNoteId.append("<option value='0'>-- Select a Request --</option>");

              $.each(JSON.parse(data), function (index, optionaldata) {
                  RequestNoteId.append($('<option />', { value: optionaldata.RequestnoteHeaderId }).html(optionaldata.DocumentNo));
              });

              if ('@ViewBag.RequestNoteId') {
                  $('#RequestNoteId').val(@ViewBag.RequestNoteId).trigger("change");
              } else {
                  $('#RequestNoteId').val(0).trigger("change");
              }
          });
    });

    $.getJSON("@Url.Action("GetDeptWiseRequests", "RequestNote")", { deptid: @ViewBag.FromDepartmentId, locid: @ViewBag.locationId },
    function (data) {

        var RequestNoteId = $("#RequestNoteId");
        RequestNoteId.empty();
        RequestNoteId.append("<option value='0'>-- Select a Request --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            RequestNoteId.append($('<option />', { value: optionaldata.RequestnoteHeaderId }).html(optionaldata.DocumentNo));
        });

        if ('@ViewBag.RequestNoteId') {
            $('#RequestNoteId').val(@ViewBag.RequestNoteId).trigger("change");
            document.getElementById('DocumentNo').value(@ViewBag.RequestNoteId);
        } else {
            $('#RequestNoteId').val(0).trigger("change");
        }
    });

</script>

