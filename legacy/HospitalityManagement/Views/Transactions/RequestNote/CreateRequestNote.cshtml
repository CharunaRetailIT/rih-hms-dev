<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectElement = document.getElementById('FromLocationId_');
        const headerElement = document.getElementById('headerSIH');

        // Function to update the header text
        function updateHeader() {
            const selectedValue = selectElement.value;
            headerElement.textContent = selectedValue ? `SIH - ${selectedValue}` : 'SIH';
        }

        // Attach event listener to the select element
        selectElement.addEventListener('change', updateHeader);

        // Optionally, set the initial header value if needed
        updateHeader();
    });
