
@model RIT.HMS.Domain.Transactions.RequestNoteHeader
@{
    ViewBag.Title = "Request Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />



<div class="container body" novalidate>
    <div class="main_container">

        @using (Html.BeginForm("", "RequestNote", FormMethod.Post, new
        {
            id = "CreateRequestNote",
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
        {
            @Html.AntiForgeryToken()

            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note</strong> @ViewBag.Code saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note</strong> @ViewBag.Code Temporary saved.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Request Note</strong> @ViewBag.Code save failed..
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please enter Request details !.
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Create New Request Note</h2>
                                    <br />
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>Step 1 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Step 2 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Step 3 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>

                                        <div id="step-1">


                                            @{ // Assume your session variable is named "ShowTOGSection" and it holds a boolean value
                                                bool showTOGSection = Session["RequestNoteAllowOnlyPO"] != null && (bool)Session["RequestNoteAllowOnlyPO"];
                                                bool isChecked = showTOGSection; // Set this based on your logic

                                            }


                                            <div class="form-horizontal col-md-12 trn-header  " style="        background-color: #f5f5f5; border-bottom-style: none !important;">
                                                <div class="row" style="background-color: #f5f5f5;">
                                                    <div class="col-md-6">

                                                        <div class="row" style="background-color: #f5f5f5;">
                                                            <div class="col-md-3">
                                                                <label>
                                                                    Mode <span class="required">*</span>
                                                                </label>
                                                            </div>
                                                            <div class="col-md-3" style="display: @(showTOGSection ? "none" : "block")">
                                                                @Html.RadioButtonFor(m => m.RequestType, "TOG", new { @id = "TOG", @checked = true })
                                                                TOG
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.RadioButtonFor(m => m.RequestType, "PO", new { @id = "PO", @checked = isChecked })
                                                                PO
                                                            </div>
                                                            <div class="col-md-3" style="display: @(showTOGSection ? "none" : "block")">
                                                                @Html.RadioButtonFor(m => m.RequestType, "Production", new { @id = "Production" })
                                                                Production
                                                            </div>


                                                        </div>

                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="row" style="background-color: #f5f5f5;">
                                                            <div class="col-md-3">
                                                                <label class="text-right">
                                                                    Doc # <span class="required">*</span>
                                                                </label>
                                                            </div>
                                                            <div class="col-md-4">

                                                                @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                                @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                            </div>
                                                            @*<div class="col-md-3">
                    </div>
                    <div class="col-md-3">
                    </div>*@
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row" style="background-color: #f5f5f5;">
                                                    <div class="col-md-6">
                                                        <div class="row" style="background-color: #f5f5f5;">
                                                            <div class="col-md-4">
                                                                <label class="text-right">
                                                                    From Location <span class="required">*</span>
                                                                </label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <select id="FromLocationId_" class="form-control" name="FromLocationId"></select>
                                                                @Html.ValidationMessageFor(model => model.FromLocationId, "", new { @class = "text-danger" })
                                                                @Html.HiddenFor(model => model.FromLocationId)
                                                            </div>
                                                            @*<div class="col-md-3">
                    </div>
                    <div class="col-md-3">
                    </div>*@

                                                        </div>
                                                    </div>

                                                    <div style="height: 5px; line-height: 1px; margin: 0;"></div>

                                                    <div class="col-md-6">
                                                        <div class="row" style="background-color: #f5f5f5;">
                                                            <div class="col-md-3">
                                                                <label class="text-right">
                                                                    To Location <span class="required">*</span>
                                                                </label>
                                                            </div>

                                                            <div class="col-md-8">

                                                                <select id="ToLocationId" class="form-control" name="ToLocationId"></select>
                                                                @Html.ValidationMessageFor(model => model.ToLocationId, "", new { @class = "text-danger" })

                                                            </div>



                                                        </div>


                                                    </div>



                                                </div>

                                                @{ // Get the current date in the "yyyy-MM-dd" format
                                                    string todayDate = DateTime.Now.ToString("yyyy-MM-dd");

                                                    string maxDate = DateTime.Now.ToString("yyyy-MM-dd"); ;

                                                }



                                                <div class="row" style="background-color: #f5f5f5;">
                                                    <div class="col-md-6">
                                                        <div class="row" style="background-color: #f5f5f5;">
                                                            <div class="col-md-4">
                                                                <label class="text-right">
                                                                    Expected Delivery Date <span class="required">*</span>
                                                                </label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                @Html.TextBoxFor(model => model.ExpectedDeleveryDate, new
                                                  {
                                                      @class = "form-control col-md-6 col-xs-6",
                                                      @Type = "date",
                                                      @Value = Model.ExpectedDeleveryDate.ToString("yyyy-MM-dd"),
                                                      Placeholder = "Expected Date",
                                                      min = todayDate // Set the minimum date to today's date
                                                  })
                                                                @Html.ValidationMessageFor(model => model.ExpectedDeleveryDate, "", new { @class = "text-danger" })
                                                            </div>


                                                        </div>
                                                    </div>
                                                </div>






                                            </div>
                                                @*<br />*@
                                                @{
                                                    bool DisableFromDepartmentAndToDepartment = Session["DisableFromDepartmentAndToDepartment"] != null && (bool)Session["DisableFromDepartmentAndToDepartment"];


                                                  //  bool DisableFromDepartmentAndToDepartment = ViewBag.DisableFromDepartmentAndToDepartment;//?? false;
                                                }

                                                @if (DisableFromDepartmentAndToDepartment)
                                                {
                                                    <div class="form-horizontal col-md-12 trn-header" style="display:none;">



                                                        <div class="form-horizontal col-md-6" style="display:none;">


                                                            <div class="form-group">
                                                                <label class="control-label col-md-4 col-sm-6" style="display:none;">
                                                                    From Department <span class="required">*</span>
                                                                </label>
                                                                <div class="col-md-6 col-sm-6 col-xs-12" style="display:none;">
                                                                    <select id="FromDepartmentId" class="form-control" name="FromDepartmentId"></select>
                                                                    @Html.ValidationMessageFor(model => model.FromDepartmentId, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>



                                                            <div class="form-group">
                                                                <label class="control-label col-md-4 col-sm-6" style="display:none;">
                                                                    To Department <span class="required">*</span>
                                                                </label>
                                                                <div class="col-md-6 col-sm-6 col-xs-12" style="display:none;">
                                                                    <select id="ToDepartmentId" class="form-control" name="ToDepartmentId"></select>
                                                                    @Html.ValidationMessageFor(model => model.ToDepartmentId, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>



                                                        </div>
                                                    </div>

                                                }
                                                else
                                                {
                                                    <div class="form-horizontal col-md-12 trn-header">
                                                        <br />


                                                        <div class="form-horizontal col-md-6">
                                                            <br /><br />


                                                            <div class="form-group">
                                                                <label class="control-label col-md-4 col-sm-6">
                                                                    From Department <span class="required">*</span>
                                                                </label>
                                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                                    <select id="FromDepartmentId" class="form-control" name="FromDepartmentId"></select>
                                                                    @Html.ValidationMessageFor(model => model.FromDepartmentId, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-4 col-sm-6">
                                                                    To Department <span class="required">*</span>
                                                                </label>
                                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                                    <select id="ToDepartmentId" class="form-control" name="ToDepartmentId"></select>
                                                                    @Html.ValidationMessageFor(model => model.ToDepartmentId, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>


                                                        </div>
                                                    </div>

                                                }

                                              





                                            </div>
                                        <div class="clearfix"></div>
                                        <div id="step-2" style="height: 300px;">
                                            <div class="trn-detail col-md-12">
                                                <br />
                                                <div class="form-group">
                                                    @*Item Table*@
                                                    <div>
                                                        <table class="table table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th style="display: none;"></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td style="width:5%">
                                                                        Product
                                                                    </td>
                                                                    <td style="width:30%">
                                                                        <select id="ProductId" class="form-control select2" style="width:100%" name="ProductId"></select>
                                                                    </td>

                                                                    <td style="width:5%">
                                                                        SIH
                                                                    </td>
                                                                    <td style="width:10%">
                                                                        <input id="txtSIH" name="txtSIH" type="text" value="0"
                                                                               readonly
                                                                               class="form-control col-md-2 col-xs-6"
                                                                               style="text-align:right" />
                                                                    </td>

                                                                    @{ // Assume your session variable is named "ShowTOGSection" and it holds a boolean value
                                                                        bool DisableServingUnit = Session["DisableServingUnit"] != null && (bool)Session["DisableServingUnit"];
                                                                        bool DisableRequestedBy = Session["DisableRequestedBy"] != null && (bool)Session["DisableRequestedBy"];// Set this based on your logic
                                                                        bool DisablePriceRequestNote = Session["DisablePriceRequestNote"] != null && (bool)Session["DisablePriceRequestNote"];
                                                                        bool EnableRequestNoteLineRemark = Session["EnableRequestNoteLineRemark"] != null && (bool)Session["EnableRequestNoteLineRemark"];

                                                                    }

                                                                    <td style="width:5%">
                                                                        Quantity
                                                                    </td>
                                                                    <td style="width:10%">
                                                                        <input id="RequestQuty" name="RequestQuty" type="text" value="0"
                                                                               min="0" , onkeypress="validateInputForNumbers(event)"
                                                                               onkeyup="checkProductQuantity()"
                                                                               class="form-control col-md-2 col-xs-6"
                                                                               style="text-align:right" />
                                                                        <font color="red">
                                                                            <label id="validateqty" name="validateqty" style=" font:small-caption"></label>
                                                                        </font>
                                                                    </td>
                                                                    @if (EnableRequestNoteLineRemark)
                                                                    {
                                                                        <td style="width:5%">
                                                                            Remark
                                                                        </td>
                                                                        <td>
                                                                            <input id="txtLineRemark" name="txtLineRemark" type="text" value=""
                                                                                   class="form-control col-md-2 col-xs-6"
                                                                                   style="text-align:left" />
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td style="display: none;">
                                                                            Remark
                                                                        </td>
                                                                        <td style="display: none;">
                                                                            <input id="txtLineRemark" name="txtLineRemark" type="text" value=""
                                                                                   class="form-control col-md-2 col-xs-6"
                                                                                   style="text-align:left" />


                                                                            }
                                                                        </td>
                                                                    }
                                                                    <td>
                                                                        <input type="button" id="btnAddTOGItem" class="btn btn-round btn-info" value="+" />
                                                                    </td>
                                                                </tr>
                                                                <tr>


                                                                    @if (DisableRequestedBy)
                                                                    {
                                                                        <td style="display: none;width:10%">
                                                                            Request By
                                                                        </td>
                                                                        <td style="display: none;width:20%">
                                                                            <select id="RequestedBy" class="form-control select2" style="width:100%" name="RequestedBy"></select>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td style="width:10%">
                                                                            Request By
                                                                        </td>
                                                                        <td style="width:20%">
                                                                            <select id="RequestedBy" class="form-control select2" style="width:100%" name="RequestedBy"></select>
                                                                        </td>

                                                                    }

                                                                    @if (DisableServingUnit)
                                                                    {
                                                                        <td style="display: none;width:10%">Serving Unit</td>
                                                                        <td style="display: none;">
                                                                            <select id="ServingUnitId" class="form-control" disabled style="width:100%" name="ServingUnitId"></select>
                                                                        </td>

                                                                    }
                                                                    else
                                                                    {
                                                                        <td style="width:10%">Serving Unit</td>
                                                                        <td>
                                                                            <select id="ServingUnitId" class="form-control" disabled style="width:100%" name="ServingUnitId"></select>
                                                                        </td>

                                                                    }


                                                                    <td>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <div class="text-info"><b>Products</b></div>
                                                    <div class="text-info">@Html.ValidationMessageFor(model => model.RequestDetail, "", new { @class = "text-danger pull-left" })</div>

                                                    <table id="tblTOGs" class="mstable">
                                                        <thead>
                                                            <tr>
                                                                <th style="display: none;"> Id</th>
                                                                <th style="display: none;">Products Id</th>
                                                                <th>Product Code</th>
                                                                <th>Product Name </th>  @*style="width:40%"*@
                                                                <th id="headerSIH">SIH</th>
                                                                <th>Quantity</th>




                                                                @if (DisablePriceRequestNote)
                                                                {

                                                                    <th style="display: none;">Unit</th>

                                                                    <th style="display: none;">Cost Price</th>

                                                                    <th style="display: none;">Selling Price</th>

                                                                    <th style="display: none;">Line Cost Value</th>

                                                                }
                                                                else
                                                                {
                                                                    <th>Unit</th>

                                                                    <th>Cost Price</th>

                                                                    <th style="display: none;">Selling Price</th>

                                                                    <th>Line Cost Value</th>

                                                                }

                                                                @if (DisableRequestedBy)
                                                                {
                                                                    <th style="display: none;">Requested By</th>
                                                                }
                                                                else
                                                                {
                                                                    <th>Requested By</th>

                                                                }
                                                                @if (DisableServingUnit)
                                                                {
                                                                    <th style="display: none;">Serving Unit</th>

                                                                }
                                                                else
                                                                {
                                                                    <th>Serving Unit</th>
                                                                }

                                                                <th style="display: none;">Serving Unit Id</th>


                                                                @if (EnableRequestNoteLineRemark)
                                                                {

                                                                    <th>Remark</th>

                                                                }
                                                                else
                                                                {

                                                                    <th style="display: none;">Remark</th>

                                                                }
                                                                <th></th>

                                                            </tr>
                                                        </thead>
                                                        <tbody id="togitems">
                                                            @if (Model.RequestDetail != null)
                                                            {
                                                                foreach (var requestitem in Model.RequestDetail)
                                                                {
                                                                    <tr id='@requestitem.ProductId'>
                                                                        <td style="display:none"><input class="text01" name='RequestDetail.Index' value=@requestitem.ProductId /></td>
                                                                        <td style="display:none"><input id='RequestDetail[@requestitem.ProductId]_ProductId' class='text02 form-control' name='RequestDetail[@requestitem.ProductId].ProductId' type='number' readonly value=@requestitem.ProductId /></td>

                                                                        <td><input id='RequestDetail[@requestitem.ProductId]_ProductCode' class='text03 form-control' name='RequestDetail[@requestitem.ProductId].ProductCode' type='text' readonly value='@requestitem.ProductCode' /></td>

                                                                        <td><input id='RequestDetail[@requestitem.ProductId]_ProductName' class='text03 form-control' name='RequestDetail[@requestitem.ProductId].ProductName' type='text' readonly value='@requestitem.ProductName' /></td>
                                                                        <td><input id='RequestDetail[@requestitem.ProductId]_SIH' class='text04 form-control' name='RequestDetail[@requestitem.ProductId].SIH' type="number" style="text-align:right" readonly value=@requestitem.SIH /></td>


                                                                        <td data-html="true"><input id='RequestDetail[@requestitem.ProductId]_RequestQty' class='text04 form-control' name='RequestDetail[@requestitem.ProductId].RequestQty' type="number" style="text-align:right"  value=@requestitem.RequestQty /></td>





                                                                        @if (DisablePriceRequestNote)
                                                                        {
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_UOM' class='text05 form-control' name='RequestDetail[@requestitem.ProductId].UOM' readonly value='@requestitem.UOM' /></td>
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_SellingPrice' class='text06 form-control' name='RequestDetail[@requestitem.ProductId].SellingPrice' type='number' readonly value=@Convert.ToDecimal(requestitem.SellingPrice) /></td>
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_CostPrice' class='text07 form-control' name='RequestDetail[@requestitem.ProductId].CostPrice' type='number' style='text-align:right' readonly value=@Convert.ToDecimal(requestitem.CostPrice) /></td>

                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_TotCostValue' class='text07 form-control' name='RequestDetail[@requestitem.ProductId].' type='number' style='text-align:right' readonly value=@Convert.ToDecimal(requestitem.CostPrice * requestitem.RequestQty) /></td>

                                                                        }
                                                                        else
                                                                        {

                                                                            <td><input id='RequestDetail[@requestitem.ProductId]_UOM' class='text05 form-control' name='RequestDetail[@requestitem.ProductId].UOM' readonly value='@requestitem.UOM' /></td>
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_SellingPrice' class='text06 form-control' name='RequestDetail[@requestitem.ProductId].SellingPrice' type='number' readonly value=@Convert.ToDecimal(requestitem.SellingPrice) /></td>
                                                                            <td><input id='RequestDetail[@requestitem.ProductId]_CostPrice' class='text07 form-control' name='RequestDetail[@requestitem.ProductId].CostPrice' type='number' style='text-align:right' readonly value=@Convert.ToDecimal(requestitem.CostPrice) /></td>

                                                                            <td><input id='RequestDetail[@requestitem.ProductId]_TotCostValue' class='text07 form-control' name='RequestDetail[@requestitem.ProductId].' type='number' style='text-align:right' readonly value=@Convert.ToDecimal(requestitem.CostPrice * requestitem.RequestQty) /></td>


                                                                        }



                                                                        @if (DisableRequestedBy)
                                                                        {
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_RequestedBy' class='text08 form-control' name='RequestDetail[@requestitem.ProductId].RequestedBy' type='text' readonly value='@requestitem.RequestedBy' /></td>
                                                                        }

                                                                        else
                                                                        {
                                                                            <td><input id='RequestDetail[@requestitem.ProductId]_RequestedBy' class='text08 form-control' name='RequestDetail[@requestitem.ProductId].RequestedBy' type='text' readonly value='@requestitem.RequestedBy' /></td>


                                                                        }


                                                                        @if (DisableServingUnit)
                                                                        {
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_ServingUnit' class='text09 form-control' name='RequestDetail[@requestitem.ProductId].ServingUnit' type='text' readonly value='@requestitem.ServingUnit' /></td>
                                                                        }
                                                                        else
                                                                        {

                                                                            <td><input id='RequestDetail[@requestitem.ProductId]_ServingUnit' class='text09 form-control' name='RequestDetail[@requestitem.ProductId].ServingUnit' type='text' readonly value='@requestitem.ServingUnit' /></td>
                                                                        }
                                                                        <td style="display:none"><input id='RequestDetail[@requestitem.ProductId]_ServingUnitId' class='text10 form-control' name='RequestDetail[@requestitem.ServingUnitId].ServingUnit' type='text' readonly value='@requestitem.ServingUnitId' /></td>

                                                                        @if (EnableRequestNoteLineRemark)
                                                                        {
                                                                            <td><input id='RequestDetail[@requestitem.ProductId]_Remark' class='text09 form-control' readonly name='RequestDetail[@requestitem.ProductId].Remark' type='text' value='@requestitem.Remark' /></td>
                                                                        }
                                                                        else

                                                                        {
                                                                            <td style="display:none;"><input id='RequestDetail[@requestitem.ProductId]_Remark' class='text09 form-control' name='RequestDetail[@requestitem.ProductId].Remark' type='text' readonly value='@requestitem.Remark' /></td>

                                                                        }

                                                                        <td>
                                                                            <input id='btnAddPOItem' type='button' value='-' class='btn btn-round btn-info' onclick='removePORow(this);' />
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <hr />
                                                <div id="summary" class="col-lg-12">
                                                    <div class="col-md-3" style="display: none;">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-6">
                                                                Total Selling Price <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (DisablePriceRequestNote)
                                                    {

                                                        <div class="col-md-4" style="display: none;">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-6">
                                                                    Total Cost Value <span class="required">*</span>
                                                                </label>
