                    // Prevent the default action of the button (if any)
                    event.preventDefault();

                    // Show a confirmation dialog
                    var userConfirmed = confirm('Are you sure you want to accept this request note?');

                    if (userConfirmed) {
                        // If user confirms, proceed with the submission process
                        $('#ButtonAcceptRequestNote').text('Processing...');
                        $('#ButtonAcceptRequestNote').prop('disabled', true);
                        $('#ModifyPendingRequestNote').attr('action', '/RequestNote/ModifyPendingRequestNote');
                        $('#ModifyPendingRequestNote').submit();
