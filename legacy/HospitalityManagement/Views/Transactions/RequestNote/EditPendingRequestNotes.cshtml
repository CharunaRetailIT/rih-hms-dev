                //---------------------
                $('#ButtonCancel').on('click', function (event) {
                    // Prevent the default action of the button (if any)
                    event.preventDefault();

                    // Show a confirmation dialog
                    var userConfirmed = confirm('Are you sure you want to cancel?');

                    if (userConfirmed) {
                        // If user confirms, proceed with the submission process
                        $('#ButtonCancel').text('Processing...');
                        $('#ButtonCancel').prop('disabled', true);
                        $('#ModifyPendingRequestNote').attr('action', '/RequestNote/CancelRequestNoteAccept');
                        $('#ModifyPendingRequestNote').submit();
