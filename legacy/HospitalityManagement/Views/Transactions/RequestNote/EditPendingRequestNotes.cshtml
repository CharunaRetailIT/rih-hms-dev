                        $('#ModifyPendingRequestNote').submit();
                    });
                //---------------------------------------------------------
                $('#ButtonReOpen').on('click',
                    function (event) {
                        $('#ButtonReOpen').text('Processing...');
                        $('#ButtonReOpen').prop('disabled', true);
                        $('#ModifyPendingRequestNote').attr('action', 'ReOpen');
                        $('#ModifyPendingRequestNote').submit();
                    });
