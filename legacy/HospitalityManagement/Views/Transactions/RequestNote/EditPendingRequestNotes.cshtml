@{
    ViewBag.Title = "Pending Request Notes Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body" novalidate>
    <div class="main_container">

        <div class="right_col" role="main">
            @if (ViewBag.Message == "1")
            {
                <div class="alert alert-success alert-dismissible fade in" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                    <strong> </strong> @ViewBag.Code Saved Successfully.
                </div>
            }


            @if (ViewBag.Message == "2")
            {
                <div class="alert alert-success alert-dismissible fade in" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                    <strong> </strong> @ViewBag.Code Successfully Canceled.
                </div>
            }






            @{ // Assume your session variable is named "ShowTOGSection" and it holds a boolean value
                bool DisableServingUnit = Session["DisableServingUnit"] != null && (bool)Session["DisableServingUnit"];
                bool DisableRequestedBy = Session["DisableRequestedBy"] != null && (bool)Session["DisableRequestedBy"];// Set this based on your logic
                bool DisablePriceRequestNote = Session["DisablePriceRequestNote"] != null && (bool)Session["DisablePriceRequestNote"];
            }



            @using (Html.BeginForm("ModifyPendingRequestNote", "RequestNote", FormMethod.Post, new { id = "ModifyPendingRequestNote", @class = "form-horizontal", enctype = "multipart/form-data" }))
            {
                <input type="hidden" id="DocumentNo" name="DocumentNo" value="@Model.DocumentNo" />
                <input type="hidden" id="DocumentDate" name="DocumentDate" value="@Model.DocumentDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" id="CompanyId" name="CompanyId" value="@Model.CompanyId" />
                <input type="hidden" id="RequestnoteHeaderId" name="RequestnoteHeaderId" value="@Model.RequestnoteHeaderId" />
                <input type="hidden" id="FromLocationId" name="FromLocationId" value="@Model.FromLocationId" />


                <div class="x_panel trn-xpanel">
                    <div class="x_title1">

                        <h2>Request Note No @Model.DocumentNo </h2>

                        <br />
                        <div class="clearfix"></div>
                    </div>
                </div>










                <table id="tblTOGs" class="mstable">
                    <thead>
                        <tr>
                            <th style="display:none">Index</th>
                            <th style="display:none">Product Id</th>
                            <th style='width:25%'>Product Code</th>
                            <th style='width:25%'>Product</th>
                            <th style="display:none">Item Id</th>
                            <th style='display: none;width:25%'>Item</th>
                            <th style="display:none">Request Quantity</th>

                            <th>SIH Quantity</th>
                            <th>Request Qty</th>
                            @if (DisablePriceRequestNote)
                            {
                                <th style="display: none;">Unit</th>
                                <th style="display: none;">Cost Price</th>
                            }
                            else
                            {
                                <th>Unit</th>
                                <th>Cost Price</th>

                            }
                            <th style="display: none;">Selling Price</th>
                            @if (DisableRequestedBy)
                            {
                                <th style="display: none;">Requested By</th>
                            }
                            else
                            {
                                <th>Requested By</th>

                            }
                            @if (DisableServingUnit)
                            {
                                <th style="display: none;">Serving Unit</th>
                            }
                            else
                            {
                                <th>Serving Unit</th>

                            }
                            <th style="display: none;">Serving Unit Id</th>
                            <th style="display: none;">Header Id</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="togitems">
                        <!-- Items will be dynamically loaded here -->
                    </tbody>
                </table>

                <!-- Add hidden field for product code -->
                <input type="hidden" id="ProductCode" name="ProductCode" value="YOUR_PRODUCT_CODE_HERE" />
                <input type="hidden" id="Remark" name="Remark" />

                <div class="actionBar">
                    <div class="msgBox">
                        <div class="pull-left">
                            <input type="button" class="btnallClear" value="Back" onclick="location.href='@Url.Action("AcceptRequestNote", null, new { })'" />
                        </div>

                        @if (!Model.IsApproved && (Model.DocumentStatus == 2 || Model.DocumentStatus == 1))
                        {
                            <div id="RequestStatus2">
                                <button type="submit" formaction="AcceptRequestNote" id="ButtonAcceptRequestNote" class="btnallSubmit btn pull-left">Request Approve</button>
                            </div>
                        }

                        @if (!Model.IsApproved && Convert.ToBoolean(Session["EnableRequestNoteCancelOnly"]) == true && (Model.DocumentStatus == 2 || Model.DocumentStatus == 1))
                        {<div class="pull-left">




                                <button type="submit" formaction="ButtonCancel" id="ButtonCancel" class="btnallClear">Cancel Request Note</button>



                            </div>
                        }




                        <div id="RequestStatus4">
                            <button type="submit" formaction="ReOpen" id="ButtonReOpen" class="btn btnallView pull-left">Request Re-Open</button>
                        </div>
                        <div id="RequestStatus6">
                            <button type="submit" formaction="AcceptRequestNote" id="ButtonAcceptRequestNote2" class="btnallSubmit btn pull-left">Request Approve</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        @section Scripts {
            <script type="text/javascript">
        $(document).ready(function () {
            // Show success message if it exists
            if ('@ViewBag.Message' == '1') {
                $('#ButtonAcceptRequestNote').attr('disabled', true);
                $('#ButtonAcceptRequestNote2').attr('disabled', true);
            }
        });
            </script>
        }

        <script src="~/vendors/jquery/dist/jquery.min.js"></script>
