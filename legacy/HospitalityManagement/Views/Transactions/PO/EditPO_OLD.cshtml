<script>
    $.getJSON("@Url.Action("GetEvents", "PO")", function (data) {
        // debugger;
        var EventId = $("#EventId");
        EventId.empty();
        EventId.append("<option value='0'>-- Select an Event --</option>");
        $.each(JSON.parse(data), function (index, optionaldata) {
            EventId.append($('<option />', { value: optionaldata.EventId }).html(optionaldata.EventName));
        });
        if ('@ViewBag.EventId') {
            $('#EventId').val(@ViewBag.EventId).trigger("change");
        } else {
            $('#EventId').val(0).trigger("change");
        }
    });
</script>

<script type="text/javascript">
    function checkProductQuantity()
    {
        document.getElementById('validateqty').innerHTML = '';

        if ($("#SupplierId").val() == 0 || $("#SupplierId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select a Supplier';

            return;
        }

        if ($("#POLocationId").val() == 0 || $("#POLocationId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select a PO Location';

            return;
        }

        if ($("#ItemId").val() == 0 || $("#ItemId").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Select an Item';
            return;
        }

        if ($("#RecQty").val() == 0 || $("#RecQty").val() == null) {
            document.getElementById('validateqty').innerHTML = 'Quantity can not be 0 or empty';
            return;

        } else
        {
            document.getElementById('validateqty').innerHTML = '';
        }

        $.ajax({
            url: "@Url.Action("VaidateQuantity", "PO")",
            data: { id: $("#ItemId").val(), qty: $("#RecQty").val(), polocid: $("#POLocationId").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {
                data = resp;

                if (resp.Stock < $("#RecQty").val()) {
                    document.getElementById('validateqty').innerHTML = 'available stock is ' + resp.Stock;
                    document.getElementById('RecQty').value = '0';
                } else
                {
                    document.getElementById('validateqty').innerHTML = '';
                }

            }
        });


    }
</script>

