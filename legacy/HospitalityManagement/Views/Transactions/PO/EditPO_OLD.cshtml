            quantity=firstquantity;
           
        }
        //  document.getElementById('PODetail' + unitindex +'_OrderQty').value=parseFloat(quantity).toFixed(3);

        //  debugger;
        $.ajax({
            url: "@Url.Action("ApplyPOTaxes", "PO")",
            data: { id:itemid, qty:quantity, polocid: $("#POLocationId").val() },
            type: "GET",
            dataType: "json",
            success: function (resp) {
                //   debugger;

                data = resp;
                document.getElementById('PODetail['+ unitindex +']_CostPrice').value=parseFloat(data.CostPrice).toFixed(3);
                document.getElementById('PODetail['+ unitindex +']_CostValue').value=parseFloat(data.CostValue).toFixed(3);
                document.getElementById('PODetail['+ unitindex +']_ItemTaxTotal').value=parseFloat(data.TaxAmount).toFixed(3);
                document.getElementById('PODetail['+ unitindex +']_CostPriceHidden').value=parseFloat(data.CostPrice).toFixed(3);

                //calcTotal();

                var totsp = 0.0;
                var totcp = 0.0;
                var totdis = 0.0;
                var tottax = 0.0;
                var costval = 0.0;
                var sellingval = 0.0;



                var orrtable = document.getElementById("poitems");
                var indexval;

                for (var r = 0, n = orrtable.rows.length; r < n; r++)
                {

                    var itemidcell = orrtable.rows[r].cells[1].innerHTML;
                    var regex = /value="(\d+(\.\d+)*)/i;
                    var itemid = itemidcell.match(regex)[1];


                    // debugger;

                    var spvalue =Number(document.getElementById('PODetail['+ itemid +']_SellingPrice').value);
                    totsp += Number(document.getElementById('PODetail['+ itemid +']_SellingPrice').value);
                    totcp += Number(document.getElementById('PODetail['+ itemid +']_CostPrice').value);
                    costval += Number(document.getElementById('PODetail['+ itemid +']_CostValue').value);
                    tottax += Number(document.getElementById('PODetail['+ itemid +']_ItemTaxTotal').value);
                    var qtyvalue = Number(document.getElementById('PODetail['+ itemid +']_OrderQty').value);
                    sellingval+=Number(spvalue*qtyvalue);
                }


                // debugger;
                //setting total values

                var otherchargers=document.getElementById('OtherCharges').value;
                var deductions=document.getElementById('Deduction').value;
                var additions=document.getElementById('Addition').value;
                document.getElementById("TotSellingPrice").value = (Number(sellingval)).toFixed(3);
                document.getElementById("TotCostPrice").value = (Number(costval)).toFixed(3);
                document.getElementById("GrossAmount").value = (Number(costval)).toFixed(3);
                document.getElementById("NetAmount").value = (Number(costval + tottax)).toFixed(3);
                document.getElementById("NetAmount").value = ((Number(document.getElementById("NetAmount").value)+
                Number(otherchargers)+Number(additions))-Number(deductions)).toFixed(3);
                document.getElementById("NetAmountHidden").value = Number((document.getElementById("NetAmount").value)).toFixed(3);
                document.getElementById("TotalTaxAmount").value = parseFloat(tottax).toFixed(3);

            },
            error: function (error)
            {
                alert("Item data mapping error");
            }

        }

        );


    };
</script>