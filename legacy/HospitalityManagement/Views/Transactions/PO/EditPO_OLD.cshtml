<script>
    //debugger;

    $(document).ready(function() {

        EnableDisable();

    });

    $('input[type=radio][name=POType]').change(function()
    {

        if (this.value == 'Manual')
        {
           // alert("Can not change the PO Mode after adding Items!");
            $("#Request").prop("disabled", true); 
            $("#Auto").prop("disabled", true);  
            $("#Manual").prop("checked", true); 
          
            EnableDisable();
        }
        else if (this.value == 'ReOrderLevelBased')
        {
           // alert("Can not change the PO Mode after adding Items!"); 
            $("#Manual").prop("disabled", true); 
            $("#Request").prop("disabled", true);
            $("#Auto").prop("checked", true); 
            
            EnableDisable();

        }
        else if (this.value == 'RequestNoteBased') 
        { 
            $("#Request").prop("checked", true); 
            $("#Auto").prop("disabled", true);  
            $("#Manual").prop("disabled", true); 
            
            EnableDisable();
           
        }   
    });
</script>

<script>
    if(@ViewBag.POHeaderId!=null){

        //$("#DeliveryAddress").val("");
        var TeamDetailPostBackURL = '/PO/Print';

        $(function () {
            // debugger;
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var options = { "backdrop": "static", keyboard: true };
            $.ajax({
                type: "GET",
                url: TeamDetailPostBackURL,
                contentType: "application/json; charset=utf-8",
                data: { "id": @Model.PurchaseOrderHeaderId,"printstatus":1 },
                datatype: "json",
                success: function (data) {
                    // debugger;
                    $('#myModalContent').html(data);
                    $('#myModal').modal(options);
                    $('#myModal').modal('show');

                },
                error: function () {
                    alert("Dynamic content load failed.");
                }
            });
        });


        $("#closbtn").click(function () {
            $('#myModal').modal('hide');
        });

    }
</script>

