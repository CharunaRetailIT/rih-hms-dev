<script>
    function calcTotal()
    {


        var table = document.getElementById("poitems");
        debugger;

        var totsp = 0.0;
        var totcp = 0.0;
        var totdis = 0.0;
        var tottax = 0.0;
        var costval = 0.0;
        var sellingval=0.0;

        var regex = /value="(\d+(\.\d+)*)/i;

        for (var r = 0, n = table.rows.length; r < n; r++)
        {
            var rowitemid =  table.rows[r].cells[1].innerHTML.match(regex)[1];

            var spvalue =document.getElementById('PODetail[' + rowitemid + ']_SellingPrice').value;
            totsp += Number(spvalue);

            var cpvalue =document.getElementById('PODetail[' + rowitemid + ']_CostPrice').value;
            totcp += Number(cpvalue);

            var costvalue = document.getElementById('PODetail[' + rowitemid + ']_CostValue').value;
            costval += Number(costvalue);

            var taxvalue =  document.getElementById('PODetail[' + rowitemid + ']_ItemTaxTotal').value;
            tottax += Number(taxvalue);

            var qtyvalue = document.getElementById('PODetail[' + rowitemid + ']_OrderQty').value;
            sellingval+=spvalue*qtyvalue;
        }


        //$("#poitems TR").each(function ()
        //{
        //    var row = $(this);

        //    var spvalue =row.find("TD").eq(6).html().match(regex)[1];
        //    totsp += Number(spvalue);

        //    var cpvalue =row.find("TD").eq(7).html().match(regex)[1];
        //    totcp += Number(cpvalue);

        //    var costvalue =row.find("TD").eq(8).html().match(regex)[1];
        //    costval += Number(costvalue);

        //    var taxvalue = row.find("TD").eq(9).html().match(regex)[1];
        //    tottax += Number(taxvalue);

        //    var qtyvalue = row.find("TD").eq(3).html().match(regex)[1];
        //    sellingval+=spvalue*qtyvalue;

        //});


        //setting tot values
        var otherchargers=document.getElementById('OtherCharges').value;
        var deductions=document.getElementById('Deduction').value;
        var additions=document.getElementById('Addition').value;


        document.getElementById("TotSellingPrice").value = parseFloat(sellingval).toFixed(3);
        document.getElementById("TotCostPrice").value = parseFloat(costval).toFixed(3);

        document.getElementById("TotalTaxAmount").value = parseFloat(tottax).toFixed(3);

        document.getElementById("GrossAmount").value = parseFloat(costval).toFixed(3);


        document.getElementById("NetAmount").value = parseFloat(
            costval + tottax).toFixed(3);

        document.getElementById("NetAmount").value = parseFloat((Number(document.getElementById("NetAmount").value)+
            Number(otherchargers)+Number(additions))-Number(deductions)).toFixed(3);
        document.getElementById("NetAmountHidden").value = parseFloat(document.getElementById("NetAmount").value).toFixed(3);
        document.getElementById("RecQty").value = "";

    }
</script>

<script type="text/javascript">

    function CalculateNetAmt()
    {
        //  debugger;
        var otherCharge = document.getElementById('OtherCharges').value;
        var addition = document.getElementById('Addition').value;
        var deductions = document.getElementById('Deduction').value;
        var totalTaxAmount = document.getElementById('TotalTaxAmount').value;
        if(otherCharge==null || otherCharge=="")
        {
            document.getElementById('OtherCharges').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                          Number(addition) - Number(deductions) + Number(totalTaxAmount)).toFixed(3);
            return;
        }


        if(addition==null || addition=="")
        {
            document.getElementById('Addition').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge)  - Number(deductions) + Number(totalTaxAmount)).toFixed(3);
            return;
        }


        if(deductions==null || deductions=="")
        {
            document.getElementById('Deduction').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge) + Number(addition) + Number(totalTaxAmount)).toFixed(3);
            return;
        }

        if(totalTaxAmount==null || totalTaxAmount=="")
        {
            document.getElementById('TotalTaxAmount').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge) + Number(addition) - Number(deductions)).toFixed(3);
            return;
        }

        document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge) + Number(addition) - Number(deductions) + Number(totalTaxAmount)).toFixed(3);
    }



    function checkOtherChargers()
    {
        //  debugger;
        var otherchargers = document.getElementById('OtherCharges').value;
        if(otherchargers=="" || otherchargers==null)
        {
            document.getElementById('OtherCharges').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value)).toFixed(3);
            return;
        }

        if (otherchargers != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(otherchargers)).toFixed(3);
        } else{
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(otherchargers)).toFixed(3);
        }

    }

    function checkAdditions()
    {
        // debugger;
        var addition = document.getElementById('Addition').value;

        if(addition==null || addition=="")
        {
            document.getElementById('Addition').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value)).toFixed(3);
            return;
        }

        if (addition != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(addition)).toFixed(3);
        } else{
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(addition)).toFixed(3);
        }

    }

    function checkDeductions() {
        //  debugger;
        var deductions = document.getElementById('Deduction').value;
        if(deductions=="" || deductions==null)
        {
            document.getElementById('Deduction').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value)).toFixed(3);
            return;
        }

        if (deductions != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                            Number(deductions)).toFixed(3);
        } else {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                            Number(deductions)).toFixed(3);
        }

    }

    function checkTotTaxes() {
        // debugger;
        var taxes = document.getElementById('TotalTaxAmount').value;
        if(taxes=="" || taxes==null)
        {
            document.getElementById('TotalTaxAmount').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value)).toFixed(3);
            return;
        }

        if (taxes != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                            Number(taxes)).toFixed(3);
        } else {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                            Number(taxes)).toFixed(3);
        }

    }

</script>

