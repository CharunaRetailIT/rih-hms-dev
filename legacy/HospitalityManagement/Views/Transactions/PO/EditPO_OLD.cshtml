
@model RIT.HMS.Domain.Transactions.PurchaseOrderHeader
@{
    ViewBag.Title = "Edit PO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm(null, null, FormMethod.Post, new
        {
            id = "EditPO",
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
        {
            @Html.HiddenFor(model => model.PurchaseOrderHeaderId);
            @Html.HiddenFor(model => model.CreatedDate);
            @Html.HiddenFor(model => model.CreatedUser);
            @Html.HiddenFor(model => model.DocumentStatus);
            @Html.HiddenFor(model => model.CompanyID);
            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">



                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PO</strong> @ViewBag.POCode modified successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PO</strong> @ViewBag.POCode failed to modified.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PO</strong> @ViewBag.POCode already exists.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Atleast one item requires to submit PO
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please enter the reject reason !</strong>
                        </div>
                    }
                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please enter the cancel reason !</strong>
                        </div>
                    }
                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btn btn-primary" value="Reset" onclick="location.href='@Url.Action("Edit", null, new {id=Model.PurchaseOrderHeaderId })'" />
                            </div>
                            @if (Model.IsTempPO)
                            {
                                <button type="submit" id="ButtonSubmit"  class="btn btn-success pull-left">Submit PO</button>
                                <button type="submit" formaction="/PO/MultipleSavePO" id="ButtonMultipleSavePO" class="btn btn-primary pull-left">Temporary Save PO</button>
                            }
                            @if (Convert.ToBoolean(Session["POApprovels"]) == true)
                            {
                                if (Model.DocumentStatus == 2)
                                {
                                    <button type="submit" formaction="/PO/Approve" id="ButtonApprove" class="btn btn-success pull-left">Approve</button>

                                    if (Convert.ToBoolean(Session["DisablePOReject"]) == false)
                                    {
                                   
                                        <button type="submit" formaction="/PO/Reject" id="ButtonReject" class="btn btn-danger pull-left">Reject</button>                                   
                                        <button type="submit" formaction="/PO/Cancel" id="ButtonCancel" class="btn btn-danger pull-left">Cancel</button>                                   
                                        <button type="submit" formaction="/PO/ForceFullyClose" id="ButtonForceFullyClose" class="btn btn-danger pull-left">Forcefully Close</button>
                                    }
                                }
                                if (Model.DocumentStatus == 4 || Model.DocumentStatus == 5)
                                {
                                    <button type="submit" formaction="/PO/ReOpen" id="ButtonReopen" class="btn btn-success pull-left">Re Open</button>
                                }
                                if (Model.DocumentStatus == 6)
                                {
                                    <button type="submit" id="ButtonSubmit" class="btn btn-success pull-left">Submit PO</button>
                                }
                            }
                            <div class="pull-left">
                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewAllPO", null, new { })'" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Purchase Order</h2>
                                    <h4 class="small">@Model.DocState </h4> 
                                    <br />

                                   
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>General</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Items</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Prices</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-4">
                                                    <span class="step_no">4</span>
                                                    <span class="step_descr">
                                                        Step 4<br />
                                                        <small>Details</small>
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>
                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>

                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.POType, "Manual", new { id = "Manual", disabled = "disabled" })
                                                                Manual
                                                            </div>
                                                            <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                <div class="clearfix"></div>
                                                                @Html.RadioButtonFor(m => m.POType, "ReOrderLevelBased", new { id = "Auto", disabled = "disabled" })
                                                                Re Order Level based
                                                            </div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.POType, "RequestNoteBased", new { @id = "Request", disabled = "disabled" })
                                                                Request Note Based
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new
                                                       {
                                                           @class = "form-control",
                                                           MaxLength = 20,
                                                           @readonly = true,
                                                           Placeholder = "Doc Number"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="SupplierId" class="form-control" Name="SupplierId"></select>
                                                            @Html.ValidationMessageFor(model => model.SupplierId, "", new { @class = "text-danger" })
                                                        </div>

                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PO Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="POLocationId" class="form-control" Name="POLocationId"></select>
                                                            @Html.ValidationMessageFor(model => model.POLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    @if (@ViewBag.IsMergedPO == true)

                                                    {

                                                        <div class="form-group" style="display:none">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Delivery Location <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="DeliveryLocationId" class="form-control" Name="DeliveryLocationId"></select>
                                                                @Html.ValidationMessageFor(model => model.DeliveryLocationId, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>

                                                        <div class="form-group" style="display:none">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Delivery Address
                                                            </label>
                                                            <div class="col-md-8 col-sm-8 col-xs-12">
                                                                @Html.TextAreaFor(model => model.DeliveryAddress, new
                                                           {
                                                               @class = "form-control",
                                                               MaxLength = 100,
                                                               Placeholder = "Delivery Address",
                                                               style = "resize: none;"
                                                           })
                                                            </div>
                                                        </div>
                                                        <div class="form-group" style="display:none">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Delivery Details
                                                            </label>
                                                            <div class="col-md-8 col-sm-8 col-xs-12">
                                                                @Html.TextAreaFor(model => model.DeliveryDetail, new
                                                           {
                                                               @class = "form-control",
                                                               MaxLength = 200,
                                                               style = "resize: none;",
                                                               Placeholder = "Delivery details"
                                                           })
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Delivery Location <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="DeliveryLocationId" class="form-control" Name="DeliveryLocationId"></select>
                                                                @Html.ValidationMessageFor(model => model.DeliveryLocationId, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>

                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Delivery Address
                                                            </label>
                                                            <div class="col-md-8 col-sm-8 col-xs-12">
                                                                @Html.TextAreaFor(model => model.DeliveryAddress, new
                                                           {
                                                               @class = "form-control",
                                                               MaxLength = 100,
                                                               Placeholder = "Delivery Address",
                                                               style = "resize: none;"
                                                           })
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Delivery Details
                                                            </label>
                                                            <div class="col-md-8 col-sm-8 col-xs-12">
                                                                @Html.TextAreaFor(model => model.DeliveryDetail, new
                                                           {
                                                               @class = "form-control",
                                                               MaxLength = 200,
                                                               style = "resize: none;",
                                                               Placeholder = "Delivery details"
                                                           })
                                                            </div>
                                                        </div>


                                                    }

                                                </div>

                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency  <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="CurrencyId" class="form-control" name="CurrencyId"></select>
                                                            @Html.ValidationMessageFor(model => model.CurrencyId, "", new { @class = "text-danger" })

                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Expected Delivery Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">

                                                            @Html.TextBoxFor(model => model.ExpectedDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.ExpectedDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.ExpectedDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Validity Period <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">

                                                            @Html.TextBoxFor(model => model.ValidityPeriod, new
                                                       {
                                                           @class = "form-control",
                                                           MaxLength = 15,
                                                           oninput = "javascript: if (this.value.length > 5) this.value = this.value.slice(0,5);",
                                                           required = "required",
                                                           type = "number",
                                                           min = "0",
                                                           onkeypress = "return event.charCode >= 46"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.ValidityPeriod, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Term <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentTermId" class="form-control" Name="PaymentTermId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentTermId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Method <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentMethodId" class="form-control" Name="PaymentMethodId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentMethodId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Period <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">

                                                            @Html.TextBoxFor(model => model.PaymentPeriod, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           MaxLength = 5,
                                                           required = "required",
                                                           type = "number",
                                                           oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);",
                                                           min = "0",
                                                           onkeypress = "return event.charCode >= 46"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.PaymentPeriod, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PO Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">

                                                            @Html.TextBoxFor(model => model.PODate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.PODate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.PODate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    @{ // Assume your session variable is named "ShowTOGSection" and it holds a boolean value
                                                        bool IsEventMandatory = Session["IsEventMandatory"] != null && (bool)Session["IsEventMandatory"];

                                                    }

                                                    @if (IsEventMandatory)
                                                    {
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-group" style="display:none">
                                                            <label class="control-label col-md-3 col-sm-6">
                                                                Event<span class="required"></span>
                                                            </label>
                                                            <div class="col-md-6 col-sm-6 col-xs-12">
                                                                <select id="EventId" class="form-control" Name="EventId"></select>
                                                            </div>
                                                        </div>


                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div> <br />
                                        <div id="step-2">
                                            <div class="trn-detail col-md-12">
                                                <br />
                                                <div class="form-group">

                                                    <div class="col-lg-12 col-md-12 col-sm-12">
                                                        @*<div class="col-md-11">*@
                                                            <div id="buttons">
                                                                <table id="buttons" class="table table table-striped" style="background-color:#f5f5f5">
                                                                    <tbody class="table table table-striped" style="background-color:#f5f5f5">
                                                                        <tr class="col-md-12">
                                                                            <td>
                                                                                Item/Material (UOM)
                                                                            </td>
                                                                            <td style="width:23%">
                                                                                @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToPO"], new
                                                                             {
                                                                                 @class = "form-control select2",
                                                                                 @style = "width:100%"
                                                                             })
                                                                                @*<select id="ItemId" class="form-control select2" style="width:100%" name="ItemId"></select>*@
                                                                            </td>
                                                                            <td>
                                                                                Order Quantity
                                                                            </td>
                                                                            <td>
                                                                                <input id="RecQty" name="RecQty" type='number' value="0" onkeypress='validateInputForNumbers(event)'  onkeyup="checkCostPrice()"
                                                                                       @*type="number" min='0' onkeypress='return event.charCode >= 46' oninput="javascript: if (this.value.length >9) this.value = this.value.slice(0, 5);"*@
                                                                                       class="form-control col-md-2 col-xs-6" />
                                                                                <font color="red"><label id="validateqty" name="validateqty" style="font:small-caption"></label></font>
                                                                            </td>
                                                                            <td>
                                                                                Cost Price
                                                                            </td>
                                                                            <td>
                                                                                <input id="CostPrice" name="CostPrice" value="0" type='text' onkeypress='validateInputForNumbers(event)' onkeyup="calcManualCostPrice()" class="form-control">
                                                                            </td>
                                                                            <td>
                                                                                Cost Value
                                                                            </td>
                                                                            <td>
                                                                                <input id="CostValue" readonly name="CostValue" value="0" type='text' onkeypress='validateInputForNumbers(event)' class="form-control">
                                                                            </td>
                                                                            <td>
                                                                                <input type="button" id="btnAddPOItem" class="btn btn-round btn-info" value="+" />
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        @*</div>
                                                        <div class="col-md-1">*@
                                                            <div id="btnAddReOrderItems">
                                                                <input type="button" id="btnAddReOrderLevelItems" class="btn btn-round btn-info pull-right"
                                                                       value="Add Re Order Levels achived Items" />
                                                            </div>
                                                            <div id="btnAddRequestItems">
                                                                <div class="col-md-8">
                                                                    <div class="form-group">
                                                                        <label class="control-label col-md-2 ">
                                                                            Request Note
                                                                        </label>
                                                                        <div class="col-md-6">
                                                                            <select id="RequestNoteId" disabled name="RequestNoteId" class="form-control"></select>
                                                                        </div>
                                                                        <input type="button" id="SelectRequestNote" name="SelectRequestNote" value="Select" class="btn btn-primary" />
                                                                    </div>
                                                                </div>     
                                                            </div><div class="clearfix"></div>
                                                        @*</div>*@
                                                    </div>



                                                    <div class="clearfix"></div>
                                                    <div class="text-info"><b>Purchasing Items</b></div>

                                                    <table id="tblRecepies" class="table table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th style="display:none">idx</th>
                                                                <th style="display:none">Item Id</th>
                                                                <th>Item</th>
                                                                <th style="display:none">Quantity</th>
                                                                <th>Quantity</th>
                                                                <th>Free Qty</th>
                                                                <th style="display:none">Unit Selling Price</th>
                                                                <th>Unit Cost Price</th>
                                                                <th>Cost value</th>
                                                                @if (Convert.ToBoolean(Session["ConfigPOLineTax"]) == true)
                                                            {
                                                                    <th>Tax</th>
                                                            }
                                                            else
                                                            {
                                                                    <th style="display:none">Tax</th>
                                                            }
                                                                @*<th>Discounts</th>
                                                                    <th>Item Tax</th>*@
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="poitems">
                                                            @if (Model.PODetail != null)
                                                        {
                                                            foreach (var poDetail in Model.PODetail)
                                                            {
                                                                    <tr>
                                                                        <td style="display:none"><input name='PODetail.Index' value=@poDetail.ProductId /></td>
                                                                        <td style="display:none"><input id='PODetail[@poDetail.ProductId]_ProductId' class='form-control' name='PODetail[@poDetail.ProductId].ProductId' type='text' readonly value=@poDetail.ProductId /></td>
                                                                        <td id='PODetail[@poDetail.ProductId]_ProductName' name='PODetail[@poDetail.ProductId].ProductName'>@(poDetail.ProductCode + "-" + poDetail.ProductName)</td>
                                                                        @if (Model.POType == "Manual")
                                                                    {
                                                                            <td style='display:none'><input id='PODetail[@poDetail.ProductId]_OrderQty' type='hidden' class='form-control' name='PODetail[@poDetail.ProductId].OrderQty' readonly value=@Convert.ToDecimal(poDetail.OrderQty) /></td>
                                                                            <td><input id='PODetail[@poDetail.ProductId]_UOM' class='form-control' name='PODetail[@poDetail.ProductId].UOM' readonly value='@poDetail.UOM' /></td>
                                                                    }
                                                                    else
                                                                    {
                                                                            <td><input id='PODetail[@poDetail.ProductId]_OrderQty' type='number' class='form-control' name='PODetail[@poDetail.ProductId].OrderQty' value=@Convert.ToDecimal(poDetail.OrderQty) onkeyup='checkCostPriceROLBased(@poDetail.ProductId)'   @(ViewBag.IsMergedPO ? "readonly" : "")    /></td>
