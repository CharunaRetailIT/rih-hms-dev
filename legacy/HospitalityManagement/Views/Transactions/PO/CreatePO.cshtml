<script type="text/javascript">
   
    function CalculateNetAmt()
    {
      //  debugger;
        var otherCharge = document.getElementById('OtherCharges').value;
        var addition = document.getElementById('Addition').value;
        var deductions = document.getElementById('Deduction').value;
        var totalTaxAmount = document.getElementById('TotalTaxAmount').value;
        if(otherCharge==null || otherCharge=="")
        {
            document.getElementById('OtherCharges').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                          Number(addition) - Number(deductions) + Number(totalTaxAmount)).toFixed(3);
            return;
        }

        
        if(addition==null || addition=="")
        {
            document.getElementById('Addition').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge)  - Number(deductions) + Number(totalTaxAmount)).toFixed(3);
            return;
        }
       
       
        if(deductions==null || deductions=="")
        {
            document.getElementById('Deduction').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge) + Number(addition) + Number(totalTaxAmount)).toFixed(3);
            return;
        }
      
        if(totalTaxAmount==null || totalTaxAmount=="")
        {
            document.getElementById('TotalTaxAmount').value="0";
            document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge) + Number(addition) - Number(deductions)).toFixed(3);
            return;
        }

        document.getElementById('NetAmount').value = (Number(document.getElementById('GrossAmount').value) +
                                                           Number(otherCharge) + Number(addition) - Number(deductions) + Number(totalTaxAmount)).toFixed(3);
    }

    function checkOtherChargers()
    {
       // debugger;
        var otherchargers = document.getElementById('OtherCharges').value;
        debugger;
        if (otherchargers != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(otherchargers)).toFixed(3);
        } else {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(otherchargers)).toFixed(3);
        }

    }

    function checkAdditions() {
      //  debugger;
        var addition = document.getElementById('Addition').value;
        debugger;
        if (addition != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(addition)).toFixed(3);
        } else {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) +
                                                            Number(addition)).toFixed(3);
        }

    }

    function checkDeductions() {
      //  debugger;
        var deductions = document.getElementById('Deduction').value;
        debugger;
        if (deductions != 0) {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                            Number(deductions)).toFixed(3);
        } else {
            document.getElementById('NetAmount').value = (Number(document.getElementById('NetAmountHidden').value) -
                                                            Number(deductions)).toFixed(3);
        }

    }
</script>

<script type="text/javascript">

