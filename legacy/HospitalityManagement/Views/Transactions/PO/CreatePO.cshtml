
@model RIT.HMS.Domain.Transactions.PurchaseOrderHeader
@{
    ViewBag.Title = "Create PO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Transactions.css" rel="stylesheet" />
@*@if (ViewBag.Message != null)
{
    <script>

        $(document).ready(function () {

            alert('@ViewBag.ErrorMessage');

        });

    </script>

}*@

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm(null, null, FormMethod.Post, new
        {
            id = "CreatePO",
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
        {

            @Html.HiddenFor(model => model.PurchaseOrderHeaderId);
            @Html.HiddenFor(model => model.CreatedDate);
            @Html.HiddenFor(model => model.CreatedUser);
            @Html.HiddenFor(model => model.CompanyID);

            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PO - </strong> @ViewBag.POCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PO - </strong> @ViewBag.POCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>PO - </strong> @ViewBag.POCode already exists.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Atleast one item requires to submit PO
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Selected Month is not opened to selected Location!
                        </div>
                    }

                    <div class="actionBar">
                        <div class="msgBox">

                            <div class="pull-left">
                                <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("CreatePO", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewAllPO", null, new { })'" />
                            </div>
                            <button type="submit" formaction="CreatePO" id="ButtonSubmit" class="btn btn-success pull-left">Submit PO</button>
                            <button type="submit" name="sbt" formaction="TempSavePO" id="ButtonTempSavePO" class="btn btn-primary pull-left">Temporary Save PO</button>

                        </div>
                    </div>

                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel trn-xpanel">
                                <div class="x_title1">
                                    <h2>Purchase Order</h2>
                                    <br />

                                    @*<ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>

                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>*@

                                    @*<div class="clearfix"></div>*@
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps" id="wizardsteps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>Step 1 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Step 2 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Step 3 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-4">
                                                    <span class="step_no">4</span>
                                                    <span class="step_descr">
                                                        Step 4<br />
                                                        <small>Step 4 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                        </ul>

                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12 trn-header">
                                                <br />
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.POType, "Manual", new { @id = "Manual", @checked = true })
                                                                Manual
                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.POType, "ReOrderLevelBased", new { @id = "Auto" })
                                                                Re Order Level based
                                                            </div><div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.POType, "RequestNoteBased", new { @id = "Request" })
                                                                Request Note Based
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="SupplierId" class="form-control" Name="SupplierId"></select>
                                                            @*@Html.HiddenFor(x => x.SupplierId)*@
                                                            @Html.ValidationMessageFor(model => model.SupplierId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PO Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="POLocationId" class="form-control" Name="POLocationId"></select>
                                                            @Html.ValidationMessageFor(model => model.POLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Delivery Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="DeliveryLocationId" class="form-control" Name="DeliveryLocationId"></select>
                                                            @Html.ValidationMessageFor(model => model.DeliveryLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Delivery Address
                                                        </label>
                                                        <div class="col-md-8 col-sm-8 col-xs-12">
                                                            @Html.TextAreaFor(model => model.DeliveryAddress, new
                                                       {
                                                           @class = "form-control",
                                                           MaxLength = 100,
                                                           Placeholder = "Delivery Address",
                                                           style = "resize: none;"
                                                       })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Delivery Details
                                                        </label>
                                                        <div class="col-md-8 col-sm-8 col-xs-12">
                                                            @Html.TextAreaFor(model => model.DeliveryDetail, new
                                                       {
                                                           @class = "form-control",
                                                           MaxLength = 200,
                                                           style = "resize: none;",
                                                           Placeholder = "Delivery details"
                                                       })
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="form-horizontal col-md-6">

                                                    @{ // Get the current date in the "yyyy-MM-dd" format
                                                        string todayDate = DateTime.Now.ToString("yyyy-MM-dd");

                                                        string maxDate = DateTime.Now.ToString("yyyy-MM-dd"); ;

                                                        }



                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency  <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="CurrencyId" class="form-control" Name="CurrencyId"></select>
                                                            @Html.ValidationMessageFor(model => model.CurrencyId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Expected Delivery Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">

                                                            @Html.TextBoxFor(model => model.ExpectedDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.ExpectedDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date",
                                                           min = todayDate // Set the minimum date to today's date
                                                       })
                                                            @Html.ValidationMessageFor(model => model.ExpectedDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Validity Period <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">
                                                            <input id="ValidityPeriod" name="ValidityPeriod" type="number"
                                                                   required="required" min='0' value="0" onkeypress='return event.charCode >= 46'
                                                                   oninput="javascript: if (this.value.length >5) this.value = this.value.slice(0, 5);"
                                                                   class="form-control col-md-6 col-xs-6">
                                                            @Html.ValidationMessageFor(model => model.ValidityPeriod, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Term <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentTermId" class="form-control" Name="PaymentTermId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentTermId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Method <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentMethodId" class="form-control" Name="PaymentMethodId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentMethodId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style="display:none">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Period <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">
                                                            <input id="PaymentPeriod" name="PaymentPeriod" type="number" autocomplete="on" min="0"
                                                                   onkeypress='return event.charCode >= 46' value="0"
                                                                   oninput="javascript: if (this.value.length >5) this.value = this.value.slice(0, 5);"
                                                                   class="form-control col-md-6 col-xs-6">
                                                            @Html.ValidationMessageFor(model => model.PaymentPeriod, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            PO Date <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            @Html.TextBoxFor(model => model.PODate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.PODate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date",
                                                           min = todayDate, // Set the minimum date to today's date,
                                                           max = maxDate,
                                                           disabled = "disabled" // Disables the input field
                                                       })
                                                            @Html.ValidationMessageFor(model => model.PODate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Event<span class="required"></span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="EventId" class="form-control" Name="EventId"></select>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="clearfix"></div><br />
                                        <div id="step-2">

                                            <div id="trndetail" class="col-md-12 trn-detail">
                                                <br />
                                                @*<div class="col-md-12 col-sm-12">*@
                                                @*<div class="col-md-11">*@
                                                <div id="buttons">
                                                    <table id="buttons" class="table table table-striped" style="background-color:#f5f5f5">
                                                        <tr class="col-md-12">
                                                            <td>
                                                                Item/Material (UOM)
                                                            </td>
                                                            <td style="width:23%">
                                                                @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)Session["AllItemsToPO"], new
                                                                {
                                                                    @class = "form-control select2",
                                                                    @style = "width:100%"
                                                                })
                                                                @*<select id="ItemId" class="form-control select2" style="width:100%" name="ItemId"></select>*@
                                                            </td>
                                                            <td>
                                                                Order Quantity
                                                            </td>
                                                            <td>
                                                                <input id="RecQty" name="RecQty" step="any" type='number' min="0" value="0"  onkeypress='return validateInputForNumbers(event)' onkeyup="checkCostPrice()" class="form-control col-md-2 col-xs-6" />
                                                                <font color="red"><label id="validateqty" name="validateqty" style="font:small-caption"></label></font>
                                                            </td>
                                                            <td>
                                                                Cost Price
                                                            </td>
                                                            <td>
                                                                <input id="CostPrice" name="CostPrice" type='text' value="0" onkeypress='return validateInputForNumbers(event)' onkeyup="calcManualCostPrice()" class="form-control">
                                                            </td>
                                                            <td>
                                                                Cost Value
                                                            </td>
                                                            <td>
                                                                <input id="CostValue" readonly name="CostValue" type='text' value=@Model.TotCostPrice onkeypress='return validateInputForNumbers(event)' class="form-control">
                                                            </td>
                                                            <td>
                                                                <input type="button" id="btnAddPOItem" class="btn btn-round btn-info" value="+" />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                                @*</div>
                                                    <div class="col-md-1">*@
                                                <div id="btnAddReOrderItems">
                                                    <input type="button" id="btnAddReOrderLevelItems" class="btn btn-round btn-info pull-right"
                                                           value="Add Re Order Levels achived Items" />
                                                </div>
                                                <div id="btnAddRequestItems">                                               
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-2 ">
                                                            Request Note
                                                        </label>
                                                        <div class="col-md-6">
                                                            <select id="RequestNoteId" name="RequestNoteId" class="form-control"></select>
                                                        </div>
                                                        <input type="button" id="SelectRequestNote" name="SelectRequestNote" value="Select" class="btn btn-primary" />
                                                    </div>      
                                                </div>                                               
                                                </div><div class="clearfix"></div>
                                                @*</div>*@
                                                @*</div>*@
                                                <div id="headerPO">
                                                    <div class="text-info"><b>Purchasing Items</b></div>
                                                    <table id="tblRecepies" class="table table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th style="display:none">idx</th>
                                                                <th style="display:none">Item Id</th>
                                                                <th>Item</th>
                                                                <th >UOM</th>
                                                                <th>Quantity</th>
                                                                <th>Free Qty</th>
                                                                <th style="display:none">Unit Selling Price</th>
                                                                <th>Unit Cost Price</th>
                                                                <th>Cost Value</th>
                                                                @if (Convert.ToBoolean(Session["ConfigPOLineTax"]) == true)
                                                                {
                                                                    <th>Tax</th>
                                                                }
                                                                else
                                                                {
                                                                    <th style="display:none">Tax</th>
                                                                }
                                                                @*<th>Discounts</th>
                                                                    <th>Item Tax</th>*@
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="poitems">
                                                            @if (Model.PODetail != null || Model.PODetail.Count != 0)
                                                            {
                                                                foreach (var poDetail in Model.PODetail)
                                                                {
                                                            <tr>

                                                                <td style='display:none'><input name='PODetail.Index' type='hidden' value=@poDetail.ProductId /></td>
                                                                <td style="display:none"><input id='PODetail[@poDetail.ProductId]_ProductId' class='form-control' name='PODetail[@poDetail.ProductId].ProductId' type='text' readonly value=@poDetail.ProductId /></td>
                                                                <td id='PODetail[@poDetail.ProductId]_ProductName' name='PODetail[@poDetail.ProductId].ProductName'>@poDetail.ProductName</td>
                                                                @if (Model.POType == "Manual")
                                                                {
                                                                    <td ><input id='PODetail[@poDetail.ProductId]_UOM' class='form-control' name='PODetail[@poDetail.ProductId].UOM' readonly value='@poDetail.UOM' /></td>
                                                                    <td><input id='PODetail[@poDetail.ProductId]_OrderQty' type='hidden' class='form-control' name='PODetail[@poDetail.ProductId].OrderQty' readonly value=@Convert.ToDecimal(poDetail.RecQty) /></td>

                                                                }
                                                                else
                                                                {
                                                                    <td ><input id='PODetail[@poDetail.ProductId]_UOM' class='form-control' name='PODetail[@poDetail.ProductId].UOM' readonly value='@poDetail.UOM' /></td>
                                                                    <td><input id='PODetail[@poDetail.ProductId]_OrderQty' type='number' class='form-control' name='PODetail[@poDetail.ProductId].OrderQty' value=@Convert.ToDecimal(poDetail.RecQty) readonly onkeyup='checkCostPriceROLBased(@poDetail.ProductId)' /></td>

                                                                }
                                                                <td><input id='PODetail[@poDetail.ProductId]_FreeQty' oninput="javascript: if (this.value.length > 5) this.value = this.value.slice(0,5);" class='form-control' name='PODetail[@poDetail.ProductId].FreeQty' type='number' value=@Convert.ToDecimal(poDetail.FreeQty) /></td>
                                                                <td style="display:none"><input id='PODetail[@poDetail.ProductId]_SellingPrice' class='form-control' name='PODetail[@poDetail.ProductId].SellingPrice' type='text' readonly value=@poDetail.SellingPrice /></td>
                                                                <td><input id='PODetail[@poDetail.ProductId]_CostPrice' class='form-control' name='PODetail[@poDetail.ProductId].CostPrice' type='text' onkeyup='SetCostValue(@poDetail.ProductId)' value=@poDetail.CostPrice /></td>
                                                                <td><input id='PODetail[@poDetail.ProductId]_CostValue' class='form-control' name='PODetail[@poDetail.ProductId].CostValue' type='text' readonly value=@poDetail.CostValue /></td>
                                                                @if (Convert.ToBoolean(Session["ConfigPOLineTax"]) == true)
                                                                {
                                                                    <td><input id='PODetail[@poDetail.ProductId]_ItemTaxTotal' class='form-control' name='PODetail[@poDetail.ProductId].ItemTaxTotal' type='number' step="any" value=@poDetail.ItemTaxTotal onkeyup="SetTax(@poDetail.ProductId)" /></td>
                                                                }
                                                                else
                                                                {
                                                                    <td style="display:none"><input id='PODetail[@poDetail.ProductId]_ItemTaxTotal' class='form-control' name='PODetail[@poDetail.ProductId].ItemTaxTotal' type='text' readonly value=@poDetail.ItemTaxTotal /></td>
                                                                }
                                                                <td>
                                                                    <input id='btnAddPOItem1' type='button' value='-' class='btn btn-round btn-info' onclick='removePORow(this);' />
                                                                    <input id='btnAddPOItem1' type='button' value='-' class='btn btn-round btn-info' onclick='removePORow(this);' />
                                                                </td>
                                                                <td style="display:none"><input id='PODetail[@poDetail.ProductId]_CostPriceHidden' class='form-control' name='PODetail[@poDetail.ProductId].CostPriceHidden' type='text' value=@poDetail.CostPrice /></td>
                                                                <td style="display:none"><input id='PODetail[@poDetail.ProductId]_ReOrderQtyPriceHidden' class='form-control' name='PODetail[@poDetail.ProductId].ReOrderQtyPriceHidden' type='text' value=@Convert.ToDecimal(poDetail.OrderQty) /></td>

                                                            </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div id="summary">
                                                    <div style="display:none">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Selling Price <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                <input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0" class="form-control">
                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="form-group col-md-3">
                                                            <label class="control-label col-md-5 col-sm-6">
                                                                Total Cost Value <span class="required">*</span>
                                                            </label>
                                                            <div class="col-md-7 col-sm-6">
                                                                @Html.TextBoxFor(model => model.TotCostPrice, new
                                                               {
                                                                   @class = "form-control",
                                                                   @Type = "number",
                                                                   @readonly = true
                                                               })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="clearfix"></div><br />
                                        <div id="trnfooter" class="col-md-12 trn-footer">
                                            <br />
                                            <div id="step-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Gross Amount<span class="required">*</span>
