<script type="text/javascript">
    $("body").on("click",
        "#btnAddPOItem",
        function () {
            

            if ($("#POLocationId").val() == 0 || $("#POLocationId").val() == null) {
                alert("Select a PO Location !");
                return;
            }

            if ($("#ItemId").val() == 0 || $("#ItemId").val() == null) {
                alert("Select an Item !");
                return;
            }
            if ($("#RecQty").val() == 0 || $("#RecQty").val() == null) {
                alert("Invalid Quantity!");
                return;
            }
            var itemId = $("#ItemId").val();
            var itemDesc = $("#ItemId option:selected").text().split(" ")[0];        
            $("#SupplierId").attr("disabled","disabled");
          


            $.ajax({
                url: "@Url.Action("ApplyPOTaxes", "PO")",
                data: { id: $("#ItemId").val(), qty: $("#RecQty").val(), polocid: $("#POLocationId").val() },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                 //   debugger;

                    data = resp;


                    if (data.CostPrice == 0 && data.SellingPrice == 0) {
                        alert("Item: " + itemDesc + " is not exists in  location: " + $("#POLocationId option:selected").text());
                        return;
                    }


                    var table = document.getElementById("poitems");
                    var hasitem = '0';

                    // checking already exists
                    for (var r = 0, n = table.rows.length; r < n; r++)
                    {

                        var itemidcell = table.rows[r].cells[1].innerHTML;
                        var regex = /value="(\d+(\.\d+)*)/i;
                        var itemidex = itemidcell.match(regex)[1];
                        if (itemidex == itemId) {
                            hasitem = '1';
                        }

                    }
                    //  debugger;
                  

                    if (hasitem == '0') 
                    {
                        var unitindex = $("#poitems").children("tr").length;
                        var unitindexCell = "<td style='display:none'><input name='PODetail.Index'  value='" +
                            itemId + "' /></td>";

