    $("body").on("click", "#btnsubmit", function () {
        //Loop through the Table rows and build a JSON array.
        var button = $(this);
        button.prop("disabled", true);
        $("body").css("cursor", "wait");
        debugger;
        var POmodes = new Array();
        $("#tblTOG TBODY TR").each(function () {
            var row = $(this);
            console.log("row" + row);
            console.log("row doc" + row.find("TD").eq(2).html());
            var POMode = {};
            POMode.DocumentNo = row.find("TD").eq(2).html(); // Assuming DocumentNo is in the third column (index 2)

            console.log(" POMode.DocumentNo  " + POMode.DocumentNo );
            console.log("row  " + row);
            console.log(" row.find " + row.find("TD").eq(1).html());

            // POMode.RequestNoteAccptanceHeaderId = row.find("TD").eq(1).html();

            var index = row.find("TD").eq(1).html();
            console.log("Index value:", index); // Debugging line

            if (index) {
                // Check if index is a number string and handle it directly
                if (!isNaN(index)) {
                    POMode.requestnoteheaderid = index; // Assign directly if it's a number
                } else {
                    console.error("No match found in index:", index);
                }
            } else {
                console.error("Index is null or undefined");
            }
          
           // POMode.requestnoteheaderid = index.match(/value="(\d+(\.\d)*)/i)[1];



            console.log("RequestNoteAccptanceHeaderId " + POMode.requestnoteheaderid );


            // Find the checkbox within the row and check if it's checked
            var isChecked = row.find("input[type='checkbox']").prop("checked");

            // Assign the checked state to IsActive property
            POMode.IsActive = isChecked;

            POmodes.push(POMode);
        });

        //Send the JSON array to Controller using AJAX.
        $.ajax({
            type: "POST",
            url: "/Merge_PO_Request/Create",
            data: JSON.stringify(POmodes),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (r) {
                debugger
                // $("#CountryName").val(data.con);
                // $("#tblTaxModes TBODY TR").remove();
                $("body").css("cursor", "default");
                data = r;
                alert(data);
                window.location.href = "/Merge_PO_Request/Merge_PO";
            },
            error: function (error) {
                $("body").css("cursor", "default");
                alert("No Records Found");
                button.prop("disabled", false);
                window.location.href = "/Merge_PO_Request/Merge_PO";
            }
        });
    });

