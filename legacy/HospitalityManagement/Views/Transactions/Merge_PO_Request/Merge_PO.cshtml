<script>




     $.getJSON("@Url.Action("GetActiveShowRoomLocations", "Location")", function (data)
    {
         var poLocationId = $("#LocationId");

         poLocationId.empty();
         poLocationId.append("<option value='0'>-- All From Locations --</option>");

         $.each(JSON.parse(data), function (index, optionaldata) {
             poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

         });


         var poLocationIdTo = $("#LocationIdTo");

         poLocationIdTo.empty();
         poLocationIdTo.append("<option value='0'>--All To Locations --</option>");

         $.each(JSON.parse(data), function (index, optionaldata) {
             poLocationIdTo.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

         });
         var isHeadOffice = @Html.Raw(Json.Encode(Convert.ToBoolean(Session["IsHeadOffice"])));
        var locationId = '@ViewBag.locationId'; // Ensure locationId is correctly formatted

        if (!isHeadOffice) {
                var locationElement = document.getElementById("LocationId");
                if (locationElement) {
                    locationElement.disabled = true;
                    locationElement.value = locationId; // Set the value from ViewBag
                }
            }


         if ('@ViewBag.SelectFromLocation') {
             var SelectFromlocationId = '@ViewBag.SelectFromLocation';

             var locationElementFrom = document.getElementById("LocationId");
             if (locationElementFrom) {

                 locationElementFrom.value = SelectFromlocationId; // Set the value from ViewBag
             }
         }


          if ('@ViewBag.SelectToLocation') {
             var SelectTolocationId = '@ViewBag.SelectToLocation';

              var locationElementTo = document.getElementById("LocationIdTo");
              if (locationElementTo) {

                  locationElementTo.value = SelectTolocationId; // Set the value from ViewBag
             }
         }









         var drpStatus = $("#drpStatus");

         drpStatus.empty();
         drpStatus.append("<option value='0'> All Status</option>");
         drpStatus.append("<option value='1'> Pending to Generate PO </option>");
         drpStatus.append("<option value='2'> PO Generated </option>");


            if ('@ViewBag.SelectAppStatus') {
             var Select_AppStatus = '@ViewBag.SelectAppStatus';

             var drpStatusElement = document.getElementById("drpStatus");
             if (drpStatusElement) {

                 drpStatusElement.value = Select_AppStatus; // Set the value from ViewBag
             }
         }


