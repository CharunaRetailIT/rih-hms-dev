    function itemOverride(orrow, id) {


        var orrtable = document.getElementById("poitems");
        var regex = /value="(\d+(\.\d)*)/i;
        var indexval;

        for (var r = 0, n = orrtable.rows.length; r < n; r++) {
            var idcell = orrtable.rows[r].cells[1].innerHTML;
            var idval = idcell.match(regex)[1];
            if (idval == id) {

                var indexcell = orrtable.rows[r].cells[0].innerHTML;
                indexval = indexcell.match(regex)[1];

            }

        }
        var controlToBeRemoved = "#trPOItem" + indexval;
        $(controlToBeRemoved).remove();

        $("#poitems").append("<tr id='trPOItem" + indexval + "'>" + "<td style='display:none' ><input name='PODetail.Index' type='hidden' value='" +
                        indexval + "' /></td>" + orrow + "<td><input id='btnAddPOItem' type='button' value='-' class='btn btn-round btn-info'  onclick='removeUnitRow(" +
                        indexval + ");' /></td></tr>");


    }

</script>

