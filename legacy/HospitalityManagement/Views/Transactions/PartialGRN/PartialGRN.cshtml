@model HospitalityManagement.Models.Transactions.PurchaseHeader

@{
    ViewBag.Title = "Create Partial GRN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
@*<html lang="en">*@
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>



</head>



@if (ViewBag.Message != null)
{
    <script>

        $(document).ready(function () {

            alert('@ViewBag.ErrorMessage');

        });

    </script>

}
<div class="container body">
    <div class="main_container">
        @*@using (Html.BeginForm("CreatePO", "PO", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))*@
        @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>GRN</strong> @ViewBag.GRNCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>GRN</strong> @ViewBag.GRNCode save failed.
                        </div>
                    }

                    <div class="actionBar">
                        <div class="msgBox">

                            <div class="btn btn-primary pl_add btn-small pull-left">
                                @Html.ActionLink("Clear", "CreateGRN", null, new
                           {
                               @style = "font-size: 12px;color:white;" +
                                                            "font-family: 'Lucida Sans Unicode', " +
                                                            "'Lucida Grande', Sans-Serif;text-decoration: none"
                           })
                            </div>
                            <div class="btn btn-info pl_add btn-small pull-left">
                                @Html.ActionLink("View Temp GRN(s)", "ViewAllGRN", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                            </div>
                            <button type="submit" formaction="CreateGRN" class="btn btn-success pull-left">Submit GRN</button>
                            <button type="submit" formaction="TempSaveGRN" class="btn btn-primary pull-left">Temporary Save GRN</button>

                        </div>
                    </div>



                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Partial GRN</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">

                                    <div id="wizard" class="form_wizard wizard_horizontal">
                                        <ul class="wizard_steps">
                                            <li>
                                                <a href="#step-1">
                                                    <span class="step_no">1</span>
                                                    <span class="step_descr">
                                                        Step 1<br />
                                                        <small>Step 1 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-2">
                                                    <span class="step_no">2</span>
                                                    <span class="step_descr">
                                                        Step 2<br />
                                                        <small>Step 2 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-3">
                                                    <span class="step_no">3</span>
                                                    <span class="step_descr">
                                                        Step 3<br />
                                                        <small>Step 3 description</small>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#step-4">
                                                    <span class="step_no">4</span>
                                                    <span class="step_descr">
                                                        Step 4<br />
                                                        <small>Step 4 description</small>
                                                    </span>
                                                </a>
                                            </li>

                                        </ul>

                                        <div id="step-1">
                                            <div class="form-horizontal col-md-12">
                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Doc # <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            @Html.TextBoxFor(model => model.DocumentNo, new { @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Doc Number" })
                                                            @Html.ValidationMessageFor(model => model.DocumentNo, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Mode <span class="required">*</span>
                                                        </label>

                                                        <div class="col-md-6 col-sm-6 col-xs-12">

                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.GRNType, "Manual", new { @id = "Manual", @checked = true })
                                                                Manual

                                                            </div> <div class="clearfix"></div>
                                                            <div class="pull-left">
                                                                @Html.RadioButtonFor(m => m.GRNType, "POBased", new { @id = "Auto" })
                                                                PO Based

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="SupplierId" class="form-control" name="SupplierId" required="required"></select>
                                                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Supplier Invoice No
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            @*<input id="SupplierInvoiceNo" name="SupplierInvoiceNo" type="text" required="required"
                                                                class="form-control col-md-6 col-xs-6">*@

                                                            @Html.TextBoxFor(model => model.SupplierInvoiceNo, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           min = 0,
                                                           MaxLength = 20,

                                                       })
                                                            @Html.ValidationMessageFor(model => model.SupplierInvoiceNo, "", new { @class = "text-danger" })

                                                        </div>

                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Location <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                                            <select id="GRNLocationId" class="form-control" name="GRNLocationId" required="required"></select>
                                                            @Html.ValidationMessageFor(model => model.GRNLocationId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="form-horizontal col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency  <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="CurrencyID" class="form-control" name="CurrencyID"></select>
                                                            @Html.ValidationMessageFor(model => model.CurrencyID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Currency Rate <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-3 col-sm-6">

                                                            @Html.TextBoxFor(model => model.CurrencyRate, new
                                                       {
                                                           type = "number",
                                                           step = 0.01,
                                                           @class = "form-control",
                                                           value = "0",
                                                           min = "0",
                                                           onkeypress = "return event.charCode >= 46",
                                                           oninput = "javascript: if (this.value.length >6) this.value = this.value.slice(0, 5);"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.CurrencyRate, "", new { @class = "text-danger" })



                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Method <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentMethodId" class="form-control" name="PaymentMethodId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentMethodId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            Payment Term <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="PaymentTermId" class="form-control" name="PaymentTermId"></select>
                                                            @Html.ValidationMessageFor(model => model.PaymentTermID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3 col-sm-6">
                                                            GRNDate <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-6 col-sm-6">

                                                            @Html.TextBoxFor(model => model.GRNDate, new
                                                       {
                                                           @class = "form-control col-md-6 col-xs-6",
                                                           @Type = "date",
                                                           @Value = Model.GRNDate.ToString("yyyy-MM-dd"),
                                                           Placeholder = "Expected Date"
                                                       })
                                                            @Html.ValidationMessageFor(model => model.GRNDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        <div id="step-2">


                                            <div class="form-group">
                                                <div id="buttons">
                                                    <table id="buttons" class="table table table-striped">
                                                        <thead>
                                                            <tr>

                                                                <th></th>
                                                                <th></th>
                                                                <th></th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td style="width:10%">
                                                                    Item/Material (UOM)
                                                                </td>
                                                                <td>
                                                                    <select id="ItemId" class="form-control select2" style="width:90%" name="ItemId"></select>
                                                                </td>
                                                                <td style="width:10%">
                                                                    Quantity
                                                                </td>
                                                                <td style="width:20%">
                                                                    <input id="RecQty" name="RecQty" type="number" min='0' onkeypress='return event.charCode >= 46'
                                                                           @*onkeyup="checkProductQuantity()"*@
                                                                           oninput="javascript: if (this.value.length >5) this.value = this.value.slice(0, 5);"
                                                                           class="form-control col-md-2 col-xs-6">
                                                                    <font color="red"><label id="validateqty" name="validateqty" style="font:small-caption"></label></font>
                                                                </td>
                                                                <td>
                                                                    <input type="button" id="btnAddPOItem" class="btn btn-round btn-info" value="+" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div id="btnAddReOrderItems">
                                                    <table id="buttons1" class="table table table-striped">
                                                        <thead>
                                                            <tr>
                                                                <th></th>
                                                                <th></th>
                                                                <th></th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td style="width:10%">
                                                                    Purchase Order
                                                                </td>
                                                                <td>
                                                                    <select id="POID" name="POID" class="form-control select2" style="width:90%"></select>
                                                                </td>
                                                                <td>
                                                                    <input type="button" id="btnAddGRNItem" class="btn btn-round btn-info" value="+" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div id="btnAddRequestItems">

                                                </div>


                                                <div class="text-info"><b>GRN Items</b></div>

                                                <table id="tblRecepies" class="table table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            @*<th>idx</th>*@
                                                            <th style="display:none">Item Id</th>
                                                            <th>Item</th>
                                                            <th>Quantity</th>
                                                            <th>GRN Quantity</th>
                                                            <th>Free Qty</th>
                                                            <th>Discount</th>
                                                            <th>Cost Price (Unit)</th>
                                                            <th>Cost Value</th>
                                                            <th>Selling Price (Unit)</th>
                                                            <th>Tax</th>
                                                            @*<th>Tax</th>*@
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="grnitems">
                                                        @if (Model.GRNDetail != null)
                                                        {
                                                            foreach (var grnDetail in Model.GRNDetail)
                                                            {

                                                                @*<tr>

                                                                    <td style="display:none">@grnDetail.ProductID</td>
                                                                     <td>@grnDetail.ProductName</td>
                                                                     <th style="display:none">OrderQty</th>
                                                                     <td>@grnDetail.UOM</td>
                                                                     <td>@grnDetail.GRNQuantity</td>
                                                                     <td>@grnDetail.FreeQty</td>
                                                                     <td>@grnDetail.Discount</td>
                                                                     <td>@grnDetail.CostPrice</td>
                                                                     <td>@grnDetail.SellingPrice</td>
                                                                     <td>@grnDetail.TotalTax</td>

                                                                     </tr>*@

                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <hr />
                                            <div id="summary" class="col-lg-12">

                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-5 col-sm-6">
                                                            Total Selling Price <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-7 col-sm-6">
                                                            <input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0" class="form-control">

                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-5 col-sm-6">
                                                            Total Cost Value <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-7 col-sm-6">
                                                            <input id="TotCostPrice" name="TotCostPrice" type="number" readonly="readonly" value="0" class="form-control">

                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-5 col-sm-6">
                                                            Total Discounts <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-7 col-sm-6">
                                                            <input id="TotDiscounts" name="TotDiscounts" type="number" readonly="readonly" value="0" class="form-control">

                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-5 col-sm-6">
                                                            Total Tax <span class="required">*</span>
                                                        </label>
                                                        <div class="col-md-7 col-sm-6">
                                                            <input id="TotalTax" name="TotalTax" type="number" readonly="readonly" value="0" class="form-control">
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="step-3">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-6">
                                                        Gross Amount<span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-6 col-sm-6 col-xs-12">

                                                        @Html.TextBoxFor(model => model.GrossAmount, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true })
                                                        @Html.ValidationMessageFor(model => model.GrossAmount, "", new { @class = "text-danger" })


                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-6">
                                                        Discount Amount<span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-6 col-sm-6 col-xs-12">


                                                        @Html.TextBoxFor(model => model.DiscountAmount, new
                                                   {
                                                       @class = "form-control",
                                                       min = 0,
                                                       Type = "number",
                                                       decimals = "4",
                                                       step = 0.01,
                                                       onkeyup = "checkdiscounts()",
                                                       oninput = "javascript: if (this.value.length >10) this.value = this.value.slice(0,10);"
                                                   })
                                                        @Html.ValidationMessageFor(model => model.DiscountAmount, "", new { @class = "text-danger" })



                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-6">
                                                        Discount Percentage<span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-6 col-sm-6 col-xs-12">

                                                        @Html.TextBoxFor(model => model.DiscountPercentage, new
                                                   {
                                                       @class = "form-control",
                                                       min = 0,
                                                       Type = "number",
                                                       decimals = "4",
                                                       step = "any",
                                                       oninput = "javascript: if (this.value.length > 10) this.value = this.value.slice(0,10);"
                                                   })
                                                        @Html.ValidationMessageFor(model => model.DiscountPercentage, "", new { @class = "text-danger" })


                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-6">
                                                        Other Chargers<span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-6 col-sm-6 col-xs-12">

                                                        @Html.TextBoxFor(model => model.OtherChargers, new
                                                   {
                                                       @class = "form-control",
                                                       min = 0,
                                                       Type = "number",
                                                       decimals = "4",
                                                       step = "any",
                                                       oninput = "javascript: if (this.value.length > 10) this.value = this.value.slice(0, 10);",
                                                       onkeyup = "checkOtherChargers()",

                                                       //onkeyup = "change()",
                                                   })
                                                        @Html.ValidationMessageFor(model => model.OtherChargers, "", new { @class = "text-danger" })

                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-6">
                                                        Total Tax Amount<span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-6 col-sm-6 col-xs-12">

                                                        @Html.TextBoxFor(model => model.TotalTax, new { type = "number", @class = "form-control", MaxLength = 20, @readonly = true, Placeholder = "Total Tax" })
                                                        @Html.ValidationMessageFor(model => model.TotalTax, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-6">
                                                        Net Amount<span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-6 col-sm-6 col-xs-12">

                                                        @Html.TextBoxFor(model => model.NetAmount, new { type = "number", @class = "form-control", @readonly = true })
                                                        @Html.ValidationMessageFor(model => model.NetAmount, "", new { @class = "text-danger" })
                                                        <input data-val="true" id="NetAmountHidden" name="NetAmountHidden" type="hidden" />
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div id="step-4">



                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    Ref No<span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                    @Html.TextBoxFor(model => model.ReferenceNo, new { type = "text", @class = "form-control", MaxLength = 20 })
                                                    @Html.ValidationMessageFor(model => model.ReferenceNo, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-6">
                                                    Remark<span class="required">*</span>
                                                </label>
                                                <div class="col-md-6 col-sm-6 col-xs-12">
                                                    @Html.TextAreaFor(model => model.Remark, new { type = "text", @class = "form-control", MaxLength = 200 })
                                                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <div class="btn btn-primary pl_add btn-small pull-left">
                                                @Html.ActionLink("Clear", "CreateGRN", null, new
                                           {
                                               @style = "font-size: 12px;color:white;" +
                                                            "font-family: 'Lucida Sans Unicode', " +
                                                            "'Lucida Grande', Sans-Serif;text-decoration: none"
                                           })
                                            </div>
                                            <div class="btn btn-info pl_add btn-small pull-left">
                                                @Html.ActionLink("View Temp GRN(s)", "ViewAllGRN", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <button type="submit" formaction="CreateGRN" class="btn btn-success pull-left">Submit GRN</button>
                                            <button type="submit" formaction="TempSaveGRN" class="btn btn-primary pull-left">Temporary Save GRN</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="se-pre-con"></div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script src="~/vendors/bootstrap/dist/js/bootstrap.js"></script>
<script src="~/vendors/bootstrap/dist/js/bootstrap.min.js"></script>


<script>
    if(@ViewBag.POHeaderId!=null){

        var TeamDetailPostBackURL = '/GRN/Print';

        $(function () {
            debugger;
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var options = { "backdrop": "static", keyboard: true };
            $.ajax({
                type: "GET",
                url: TeamDetailPostBackURL,
                contentType: "application/json; charset=utf-8",
                data: { "id": @Model.PurchaseHeaderId },
                datatype: "json",
                success: function (data) {
                    debugger;
                    $('#myModalContent').html(data);
                    $('#myModal').modal(options);
                    $('#myModal').modal('show');

                },
                error: function () {
