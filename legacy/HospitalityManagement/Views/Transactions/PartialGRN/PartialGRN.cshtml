<script>
    function calcTotal(table) {
        var totsp = 0.0;
        var totcp = 0.0;
        var totdis = 0.0;
        var tottax = 0.0;
        var sellingval=0;
        var costval = 0.0;

        for (var r = 0, n = table.rows.length; r < n; r++)
        {





            var spvalue =document.getElementById('GRNDetail' + r + '_SellingPrice').value;
            totsp += Number(spvalue);

            var cpvalue =document.getElementById('GRNDetail' + r + '_CostPrice').value;
            totcp += Number(cpvalue);

            var costvalue =document.getElementById('GRNDetail' + r + '_CostValue').value;
            costval += Number(costvalue);

            var taxvalue =document.getElementById('GRNDetail' + r + '_TotalTax').value;
            tottax += Number(taxvalue);

            var qtyvalue =document.getElementById('GRNDetail' + r + '_GRNQuantity').value;
            sellingval+=spvalue*qtyvalue;




        }


        document.getElementById("TotSellingPrice").value = parseFloat(sellingval).toFixed(2);
        document.getElementById("TotCostPrice").value = parseFloat(costval).toFixed(2);
        document.getElementById("TotalTax").value = parseFloat(tottax).toFixed(2);

        document.getElementById("GrossAmount").value = parseFloat(
            //Number(document.getElementById("TotDiscounts").value) +
            Number(document.getElementById("TotCostPrice").value)

        ).toFixed(2);


        document.getElementById("NetAmount").value = parseFloat((tottax +
                //Number(document.getElementById("TotSellingPrice").value))
             Number(document.getElementById("TotCostPrice").value))
            //    -
            //Number(document.getElementById("TotDiscounts").value)
        ).toFixed(2);

        document.getElementById("NetAmountHidden").value = parseFloat(document.getElementById("NetAmount").value).toFixed(2);
    }
</script>

