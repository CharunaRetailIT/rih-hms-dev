<script src="~/vendors/jquery/dist/jquery.min.js"></script>


<script>
    debugger;
    if(@ViewBag.JournalId!=null){

        debugger;
        var TeamDetailPostBackURL = '/Journal/Print';

        $(function () {
           // debugger;
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var options = { "backdrop": "static", keyboard: true };
            $.ajax({
                type: "GET",
                url: TeamDetailPostBackURL,
                contentType: "application/json; charset=utf-8",
                data: { "locations":'@ViewBag.Locations',"date":'@Model.DateFrom.ToShortDateString()'},
                datatype: "json",
                success: function (data) {
                  //  debugger;
                    $('#myModalContent').html(data);
                    $('#myModal').modal(options);
                    $('#myModal').modal('show');

                },
                error: function () {
                    alert("Dynamic content load failed.");
                }
            });
        });
        $("#closbtn").click(function ()
        {
           // debugger;
            $('#myModal').modal('hide');
             // location.href='@Url.Action("CreatePO", null, new { })';
           // window.location.href = "/PO/CreatePO";
        });
    }
</script> 


<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var Locations = $("#Locations");

        Locations.empty();
        //Locations.append("<option value='0'>-- Select a Location --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            Locations.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@Model.Locations') {
            $('#Locations').val(@ViewBag.locations).trigger("change");
        } else {
            $('#Locations').val(0).trigger("change");
        }


    });


    @*document.getElementById('Date').Value=@ViewBag.Date;*@


    function PrintDiv() {
        var divContents = document.getElementById("datatable-responsive").innerHTML;
        var printWindow = window.open('', '', 'height=200,width=400');
        printWindow.document.write('<html><head><title></title>');
        printWindow.document.write('</head><body >');
        printWindow.document.write(divContents);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.print();

        $(document).ready(function () {
            $('#printcontent').DataTable();
        });
    }


</script>







