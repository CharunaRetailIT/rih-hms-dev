<script>
    function validateInputForNumbers(evt) {
        debugger;
        var theEvent = evt || window.event;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        } else {

            var key = theEvent.keyCode || theEvent.which;
            key = String.fromCharCode(key);
        }
        var regex = /[0-9]|\./;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }
</script>

<script>
    $.getJSON("@Url.Action("GetActiveSupplierGroups", "SupplierGroup")", function (data) {

        var supplierGroupDropDown = $("#SupplierGroupID");
        //var CompanyCodelist = $("#CompanyID");

        supplierGroupDropDown.empty();
        supplierGroupDropDown.append("<option value='0'>-- Select a Supplier Group --</option>");
        //CompanyCodelist.append("<option value='0'>-- Select a Company --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            supplierGroupDropDown.append($('<option />', { value: optionaldata.SupplierGroupID }).html(optionaldata.SupplierGroupName));

        });

        if ('@ViewBag.SupplierGroupID ') {
            $('#SupplierGroupID').val(@ViewBag.SupplierGroupID ).trigger("change");
        } else {
            $('#SupplierGroupID').val(0).trigger("change");
        }
    });
    
    $.getJSON("@Url.Action("GetActiveSupplierTypes", "Supplier")", function (data) {

        var supplierTypeDropDown = $("#SupplierTypeID");
