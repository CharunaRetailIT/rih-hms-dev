<script>
    window.onload = function () {
        var chkIsBlocked = document.getElementById("IsBlocked");
        chkIsBlocked.addEventListener('click', function () {
            if (chkIsBlocked.checked) {
                //$('#IsUpload').hide();
                //$('#IsSuspended').hide();
                //$('#IsPOMail').hide();
                //$('#IsDelete').hide();

                //$('#lblUpload').hide();
                //$('#lblSuspended').hide();
                //$('#lblPOMail').hide();
                //$('#lblDelete').hide();

                $("#IsUpload").prop("checked", false);
                $("#IsSuspended").prop("checked", false);
                $("#IsPOMail").prop("checked", false);
                $("#IsDelete").prop("checked", false);
            } else {
                //$('#IsUpload').show();
                //$('#IsSuspended').show();
                //$('#IsPOMail').show();
                //$('#IsDelete').show();
                
                //$('#lblUpload').show();
                //$('#lblSuspended').show();
                //$('#lblPOMail').show();
                //$('#lblDelete').show();
            }
        });

        if (chkIsBlocked.checked) {
            $('#IsUpload').hide();
            $('#IsSuspended').hide();
            $('#IsPOMail').hide();
            $('#IsDelete').hide();

            $('#lblUpload').hide();
            $('#lblSuspended').hide();
            $('#lblPOMail').hide();
            $('#lblDelete').hide();

            $("#IsUpload").prop("checked", false);
            $("#IsSuspended").prop("checked", false);
            $("#IsPOMail").prop("checked", false);
            $("#IsDelete").prop("checked", false);
        }
    }
