@model IEnumerable<RIT.HMS.Domain.Supplier>
@{
    ViewBag.Title = "ViewSuppliers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
                      <link href="~/Content/MasterFile.css" rel="stylesheet" />

@using (Html.BeginForm("", "Supplier", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<body class="nav-md">

    <div class="right_col" role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">

                        <div class="x_content">
                            <br />

                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Suppliers<small>Existing</small></h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                        @*<li class="dropdown">
                                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                                            <ul class="dropdown-menu" role="menu">
                                                <li>
                                                    <a href="#">Settings 1</a>
                                                </li>
                                                <li>
                                                    <a href="#">Settings 2</a>
                                                </li>
                                            </ul>
                                        </li>*@
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="form-group ">
                                    <div class="">

                                    </div>
                                    <div class="pull-right">
                                        <input type="submit" value="Download Data" formaction="HMSSupplier" class="btn btn-primary">
                                    </div>
                                </div><div class="clerfix"></div><br />
                                <div class="x_content"><br />
                                    @*<table id="datatable-responsive"
                                           class="table table-striped table-bordered dt-responsive nowrap">*@
                                    <table id="datatable-responsive" class="mstable col-xs-12 col-lg-12 col-md-12 col-sm-12">
                                        <thead>
                                            <tr>
                                                <th>Code</th>
                                                <th>Title</th>
                                                <th>Name</th>
                                                <th>Contact No</th>
                                                <th>Email</th>
                                                <th>Credit Limit</th>
                                                <th>Cheque Limit</th>
                                                <th>Is Active</th>
                                                <th>Supplier Type</th>
                                                <th>Supplier Group</th>
                                                <th></th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.SupplierCode)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.SupplierTitle)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.SupplierName)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.BillingTelephone)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.CreditLimit)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.ChequeLimit)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.IsBlocked)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.SuppliedProducts)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Remark)</td>
                                                    <td>@Html.ActionLink("Edit", "Edit", new { id = item.SupplierID })</td>
                                                    @*<td>@Html.ActionLink("View", "Details", new { id = item.SysGroupOfCompanyId })</td>*@
                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>


                        </div>
                    </div>
                    <div class="clerfix">
                        <div class="pull-left">
                            <input type="button" class="btn btn-info" value="Add Supplier" onclick="location.href='@Url.Action("Index", null, new { })'" />
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>


</body>

}