<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $.getJSON("@Url.Action("GetActiveRoomTypes", "RoomType")", function (data) {

        var roomTypeDropDown = $("#RoomType");
        //var CompanyCodelist = $("#CompanyID");

        roomTypeDropDown.empty();
        roomTypeDropDown.append("<option value='0'>-- Select a Room Type--</option>");
        //CompanyCodelist.append("<option value='0'>-- Select a Company --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            roomTypeDropDown.append($('<option />', { value: optionaldata.RstRoomTypeID }).html(optionaldata.RoomTypeName));

        });

        if ('@ViewBag.RoomTypeID') {
            $('#RoomType').val(@ViewBag.RoomTypeID).trigger("change");
        } else {
            $('#RoomType').val(0).trigger("change");
        }


    });


</script>