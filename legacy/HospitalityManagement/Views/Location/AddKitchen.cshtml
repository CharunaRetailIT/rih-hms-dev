@model RIT.HMS.Domain.KitchenAddToLocation

@{
    ViewBag.Title = "Add Kitchen To location";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

@if (ViewBag.Message != null)
{
    <script>

        $(document).ready(function () {

            alert('@ViewBag.ErrorMessage');

        });

    </script>

}
<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("AddKitchen", "Location",new { comId = Model.GeneralLocation.CompanyID, locationId = Model.GeneralLocation.SysLocationID }, FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">



                    <div class="clearfix"></div>
                    @if (@Session["MessageId"].ToString() == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Kitchen Locations</strong> @ViewBag.LocCode saved successfully.
                        </div>
                    }
                    else if (@Session["MessageId"].ToString() == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Kitchen Locations</strong> @ViewBag.LocCode save failed.
                        </div>
                    }
                    else if (@Session["MessageId"].ToString() == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Kitchen Locations</strong> @ViewBag.LocCode already exists.
                        </div>
                    }


                    else if (@Session["MessageId"].ToString() == "4")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>@Session["Message"].ToString()</strong>
                        </div>
                    }

                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Assign Kitchens to Location</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />

                                    <div class="form-horizontal form-label-left col-md-12 text-right">

                                        <div class="form-group">
                                            <div class="col-md-5"></div>
                                            <label class="control-label col-md-3">General Location</label>
                                            <div class="col-md-4 ">
                                                @Html.TextBoxFor(model => Model.GeneralLocation.LocationName, new { @class = "form-control", @readOnly = true })
                                                @Html.HiddenFor(model => Model.GeneralLocation.SysLocationID, new { @class = "form - control", })
                                                @Html.HiddenFor(model => Model.GeneralLocation.GroupOfCompanyID, new { @class = "form - control", })
                                                @Html.HiddenFor(model => Model.GeneralLocation.CompanyID, new { @class = "form - control", })
                                                @Html.HiddenFor(model => model.GeneralLocationId, new { @class = "form - control", })
                                                @Html.ValidationMessageFor(model => model.GeneralLocationId, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12" style="padding: 19px;">

                                                <div class="panel panel-default">
                                                    <div class="panel-heading">
                                                        <h3 class="panel-title text-left">
                                                            Select Kitchen Location
                                                        </h3>
                                                    </div>
                                                    <ul class="list-group" id="LocationPanel">
                                                        <li class="list-group-item text-left">
                                                            <div class="row">
                                                                <div class="col-md-4">
                                                                    <b>Select Location</b>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <b>Location Name</b>
                                                                </div>
                                                                <div class="col-md-2" style="display:none">
                                                                    <b>Is Active</b>
                                                                </div>
                                                            </div>
                                                        </li>
                                                        @for (int a = 0; a <= Model.KitchenLocationList.Count - 1; a++)
                                                        {
                                                            <li class="list-group-item text-left">
                                                                <div class="row">
                                                                    <div class="col-md-4">
                                                                        @Html.CheckBoxFor(model => Model.KitchenLocationList[a].IsSelectLocation, new { @class = "", @id = "checkbox1" })
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        @Model.KitchenLocationList[a].LocationName
                                                                        @Html.HiddenFor(model => Model.KitchenLocationList[a].SysLocationID, new { @class = "" })
                                                                        @Html.HiddenFor(model => Model.KitchenLocationList[a].LocationName, new { @class = "" })
                                                                    </div>
                                                                    <div class="col-md-2" style="display:none">
                                                                        @Html.CheckBoxFor(model => Model.KitchenLocationList[a].IsSelectLocationIsActive, new { @class = "", @id = "checkbox2" })
                                                                    </div>
                                                                </div>
                                                            </li>
                                                        }

                                                    </ul>
                                                </div>




                                            </div>
                                        </div>


                                    </div>

                                    <div class="clearfix"></div>

                                    <div class="actionBar">
                                        <div class="msgBox">

                                            <div class="btn btn-info pl_add btn-small pull-left">
                                                @Html.ActionLink("View All", "AssignKitchens", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <button type="submit" class="btn btn-success">Modify</button>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        RealCheckBox();

        $('#LocationPanel li #checkbox1').change(function () {
            var getche2 = $(this).parent().parent().find('#checkbox2');
            console.log(getche2);
            if (this.checked) {
                getche2.show();
            }
            else {
                getche2.hide();
            }

        });
      
        function RealCheckBox() {
            $('#LocationPanel li').each(function () {
                console.log($(this).html());
;                var che1 = $(this).find('#checkbox1');
                var che2 = $(this).find('#checkbox2');
                if (che1.is(":checked")) {
                    che2.show();
                }
                else {
                    che2.hide();
                }
            })
        }
    });
</script>