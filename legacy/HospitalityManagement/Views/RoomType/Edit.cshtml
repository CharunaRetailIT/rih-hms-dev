@model RIT.HMS.Domain.RstRoomType
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System </title>

</head>
@*<body class="nav-md">*@
<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm("Edit", "RoomType", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.RstRoomTypeID)
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @if (@ViewBag.Message == "1")
                            {
                                <div class="alert alert-success alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Room Type</strong> @ViewBag.RoomTypeCode modified successfully.
                                </div>
                            }
                            else if (@ViewBag.Message == "2")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Room Type</strong> @ViewBag.RoomTypeCode failed to modify.
                                </div>
                            }
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Room Type - Edit</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                       
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <br />
                                    <form class="form-horizontal form-label-left">
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Room Type Code</label>
                                            <div class="col-md-5 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.RoomTypeCode,
                                               new
                                               {
                                                   @class = "form-control",
                                                   MaxLength = 50,
                                                   Placeholder = "Room Type Code",
                                                   @readonly=true
                                               })
                                                @Html.ValidationMessageFor(model => model.RoomTypeCode, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Room Type Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.RoomTypeName, new { @class = "form-control", MaxLength = 50, Placeholder = "Room Type Name" })
                                                @Html.ValidationMessageFor(model => model.RoomTypeName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Bed Type</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.BedType, new { @class = "form-control", MaxLength = 50, Placeholder = "Bed Type" })
                                                @Html.ValidationMessageFor(model => model.BedType, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Max Adult</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.MaxAdult, new { @class = "form-control", MaxLength = 50, Placeholder = "Max Adult" })
                                                @Html.ValidationMessageFor(model => model.MaxAdult, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Max Child</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.MaxChild, new { @class = "form-control", MaxLength = 50, Placeholder = "Max Child" })
                                                @Html.ValidationMessageFor(model => model.MaxChild, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Max Infant</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.MaxInfant, new { @class = "form-control", MaxLength = 50, Placeholder = "Max Infant" })
                                                @Html.ValidationMessageFor(model => model.MaxInfant, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">A/C</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsAC, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Smorking</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsSmoking, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">MiniBar</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsMiniBar, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Normal View</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsNormalView, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Ocean View</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsOceanView, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Landside</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsLandside, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Balcony</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsBalcony, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">IsActive</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">IsDelete</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                            </div>
                                        </div>


                                        @*<div class="ln_solid"></div>*@ <br />
                                        <div class="actionBar">
                                            <div class="msgBox">

                                                <div class="btn btn-primary pl_add btn-small pull-left">
                                                    @Html.ActionLink("Reset", "Edit", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                                <div class="btn btn-info pl_add btn-small pull-left">
                                                    @Html.ActionLink("View All", "ViewRoomTypes", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                                <button type="submit" class="btn btn-success">Modify</button>

                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>


<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    @*$.getJSON("@Url.Action("GetUserGroup", "UserGroup")", function (data) {

        var companyDropDown = $("#SysUserGroupID");

        usergroupDropDown.empty();
        usergroupDropDown.append("<option value='0'>-- Select the User Group --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            usergroupDropDown.append($('<option />', { value: optionaldata.SysUserGroupID }).html(optionaldata.UserGroupName));
        });*@

    if ('@ViewBag.SysUserGroupID') {
        $('#SysGroupOfCompanyId').val(@ViewBag.SysUserGroupID).trigger("change");
    } else {
        $('#SysUserGroupID').val(0).trigger("change");
    }


    //});


</script>



