@model RIT.HMS.Domain.SysUserMaster
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Change Password </title>

</head>
@*/<body class="nav-md">*@
<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm("ChangePassword", "UserMaster", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.SysUserMasterID)

            @*@Html.HiddenFor(model => model.ConfirmPassword)
            @Html.HiddenFor(model => model.Password)*@


            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-8 col-sm-8 col-xs-8">
                            @if (@ViewBag.Message == "1")
                            {
                                <div class="alert alert-success alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                  Password change sucessfully!
                                </div>
                            }
                            else if (@ViewBag.Message == "0")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                  Can not Change the Password!
                                </div>
                            }
                            else if (@ViewBag.Message == "2")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong></strong> Passwords did not matched!
                                </div>
                            }
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>User - Change Password</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                        
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <br />
                                    <form class="form-horizontal form-label-left">


                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">User Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", MaxLength = 50, Placeholder = "User Name", @readonly=true })
                                                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Old Password</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.PasswordFor(model => model.OldPassword, new { @class = "form-control", MaxLength = 50, Placeholder = "Old Password" })
                                                @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">New Password</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.PasswordFor(model => model.Password, new { @class = "form-control", MaxLength = 50, Placeholder = "New Password" })
                                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Confirm Password</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", MaxLength = 50, Placeholder = "Confirm Password" })
                                                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })

                                            </div>
                                        </div>

                                        <br />
                                        <div class="actionBar">
                                            <div class="msgBox">

                                         
                                                <div class="btn btn-info pl_add btn-small pull-left">
                                                    @Html.ActionLink("Reset", "ChangePassword", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                                <button type="submit" class="btn btn-success">Change Password</button>

                                            </div>
                                        </div>


                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>


<script src="~/vendors/jquery/dist/jquery.min.js"></script>





