@model RIT.HMS.Domain.SysGroupOfCompany
@{
    ViewBag.Title = "Group Of Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>

</head>

<body class="nav-md">
    <div class="container body">
        <div class="main_container">
            @using (Html.BeginForm("Edit", "GroupOfCompany", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.SysGroupOfCompanyId)
            <!-- page content -->
                <div class="right_col" role="main">
                    <div class="">

                        <div class="clearfix"></div>
                        @if (@ViewBag.Message == "1")
                        {
                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Group of Company</strong> @ViewBag.GOCCode modified successfully.
                            </div>
                        }
                        else if (@ViewBag.Message == "2")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Group of Company</strong> @ViewBag.GOCCode failed to modify.
                            </div>
                        }
                        else if (@ViewBag.Message == "4")
                        {
                            <div class="alert alert-warning alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                Can't be select Active and Delete options in the same time..!
                            </div>
                        }

                        <div class="row">

                            <!-- form input mask -->
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Group of Company - Edit</h2>
                                        <br />

                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                          
                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>
                                    <div class="x_content">
                                        <br />
                                        <form class="form-horizontal form-label-left">
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Group of Company Code</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.GroupOfCompanyCode,
                                                   new
                                                   {
                                                       @class = "form-control",
                                                       MaxLength = 10,
                                                       Placeholder = "Company Code",
                                                       @readonly = true,
                                                       onkeypress = "return checkCodeTypeInput(event)"
                                                   })
                                                    @Html.ValidationMessageFor(model => model.GroupOfCompanyCode, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Group of Company Name</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.GroupOfCompanyName, new { @class = "form-control", MaxLength = 50, Placeholder = "Company Name" })
                                                    @Html.ValidationMessageFor(model => model.GroupOfCompanyName, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Company Email</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.CompanyGmail, new
                                               {
                                                   @class = "form-control",
                                                   Type = "email",
                                                   Placeholder = "Company E Mail",
                                                   MaxLength = 100,
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.CompanyGmail, "", new { @class = "text-danger pull-left" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Company Vat Number</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.CompanyVatNumber, new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Company Vat No",
                                                   MaxLength = 50,
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.CompanyVatNumber, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsActive</label>
                                                <div class="checkbox col-xs-1 pull-left ">

                                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsDelete</label>
                                                <div class="checkbox col-xs-1 pull-left ">

                                                    @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })

                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Company Logo</label>
                                                <div class="col-xs-1 pull-left">

                                                    <input type="file" id="File" name="File" class="flat" />
                                                    @ViewBag.FileName
                                                    @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger pull-left" })
                                                </div>
                                            </div>
                                            <br />
                                            <div class="actionBar">
                                                <div class="msgBox">

                                                    <div class="btn btn-primary pl_add btn-small pull-left">
                                                        @Html.ActionLink("Reset", "Edit", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    <div class="btn btn-info pl_add btn-small pull-left">
                                                        @Html.ActionLink("View All", "ViewGroupOfCompanies", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    <button type="submit" class="btn btn-success">Modify</button>

                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>


</body>
</html>
