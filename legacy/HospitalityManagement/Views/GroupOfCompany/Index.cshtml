<body class="nav-md">
    <div class="container body">
        <div class="main_container">
            @using (Html.BeginForm("Create", "GroupOfCompany", FormMethod.Post, 
                new { @class = "form-horizontal", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
            <!-- page content -->
                <div class="right_col" role="main">
                    <div class="">

                      
                        <div class="clearfix"></div>
                        @if (@ViewBag.Message == "1")
                        {
                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Group of Company</strong> @ViewBag.GOCCode saved successfully.
                            </div>
                        }
                        else if (@ViewBag.Message == "2")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Group of Company</strong> @ViewBag.GOCCode save failed.
                            </div>
                        }
                        else if (@ViewBag.Message == "3")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Group of Company</strong> @ViewBag.GOCCode already exists.
                            </div>
                        }
                        else if (@ViewBag.Message == "4")
                        {
                            <div class="alert alert-warning alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Group of Company</strong> Can't be select Active and Delete options in the same time..!
                            </div>
                        }
                        <div class="row">

                            <!-- form input mask -->
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Group of Company</h2>
                                        <br />

                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                           
                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>
                                    <div class="x_content">
                                        <br />
                                        <form class="form-horizontal form-label-left">
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Group of Company Code</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.GroupOfCompanyCode,
                                                   new {
                                                       @class = "form-control",
                                                       MaxLength = 10,
                                                       Placeholder = "Company Code",
                                                       onkeypress = "return checkCodeTypeInput(event)"
                                                   }
                                                    )
                                                    @Html.ValidationMessageFor(model => model.GroupOfCompanyCode, "", new { @class = "text-danger pull-left" })
                                             
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Group of Company Name</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.GroupOfCompanyName,
                                                    new { @class = "form-control",
                                                        MaxLength = 50,
                                                        Placeholder = "Company Name",
                                                     //   onkeypress = "return checkNameTypeInput(event)"
                                                    }
                                                        )
                                                    @Html.ValidationMessageFor(model => model.GroupOfCompanyName, "", new { @class = "text-danger pull-left" })
                                            
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Company Email</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.CompanyGmail, new
                                               {
                                                   @class = "form-control",
                                                   Type = "email",
                                                   Placeholder = "Company E Mail",
                                                   MaxLength = 100,
                                                   //onkeypress = "return checkNameTypeInput(event)"
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.CompanyGmail, "", new { @class = "text-danger pull-left" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Company Vat Number</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.CompanyVatNumber, new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Company Vat No",
                                                   MaxLength = 50,
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.CompanyVatNumber, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <div class="form-group" style="display:none;">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsActive</label>
                                                <div class="checkbox col-xs-1 pull-left ">                                                  
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })
                                                </div>
                                            </div>

                                            <div class="form-group" style="display:none;">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsDelete</label>
                                                <div class="checkbox col-xs-1 pull-left ">                                                
                                                    @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Company Logo</label>
                                                <div class="col-xs-1 pull-left">
                                                    <input type="file" id="File" name="File" class="flat " />
                                                    @ViewBag.FileName
                                                    @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                           <br />
                                            <div class="actionBar">
                                                <div class="msgBox">                             
                                                    <div class="btn btn-primary pl_add btn-small pull-left">
                                                        @Html.ActionLink("Clear", "Index", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    <div class="btn btn-info pl_add btn-small pull-left">
                                                        @Html.ActionLink("View All", "ViewGroupOfCompanies", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    @if (Convert.ToBoolean(Session["CreateGroupOfCompanies"]) == true)
                                                    {
                                                    <button type="submit" class="btn btn-success">Submit</button>  
                                                    }
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>

  
    
    @*<!-- jQuery -->
        <script src="../vendors/jquery/dist/jquery.min.js"></script>
        <!-- Bootstrap -->
        <script src="../vendors/bootstrap/dist/js/bootstrap.min.js"></script>
        <!-- FastClick -->
        <script src="../vendors/fastclick/lib/fastclick.js"></script>
        <!-- NProgress -->
        <script src="../vendors/nprogress/nprogress.js"></script>
        <!-- bootstrap-daterangepicker -->
        <script src="../vendors/moment/min/moment.min.js"></script>
        <script src="../vendors/bootstrap-daterangepicker/daterangepicker.js"></script>
        <!-- bootstrap-datetimepicker -->
        <script src="../vendors/bootstrap-datetimepicker/build/js/bootstrap-datetimepicker.min.js"></script>
        <!-- Ion.RangeSlider -->
        <script src="../vendors/ion.rangeSlider/js/ion.rangeSlider.min.js"></script>
        <!-- Bootstrap Colorpicker -->
        <script src="../vendors/mjolnic-bootstrap-colorpicker/dist/js/bootstrap-colorpicker.min.js"></script>
        <!-- jquery.inputmask -->
        <script src="../vendors/jquery.inputmask/dist/min/jquery.inputmask.bundle.min.js"></script>
        <!-- jQuery Knob -->
        <script src="../vendors/jquery-knob/dist/jquery.knob.min.js"></script>
        <!-- Cropper -->
        <script src="../vendors/cropper/dist/cropper.min.js"></script>
        <!-- Custom Theme Scripts -->
        <script src="../build/js/custom.min.js"></script>*@

