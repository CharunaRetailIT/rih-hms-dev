    var Giftvouchergroupload = function () {

        $.getJSON("@Url.Action("GetGiftvoucherGroup", "GiftVoucherMaster")", function (data) {
            var GiftVoucherGroupCode = $("#GiftVoucherGroupCode");
            GiftVoucherGroupCode.empty();
            GiftVoucherGroupCode.append("<option value='0'>-- Select Group --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                GiftVoucherGroupCode.append($('<option />', { value: optionaldata.GiftVoucherGroupCode }).html(optionaldata.GiftVoucherGroupCode));


            });
            if ('@ViewBag.GiftVoucherGroupCode') {

                $('#GiftVoucherGroupCode').val(@ViewBag.GiftVoucherGroupCode).trigger("change");

            } else {
                $('#GiftVoucherGroupCode').val(0).trigger("change");

            }

        });
    }

    var GVsupplier = function () {

        $.getJSON("@Url.Action("GetGiftvoucherSupplier", "GiftVoucherPurchaseOrder")", function (data) {
            var SupplierID = $("#SupplierID");
            SupplierID.empty();
            SupplierID.append("<option value='0'>-- Select Supplier --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                SupplierID.append($('<option />', { value: optionaldata.SupplierCode }).html(optionaldata.SupplierName));
            });
            if ('@ViewBag.SupplierID') {

                $('#SupplierID').val(@ViewBag.SupplierID).trigger("change");

            } else {
                $('#SupplierID').val(0).trigger("change");

            }

        });
    }

    var LoadPaymentTerm = function () {

        $.getJSON("@Url.Action("GetPaymentTerm", "GiftVoucherPurchaseOrder")", function (data) {
            var PaymentTerm = $("#PaymentTerm");
            PaymentTerm.empty();
            PaymentTerm.append("<option value='0'>-- Select --</option>");
