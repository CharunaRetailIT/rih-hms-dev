@model IEnumerable<RIT.HMS.Domain.Employee>
@{
    ViewBag.Title = "View Cashiers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/MasterFile.css" rel="stylesheet" />
@using (Html.BeginForm("", "CashierMaster", FormMethod.Post, new { @class = "form-horizontal" }))
{
<body class="nav-md">

    <div class="right_col" role="main" id="bgt">
        <div class="">
            <div class="clearfix"></div>
            @if (@ViewBag.ViewMessage == "2")
            {
                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                    <strong>User Master</strong>- User code  @ViewBag.UMID is already exists.
                </div>
            }
            @if (@ViewBag.ViewMessage == "3")
            {
                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                    <strong>User Master</strong>- User code  @ViewBag.UMID is saved.
                </div>
            }
            <div class="row">
                <!-- form input mask -->
                <div class="col-md-12 col-sm-12 col-xs-12">

                    <div class="x_panel" id="test1">

                        <div class="x_content">
                            <br />

                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Cashiers<small>Existing</small></h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                        @*<li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                                <ul class="dropdown-menu" role="menu">
                                    <li>
                                        <a href="#">Settings 1</a>
                                    </li>
                                    <li>
                                        <a href="#">Settings 2</a>
                                    </li>
                                </ul>
                            </li>*@
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="form-group ">
                                    <div class="">

                                    </div>
                                    <div class="pull-right">
                                        <input type="submit" value="Download Data" formaction="HMSCashiers" class="btn btn-primary">
                                    </div>
                                </div><div class="clerfix"></div><br />
                                <div class="x_content"><br />
                                    @*<table id="datatable-responsive"
                        class="table table-striped table-bordered dt-responsive nowrap">*@
                                    <table id="datatable-responsive" class="mstable col-xs-12 col-lg-12 col-md-12 col-sm-12">
                                        <thead>
                                            <tr>
                                                <th>Code</th>
                                                <th>POS User Name</th>
                                                <th>Location</th>
                                                <th></th>
                                                @*<th>IsActive</th>
                                                  <th>IsDelete</th>
                                                  <th></th>*@
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (Model != null)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@Html.DisplayFor(modelItem => item.EmployeeCode)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.EmployeeName)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.LocationName)</td>
                                                        @*<td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.IsDelete)</td>*@
                                                        <td>@Html.ActionLink("Edit", "EditCashier", "CashierMaster", new { code = item.EmployeeCode, id = item.EmployeeID }, null)</td>
                                                        @*<td>@Html.ActionLink("View", "Details", new { id = item.SysGroupOfCompanyId })</td>*@
                                                    </tr>
                                                }
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="clerfix">
                            <div class="btn btn-info pl_add btn-small pull-left">
                                @Html.ActionLink("Create/Remove Cashier Permissions", "CreateCashier", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>

}

