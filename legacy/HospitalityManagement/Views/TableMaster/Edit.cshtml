<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var locationId = $("#LocationId");

        locationId.empty();
        locationId.append("<option value='0'>-- Select a Location --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            locationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.LocationId')
        {
            $('#LocationId').val(@ViewBag.LocationId).trigger("change");
        } else
        {
            $('#LocationId').val(0).trigger("change");
        }


    });


</script>

<script>


    $.getJSON("@Url.Action("GetActiveInterDepartments", "RequestNote")", function (data) {

        var InterDeptId = $("#InterDeptId");

        InterDeptId.empty();
        InterDeptId.append("<option value='0'>-- Select a Department --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            InterDeptId.append($('<option />', { value: optionaldata.InterDepartmentId }).html(optionaldata.InterDepartmentName));

        });

        if ('@ViewBag.InterDeptId') {
            $('#InterDeptId').val(@ViewBag.InterDeptId).trigger("change");
        } else {
            $('#InterDeptId').val(0).trigger("change");
        }


    });



</script>



