<script>
    $.getJSON("@Url.Action("GetActiveCustomerCategories", "Customer")", function (data) {

        var CustomerCategoryId = $("#CustomerCategoryId");
        CustomerCategoryId.empty();
        CustomerCategoryId.append("<option value='0'>-- Select a Group --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            CustomerCategoryId.append($('<option />', { value: optionaldata.CustomerCategoryID }).html(optionaldata.CustomerCategoryName));

        });

        if ('@ViewBag.CustomerCategoryId') {
            $('#CustomerCategoryId').val('@ViewBag.CustomerCategoryId').trigger("change");
        } else {
            $('#CustomerCategoryId').val(0).trigger("change");
        }
    });

