<script type="text/javascript">
    function checkCustomerCode()
    {
        document.getElementById('validatecode').innerHTML = '';

        $.ajax({
            url: "@Url.Action("CheckCustomerCode", "Customer")",
            data: { code: $("#CustomerCode").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {
                data = resp;
                if (resp != null || resp != "") {
                    document.getElementById('validatecode').innerHTML = "Customer Code Already Exists";
                } else
                {
                    document.getElementById('validatecode').innerHTML = "";
                }

            }
        });


    }
</script>

<script type="text/javascript">
    function ValidateCardNo()
    {
        document.getElementById('validatecard').innerHTML = '';

        $.ajax({
            url: "@Url.Action("ValidateCardNumber", "CardNumberGeneration")",
            data: { cardnumber: $("#CardNumber").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {
                data = resp;
                if (resp == 1)
                {
                    document.getElementById('validatecard').innerHTML = "Card number is not generated";
                    $("#IsCardValid").val(false);

                } else if(resp == 2)
                {
                    document.getElementById('validatecard').innerHTML = "Card number already issued";
                    $("#IsCardValid").val(false);

                } else if (resp == 3)
                {
                    document.getElementById('validatecard').innerHTML = "";
                    $("#IsCardValid").val(true);
                }

            }
        });


    }
</script>