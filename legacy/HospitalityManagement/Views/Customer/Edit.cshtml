<script type="text/javascript">
    //document.getElementById("WeddingAnniversary").required = false;
    function checkDOB() {
        var dateString = document.getElementById('DOB').setAttribute("max", today);;
        var myDate = new Date(dateString);
        var today = new Date();
        if (myDate > today) {
            $('#DOB').after('<p>You cannot enter a BOD in the future!.</p>');
            return false;
        }
        return true;
    }
</script>
