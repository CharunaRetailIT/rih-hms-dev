@model RIT.HMS.Domain.Customer

@{
    ViewBag.Title = "Edit Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
@*<html lang="en">*@
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>


    <script src="~/vendors/jquery/dist/jquery.min.js"></script>
</head>


<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Edit", "Customer", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CustomerID);
            @Html.HiddenFor(model => model.IsCardValid);
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">



                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Customer</strong> @ViewBag.CustCode modified successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Customer</strong> @ViewBag.CustCode failed to modify.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Can't be select Active and Delete options in the same time..!
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Loyalty customers must have a Loyalty Card Number.
                        </div>
                    }
                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please entere a valid card number.
                        </div>
                    }


