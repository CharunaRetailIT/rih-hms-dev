    function checkDiscountAmount() {
        var Dis = $("#DiscountPrc");
        $("#CustomerSellingPrice").val("0.00");
        if (Dis.val() > 0) {
            alert("Can't apply discount percentage with discount amount for the same item..!");
            $("#DiscountAmount").val("0.00");
            return;
        }
        var strDiscountAmount = $("#DiscountAmount").val();
        var strFreesellingprice = $("#freesellingprice").val();
        if ((Number(strFreesellingprice) - Number(strDiscountAmount)) < 0) {
            alert("Can't apply discount amount more than selling price for the item..!");
            $("#DiscountAmount").val("0.00");
        }
        if ((Number(strFreesellingprice) - Number(strDiscountAmount)) > 0) {
            $("#CustomerSellingPrice").val(parseFloat(Number(strFreesellingprice) - Number(strDiscountAmount)).toFixed(2));
        }
    }

    function checkDiscountPercentage() {
        var Dis = $("#DiscountAmount");
        $("#CustomerSellingPrice").val("0.00");
        if (Dis.val() > 0) {
            alert("Can't apply discount amount with discount percentage for the same item..!");
            $("#DiscountPrc").val("0.00");
            return;
        }
        var DisPer = $("#DiscountPrc");
        if (DisPer.val() > 100) {
            $("#DiscountPrc").val("100.00");
            return;
        }
        var strDiscountPrc = $("#DiscountPrc").val();
        var strFreesellingprice = $("#freesellingprice").val();
        $("#CustomerSellingPrice").val(parseFloat(Number(strFreesellingprice) - (Number(strFreesellingprice) * (Number(strDiscountPrc) / 100))).toFixed(2));
    }

