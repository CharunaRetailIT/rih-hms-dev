@model RIT.HMS.Domain.TourAgent
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Create", "TourAgent", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @*@Html.HiddenFor(m => m.IsTourAgent)*@
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Tour Agent</strong> @ViewBag.TourAgentCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Tour Agent</strong> @ViewBag.TourAgentCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Tour Agent</strong> @ViewBag.TourAgentCode already exists.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Can't be select Active and Delete options in the same time..!
                        </div>
                    }
                   
                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Please entere a valid card number.
                        </div>
                    }
                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Tour Agent</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />

                                    <div class="form-horizontal form-label-left col-md-6">
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Tour Agent Code</label>
                                            <div class="col-md-3 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.AgentCode,
                                               new
                                               {
                                                   @class = "form-control",
                                                   MaxLength = 5,
                                                   Placeholder = "Code",
                                                   onkeyup = "CheckTourAgentCode()",
                                                   onkeypress = "return checkCodeTypeInput(event)"
                                               })
                                                @Html.ValidationMessageFor(model => model.AgentCode, "", new { @class = "text-danger pull-left" })
                                            </div>
                                            <font color="red" class="col-md-5">
                                                <label id="validatecode" name="validatecode" style="font:small-caption"></label>
                                            </font>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Title</label>
                                            <div class="col-md-3 col-sm-9 col-xs-9">
                                                <select id="TourAgentTitle" name="TourAgentTitle" class="form-control">
                                                    @*<option value="0">-Title-</option>*@
                                                    <option value="Mr">Mr.</option>
                                                    <option value="Mrs">Mrs.</option>
                                                    <option value="Mrs">Ms.</option>
                                                    <option value="Miss">Miss.</option>
                                                    <option value="Dr">Dr.</option>
                                                    <option value="Rev">Rev.</option>
                                                </select>
                                                @Html.ValidationMessageFor(model => model.TourAgentTitle, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.TourAgentName, new { @class = "form-control", Placeholder = "Name", autocomplete = "false" })
                                                @Html.ValidationMessageFor(model => model.TourAgentName, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Address 01</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">

                                                @Html.TextBoxFor(model => model.BillingAddress1, new { @class = "form-control", Placeholder = "Address 01" })
                                                @Html.ValidationMessageFor(model => model.BillingAddress1, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Address 02</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">


                                                @Html.TextBoxFor(model => model.BillingAddress2, new { @class = "form-control", MaxLength = 20, Placeholder = "Address 02" })
                                                @Html.ValidationMessageFor(model => model.BillingAddress2, "", new { @class = "text-danger pull-left" })


                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Address 03</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.BillingAddress3, new { @class = "form-control", MaxLength = 20, Placeholder = "Address 03" })
                                                @Html.ValidationMessageFor(model => model.BillingAddress3, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Tour Agent Company</label>
                                            <div class="col-md-6 col-sm-9 col-xs-9">
                                                <select id="TourAgentCompanyID" name="TourAgentCompanyID" class="form-control"></select>
                                                @Html.ValidationMessageFor(model => model.TourAgentCompanyID, "", new { @class = "text-danger pull-left" })
                                            </div>

                                            @*<label class="control-label col-md-3 col-sm-3 col-xs-12">Tour Agent Company Code</label>
                                            <div class="col-md-7 col-sm-7 col-xs-12">
                                                <select id="TourAgentCompanyID" name="TourAgentCompanyID" class="form-control"></select>
                                            </div>*@


                                        </div>

                                        <br />

                                    </div>
                                    <div class="form-horizontal form-label-left col-md-6">
                                     
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">NIC</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.NIC, new { @class = "form-control", MininumLength = 10, MaxLength = 12, Placeholder = "NIC" })
                                                @Html.ValidationMessageFor(model => model.NIC, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Mobile</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Mobile, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "Mobile",
                                               type = "number",
                                               min = 0,
                                               MaxLength = 10,
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">E Mail</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Email, new
                                           {
                                               @class = "form-control",
                                               Type = "email",
                                               Placeholder = "E Mail",
                                               MaxLength = 100,
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                       
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Percentage %</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.TourPercentage, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "TourPercentage",
                                               type = "number",
                                               min = 0,
                                               MaxLength = 20,
                                               Value = "0",
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.TourPercentage, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Amount</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.TourAmount, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "Amount",
                                               type = "number",
                                               min = 0,
                                               MaxLength = 20,
                                               Value = "0",
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.TourAmount, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Remarks</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Remarks, new { @class = "form-control", Placeholder = "Remarks" })
                                                @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="col-md-9">

                                                <label class="control-label col-md-4 col-sm-3 col-xs-3">IsActive</label>
                                                <div class="checkbox col-xs-1">
                                                    @Html.CheckBoxFor(model => model.IsActive, new { })
                                                </div>
                                             

                                            </div>
                                        </div>
                                        <br />

                                    </div>

                                    <div class="clearfix"></div>

                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("Create", null, new { })'" />
                                            @*<div class="btn btn-primary pl_add btn-small pull-left">
                                                    @Html.ActionLink("Clear", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>*@
                                            <div class="btn btn-info pl_add btn-small pull-left">
                                                @Html.ActionLink("View All", "ViewTourAgents", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <button type="submit" class="btn btn-success">Submit</button>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script src="~/Scripts/SweetAlets/sweetalert.js"></script>
<script>

    $.getJSON("@Url.Action("GetActiveTourAgentCompany", "TourAgent")", function (data) {
        var TourAgentCompanyID = $("#TourAgentCompanyID");
        TourAgentCompanyID.empty();
        TourAgentCompanyID.append("<option value='0'>-- Select a Group --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            TourAgentCompanyID.append($('<option />', { value: optionaldata.TourAgentCompanyID }).html(optionaldata.TourAgentCompanyName));

        });

        if ('@ViewBag.TourAgentCompanyID') {
            $('#TourAgentCompanyID').val('@ViewBag.TourAgentCompanyID').trigger("change");
        } else {
            $('#TourAgentCompanyID').val(0).trigger("change");
        }
    });
</script>


