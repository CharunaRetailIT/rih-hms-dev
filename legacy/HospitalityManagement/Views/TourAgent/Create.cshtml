<script type="text/javascript">
    function CheckTourAgentCode()
    {
        document.getElementById('validatecode').innerHTML = '';

        $.ajax({
            url: "@Url.Action("CheckTourAgentCode", "TourAgent")",
            data: { code: $("#AgentCode").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {
                data = resp;
                if (resp != null || resp != "") {
                    document.getElementById('validatecode').innerHTML = "Tour Agent Code Already Exists";
                } else
                {
                    document.getElementById('validatecode').innerHTML = "";
                }

            }
        });


    }
</script>
