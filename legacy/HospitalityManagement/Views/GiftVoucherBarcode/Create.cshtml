<script>
    $(document).ready(function () {
        Giftvouchergroupload();
        LoadLocation();
        LoadLocationTo();
        GVbookload();
    });

    $('#LocationA').click(function (e) {
        e.preventDefault(); // Prevent form submission
        $('#LocationA').change(function () {
            var selectedValue = $(this).val();
            $('#LocationAhidden1').val(selectedValue);//value assign to the hidden variable
        });
    });
    $('#LocationB').click(function (e) {
        e.preventDefault(); // Prevent form submission
        $('#LocationB').change(function () {
            var selectedValue = $(this).val();
            $('#LocationAhidden2').val(selectedValue);//value assign to the hidden variable
        });
    });
    $('#BookCode').click(function (e) {
        e.preventDefault(); // Prevent form submission
        $('#BookCode').change(function () {
            var selectedValue = $(this).val();
            $('#GiftVoucherGroupCode2').val(selectedValue);//value assign to the hidden variable when dropdown select
        });
    });
     var GVbookload = function () {

        $.getJSON("@Url.Action("GetGiftvoucherBook", "GiftVoucherMaster")", function (data) {
            var BookCode = $("#BookCode");
            BookCode.empty();
            BookCode.append("<option value='0'>-- Select Book --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                BookCode.append($('<option />', { value: optionaldata.BookCode }).html(optionaldata.BookName));
            });
            if ('@ViewBag.BookCode') {
                $('#BookCode').val(@ViewBag.BookCode).trigger("change");
            } else {
                $('#BookCode').val(0).trigger("change");
            }
        });
    }
    var LoadLocation = function () {

        $.getJSON("@Url.Action("GetLocationAll", "GiftVoucherPurchaseOrder")", function (data) {
            var LocationA = $("#LocationA");
            LocationA.empty();
            LocationA.append("<option value='0'>-- Select --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                LocationA.append($('<option />', { value: optionaldata.LocationCode }).html(optionaldata.LocationName));
            });
            if ('@ViewBag.LocationA') {

                $('#SupplierID').val(@ViewBag.LocationA).trigger("change");

            } else {
                $('#SupplierID').val(0).trigger("change");

            }

        });
    }
    var LoadLocationTo = function () {

        $.getJSON("@Url.Action("GetLocationAll", "GiftVoucherPurchaseOrder")", function (data) {
            var LocationB = $("#LocationB");
            LocationB.empty();
            LocationB.append("<option value='0'>-- Select --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                LocationB.append($('<option />', { value: optionaldata.LocationCode }).html(optionaldata.LocationName));
            });
            if ('@ViewBag.LocationB') {

                $('#SupplierID').val(@ViewBag.LocationB).trigger("change");

            } else {
                $('#SupplierID').val(0).trigger("change");

            }

        });
    }
    var Giftvouchergroupload = function () {
        $.getJSON("@Url.Action("GetGiftvoucherGroup", "GiftVoucherGoodReceiveNote")", function (data) {
            var GiftVoucherGroupCode = $("#InvGiftVoucherGroupID");
            GiftVoucherGroupCode.empty();
            GiftVoucherGroupCode.append("<option value='0'>-- Select Group --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                GiftVoucherGroupCode.append($('<option />', { value: optionaldata.GiftVoucherGroupCode }).html(optionaldata.GiftVoucherGroupCode));
            });
            if ('@ViewBag.GiftVoucherGroupCode') {

                $('#InvGiftVoucherGroupID').val(@ViewBag.GiftVoucherGroupCode).trigger("change");
            } else {
                $('#InvGiftVoucherGroupID').val(0).trigger("change");
            }
        });
    }
    $("input[type='radio']").change(function () {

        if ($(this).val() == "other") {
            $("#otherAnswer").show();
        }
        else {
            $("#otherAnswer").hide();
        }
    });
</script>
<script type="text/javascript">
    function EnableDisable() {
        var others = document.getElementById();
        var otherCoupen = document.getElementById(model.GiftVoucherPercentage);
        otherCoupen.disabled = others.checked ? false : true;
        otherCoupen.value = "";
        if (!otherCoupen.disabled) {
            otherCoupen.focus();
        }
    }

    // Fire on radio button checked event
    $('input[type="radio"]').change(function () {

        // Get the value of currently clicked radio button
        var value = $(this).val();

        // Find the corresponding textbox inside the div that has the id same as radio button value and remove it disabled attribute
        $('#' + $(this).val())
            .children('input[type="text"]')
            .removeAttr('disabled');

        // Find all radio button and find its corresponding textbox and make it disable except the checked radio button.
        $('input[type="radio"]').each(function () {
            if (this.value != value) {
                $('#' + this.value)
                    .children('input[type="text"]')
                    .attr('disabled', 'disabled');
            }
        })
    });
</script>

