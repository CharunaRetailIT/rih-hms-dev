@model IEnumerable<RIT.HMS.Domain.RstCategory>
@{
    ViewBag.Title = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/MasterFile.css" rel="stylesheet" />
<h2></h2>

@using (Html.BeginForm("", "Category", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="right_col" role="main">
    <div class="">
        <div class="clearfix"></div>

        <div class="row">
            <!-- form input mask -->
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="x_panel">

                    <div class="x_content">
                        <br />

                        <div class="x_panel">
                            <div class="x_title">
                                <h2>Categories<small>Existing</small></h2>
                                <ul class="nav navbar-right panel_toolbox">
                                    <li>
                                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                    </li>
                                   
                                    <li>
                                        <a class="close-link"><i class="fa fa-close"></i></a>
                                    </li>
                                </ul>
                                <div class="clearfix"></div>
                            </div>
                            <div class="form-group ">

                                <div class="">

                                </div>
                                <div class="pull-right">
                                    <input type="submit" value="Download Data" formaction="HMSCategories" class="btn btn-primary">
                                </div>
                            </div>
                            <div class="clerfix"></div><br />
                            <div class="x_content">
                                @*<table id="datatable-responsive"
                                       class="table table-striped table-bordered dt-responsive nowrap">*@
                                <table id="datatable-responsive" class="mstable">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Department</th>
                                            <th>IsActive</th>
                                            <th></th>

                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => item.RstCategoryCode)</td>
                                                <td>@Html.DisplayFor(modelItem => item.RstCategoryName)</td>
                                                <td>@Html.DisplayFor(modelItem => item.DepartmentName)</td>
                                                <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                                <td>@Html.ActionLink("Edit", "Edit", new { id = item.RstCategoryID })</td>

                                            </tr>
                                        }
                                    </tbody>

                                </table>
                            </div>
                        </div>


                    </div>
                </div>
                <div class="clerfix">
                    <div class="btn btn-info pl_add btn-small pull-left">
                        @Html.ActionLink("Add Category", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>


}

