<script type="text/javascript">
    function checkDiscountPercentage() {
        if (!($('#IsDiscount').is(":checked"))) {
            alert("Product discount have not allowed..!");
            $("#FixedDiscountPercentage").val("0.00");
            return;
        }
        var Dis = $("#FixedDiscountAmount");
        if (Dis.val() > 0) {
            alert("Cannot apply fixed discount amount with fixed discount percentage for the same item..!");
            $("#FixedDiscountPercentage").val("0.00");
            return;
        }
        var DisPer = $("#FixedDiscountPercentage");
        if (DisPer.val() > 100) {
            $("#FixedDiscountPercentage").val("100.00");
            return;
        }
    }
</script>

