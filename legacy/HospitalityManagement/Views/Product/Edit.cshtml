<script type="text/javascript">
    function checkDiscountAmount() {
        if (!($('#IsDiscount').is(":checked"))) {
            alert("Product discount have not allowed..!");
            $("#FixedDiscountAmount").val("0.00");
            return;
        }
        var Dis = $("#FixedDiscountPercentage");
        if (Dis.val() > 0) {
            alert("Cannot apply fixed discount percentage with fixed discount amount for the same item..!");
            $("#FixedDiscountAmount").val("0.00");
            return;
        }
    }
</script>


<script>
    $("body").on("click", "#btnsubmit", function ()
    {

        var isSupplierExists = false;
        var tableBody = document.querySelector('#tblSuppliers tbody');

        // Check if table body exists and has rows
        if (tableBody && tableBody.rows.length > 0) {
            isSupplierExists = true;
        }

