@using RIT.HMS.Domain
@model RIT.HMS.Domain.Product
@{
    ViewBag.Title = "Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(model => Model.ProductId)
            @Html.AntiForgeryToken()


            @*<input id="ProductId" name="ProductId" type="hidden" value=@Model.ProductId>*@

        <!-- page content -->
            <div class="se-pre-con"></div>
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "0")
                {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Product</strong> @ViewBag.PrdCode  failed to modify.
                        </div>
                    }
                    else if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Product </strong> @ViewBag.PrdCode modified successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please select printer type on Pricing & Stock tab.!</strong>.
                        </div>
                    }
                    else if (@ViewBag.Message == "5")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Can't be select Active and Delete options in the same time..!
                        </div>
                    }
                    else if (@ViewBag.Message == "6")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            Can't be Delete, Recipe exists for this Product Serving Unit..!
                        </div>
                    }

                    <div class="actionBar">
                        <div class="msgBox">

                            <div class="pull-left">
                                <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("Edit", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewAllProducts", null, new { })'" />
                            </div>
                            <button type="submit" class="btn btn-success">Modify</button>
                            <div class="pull-left">
                                <input type="button" class="btn btn-info" value="Add Product" onclick="location.href='@Url.Action("Index", null, new { })'" />
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">

                                <div class="x_title">
                                    <h2>Product - Edit </h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />
                                    <div class="col-md-12">
                                        <div class="x_panel">

                                            <div class="" role="tabpanel" data-example-id="togglable-tabs" id="mapContent">

                                                <ul id="myTab" class="nav nav-tabs bar_tabs" role="tablist">
                                                    <li role="presentation" class="active">
                                                        <a href="#tab_content1" id="home-tab" role="tab" data-toggle="tab" aria-expanded="true">General</a>
                                                    </li>
                                                    <li role="presentation" class="">
                                                        <a href="#tab_content2" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Pricing & Stock</a>
                                                    </li>
                                                    <li role="presentation" class="optDiscounts">
                                                        <a href="#tab_content3" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Discounts</a>
                                                    </li>
                                                    <li role="presentation" class="optServingUnits">
                                                        <a href="#tab_content5" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Serving Units</a>
                                                    </li>
                                                    <li role="presentation" class="optTaxes">
                                                        <a href="#tab_content6" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Taxes</a>
                                                    </li>
                                                    <li role="presentation" class="" style="display: none;">
                                                        <a href="#tab_content7" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Configurations</a>
                                                    </li>
                                                    <li role="presentation" class="">
                                                        <a href="#tab_content8" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Suppliers</a>
                                                    </li>
                                                    <li role="presentation" class="">
                                                        <a href="#tab_content9" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Printers</a>
                                                    </li>
                                                    <li role="presentation" class="">
                                                        <a href="#tab_content10" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Price Level</a>
                                                    </li>
                                                    <li role="presentation" class="">
                                                        <a href="#tab_content11" role="tab" id="profile-tab2" data-toggle="tab" aria-expanded="false">Target</a>
                                                    </li>
                                                </ul>

                                                <div id="myTabContent" class="tab-content">

                                                    <div role="tabpanel" class="tab-pane fade active in" id="tab_content1" aria-labelledby="home-tab">

                                                        <div class="form-horizontal form-label-left col-md-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Product Code *</label>
                                                                <div class="col-md-4 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.ProductCode,
                                                                new
                                                                {
                                                                    @class = "form-control",
                                                                    MaxLength = 10,
                                                                    Placeholder = "Code",
                                                                    @readonly = true
                                                                })
                                                                    @Html.ValidationMessageFor(model => model.ProductCode, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Raw Material</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsRowMaterial, new { id = "IsRowMaterial" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Product Name *</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control", Placeholder = "ProductName" })
                                                                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Description </label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.ProductDesp, new { @class = "form-control", Placeholder = "Description" })
                                                                    @Html.ValidationMessageFor(model => model.ProductDesp, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Name On Invoice</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.NameOnInvoice, new { @class = "form-control", Placeholder = "NameOnInvoice" })
                                                                    @Html.ValidationMessageFor(model => model.NameOnInvoice, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Product Name (Sinhala)</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.ProductNameInSinhala, new { @class = "form-control", Placeholder = "ProductNameInSinhala" })
                                                                    @Html.ValidationMessageFor(model => model.ProductNameInSinhala, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Ref Code 01</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.RefCode01, new { @class = "form-control", Placeholder = "Ref Code 01" })
                                                                    @Html.ValidationMessageFor(model => model.ProductNameInSinhala, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Ref Code 02</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.RefCode02, new { @class = "form-control", Placeholder = "Ref Code 02" })
                                                                    @Html.ValidationMessageFor(model => model.ProductNameInSinhala, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Product Images</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <input type="file" id="Photograph" name="Photograph" class="flat pull-left" />
                                                                    @Html.ValidationMessageFor(model => model.Photograph, "", new { @class = "text-danger pull-left" })
                                                                    
                                                                    <div class="pull-left">
                                                                        @ViewBag.FileName
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">

                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Active</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsActive)
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Delete</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsDelete)
                                                                </div>
                                                            </div>
                                                            <div class="form-group" style="display: none;">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3" style='display:none'>Is Pack</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9" style="display: none;">
                                                                    @Html.CheckBoxFor(model => model.IsPackItem, new { @class = "flat" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Expiary</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsExpiry)
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">No Effect Cost for Menu</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsNoEffectCostforMenu)
                                                                </div>
                                                            </div>
                                                            <div id="IsMaterialLeft">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Promotion</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsPromotion)
                                                                    </div>

                                                                </div>
                                                                <div class="form-group" style="display: none;">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3" style="display: none;">Free Issue</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9" style="display: none;">
                                                                        @Html.CheckBoxFor(model => model.IsFreeIssue, new { @class = "flat" })
                                                                    </div>

                                                                </div>
                                                                <div class="form-group" style="display: none;">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3" style="display: none;">Bundle</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9" style="display: none;">
                                                                        @Html.CheckBoxFor(model => model.IsBundle, new { @class = "flat" })
                                                                    </div>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Sell In Fraction</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsCountable)
                                                                    </div>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Open Item</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsOpenItem)
                                                                    </div>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Update Cost On Receipe</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsCostOnReceipe)
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <br />

                                                        </div>

                                                        <div class="form-horizontal form-label-left col-md-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Department *</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <select id="DepartmentId" name="DepartmentId" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.DepartmentId, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Category *</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <select id="CategoryId" name="CategoryId" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Sub Category *</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <select id="SubCategoryId" name="SubCategoryId" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.SubCategoryId, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Printer Type *</label>
                                                                <div class="col-md-5 col-sm-9 col-xs-9">
                                                                    <select id="PrinterTypeId" name="PrinterTypeId" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.PrinterTypeId, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>
                                                            @*<div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Kitchen / Bar</label>
                                                                <div class="col-md-5 col-sm-9 col-xs-9">
                                                                    <select id="KitchenCode" name="KitchenCode" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.KitchenCode, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>*@
                                                            <div class="form-group" style="display: none;">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Wastage Prc</label>
                                                                <div class="col-md-3 col-sm-3 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.WastagePrc, new { @class = "form-control", Type = "number", step = "0.01", onkeypress = "return event.charCode >= 46" })
                                                                    @Html.ValidationMessageFor(model => model.WastagePrc, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group" style="display: none;">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Pack Size</label>
                                                                <div class="col-md-3 col-sm-3 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.PackSize, new { @class = "form-control", Type = "number", min = "0", step = "0.01", onkeypress = "return event.charCode >= 46" })
                                                                    @Html.ValidationMessageFor(model => model.PackSize, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group" style="display: none;">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Pack Price</label>
                                                                <div class="col-md-3 col-sm-3 col-xs-9">
                                                                    @Html.TextBoxFor(model => model.PackPrice, new { @class = "form-control", Type = "number", min = "0", step = "0.01", onkeypress = "return event.charCode >= 46" })
                                                                    @Html.ValidationMessageFor(model => model.PackPrice, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Unit Of Measure*</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <select id="PurchasingUnit" name="PurchasingUnit" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.PurchasingUnit, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Sub Unit*</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <select id="WeightPerUnit" name="WeightPerUnit" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.WeightPerUnit, "", new { @class = "text-danger pull-left" })

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Addon</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsAddon)
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Addon Category</label>
                                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                                    <select id="AddonCategoryMasterId" name="AddonCategoryMasterId" class="form-control"></select>
                                                                    @Html.ValidationMessageFor(model => model.AddonCategoryMasterId, "", new { @class = "text-danger pull-left" })
                                                                </div>
                                                            </div>
                                                            <br />
                                                            <div class="form-group" style="display: none;">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3" style="display: none;">Scale Item</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9" style="display: none;">
                                                                    @Html.CheckBoxFor(model => model.IsScaleItem, new { @class = "flat" })
                                                                </div>
                                                            </div>
                                                            @*<div class="form-group" style="display: none;">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Cost On Receipe</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsCostOnReceipe, new { @class = "flat" })
                                                                </div>
                                                            </div>*@
                                                            <div class="form-group">
                                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Tax</label>
                                                                <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                    @Html.CheckBoxFor(model => model.IsTax, new { id = "IsTax" })
                                                                </div>
                                                            </div>
                                                            <div id="IsMaterialRight">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Allow Discounts</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsDiscount)
                                                                    </div>
                                                                </div>
                                                               
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Tax Include Price</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsTaxInclude)
                                                                    </div>
                                                                </div>


                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Is Under Cost</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.IsUnderCost)
                                                                    </div>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Auto Production</label>
                                                                    <div class="checkbox col-md-3 col-sm-9 col-xs-9">
                                                                        @Html.CheckBoxFor(model => model.AutoProduction)
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div role="tabpanel" class="tab-pane fade" id="tab_content2" aria-labelledby="profile-tab">

                                                        <div class="clearfix"></div>
                                                        <div class="text-info"><b>Locations</b></div>
                                                        <div id="btnAddToAllLocs">
                                                            <input type="button" id="btnAddToAll" class="btn btn-round btn-info pull-right"
                                                                   value="Add to all locations" />
                                                            @Html.ValidationMessageFor(model => model.ProductLocationViewModel, "", new { @class = "text-danger pull-left" })
                                                        </div>
                                                        <br />
                                                        <table id="tblUnits" class="table table table-striped table-bordered bulk_action  table-responsive">
                                                            <thead>
                                                                <tr>
                                                                    <th style="display:none">Location Id</th>
                                                                    <th>Location</th>
                                                                    <th>Cost Price</th>
                                                                    <th>Selling Price</th>
                                                                    <th>Re Order Level</th>
                                                                    <th>Re Order Qty</th>
                                                                    <th>Re Order Period</th>
                                                                    <th>Foreign Customer Price</th>
                                                                    <th>Avg.Cost</th>
                                                                    <th style='display:none;'>Printer Type</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="locitemsitems">
                                                                @if (Model != null)
                                                                {
                                                                    foreach (var productloc in Model.ProductLocationViewModel)
