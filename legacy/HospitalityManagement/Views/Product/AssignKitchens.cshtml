@model IEnumerable<RIT.HMS.Domain.Product>
@{
    ViewBag.Title = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/MasterFile.css" rel="stylesheet" />

<h2></h2>


    @Html.AntiForgeryToken()
    <body class="nav-md">

        <div class="right_col" role="main">
            <div class="">
                <div class="clearfix"></div>

                <div class="row">
                    <!-- form input mask -->
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="x_panel">

                            <div class="x_content">
                                <br />
                               

                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Select Product to Assign Kitchens<small> Existing</small></h2>
                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>

                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>

                                    <div class="form-group ">
                                        <div class="">

                                        </div>
                                        <div class="pull-right">
                                           
                                        </div>
                                    </div><div class="clerfix"></div><br />
                                    <div class="x_content">
                                        <br />
                                        @*<table id="datatable-responsive"
                                            class="table table-striped table-bordered dt-responsive nowrap">*@
                                        <table id="datatable-responsive" class="mstable col-xs-12 col-lg-12 col-md-12 col-sm-12">
                                            <thead>
                                                <tr>
                                                    <th style="display:none"></th>
                                                    <th>Code</th>
                                                    <th>Name</th>
                                                    <th>Is.Active</th>
                                                    <th>Is.RowMaterial</th>
                                                    <th>Number.Of.Kitchens</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td style="display:none">@item.ProductId</td>
                                                        <td>@Html.DisplayFor(modelItem => item.ProductCode)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.IsRowMaterial)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.KitchenLocationCount)</td>
                                                        <td>@Html.ActionLink("Add Kitchen", "AddKitchen", new { id = item.ProductId })</td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                          
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>

