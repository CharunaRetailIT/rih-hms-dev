    function checkProductCode() {
        document.getElementById('validatecode').innerHTML = '';

        $.ajax({
            url: "@Url.Action("VaidateProductCode", "Product")",
            data: { productcode: $("#ProductCode").val() },
            type: "GET",
            dataType: "json",
            success: function (resp) {
                data = resp;
                if (resp != null || resp != "") {
                    document.getElementById('validatecode').innerHTML = "Product Code Already Exists";
                    // document.getElementById('ProductCode').value = '';

                } else {
                    document.getElementById('validatecode').innerHTML = "";
                }
            }
        });
    }
</script>


