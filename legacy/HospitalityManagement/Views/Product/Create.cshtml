<script>
    window.onload = function () {
        $('#AddonCategoryMasterId').prop('disabled', true);
        $('#mapContent ul li.optTaxes').hide();
        $('#mapContent ul li.optDiscounts').hide();

        var chkIsAddon = document.getElementById("IsAddon");
        chkIsAddon.addEventListener('click', function () {
            if (chkIsAddon.checked) {
                $('#AddonCategoryMasterId').prop('disabled', false);
            } else {
                $('#AddonCategoryMasterId').prop('disabled', true);
                $("select#AddonCategoryMasterId").prop('selectedIndex', 0);
            }
        });
        var chkIsTax = document.getElementById("IsTax");
        chkIsTax.addEventListener('click', function () {
            if (chkIsTax.checked) {
                $('#mapContent ul li.optTaxes').show();
            } else {
                $('#mapContent ul li.optTaxes').hide();
            }
        });
        var chkIsDiscount = document.getElementById("IsDiscount");
        chkIsDiscount.addEventListener('click', function () {
            if (chkIsDiscount.checked) {
                $('#mapContent ul li.optDiscounts').show();
            } else {
                $('#mapContent ul li.optDiscounts').hide();
            }
        });
        var chkIsMatirial = document.getElementById("IsRowMaterial");
        chkIsMatirial.addEventListener('click', function () {
            if (chkIsMatirial.checked) {
                $('#IsMaterialLeft').hide();
                $('#IsMaterialRight').hide();

                $("#IsPromotion").prop("checked", false);
                $("#IsCountable").prop("checked", false);
                $("#IsOpenItem").prop("checked", false);
                $("#IsDiscount").prop("checked", false);
                $("#IsTax").prop("checked", false);
                $("#IsTaxInclude").prop("checked", false);
                $("#IsUnderCost").prop("checked", false);
                $("#AutoProduction").prop("checked", false);

                $('#mapContent ul li.optTaxes').hide();
                $('#mapContent ul li.optDiscounts').hide();
                $('#mapContent ul li.optServingUnits').hide();

                var rowCount = $('#unititems tr').length;
                for (var i = 0; i < rowCount; i++) {
                    document.getElementById('ProductLocationViewModel[' + i + ']_SellingPrice').value = '0.00';
                    document.getElementById('ProductLocationViewModel[' + i + ']_SellingPrice').disabled = true;
                }
            } else {
                $('#IsMaterialLeft').show();
                $('#IsMaterialRight').show();
                $('#mapContent ul li.optServingUnits').show();

                var rowCount = $('#unititems tr').length;
                for (var i = 0; i < rowCount; i++) {
                    document.getElementById('ProductLocationViewModel[' + i + ']_SellingPrice').disabled = false;
                }
            }
        });
        if (chkIsAddon.checked) {
            $('#AddonCategoryMasterId').prop('disabled', false);
        }
        if (chkIsTax.checked) {
            $('#mapContent ul li.optTaxes').show();
        }
        if (chkIsDiscount.checked) {
            $('#mapContent ul li.optDiscounts').show();
        }
        if (!chkIsMatirial.checked) {
            $('#IsMaterialLeft').show();
            $('#IsMaterialRight').show();
        }
        if (chkIsMatirial.checked) {
            $('#mapContent ul li.optServingUnits').hide();
            $('#IsMaterialLeft').hide();
            $('#IsMaterialRight').hide();
        }
    }
</script>