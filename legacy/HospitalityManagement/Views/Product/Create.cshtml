@using RIT.HMS.Domain
@model RIT.HMS.Domain.Product
@{
    ViewBag.Title = "Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Create", "Product", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
            {
            @Html.AntiForgeryToken()
            @*@Html.HiddenFor(model=>model.RstDepartmentID)*@
            <!-- page content -->
            <div class="se-pre-con"></div>
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "0")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Product</strong> @ViewBag.PrdCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Product </strong> @ViewBag.PrdCode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Product</strong> @ViewBag.PrdCode already exists.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Product must have atleast one supplier.!</strong>.
                        </div>
                    }
                    else if (@ViewBag.Message == "4")
                    {
                        <div class="alert alert-warning alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Please select printer type on Pricing & Stock tab.!</strong>.
                        </div>
                    }
                  
                 

                    <div class="actionBar">
                        <div class="msgBox">
                            <div class="pull-left">
                                <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("Index", null, new { })'" />
                            </div>
                            <div class="pull-left">
                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewAllProducts", null, new { })'" />
                            </div>
                            <button type="submit" class="btn btn-success">Submit</button>
                        </div>
                    </div>


                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">

                                <div class="x_title">
                                    <h2>Product</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />
