@model IEnumerable<RIT.HMS.Domain.Product>
@{
    ViewBag.Title = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/MasterFile.css" rel="stylesheet" />

<h2></h2>
@using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
<body class="nav-md">

    <div class="right_col" role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">
                <!-- form input mask -->
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">

                        <div class="x_content">
                            <br />
                            <div class="clerfix">
                                <div class="pull-left">                                  
                                    <input type="button" class="btn btn-info" value="Add Product" onclick="location.href='@Url.Action("index", null, new { })'" />
                                </div>
                            </div>

                            <div class="x_panel">                              
                                <div class="x_title">
                                    <h2>Products<small> Existing</small></h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                      
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>

                                <div class="form-group ">
                                    <div class="">

                                    </div>
                                    <div class="pull-right">
                                        <input type="submit" value="Download Data" formaction="HMSProducts" class="btn btn-primary">
                                    </div>
                                </div><div class="clerfix"></div><br />
                                <div class="x_content"><br />
                                    @*<table id="datatable-responsive"
                                           class="table table-striped table-bordered dt-responsive nowrap">*@
                                    <table id="datatable-responsive" class="mstable col-xs-12 col-lg-12 col-md-12 col-sm-12" >
                                        <thead>
                                            <tr>
                                                <th style="display:none"></th>
                                                <th>Code</th>
                                                <th>Name</th>
                                                <th>IsActive</th>
                                                <th>IsRowMaterial</th>
                                                <th></th>
                                          
                                                @if (ViewBag.Update == "1")
                                                {
                                                    <th></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td style="display:none">@item.ProductId</td>
                                                    <td>@Html.DisplayFor(modelItem => item.ProductCode)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.IsRowMaterial)</td>
                                                    <td>@Html.ActionLink("Edit", "Edit", new { id = item.ProductId })</td>
                                                    @if (ViewBag.Update == "1")
                                                    {
                                                    <td>                                                                                                            
                                                     <input type="button" class="btn btn-warning btn-sm" value="Update Recipes" id="UpdateRecipe" name="UpdateRecipe" />                                                  
                                                    </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                       
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="clerfix">
                            <div class="pull-left">                            
                                <input type="button" class="btn btn-info" value="Add Product" onclick="location.href='@Url.Action("index", null, new { })'" />
                            </div>
                        </div>
                    </div>             
                </div>
            </div>
        </div>
    </div>
</body>
}
<script src="~/vendors/jquery/dist/jquery.min.js"></script>

    
   <script type="text/javascript">
       $("body").on("click", "#UpdateRecipe", function ()
       {
           var row = $(this).closest("TR");
           var productid = $("TD", row).eq(0).html();
           // alert("aaaa" + name);
           if (confirm("Do you want to update recipe(s)? "))
           {
               $.ajax({
                   url: "@Url.Action("UpdateRecipe", "Product")",
                   data: { productid: productid },
                   type: "GET",
                   dataType: "json",
                   success: function (resp) {
                       data = resp;
                       if (resp != null || resp != "") {
                           alert(resp+" Recipe(s) Updated");

                       } else {
                           alert("recipe Update Failed");
                       }
                   }
               });
           }


       });
</script>
