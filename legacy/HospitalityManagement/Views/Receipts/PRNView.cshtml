@model RIT.HMS.Domain.Transactions.PurchaseHeader
@{
    ViewBag.Title = "Print PRN";
    Layout = null;
}

@using (Html.BeginForm("CreatePRN", "PurchaseReturnNote", FormMethod.Get, new{ @class = "form-horizontal",}))
{


    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="modal-header col-md-12">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h4 class="modal-title" id="myModalLabel">...</h4>
        </div>
        <div class="x_panel">

            <div id="printcontent">
                <div class="x_title" style="text-align:center">
                    @if (Model.PrintStatus == 1)
                    {
                        <div class="small text-right" style="text-align:right">Original | @Model.DocState</div>
                    }
                    else
                    {
                        <div class="small text-right" style="text-align:right">Duplicate | @Model.DocState</div>
                    }
                    <div style="font-size:large">@Model.SysCompany.CompanyName</div>
                    <div style="font-size:medium">@Model.SysCompany.Address1,@Model.SysCompany.Address2,@Model.SysCompany.Address3</div><br />
                    <div style="font-size:large">Purchase Return Note</div>
                    <br />
                </div>

                <div class="x_content">
                    <div>
                        <table align="center" style="width:100%">
                            <tr>
                                <td style="text-align:left">
                                    <label class="control-label">Company: @Model.Company </label>
                                </td>
                                <td width="10%"></td>
                                <td style="text-align:right">
                                    <label class="control-label">Location: @Model.Location </label>
                                </td>
                            </tr>

                            <tr>
                                <td style="text-align:left">
                                    <label class="control-label">Doc #: @Model.DocumentNo </label>
                                </td>
                                <td width="10%"></td>
                                <td style="text-align:right">
                                    @*<label class="control-label">Doc Date: @Model.CreatedDate </label>*@
                                    <label class="control-label">PRN Date: @Model.GRNDate.ToShortDateString() </label>
                                </td>
                            </tr>

                            <tr>
                                <td style="text-align:left">
                                    <label class="control-label">Create User: @Model.CreatedUser </label>
                                </td>
                                <td width="10%"></td>
                                <td style="text-align:right">
                                    <label class="control-label">Print Date: @DateTime.Now </label>
                                </td>
                            </tr>
                            @* Added by pavithra *@
                            <tr>
                                <td style="text-align:left">

                                    <label class="control-label">Reference No: @Model.ReferenceNo </label>
                                </td>
                                <td width="10%"></td>
                                <td style="text-align:right">
                                    <label class="control-label">Remark: @Model.Remark </label>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align:left">

                                    <label class="control-label">Base GRN No: @Model.BaseDocNo </label>
                                </td>
      
                            </tr>
                        </table>
                    </div>
                    <br />
                    <div class="clearfix"></div>


                    <br />

                    <div class="table-responsive">

                        @if (Model.PurchaseDetail != null)
                        {


                            <table id="tblstock" border="1" style="width:100%;border:thick" class="table table-striped jambo_table bulk_action">
                                <thead>
                                    <tr class="headings">

                                        <th>Product Code</th>
                                        <th>Product Name</th>
                                        <th>PRN Quantity </th>
                                        <th>Discounts</th>
                                        <th>Cost Value</th>
                                        <th style="display:none">Selling Value</th>
                                        <th>Tax</th>

                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model.PurchaseDetail)
                                    {
                                        <tr class="even pointer">

                                            <td>@Html.DisplayFor(modelItem => item.ProductCode)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.OrderQty) </td>
                                            <td style="text-align:right">@Html.DisplayFor(modelItem => item.Discount) </td>
                                            <td style="text-align:right">@Html.DisplayFor(modelItem => item.CostPrice) </td>
                                            <td style="text-align:right;display:none">@Html.DisplayFor(modelItem => item.SellingPrice) </td>
                                            <td style="text-align:right">@Html.DisplayFor(modelItem => item.TotalTax) </td>

                                        </tr>
                                    }

                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Total</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align:right">@Model.TotDiscounts</td>
                                        <td style="text-align:right">@Model.TotCostPrice</td>
                                        <td style="text-align:right;display:none">@Model.TotSellingPrice</td>
                                        <td style="text-align:right">@Model.TotalTax</td>
                                    </tr>
                                </tfoot>

                            </table>
                            <br />
                            <br />
                                <br />

                            //Added by pavithra
                            <table id="tblNet" style="width:50%" align="right">
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Gross Amount: </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.GrossAmount </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Subtotal Discount Amount:  </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.DiscountAmount </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Subtotal Discount Percentage:  </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.DiscountPercentage </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Deductions:  </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.Deductions </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Other Charges:  </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.OtherChargers </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Total Taxes:  </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.TotalTax </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Net Amount:  </label>
                                    </td>
                                    <td style="text-align:right">
                                        <label class="control-label">@Model.NetAmount </label>
                                    </td>
                                </tr>
                            </table>
                            <div class="clearfix"></div>
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />

                                <table id="signature" style="width:100%">
                                    <tr style="width:100%">
                                        <td style="text-align:center">
                                            ..................................<br />
                                            Entered By
                                        </td>
                                        <td style="text-align:center">
                                            ..................................<br />
                                            Received By
                                        </td>
                                        <td style="text-align:center">
                                            ..................................<br />
                                            Checked By
                                        </td>
                                    </tr>

                                </table>
                        }
                    </div>
                </div>



            </div>

        </div>



        <div class="actionBar">
            <div class="msgBox">
                <button type="submit" class="btn btn-primary pull-right">Back</button>
                <div class="btn-group">
                    <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                    <ul class="dropdown-menu">
                        <li>
                            <a href="#" onclick="$('#tblstock').tableExport({ type: 'excel', escape: 'false' });">
                                <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                            </a>
                        </li>
                        <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" />Print/PDF</a></li>
                    </ul>
                </div>
            </div>
        </div>

    </div>


}




@*<script src="~/vendors/jquery/dist/jquery.min.js"></script>*@

