
@model RIT.HMS.Domain.ViewModels.VMInvRequestNotePOTransactionsHead
@{
    ViewBag.Title = "Print Merged PO";
    Layout = null;
    // Layout =null;
}


<body>

    @using (Html.BeginForm("CreatePO", "PO", FormMethod.Get, new { @class = "form-horizontal", }))
    {

        <div class="col-md-12 col-sm-12 col-xs-12" >

            <div class="modal-header col-md-12"  >

                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title" id="myModalLabel">...</h4>
            </div>


            <div class="x_panel">

                <div id="printcontent">
                    <div class="title" style="text-align:center">
                        @if (Model.PrintStatus == 1)
                        {
                        <div class="small text-right" style="text-align:right">Original | @Model.DocState</div>
                        }
                        else
                        {
                        <div class="small text-right" style="text-align:right">Duplicate | @Model.DocState</div>
                        }
                        <div class="small text-left" style="text-align:right">@DateTime.Now</div>
                        <div style="font-size:large">@Model.SysCompany.CompanyName</div>
                        @*<div style="font-size:medium">@Model.SysCompany.Address1,@Model.SysCompany.Address2,@Model.SysCompany.Address3</div><br />*@                     
                        <div style="font-size:large">Kitchen Summary</div>                       
                        <br />
                        <hr />
                        
                    </div>

                    <div class="x_content">
                        <div>

                            <table align="center" style="width:100%">
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">PO Location: @Model.Location </label>
                                    </td>
                                    <td width="10%"></td>
                                    <td style="text-align:right">
                                        @*<label class="control-label">Address: @Model.POLocationAddress </label>*@
                                        <label class="control-label">PO Date: @Model.PODate.ToShortDateString()</label>
                                    </td>

                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Doc #: @Model.DocumentNo </label>
                                    </td>
                                    <td width="10%"></td>
                                    <td style="text-align:right">
                                        <label class="control-label">Expected Delivery Date: @Model.ExpectedDate.ToShortDateString()</label>
                                        @*<label class="control-label">PO Date: @Model.PODate.ToShortDateString()</label>*@
                                    </td>
                                </tr>
                                @*<tr>*@
                                    @*<td style="text-align:left">
                                        <label class="control-label">Supplier: @Model.Supplier.SupplierName </label>
                                    </td>
                                    <td width="10%"></td>*@
                                    @*<td style="text-align:right">
                                        <label class="control-label">Expected Delivery Date: @Model.ExpectedDate.ToShortDateString()</label>
                                    </td>*@
                                @*</tr>*@
                                @*<tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Payment Term: @Model.PaymentTerm </label>
                                    </td>
                                    <td width="10%"> </td>
                                    <td style="text-align:right">
                                        <label class="control-label">Create User: @Model.CreatedUser </label>
                                    </td>
                                </tr>*@

                            </table>
                        </div>
                        <br />
                        <div class="clearfix"></div>


                        <br />

                        @{ var crosstabData = ViewBag.CrosstabData as Dictionary<string, Dictionary<string, int>>;
                           }

                        @{ int? nullableInt = null;
                            int defaultValue = nullableInt.GetValueOrDefault(0); // 0 will be used if nullableInt is null
                        }
                    <div class="table-responsive">
                        @if (Model.POTransactionsDetails != null)
                        {
                            <table id="tblstock" border="1" style="width:100%;border:none" class="table table-striped jambo_table bulk_action">
                                <thead>
                                    <tr class="headings">
                                        <th style="vertical-align: top;">Product</th>
                                        @foreach (var region in crosstabData.Values.SelectMany(d => d.Keys).Distinct())
                                        {
                                            <th style="vertical-align: top;">@region</th>
                                        }
                                        <th style="vertical-align: top;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var productEntry in crosstabData)
                                    {
                                        <tr>
                                            <td>@productEntry.Key</td>
                                            @foreach (var region in crosstabData.Values.SelectMany(d => d.Keys).Distinct())
                                            {
                                                 
                                             <td>
                                               @(productEntry.Value.ContainsKey(region) && productEntry.Value[region] != 0    ? productEntry.Value[region].ToString()   : "0")
                                              </td>
                                              }
                                              <td>
                                                 @(productEntry.Value.Values.Sum())
                                              </td>
                                        </tr>
                                     }
                                    @*<tr>
                                        <td>Total</td>
                                        @foreach (var region in crosstabData.Values.First().Keys)
                                        {
                    <td>
                        @(crosstabData.Values.Sum(p => p.ContainsKey(region) ? p[region] : 0))
                    </td>}
                                        <td>
                                            @(crosstabData.Values.Sum(p => p.Values.Sum()))
                                        </td>
                                    </tr>*@
                                </tbody>
                            </table>



                            <br />

                            <table align="left" style="width:100%">


                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Request Notes </label>
                                    </td>
                                    @*<td width="10%"></td>*@
                                    <td style="text-align:left">
                                        <label class="control-label" style="text-align: left;">@Model.RequestNoteNos</label>

                                    </td>

                                </tr>


                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Remark </label>
                                    </td>
                                    @*<td width="10%"></td>*@
                                    <td style="text-align:left">
                                        <label class="control-label"> @Model.Remark </label>

                                    </td>

                                </tr>





                            </table>

                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <table id="signature" style="width:100%">
                                    <tr style="width:100%">
                                        <td style="text-align:center">
                                            ..................................<br />
                                            Entered By
                                        </td>
                                        <td style="text-align:center">
                                            ..................................<br />
                                            Checked By
                                        </td>
                                        <td style="text-align:center">
                                            ..................................<br />
                                            Approved By
                                        </td>
                                    </tr>
                                </table>
                                <div class="clearfix"></div>
                                <br />
                                <hr />
                                @*<div style="font-size:small; text-align:left">
                    Delivery Details:<br /> @Model.DeliveryDetail
                </div>*@
                                <br />
                                }

                        </div>


                    </div>
                </div>
            </div>

            <div class="actionBar">
                <div class="msgBox">
                    <button type="submit" class="btn btn-primary pull-right">Back</button>
                    <div class="btn-group">
                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#" onclick="$('#tblstock').tableExport({ type: 'excel', escape: 'false' });">
                                    <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                </a>
                            </li>
                            <li>
                                <a href="#" id="btnPrint" onclick="PrintDiv();">
                                    <img src='~/Content/Images/icons/pdf.png' width="10" />
                                    Print/PDF
                                </a>                                
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>

    }

</body>


@*<script>
        $(window).load(function() {
            $(".se-pre-con").fadeOut("slow");;
        });
    </script>*@


<script type="text/javascript">

  

    function PrintDiv() {

      


        var divToPrint = document.getElementById("printcontent");
        newWin = window.open("");
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();

    }

    
</script>



