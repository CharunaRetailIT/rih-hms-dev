@model List<RIT.HMS.Domain.KOTBOTDescription>
    @{
        ViewBag.Title = "Edit";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }


    <h2></h2>

    <body class="nav-md">

        <div class="right_col" role="main">
            <div class="">
                <div class="clearfix"></div>

                <div class="row">
                    <!-- form input mask -->
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        @using (Html.BeginForm("Edit", "ProductInstruction", FormMethod.Post))
                        {
                            <div class="x_panel">

                                <div class="x_content">
                                    <br />

                                    <div class="x_panel">
                                        <div class="x_title">
                                            <h2>Product Instructions<small>Existing</small></h2>
                                            <ul class="nav navbar-right panel_toolbox">
                                                <li>
                                                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                                </li>
                                               
                                                <li>
                                                    <a class="close-link"><i class="fa fa-close"></i></a>
                                                </li>
                                            </ul>
                                            <div class="clearfix"></div>
                                        </div>
                                        <div class="x_content">
                                            <table id="datatable-responsive"
                                                   class="table table-striped table-bordered dt-responsive nowrap">
                                                <thead>
                                                    <tr>
                                                        <th>Id</th>                                                      
                                                        <th>Instructions</th>
                                                        <th>Product Id</th>
                                                        <th></th>

                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@Html.DisplayFor(modelItem => item.KOTBOTDescriptionId)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.ProductId)</td>
                                                                                                                        
                                                            <td>@Html.ActionLink("Remove", "RemoveIns", new { id = item.KOTBOTDescriptionId, productid = item.ProductId })</td>

                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            @*<button type="submit" class="btn btn-success">Apply Changes</button>*@
                        }
                        <div class="clerfix">

                            <div class="actionBar">
                                <div class="msgBox">

                                    <div class="btn btn-primary pl_add btn-small pull-left">
                                        @Html.ActionLink("Add Product Instructions", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                    </div>
                                    <div class="btn btn-info pl_add btn-small pull-left">
                                        @Html.ActionLink("Back To Products", "Vieww", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                    </div>

                                </div>
                            </div>

                            @*<div class="btn btn-info pl_add btn-small pull-left">


                                    <div class="btn btn-primary pl_add btn-small pull-left">

                                    </div>
                                    <div class="btn btn-info pl_add btn-small pull-left">

                                    </div>

                                </div>*@
                        </div>
                    </div>
                </div>

            </div>
        </div>


    </body>

