<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>

    $.getJSON("@Url.Action("GetAddons", "Product")", function (data) {

        var itemId = $("#AddonId");


        itemId.empty();
        itemId.append("<option value='0'>-- Select an Item --</option>");


        $.each(JSON.parse(data), function (index, optionaldata) {
            itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName + '(' + optionaldata.UOM+')'));

        });

        if ('@ViewBag.AddonId') {
            $('#AddonId').val(@ViewBag.AddonId).trigger("change");
        } else {
            $('#AddonId').val(0).trigger("change");
        }


    });
</script>

<script>
    $.getJSON("@Url.Action("GetActiveDepartments", "Department")", function (data) {

        var departmentGroupDropDown = $("#DepartmentId");

        departmentGroupDropDown.empty();
        departmentGroupDropDown.append("<option value='0'>-- Select a Department--</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            departmentGroupDropDown.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));

        });

        if ('@ViewBag.DepartmentId') {
            $('#DepartmentId').val(@ViewBag.DepartmentId).trigger("change");
        } else {
            $('#DepartmentId').val(0).trigger("change");
        }
    });


</script>


<script>


    $.getJSON("@Url.Action("GetProductInstructions", "ProductInstruction")", function (data) {
        var Instruction = $("#Instruction");
        Instruction.empty();
    
        Instruction.append("<option value='0'>-- Select Instructions --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            Instruction.append($('<option />', { value: optionaldata.KOTBOTDescriptionId }).html(optionaldata.Description));

        });


    });



    $.getJSON("@Url.Action("GetActiveDepartments", "Department")", function (data) {

        var DepartmentId = $("#Department");
        var CategoryId = $("#Category");
        var subCategoryId = $("#SubCategory");

        DepartmentId.empty();
        DepartmentId.append("<option value='0'>-- Select a department --</option>");
        CategoryId.append("<option value='0'>-- Select All --</option>");
        subCategoryId.append("<option value='0'>-- Select All --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            DepartmentId.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));

        });

    });

    $("#Department").change(function () {
        var diptId = this.value;

       $.getJSON("@Url.Action("GetMenuByDeptId", "Product")", { id: diptId },
       function (data)
       {

           var itemId = $("#Product");


           itemId.empty();
           itemId.append("<option value='0'>-- Select All Products --</option>");


           $.each(JSON.parse(data), function (index, optionaldata) {
               itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));

           });

       }
    );
    });

    $("#Department").change(function () {
        var diptId = this.value;

        $.getJSON("@Url.Action("GetCategoriesByDepartmentId", "Category")", { id: diptId },
            function (data) {

                var CategoryId = $("#Category");

                CategoryId.empty();
                CategoryId.append("<option value='0'>-- Select All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    CategoryId.append($('<option />', { value: optionaldata.RstCategoryID }).html(optionaldata.RstCategoryName));
                });


            });
    });


    $("#Category").change(function () {
        var deptid = $("#Department").val();
        var catid = this.value;

        $.getJSON("@Url.Action("GetSubcatByCatId", "Product")", { id: catid },
            function (data) {

                var subCategoryId = $("#SubCategory");

                subCategoryId.empty();
                subCategoryId.append("<option value='0'>-- Select All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    subCategoryId.append($('<option />', { value: optionaldata.RstSubCategoryID }).html(optionaldata.RstSubCategoryName));
                });

            });

             $.getJSON("@Url.Action("GetMenuByDeptCatId", "Product")", { deptid: deptid, catid: catid },
              function (data)
              {

                  var itemId = $("#Product");


                  itemId.empty();
                  itemId.append("<option value='0'>-- Select All Products --</option>");


                  $.each(JSON.parse(data), function (index, optionaldata) {
                      itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));

                  });

              }
            );


    });


    $("#SubCategory").change(function () {
        var deptid = $("#Department").val();
        var catid = $("#Category").val();
        var scatid = this.value;

        $.getJSON("@Url.Action("GetMenuByDeptCatScatId", "Product")", { deptid: deptid, catid: catid, scatid: scatid },
              function (data)
              {

                  var itemId = $("#Product");


                  itemId.empty();
                  itemId.append("<option value='0'>-- Select All Products --</option>");


                  $.each(JSON.parse(data), function (index, optionaldata) {
                      itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));

                  });

              }
            );



    });

  



</script>


<script type="text/javascript">
    $("body").on("click",
        "#btnAddItem",
        function () {

            //if ($("#Product").val() == 0 || $("#Product").val() == null) {
            //    alert("Select a Product !");
            //    return;
            //}

            if ($("#Department").val() == 0 || $("#Department").val() == null) {
                alert("Select a Department !");
                return;
            }

           

           

            var Product = $("#Product").val();
            var Department = $("#Department").val();
            var Category = $("#Category").val();
            var SubCategory = $("#SubCategory").val();

          
            //var addonDesc = $("#AddonId option:selected").text();
            //var productDesc = $("#ProductId option:selected").text();
            //var AddonQty = $("#AddonQuantity").val();
            //var AddonSP = $("#AddonSellingPrice").val();
          

            $.ajax({
                url: "@Url.Action("GetProducts", "ProductInstruction")",
                data: { deptid: Department, catid: Category, subcatid: SubCategory, pid: Product },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {

                data = resp;

                $("#products tr").remove();

                $.each(data, function (i, item) {


                    var unitindex = $("#products").children("tr").length;
                    var unitindexCell = "<td style='display:none' ><input name='products.Index' type='hidden' value='" +
                        unitindex + "' /></td>";

                    var unitProductIdCell = "<td style='display:none'><input id='Idetail" + unitindex + "_ProductId' class='form-control' name='Idetail[" +
                        unitindex + "].ProductId' type='text' readonly value='" + item.ProductId + "' /></td>";

                    var unitProductDescCell = "<td id='Idetail" + unitindex + "_ProductDesc'    name='Idetail[" +
                        unitindex + "].ProductDesc'>" + item.ProductName + "</td>";

                    var unitInstructionListCell = "<td style='display:none'><input id='Idetail" + unitindex + "_InstructionList'  class='form-control'  name='Idetail[" +
                        unitindex + "].InstructionList' type='text' readonly value='" + "" + "' /></td>";



                    var unitRemoveCell = "<td><input id='btnAddItem1' type='button' value='-' class='btn btn-round btn-info'  onclick='removeUnitRow(" +
                                          unitindex + ");' /></td>";


                    var newUnitRow = "<tr id='trAddons" + unitindex + "'>" +
                        //unitDeptIdCell +
                        unitProductIdCell +
                        unitProductDescCell +
                        unitInstructionListCell +
                        unitRemoveCell + "</tr>";

                    $("#products").append(newUnitRow);

                });

            },
            error: function (error) {
                alert("Error");
            }
            });


        });

</script>


<script>

    function removeUnitRow(id) {

        if (confirm("Do you want to delete? "))
        {
            var controlToBeRemoved = "#trAddons" + id;
            $(controlToBeRemoved).remove();

            //var table = document.getElementById("Addons");


        }

    }

</script>