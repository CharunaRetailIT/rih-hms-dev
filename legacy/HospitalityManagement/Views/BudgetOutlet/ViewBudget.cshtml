@model IEnumerable<RIT.HMS.Domain.BudgetOutlet>
@{
    ViewBag.Title = "Budget Outlet Wise View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2></h2>
@using (Html.BeginForm("CreateNew", "BudgetOutlet", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <body class="nav-md">

        <div class="right_col" role="main">
            <div class="">
                <div class="clearfix"></div>
                <div class="row">
                    <!-- form input mask -->
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="x_panel">
                            <div class="x_content">
                                <br />
                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Budget Outlet Wise<small>Existing</small></h2>
                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>
                                    <div class="form-group ">
                                        <div class="">
                                        </div>
                                    </div><div class="clerfix"></div><br />
                                    <div class="x_content">
                                        <br />
                                        <table id="datatable-responsive"
                                               class="table table-striped table-bordered dt-responsive nowrap mstable">
                                            <thead>
                                                <tr>
                                                    <th>location ID</th>
                                                    <th>Budget Type</th>
                                                    <th>Total Budget</th>
                                                    <th>Starting Date</th>
                                                    <th>End Date</th>
                                                    @*<th></th>*@
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.locationID)</td>
                                                    <td>@((HospitalityManagement.Models.BudegtTypeEnum)item.BudgetType)</td>
                                                    <td>@item.totalbudget.ToString("#,##0")</td>
                                                    <td>@item.StartingDate.ToShortDateString()</td>
                                                    <td>@item.EndDate.ToShortDateString()</td>
                                                    @*<td>@Html.ActionLink("Edit", "Edit", new { BudgetOutletID = item.BudgetOutletID })</td>*@
                                                </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="clerfix">
                            <div class="btn btn-info pl_add btn-small pull-left">
                                @Html.ActionLink("Add Budget Outlet Wise", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </body>
}