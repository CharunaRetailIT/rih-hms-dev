@model IEnumerable<RIT.HMS.Domain.Currency>
@{
    ViewBag.Title = "Currencies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


                      <link href="~/Content/MasterFile.css" rel="stylesheet" />

<h2></h2>

<body class="nav-md">

    <div class="right_col" role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">
                <!-- form input mask -->
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">

                        <div class="x_content">
                            <br />

                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Currencies - <small>Existing</small></h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                        @*<li class="dropdown">
                                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                                            <ul class="dropdown-menu" role="menu">
                                                <li>
                                                    <a href="#">Settings 1</a>
                                                </li>
                                                <li>
                                                    <a href="#">Settings 2</a>
                                                </li>
                                            </ul>
                                        </li>*@
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    @*<table id="datatable-responsive"
                                           class="table table-striped table-bordered dt-responsive nowrap">*@
                                    <table id="datatable-responsive" class="mstable col-xs-12 col-lg-12 col-md-12 col-sm-12">
                                        <thead>
                                            <tr>
                                                <th>Currency Code</th>
                                                <th>Description</th>
                                                <th>Symbol</th>
                                                <th>Buying Rate</th>
                                                <th>Selling Rate</th>
                                                <th>Active</th>
                                                <th></th>

                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.CurrencyCode)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.CurrencyDescription)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.CurrencySymbol)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.BuyingRate)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.SellingRate)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                                    <td>@Html.ActionLink("Edit", "Edit", new { id = item.CurrencyId })</td>

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>


                        </div>
                    </div>
                    <div class="clerfix">
                        <div class="btn btn-info pl_add btn-small pull-left">
                            @Html.ActionLink("Add New Currency", "Currency", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>


</body>

