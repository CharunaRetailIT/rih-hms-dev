@model IEnumerable<RIT.HMS.Domain.Addons>
@{
    ViewBag.Title = "Addon Based Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
                      <link href="~/Content/MasterFile.css" rel="stylesheet" />

<h2></h2>

<body class="nav-md">

    <div class="right_col" role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">
                <!-- form input mask -->
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">

                        <div class="x_content">
                            <br />

                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Addons Based Products</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                        @*<li class="dropdown">
                                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                                                <ul class="dropdown-menu" role="menu">
                                                    <li>
                                                        <a href="#">Settings 1</a>
                                                    </li>
                                                    <li>
                                                        <a href="#">Settings 2</a>
                                                    </li>
                                                </ul>
                                            </li>*@
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    @*<table id="datatable-responsive"
                                           class="table table-striped table-bordered dt-responsive nowrap">*@
                                    <table id="datatable-responsive" class="mstable">
                                        <thead>
                                            <tr>
                                                <th>Product Code</th>
                                                <th>Product</th>
                                                <th></th>

                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    @*<td>@Html.DisplayFor(modelItem => item.AddonsId)</td>*@
                                                    <td>@Html.DisplayFor(modelItem => item.ProductCode)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.ProductDesc)</td>
                                                    <td>@Html.ActionLink("View Addons", "ViewProductAddons", new { id = item.ProductId })</td>

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>

                            </div>

                            <div class="actionBar">
                                <div class="msgBox">
                                    <div class="pull-left">
                                        <input type="button" class="btn btn-primary" value="Create New Product Addons" onclick="location.href='@Url.Action("Create", null, new { })'" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                   
                </div>
            </div>

        </div>
    </div>


</body>
