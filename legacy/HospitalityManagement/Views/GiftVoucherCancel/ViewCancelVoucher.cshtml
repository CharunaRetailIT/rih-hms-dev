@model IEnumerable<RIT.HMS.Domain.Transactions.InvGiftVoucherMaster>
@{
    ViewBag.Title = "Voucher Cancel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2></h2>
@*@using (Html.BeginForm("CreateNew", "GiftVoucherCancel", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))*@
@using (Html.BeginForm("", "GiftVoucherCancel", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <body class="nav-md">

        <div class="right_col" role="main">
            <div class="">
                <div class="clearfix"></div>
                @if (@ViewBag.Message == "3")
                {
                    <div class="alert alert-success alert-dismissible fade in" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                        <strong></strong> @ViewBag.Gift Voucher Cancel saved successfully.
                    </div>
                }
                else if (@ViewBag.Message == "0")
                {
                    <div class="alert alert-danger alert-dismissible fade in" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                        <strong></strong> @ViewBag.Gift Voucher Cancel save failed.
                    </div>
                }
                else if (@ViewBag.Message == "1")
                {
                    <div class="alert alert-danger alert-dismissible fade in" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                        <strong></strong> @ViewBag.Gift This is not a Valid Voucher No..
                    </div>
                }
                <div class="row">
                    <!-- form input mask -->
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="x_panel">
                            <div class="x_content">
                                <br />
                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Gift Voucher Cancel</h2>

                                        <div class="form-horizontal form-label-left col-md-12">
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Gift Voucher No *</label>
                                                <div class="col-md-3 col-sm-3 col-xs-3 text-left">
                                                    <input type="text" class="form-control has-feedback-left text-right" value="" id="txtVoucherNo" placeholder="Gift Voucher No">
                                                    @*@Html.TextBoxFor(model => , new { id = "txtGiftVoucherPercentage", @class = "form-control", MaxLength = 50 })*@
                                                </div>
                                                <div class="btn btn-info pl_add btn-small pull-left">
                                                    @Html.ActionLink("View", "ViewVoucher", new { VoucherNo = "" }, new { id = "myLink" })
                                                    @*@Html.ActionLink("ViewNew", "ViewVoucher" , new { @onclick = "OnIndexCall(this)" })*@
                                                </div>
                                                <div class="form-group">
                                                </div>
                                            </div>
                                        </div>
                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>
                                    <div class="form-group ">
                                        <div class="">
                                        </div>
                                    </div><div class="clerfix"></div><br />
                                    <div class="x_content">
                                        <br />
                                        <table id="datatable-responsive"
                                               class="table table-striped table-bordered dt-responsive nowrap mstable">
                                            <thead>
                                                <tr>
                                                    <th style="display:none">Gift Voucher Master ID</th>
                                                    <th>Voucher No</th>
                                                    <th>Voucher Prefix</th>
                                                    <th>Gift Voucher Value</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td style="display:none">@Html.DisplayFor(modelItem => item.InvGiftVoucherMasterID)</td>
                                                        <td>@item.VoucherNo</td>
                                                        <td>@item.VoucherSerial</td>
                                                        <td>@item.GiftVoucherValue</td>
                                                        <td>@Html.ActionLink("Cancel", "Edit", new { VoucherPrefix = item.VoucherSerial }, new { @style = "font-size: 12px;color:Red;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </body>
}
<script type="text/javascript">

    document.addEventListener("DOMContentLoaded", function () {
        var txtVoucherNo = document.getElementById("txtVoucherNo");
        var myLink = document.getElementById("myLink");
        console.log('Tharaka');
        txtVoucherNo.addEventListener("input", function () {
            var voucherNo = txtVoucherNo.value;
            var url = myLink.href;

            // Update the URL with the voucher number
            var updatedUrl = url.split('?')[0] + '?VoucherNo=' + encodeURIComponent(voucherNo);
            myLink.href = updatedUrl;
        });
    });
</script>