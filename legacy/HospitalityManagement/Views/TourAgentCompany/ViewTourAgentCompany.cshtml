@model IEnumerable<RIT.HMS.Domain.TourAgentCompany>
    @{
        ViewBag.Title = "ViewTourAgentCompany";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <link href="~/Content/MasterFile.css" rel="stylesheet" />

    <h2></h2>
    @using (Html.BeginForm("", "TourAgentCompany", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <body class="nav-md">
            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_content">
                                    <br />
                                    <div class="x_panel">
                                        <div class="x_title">
                                            <h2>Tour Agent Company<small>Existing</small></h2>
                                            <ul class="nav navbar-right panel_toolbox">
                                                <li>
                                                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                                </li>

                                                <li>
                                                    <a class="close-link"><i class="fa fa-close"></i></a>
                                                </li>
                                            </ul>
                                            <div class="clearfix"></div>
                                        </div>
                                        <div class="form-group ">
                                            <div class="">

                                            </div>
                                            <div class="pull-right">
                                                <input type="submit" value="Download Data" formaction="HMSTourAgentCompany" class="btn btn-primary">
                                            </div>
                                        </div><div class="clerfix"></div><br />
                                        <div class="x_content">
                                            <br />
                                            <table id="datatable" class="mstable">
                                                <thead>
                                                    <tr>
                                                        <th>Code</th>
                                                        <th>Name</th>
                                                        <th>Address</th>
                                                        <th>Contact No</th>
                                                        <th>E-mail</th>
                                                        <th>Commision Amount</th>
                                                        <th>IsActive</th>
                                                        <th></th>
                                                        @*<th></th>*@
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@Html.DisplayFor(modelItem => item.TourAgentCompanyCode)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.TourAgentCompanyName)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.Address1)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.Mobile)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.CommissionAmount)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                                            <td>@Html.ActionLink("Edit", "Edit", new { id = item.TourAgentCompanyID})</td>
                                                            @*<td>@Html.ActionLink("View", "Details", new { id = item.SysGroupOfCompanyId })</td>*@
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="clerfix">
                                <div class="btn btn-info pl_add btn-small pull-left">
                                    @Html.ActionLink("Add Tour Agent Company", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>


        </body>

    }


