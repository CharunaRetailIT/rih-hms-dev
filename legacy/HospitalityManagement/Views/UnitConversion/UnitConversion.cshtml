<script src="~/Scripts/json2.js"></script>

<script>

    loadbaseunits();
    $.getJSON("@Url.Action("GetUnitOfMeasures", "UnitConversion")", function (data) {
        var measurement = $("#UnitOfMeasureId");
        measurement.empty();
        measurement.append("<option value='0'>-- Select a Unit of Measure --</option>");
        $.each(JSON.parse(data), function (index, optionaldata) {
            measurement.append($('<option />', { value: optionaldata.UnitOfMeasureId }).html(optionaldata.UnitOfMeasureName));
        });

        @*if ('@ViewBag.SysUserGroupId') {
            $('#SysUserGroupId').val(@ViewBag.SysUserGroupId).trigger("change");
        } else {
            $('#SysUserGroupId').val(0).trigger("change");
        }*@


    });


    function loadbaseunits(){

        $.getJSON("@Url.Action("GetUnitOfMeasures", "UnitConversion")", function (data) {

            var BaseUnitName = $("#BaseUnitName");

            BaseUnitName.empty();
            BaseUnitName.append("<option value='0'>-- Select a Unit of Measure --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                BaseUnitName.append($('<option />', { value: optionaldata.UnitOfMeasureId }).html(optionaldata.UnitOfMeasureName));
            });

        });
    }
  
    $("#UnitOfMeasureId ").change(function () {
        var measurementid = this.value;
        $.getJSON("@Url.Action("GetUnitOfConversionsById", "UnitConversion")", { id: measurementid },
            function (data) {

              // alert('aaaa');
                $("#conversionrows tr").remove();
                $.each(JSON.parse(data), function (index, optionaldata)
                {
                    var conversionId = optionaldata.UnitConversionId;
                    var baseUnitName = optionaldata.SubUnit;
                    var baseUnitValue = optionaldata.SubUnitValue;
                    var baseUnitSymbol = optionaldata.SubUnitSymbol;

                    //Get the reference of the Table's TBODY element.
                    var tBody = $("#tblUnitConversions > TBODY")[0];

                    //Add Row.
                    var row = tBody.insertRow(-1);

                    var cell = $(row.insertCell(-1));
                    cell.html(conversionId);
                    cell.attr("style", "display:none");

                    //Add Name cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(baseUnitName);

                    //Add Country cell.
                    cell = $(row.insertCell(-1));
                    cell.html(baseUnitValue);

                    //Add Country cell.
                    cell = $(row.insertCell(-1));
                    cell.html(baseUnitSymbol);


                    //Add Button cell.
                    cell = $(row.insertCell(-1));
                    var btnRemove = $("<input class='btn btn-round btn-info'/>");
                    btnRemove.attr("type", "button");

                    btnRemove.attr("onclick", "Remove(this);");
                    btnRemove.val("-");
                    cell.append(btnRemove);

                    //Clear the TextBoxes.
                    baseUnitName = "";
                    baseUnitValue = "";
                    baseUnitSymbol = "";
                });
            });
    });
</script>

<script type="text/javascript">
        $("body").on("click", "#btnAdd", function () {
            //Reference the Name and Country TextBoxes.

            $('#textTableError').html('');
            if ($("#UnitOfMeasureId").val() == 0) {
                alert("Select a unit of measure !");
                return;
            }

            if ($("#BaseUnitName").val() == "") {
                alert("Base Unit Name required!");
                return;
            }

            if ($("#BaseUnitValue").val() == "") {
                alert("Base Unit Value required!");
                return;
            }
            //if ($("#BaseUnitSymbol").val() == "") {
            //    alert("Base Unit Symbol required!");
            //    return;
            //}

            var baseUnitName = $("#BaseUnitName");
            var baseUnitValue = $("#BaseUnitValue");
            var baseUnitSymbol = $("#BaseUnitSymbol");

            var getValidationResult = IsValidateAddItem(baseUnitName.find(":selected").text(), baseUnitValue.val())
            if (!getValidationResult) {
                //Get the reference of the Table's TBODY element.
                var tBody = $("#tblUnitConversions > TBODY")[0];

                console.log(tBody);
                //Add Row.
                var row = tBody.insertRow(-1);

                var cell = $(row.insertCell(-1));
                cell.html(0);
                cell.attr("style", "display:none");

                //Add Name cell.
                var cell = $(row.insertCell(-1));
                cell.html(baseUnitName.find(":selected").text());

                //Add base unit value cell.
                cell = $(row.insertCell(-1));
                cell.html(baseUnitValue.val());

                //Add sub unit simbole cell.
                cell = $(row.insertCell(-1));
                cell.html(baseUnitValue.val() + ' ' + baseUnitName.find(":selected").text());

                //Add Button cell.
                cell = $(row.insertCell(-1));
                var btnRemove = $("<input class='btn btn-round btn-info'/>");
                btnRemove.attr("type", "button");

                btnRemove.attr("onclick", "Remove(this);");
                btnRemove.val("-");
                cell.append(btnRemove);

                //Clear the TextBoxes.
                baseUnitName.val("");
                baseUnitValue.val("");
                baseUnitSymbol.val("");

                loadbaseunits();
            }
            else {
                $('#textTableError').html('Inserted Sub Unit is already existing list.');
                $('#BaseUnitName').focus();
            }
        });


    function IsValidateAddItem(baseUnitName, baseUnitValue, baseUnitSymbol) {
        var result = false;

        $("#tblUnitConversions TBODY TR").each(function () {
            var row = $(this);
            var UnitConversion = {};
            if (row.find("TD").eq(1).html() === baseUnitName && row.find("TD").eq(2).html() === baseUnitValue) {
                result = true;
            }
        });

        return result;
    }

        function Remove(button) {
            //Determine the reference of the Row using the Button.
            var row = $(button).closest("TR");
            var cid = $("TD", row).eq(0).html();
            var cname = $("TD", row).eq(1).html();
            if (confirm("Do you want to delete: " + cname)) {
                //Get the reference of the Table.
                var table = $("#tblUnitConversions")[0];

                
                $.ajax({
                    type: "GET",
                    url: "/UnitConversion/CheckConversion",
                    data: { id: cid },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (r) {
                        debugger
                      //  alert(r);
                        if (r == 0) {
                            table.deleteRow(row[0].rowIndex);
                            alert("Unit Conversion Removed !");
                        } else
                        {
                            alert("Can not delete. "+ r +" Product(s) has this unit Conversion !");
                        }
                    }
                });


                
            }
        };

        $("body").on("click", "#btnSave", function () {
            //Loop through the Table rows and build a JSON array.
            var unitConversions = new Array();
            $("#tblUnitConversions TBODY TR").each(function () {
                var row = $(this);
                var UnitConversion = {};
                UnitConversion.UnitConversionId = row.find("TD").eq(0).html();
                UnitConversion.SubUnit = row.find("TD").eq(1).html();
                UnitConversion.SubUnitvalue = row.find("TD").eq(2).html();
                UnitConversion.SubUnitSymbol = row.find("TD").eq(3).html();
                UnitConversion.UnitOfMeasureId = $("#UnitOfMeasureId").val();
                UnitConversion.BaseUnitValue = 1;
                unitConversions.push(UnitConversion);
            });

            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/UnitConversion/SaveConversions",
                data: JSON.stringify(unitConversions),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (r) {
                    debugger
                    // $("#CountryName").val(data.con);
                    $("#tblUnitConversions TBODY TR").remove();
                    alert("Unit Conversion saved !");
                }
            });
        });
</script>

