
@model RIT.HMS.Domain.ServingUnit

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@*<!DOCTYPE html>
    <html lang="en">*@
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System </title>


</head>
@*<body class="nav-md">*@
<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm("Create", "ServingUnit", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            @if (@ViewBag.Message == "1")
                            {
                                <div class="alert alert-success alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Serving Unit</strong>  saved successfully.
                                </div>
                            }
                            else if (@ViewBag.Message == "2")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Serving Unit</strong> save failed.
                                </div>
                            }
                            else if (@ViewBag.Message == "3")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Serving Unit</strong> already exists.
                                </div>
                            }
                            else if (@ViewBag.Message == "4")
                            {
                                <div class="alert alert-warning alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Serving Unit</strong> Can't be select Active and Delete options in the same time..!
                                </div>
                            }
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Serving Units</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <br />
                                    <form class="form-horizontal form-label-left">
                                        @*<div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Serving Unit ID</label>
                                            <div class="col-md-5 col-sm-9 col-xs-9">

                                                @Html.TextBoxFor(model => model.ServingUnitId, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "Serving Unit ID",
                                               MaxLength = 10,
                                               onkeypress = "return checkCodeTypeInput(event)",
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.ServingUnitId, "", new { @class = "text-danger" })
                                            </div>
                                        </div>*@

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Serving unit Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.ServingUnitName, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "Serving Unit Name",
                                               MaxLength = 50,
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })

                                                @*@Html.TextBoxFor(model => model.CompanyName, new { @class = "form-control", MaxLength = 50, Placeholder = "Company Name" })*@
                                                @Html.ValidationMessageFor(model => model.ServingUnitName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Active</label>
                                            <div class="checkbox col-xs-1 pull-left ">
                                                @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })

                                            </div>
                                        </div>



                                        <div tabindex="0">
                                            @*<div class="ln_solid"></div>*@ <br />
                                            <div class="actionBar">
                                                <div class="msgBox">

                                                    <div class="pull-left">
                                                        @*@Html.ActionLink("Clear", "Index", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })*@
                                                        <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("Create",null, new { })'" />
                                                    </div>
                                                    <div class=" pull-left">
                                                        @*@Html.ActionLink("View All", "ViewCompanies", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })*@
                                                        <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("Index",null, new { })'" />
                                                    </div>
                                                    <button type="submit" class="btn btn-success">Submit</button>

                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>

@*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>*@

<script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>




<script>
    $.getJSON("@Url.Action("GetGroupOfCompanies", "GroupOfCompany")", function (data) {

        var companyDropDown = $("#SysGroupOfCompanyId");

        companyDropDown.empty();
        companyDropDown.append("<option value='0'>-- Select a Group of Company --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            companyDropDown.append($('<option />', { value: optionaldata.SysGroupOfCompanyId }).html(optionaldata.GroupOfCompanyName));
        });

        if ('@ViewBag.SysGroupOfCompanyId') {
            $('#SysGroupOfCompanyId').val(@ViewBag.SysGroupOfCompanyId).trigger("change");
        } else {
            $('#SysGroupOfCompanyId').val(0).trigger("change");
        }


    });

</script>

<script>

    $(function () {
        var groupofcompanyValue = localStorage.getItem("groupofcompanyValue");
        if (groupofcompanyValue != null) {
            $("select[name=SysGroupOfCompanyId]").val(groupofcompanyValue);
        }

        $("select[name=SysGroupOfCompanyId]").on("change", function () {
            localStorage.setItem("groupofcompanyValue", $(this).val());
        });
    })
</script>




