<script>
    $(document).ready(function(){
        $('#ServingUnitId').change(function()
        {
            if($('#ProductId').val()==0 || $('#ProductId').val()==null)
            {
                return;
            }


            $.ajax({
                type: "GET",
                url: "/ServingUnitsPrices/GetServingUnitsByPrdId",
                data: { id: $('#ProductId').val(), unit:$('#ServingUnitId option:selected').text() },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    debugger
                    $("#locwisesu tr").remove();

                    $.each(data, function (i, item) {
                        debugger;

                        var unitindex = $("#locwisesu").children("tr").length;
                        var unitindexCell = "<td style='display:none'><input name='ServingUnitsDetail.Index' value='" +
                            item.LocationId + "' /></td>";

                        var unitLocIdCell = "<td style='display:none;'><input id='ServingUnitsDetail[" + item.LocationId + "]_LocationId'  class='form-control'  name='ServingUnitsDetail[" +
                            item.LocationId + "].LocationId' type='text' value='" + item.LocationId + "' /></td>";

                        var unitLocDescCell = "<td><input id='ServingUnitsDetail[" + item.LocationId + "]_Location'  class='form-control'  name='ServingUnitsDetail[" +
                            item.LocationId + "].Location' type='text' readonly value='" + item.Location + "' /></td>";

                        if(item.ServingUnit=="N/A"){
                            var unitServingUnitCell = "<td><input id='ServingUnitsDetail[" + item.LocationId + "]_ServingUnit'  class='form-control'  name='ServingUnitsDetail[" +
                                item.LocationId + "].ServingUnit' type='text' readonly value='" + $('#ServingUnitId option:selected').text() + "' /></td>";
                        }else
                        {
                            var unitServingUnitCell = "<td><input id='ServingUnitsDetail[" + item.LocationId + "]_ServingUnit'  class='form-control'  name='ServingUnitsDetail[" +
                                item.LocationId + "].ServingUnit' type='text' readonly value='" + item.ServingUnit + "' /></td>";
                        }
                        var unitCostPriceCell = "<td><input id='ServingUnitsDetail[" + item.LocationId + "]_CostPrice'  class='form-control'  name='ServingUnitsDetail[" +
                            item.LocationId + "].CostPrice' type='number' style='text-align:right;' step='0.0001' min='0'  oninput='javascript: if (this.value.length >9) this.value = this.value.slice(0, 5);' value='" + item.CostPrice + "' /></td>";

                        var unitSellingPriceCell = "<td><input id='ServingUnitsDetail[" + item.LocationId + "]_SellingPrice'  class='form-control'  name='ServingUnitsDetail[" +
                            item.LocationId + "].SellingPrice' type='number'  style='text-align:right;' step='0.0001' min='0'  oninput='javascript: if (this.value.length >9) this.value = this.value.slice(0, 5);'  value='" + item.SellingPrice + "' /></td>";

                        var newUnitRow = "<tr id='trSUnit" + item.LocationId + "'>" +
                           unitindexCell +
                           unitLocIdCell +
                           unitLocDescCell +
                           unitServingUnitCell +
                           unitCostPriceCell +
                           unitSellingPriceCell +"</tr>";

                        $("#locwisesu").append(newUnitRow);

                    });
                }
            });

        });
        //By Aruna load serving unit by passing productID
        $("#ProductId").change(function () {
            var ProductId = this.value;

            $.getJSON("@Url.Action("GetServingUnitsByPrductId", "ServingUnitsPrices")", { id: ProductId },
                function (data) {

                    var ServingUnitId = $('#ServingUnit');
                    ServingUnitId.empty();
                    ServingUnitId.append("<option value='0'>-- Select Serving unit --</option>");

                    $.each(JSON.parse(data), function (index, optionaldata) {
                        ServingUnitId.append($('<option />', { value: optionaldata.ServingUnit }).html(optionaldata.ServingUnit));
                    });
                    @*if ('@ViewBag.ServingUnitId') {
                        $('#ServingUnitId').val(@ViewBag.ServingUnitId).trigger("change");
                    } else {
                        $('#ServingUnitId').val(0).trigger("change");
                    }*@
                });
        });

        $("#ServingUnit").change(function () {
            var ServingUnit = this.value;
            var ProductId = $("#ProductId option:selected").val();
         //   debugger;
           $.getJSON("@Url.Action("GetSellingAndCostPriceByServUnitPrdId", "ServingUnitsPrices")", { id: ProductId,unit: ServingUnit},
                function (data) {
                 //   debugger;
                     
                    $.each(JSON.parse(data), function (index, optionaldata) {
                      //  debugger;

                        //console.log(optionaldata.CostPrice);

                        $("#CostPrice").val(optionaldata.CostPrice.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                        $("#SellingPrice").val(optionaldata.SellingPrice.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

                    });
                   
            });
    });

    });

</script>
