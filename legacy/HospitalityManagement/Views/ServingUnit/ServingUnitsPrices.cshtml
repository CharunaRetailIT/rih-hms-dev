
@model RIT.HMS.Domain.ViewModels.ServingUnitPricesViewModel
@{
    ViewBag.Title = "Serving Units Price Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/MasterFile.css" rel="stylesheet" />



<body class="nav-md">
