                                                <div class="col-md-6 col-sm-6 col-xs-6">
                                                    @*@Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })*@
                                                    <select id="ProductId" name="ProductId" class="form-control select2"></select>
                                                </div>
                                            </div>
                                            <div class="clearfix"></div><br />
                                            <div class="form-group">
                                                <label class="col-md-3 col-sm-3 col-xs-3">Serving Unit</label>
                                                @*<div class="col-md-4 col-sm-4 col-xs-4">*@
                                                <div class="col-md-6 col-sm-6 col-xs-6">
                                                    @*@Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })*@
                                                    @*<select id="ServingUnitId" name="ServingUnitId" class="form-control"></select>*@
                                                    <select id="ServingUnit" name="ServingUnit" class="form-control"></select>
                                                </div>
                                            </div>
                                            <div class="clearfix"></div><br />
                                            <div class="form-group">
                                                @*<label class="control-label col-md-3 col-sm-3 col-xs-3">Cost Price *</label>*@
                                                <label class="col-md-3 col-sm-3 col-xs-3">Cost Price</label>
                                                <div class="col-md-6 col-sm-6 col-xs-6">
                                                    @Html.TextBoxFor(model => model.CostPrice, new { @class = "form-control", id= "CostPrice" })
                                                    @Html.ValidationMessageFor(model => model.CostPrice, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <div class="clearfix"></div><br />
                                            <div class="form-group">
                                                @*<label class="control-label col-md-3 col-sm-3 col-xs-3">Selling Price *</label>*@
                                                <label class="col-md-3 col-sm-3 col-xs-3">Selling Price</label>
                                                <div class="col-md-6 col-sm-6 col-xs-6">
                                                    @Html.TextBoxFor(model => model.SellingPrice, new { @class = "form-control", id = "SellingPrice" })
                                                    @Html.ValidationMessageFor(model => model.SellingPrice, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <br />
                                            <hr />
                                            <div class="clerfix"></div>
                                            @*<div id="divtable">
                                                    <table id="datatable-responsive1" class="mstable">
                                                        <thead>
                                                            <tr>
                                                                <th style="display:none">LocationId</th>
                                                                <th>Location</th>
                                                                <th>Serving Unit</th>
                                                                <th>Cost Price</th>
                                                                <th>Selling Price</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="locwisesu">

                                                        </tbody>
                                                    </table>
                                                </div>*@
                                        </div>
                                    </div>
                                </div>
                                <div tabindex="0">
                                    @*<div class="ln_solid"></div>*@ <br />
                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <button type="submit" class="btn btn-success">Update Prices</button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</body>
<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    // load ProductId ddl

    var allactiveproducts = @Html.Raw(Json.Encode(ViewBag.productdata));
    var itemID = $("#ProductId");
    itemID.empty();
    itemID.append("<option value='0'>-- Select a Product --</option>");
    $.each(allactiveproducts, function (index, optionaldata) {
        itemID.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductCode+"-"+optionaldata.ProductName));
    });
    if ('@ViewBag.ProductId') {
        $('#ProductId').val(@ViewBag.ProductId).trigger("change");
    } else {
        $('#ProductId').val(0).trigger("change");
    }
