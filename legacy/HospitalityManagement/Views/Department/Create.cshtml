@model RIT.HMS.Domain.RstDepartment
@{
    ViewBag.Title = "Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<body class="nav-md">
    <div class="container body">
        <div class="main_container">
            @using (Html.BeginForm("Create", "Department", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @*@Html.HiddenFor(model=>model.RstDepartmentID)*@
            <!-- page content -->
                <div class="right_col" role="main">
                    <div class="">

                        <div class="clearfix"></div>
                        @if (@ViewBag.Message == "1")
                        {
                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Department </strong> @ViewBag.DeptCode saved successfully.
                            </div>
                        }
                        else if (@ViewBag.Message == "0")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Department</strong> @ViewBag.DeptCode save failed.
                            </div>
                        }
                        else if (@ViewBag.Message == "3")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Department</strong> @ViewBag.DeptCode already exists.
                            </div>
                        }

                        <div class="row">

                            <!-- form input mask -->
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="x_panel">

                                    <div class="x_title">
                                        <h2>Department</h2>
                                        <br />

                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                       
                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>

                                    <div class="x_content">
                                        <br />
                                        <form class="form-horizontal form-label-left">
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Department Code</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.DepartmentCode, new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Department Code",
                                                   MaxLength = 50,
                                                   onkeyup = "checkDepartmentCode()",
                                                   onkeypress = "return checkCodeTypeInput(event)",
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.DepartmentCode, "", new { @class = "text-danger pull-left" })

                                                </div>
                                                <font color="red" class="col-md-5">
                                                    <label id="validatecode" name="validatecode" style="font:small-caption"></label>
                                                </font>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Department Name</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.DepartmentName, new { @class = "form-control", MaxLength = 50, Placeholder = "Department Name" })
                                                    @Html.ValidationMessageFor(model => model.DepartmentName, "", new { @class = "text-danger pull-left" })

                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Department Image</label>
                                                <div class="col-md-6 col-sm-9 col-xs-9">
                                                    <input type="file" id="Photograph" name="Photograph" class="iradio_flat-grey pull-left" />
                                                    @Html.ValidationMessageFor(model => model.Photograph, "", new { @class = "text-danger pull-left" })                                                  
                                                    <div class="pull-left">
                                                        @ViewBag.FileName
                                                    </div>
            
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Remark</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextAreaFor(model => model.Remark, new { @class = "form-control", Placeholder = "Remark" })
                                                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            @*//Commented by Pavithra on 2019-11-30*@ 
                                            @*<div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsActive</label>
                                                <div class="checkbox col-xs-1 pull-left ">
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsDelete</label>
                                                <div class="checkbox col-xs-1 pull-left ">
                                                    @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                                </div>
                                            </div>*@


                                            <div class="actionBar">
                                                <div class="msgBox">

                                                    <div class="btn btn-primary pl_add btn-small pull-left">
                                                        @Html.ActionLink("Clear", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    <div class="btn btn-info pl_add btn-small pull-left">
                                                        @Html.ActionLink("View All", "ViewDepartments", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    <button type="submit" class="btn btn-success">Submit</button>

                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>


</body>
</html>


<script type="text/javascript">
    function checkDepartmentCode()
    {
        document.getElementById('validatecode').innerHTML = '';

        $.ajax({
            url: "@Url.Action("checkDepartmentCode", "Department")",
            data: { code: $("#DepartmentCode").val() },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {
                data = resp;
                if (resp != null || resp != "") {
                    document.getElementById('validatecode').innerHTML = "Department Code Already Exists";
                } else
                {
                    document.getElementById('validatecode').innerHTML = "";
                }

            }
        });


    }
</script>

