<script>
    $.getJSON("@Url.Action("GetDocStatus", "PO")", function (data) {

        var DocStatusId = $("#DocStatusId");


        DocStatusId.empty();
        DocStatusId.append("<option value='0'>-- Select a Doc Status--</option>");


        $.each(JSON.parse(data), function (index, optionaldata) {
            DocStatusId.append($('<option />', { value: optionaldata.DocStatusId }).html(optionaldata.Description));

        });

        if ('@ViewBag.DocStatusId') {
            $('#DocStatusId').val(@ViewBag.DocStatusId).trigger("change");
        } else {
            $('#DocStatusId').val(0).trigger("change");
        }


    });
</script>

