<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    $(document).ready(function() {
        $('#Update').change(function () {
            if(this.checked) {
                $('#update').removeAttr("style", "display:none;")
                $('#insert').attr("style", "display:none;")
                $("#carditems tr").remove();
            }else
            {
                $('#insert').removeAttr("style", "display:none;")
                $('#update').attr("style", "display:none;")
                $("#carditems tr").remove();
            }
        });

    debugger;
    if('@Model.Update'=='True')
    {
        $('#update').removeAttr("style", "display:none;");
        $('#insert').attr("style", "display:none;")
        $("#carditems tr").remove();
    }else
    {
        $('#insert').removeAttr("style", "display:none;");
        $('#update').attr("style", "display:none;")
        $("#carditems tr").remove();
    }

    });
</script>

<script>
    // Excel Export

    if ('@Model.LoyaltyCardGenerationHeaderId' != '0')
    {
       // alert(@Model.LoyaltyCardGenerationHeaderId+' For export');
        $.ajax({
            type: "GET",
            contentType: "application/json;charset=utf-8",
            url: '@Url.Action("ExportToExcel", "CardNumberGeneration")',
            data: { "id":@Model.LoyaltyCardGenerationHeaderId },
            success: function (response) {
                debugger;
                var blob=new Blob([response],{type:'application/ms-excel'});
                var downloadurl=URL.createObjectURL(blob);
                var a=document.createElement("a");
                a.href=downloadurl;
                a.download="CardNumbers.xls";
                document.body.appendChild(a);
                a.click();

            },
        });
    }

</script>

<script>

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode == 46 && charCode > 31
          && (charCode < 48 || charCode > 57))
            return false;
            return true;
    }

    $(document).ready(function SwitchWizard() {
        // Switch On Off Wizard
        if ('@Convert.ToBoolean(Session["CGWizadUI"])' == 'False') {
            //debugger;
            document.getElementById("wizard").className = "";
            var e = document.getElementById("wizard");
            e.id = "plain";
            document.getElementById("wizardsteps").style = "display:none";
        }
        // End Switch On Off Wizard
        // DDL Loaders
        debugger;
        $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {
            var LocationId = $("#GenLocationId");
            LocationId.empty();
            LocationId.append("<option value='0'>-- Select a Location --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                debugger;
                LocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));
            });

            if ('@ViewBag.GenLocationId') {
                $('#GenLocationId').val(@ViewBag.GenLocationId).trigger("change");
            } else {
                $('#GenLocationId').val(0).trigger("change");
            }
        });

        $.getJSON("@Url.Action("GetActiveCards", "CardMaster")", function (data) {
            var CardMasterId = $("#CardMasterId");
            CardMasterId.empty();
            CardMasterId.append("<option value='0'>-- Select --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                debugger;
                CardMasterId.append($('<option />', { value: optionaldata.CardMasterId }).html(optionaldata.CardCode));
            });

            if ('@ViewBag.CardMasterId') {
                $('#CardMasterId').val(@ViewBag.CardMasterId).trigger("change");
            } else {
                $('#CardMasterId').val(0).trigger("change");
            }
        });
        // End DDL Loaders

        // DDL Changers

        @*$("#GenLocationId").change(
        function () {
            debugger;
            var locid = this.value;
            if (locid == 0) { return; }

            $.getJSON("@Url.Action("GetCardGenParams", "CardNumberGeneration")", { locid: locid },
            function (data) {
                debugger;
                $('#CardPrefix').val(data.LocationPrefix);
                $('#CardStartingNo').val(data.CardStartingNo);
                $('#EncodeStartingNo').val(data.EncodeStartingNo);
                $('#CardLength').val(data.CardNoLength);

            });
        });*@

        $("#CardMasterId").change(
        function () {
            debugger;
            var cid = this.value;
            if (cid == 0) { return; }
            $.getJSON("@Url.Action("GetCardDetailsById", "CardMaster")", { cid1: cid },
            function (data) {
                debugger;
                $('#cardname').val(data.CardName);
            });
        });
        // End DDL Changers
    });
</script>

<script type="text/javascript">
    $("body").on("click",
        "#generate",
        function () {

            debugger;

            if ($("#GenLocationId").val() == 0 || $("#GenLocationId").val() == null) {
                alert("Select a location!");
                return;
            }
            if ($("#CardMasterId").val() == 0 || $("#CardMasterId").val() == null) {
                alert("Select a card type !");
                return;
            }
            if ($("#qty").val() == 0 || $("#qty").val() == null)
            {
                alert("Quantity Can not be 0!");
                return;
            }
            
            $("#carditems tr").remove();
            $.getJSON("@Url.Action("GenerateCardNumbers", "CardNumberGeneration")",
            {
                qty: $("#qty").val(),
             //   locprefx: $("#CardPrefix").val(),
                CardStartingNo: $("#CardStartingNo").val(),
                EncodeStartingNo: $("#EncodeStartingNo").val(),
                CardNoLength: $("#CardLength").val(),
            },function (data) {
                $.each(JSON.parse(data), function (index, optionaldata)
                {
                            
                    debugger;
                    var table = document.getElementById("carditems");                  
                    var unitindex = $("#carditems").children("tr").length;
                    var unitindexCell = "<td style='display:none'><input name='LoyaltyCardGenerationDetail.Index'  value='" +
                        unitindex + "' /></td>";
                    var unitBillValueFrom = "<td><input id='LoyaltyCardGenerationDetail[" + unitindex + "]_CardNo' class='form-control' name='LoyaltyCardGenerationDetail[" +
                        unitindex + "].CardNo' type='text' readonly value=" + optionaldata.CardNo + " /></td>";
                    var unitBillValueTo = "<td ><input id='LoyaltyCardGenerationDetail[" + unitindex + "]_EncodeNo' class='form-control' name='LoyaltyCardGenerationDetail[" +
                        unitindex + "].EncodeNo' type='text' readonly value='" + optionaldata.EncodeNo + "' /></td>";

                    var newUnitRow = "<tr id='trcarditems_" + unitindex + "'>" +
                        unitindexCell +
                        unitBillValueFrom +
                        unitBillValueTo +"</tr>";
                    $("#carditems").append(newUnitRow);

                });
            });
        }
     );

    
</script>

