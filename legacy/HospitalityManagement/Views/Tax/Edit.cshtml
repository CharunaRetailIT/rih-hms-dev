@model RIT.HMS.Domain.Tax
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
@*<html lang="en">*@
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>


    <script src="~/vendors/jquery/dist/jquery.min.js"></script>
</head>


<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Edit", "Tax", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.TaxId);
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Tax</strong> @ViewBag.TaxCode modified successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Tax</strong> @ViewBag.TaxCode failed to modify.
                        </div>
                    }


                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Tax - Edit</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>                                      
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />

                                    <div class="form-horizontal form-label-left col-md-6">

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Tax Code</label>
                                            <div class="col-md-3 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.TaxCode,
                                               new {
                                                   @class = "form-control",
                                                   MaxLength = 10,
                                                   Placeholder = "Tax Code",
                                                   @readonly=true
                                               })
                                                @Html.ValidationMessageFor(model => model.TaxCode, "", new { @class = "text-danger" })

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Tax Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.TaxName, new { @class = "form-control", Placeholder = "Tax Name" })
                                                @Html.ValidationMessageFor(model => model.TaxName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Tax Percentage</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">

                                                @Html.TextBoxFor(model => model.TaxPercentage, new { @class = "form-control", Placeholder = "Tax Percentage", @Type = "number" })
                                                @Html.ValidationMessageFor(model => model.TaxPercentage, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <br />

                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3"> Active</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })
                                            </div>
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3">IsDelete</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                            </div>
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3">Is Purchasing Tax</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.IsPurchasingTax, new { @class = "flat" })
                                            </div>
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3">Is Selling Tax</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.IsSellingTax, new { @class = "flat" })
                                            </div>
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3">Is Tax On Tax</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.IsTaxOnTax, new { @class = "flat" })
                                            </div>
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3">Is Service Charge</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.IsServiceCharge, new { @class = "flat" })
                                            </div>
                                            <label class="control-label col-md-4 col-sm-3 col-xs-3">Is Exclude Tax</label>
                                            <div class="checkbox col-xs-1">
                                                @Html.CheckBoxFor(model => model.isExcludeTax, new { @class = "flat" })
                                            </div>
                                        </div>
                                    </div>

                                   

                                </div>
                                <div class="clearfix"></div>

                                <div class="actionBar">
                                    <div class="msgBox">

                                        <div class="btn btn-primary pl_add btn-small pull-left">
                                            @Html.ActionLink("Reset", "Edit", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                        </div>
                                        <div class="btn btn-info pl_add btn-small pull-left">
                                            @Html.ActionLink("View All", "ViewTaxes", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                        </div>
                                        <button type="submit" class="btn btn-success">Modify</button>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>




