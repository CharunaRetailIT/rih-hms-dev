
@model RIT.HMS.Domain.Receipe
@{
    ViewBag.Title = "Recipes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@*<body class="nav-md">*@
<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm("EditReceipe", "Receipe", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ServingUnitName)
            @*@Html.HiddenFor(model=>model.LocationId)*@
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">

                            @if (@ViewBag.Message == "1")
                            {
                                <div class="alert alert-success alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Recipe</strong>  saved successfully.
                                </div>
                            }
                            else if (@ViewBag.Message == "2")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Recipe</strong> save failed.
                                </div>
                            }
                            else if (@ViewBag.Message == "3")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Recipe</strong> already exists.
                                </div>
                            }
                            else if (@ViewBag.Message == "4")
                            {
                                <div class="alert alert-warning alert-warning fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    Please enter recipes details !.
                                </div>
                            }
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Recipes Edit</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="x_content">
                                    <br />
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 ">Product</label>
                                        <div class="col-md-5 col-sm-9 "> 
                                            @Html.DropDownList("ProductId_", (IEnumerable<SelectListItem>)Session["FGs"], new
                                           {
                                               @class = "form-control select2",
                                               disabled = "disabled"

                                           })                                                                              
                                            @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger pull-right" })
                                            @Html.TextBoxFor(model => model.ProductId, new { @style = "display: none;" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3">Serving Unit</label>
                                        <div class="col-md-5 col-sm-9">
                                            <select id="ProductServingUnitId_" name="ProductServingUnitId_" class="form-control" style="width:100%" disabled></select>
                                            @Html.ValidationMessageFor(model => model.ProductServingUnitId, "", new { @class = "text-danger pull-right" })
                                            @Html.TextBoxFor(model => model.ProductServingUnitId, new { @style = "display: none;" })
                                            @*<input id="ServingUnitName" name="ServingUnitName" style="display:none" />*@
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3">Product Qty</label>
                                        <div class="col-md-5 col-sm-9">
                                            @Html.TextBoxFor(model => model.ProductQty, new { @class = "form-control", MaxLength = 20, @readonly = true, onkeypress = "validateInputForNumbers(event)" })
                                            @Html.ValidationMessageFor(model => model.ProductQty, "", new { @class = "text-danger pull-right" })
                                            <input id="UnitConvertion" type="text" style="display: none;" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3">Location</label>
                                        <div class="col-md-5 col-sm-9">
                                            <select id="LocationId" name="LocationId" class="form-control" disabled  style="width:100%"></select>
                                            @Html.TextBoxFor(model => model.LocationId, new { @style = "display: none;" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.CheckBoxFor(model => model.ApplyForAllLocation, new { @class = "" })
                                            <label class="control-label">Change the recipe in all locations</label>
                                        </div>
                                    </div>
                                    <br />
                                    <div>

                                        <table id="buttons" class="table table table-striped table-bordered">
                                            <thead>
                                                <tr>

                                                    <th style="width:50%">Material</th>
                                                    <th style="width:15%">Sub Unit</th>
                                                    <th style="width:15%">Cost</th>
                                                    <th style="width:10%">Quantity</th>
                                                    <th style="width:10%"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="width:50%">
                                                    @Html.DropDownList("ReceipeProductId", (IEnumerable<SelectListItem>)Session["RMs"], new
                                                   {
                                                       @class = "form-control select2",

                                                   })
                                                    @*<select id="ReceipeProductId" name="ReceipeProductId" class="form-control select2" style="width:100%"></select>*@
                                                    </td>
                                                    <td style="width:15%">
                                                        <input id='UOM' class='form-control' name='UOM' type='text' readonly value='' />
                                                    </td>
                                                    <td style="width:15%"><input type="number" step="0.0001" min="0" onkeypress='return event.charCode >= 46' id="CostPrice" class="form-control" readonly /></td>
                                                    <td style="width:10%"><input type="text" min="0" onkeypress='validateInputForNumbers(event)' id="ProductQuantity" class="form-control" /></td>
                                                    <td style="width:10%"><input type="button" id="btnAdd" class="btn btn-round btn-info" value="+" /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <br />
                                        <div class="text-info"><b>Receipe Items</b></div>
                                        <table id="tblRecepies" class="table table table-striped table-bordered bulk_action">
                                            <thead>
                                                <tr>
                                                    <th style='display:none'>Material Id</th>
                                                    <th>Code</th>
                                                    <th style="width:40%">Material</th>
                                                    <th>Sub Unit</th>
                                                    <th>Quantity</th>
                                                    <th>Cost Price</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="receipeitems">
                                                @if (Model != null)
                                                {
                                                    foreach (var receipes in Model.Receipes)
                                                    {

                                                        int i = Model.Receipes.IndexOf(receipes);

                                                        <tr id='@i'>

                                                            <td style='display:none'><input name='Receipes.Index' id='Receipes[@i]' type='hidden' value=@i /></td>
                                                            <td style='display:none'><input id='Receipes[@i]_MaterialId' class='form-control' name='Receipes[@i].MaterialId' type='text' readonly value=@receipes.MaterialId /></td>
                                                            <td><input class='form-control' type='text' readonly value=@receipes.ProductCode /></td>
                                                            <td><input id='Receipes[@i]_ProductName' class='form-control' name='Receipes[@i].ProductName' type='text' readonly value='@receipes.ProductName' /></td>
                                                            <td><input id='Receipes[@i]_UOM' class='form-control' name='Receipes[@i].UOM' type='text' readonly value='@receipes.UOM' /></td>
                                                            <td><input id='Receipes[@i]_Quantity' class='form-control' name='Receipes[@i].Quantity' type='text' readonly value=@receipes.Quantity /></td>
                                                            <td><input id='Receipes[@i]_CostPrice' class='form-control' name='Receipes[@i].CostPrice' type='text' readonly value=@receipes.CostPrice /></td>
                                                            <td>
                                                               
                                                                <input id='btnRemoveItem' type='button' value='-' class='btn btn-round btn-info' onclick='removeThisRow(@i);' />
                                                            </td>
                                                        </tr>

                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <hr />

                                    <div id="summary" class="col-lg-12">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                    Item Cost Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    @Html.TextBoxFor(model => model.TotCostPrice, new { @class = "form-control", MaxLength = 20, @readonly = true })
                                                    @*<input id="TotCostPrice" name="TotCostPrice" type="number" readonly="readonly" value="0" class="form-control">*@

                                                </div>                                                                                     
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                    Total Selling Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    @Html.TextBoxFor(model => model.TotSellingPrice, new { @class = "form-control", MaxLength = 20, onkeypress = "validateInputForNumbers(event)" })
                                                    @*<input id="TotSellingPrice" name="TotSellingPrice" readonly="readonly" value="0" class="form-control">*@

                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                    Total Cost Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    @Html.TextBoxFor(model => model.ActualTotalCost, new { @class = "form-control", MaxLength = 20, onkeypress = "validateInputForNumbers(event)" })

                                                </div>

                                            </div>
                                        </div>
                                        @*<div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                    Item Cost Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    <input type="text" id="singleProductCostPrice" name="singleProductCostPrice" type="number" class="form-control" maxlength=20 readonly=true />

                                                </div>
                                            </div>
                                        </div>*@
                                    </div>
                                    <br />
                                    <br />
                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <div class="pull-left">
                                                <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("CreateReceipe", null, new { })'" />
                                            </div>
                                            <div class="pull-left">
                                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewReceipes", null, new { })'" />
                                            </div>
                                            <button type="submit" class="btn btn-success">Modify</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="se-pre-con"></div>
            </div>
        }
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    function validateInputForNumbers(evt) {
        debugger;
        var theEvent = evt || window.event;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        } else {

            var key = theEvent.keyCode || theEvent.which;
            key = String.fromCharCode(key);
        }
        var regex = /[0-9]|\./;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }
</script>

<script>

    var rowCount = document.getElementById('tblRecepies').rows.length;
    if (rowCount == 1) {
        document.getElementById("TotCostPrice").value = "0";
        document.getElementById("TotSellingPrice").value = "0";
        document.getElementById("ProductQty").value = "1";
    }
</script>



