@model RIT.HMS.Domain.Receipe

@{
    ViewBag.Title = "Recipes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<body class="nav-md">*@
<div class="container body">
    <div class="main_container">

        @using (Html.BeginForm("CreateReceipe", "Receipe", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">

                    <div class="clearfix"></div>
                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12">

                            @if (@ViewBag.Message == "1")
                            {
                                <div class="alert alert-success alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Recipe</strong>  saved successfully.
                                </div>
                            }
                            else if (@ViewBag.Message == "2")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Recipe</strong> save failed.
                                </div>
                            }
                            else if (@ViewBag.Message == "3")
                            {
                                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    <strong>Recipe</strong> already exists.
                                </div>
                            }
                            else if (@ViewBag.Message == "4")
                            {
                                <div class="alert alert-warning alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    Please enter recipes details !.
                                </div>
                            }
                            else if (@ViewBag.Message == "5")
                            {
                                <div class="alert alert-warning alert-dismissible fade in" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                    Select a Location OR Create for all Locations !.
                                </div>
                            }
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Recipes</h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>

                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                              
                                @*<div class="x_content">*@
                                    <div class="clearfix"></div>
                                    <br />                                                               
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Product</label>
                                            <div class="col-md-5 col-sm-9 ">
                                                @Html.DropDownList("ProductId", (IEnumerable<SelectListItem>)Session["FGs"], new
                                               {
                                                   @class = "form-control select2",
                                                   @style = "width:100%"
                                               })                                               
                                                @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger pull-right" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Serving Unit</label>
                                            <div class="col-md-5 col-sm-9">
                                                <select id="ProductServingUnitId" name="ProductServingUnitId" class="form-control" style="width:100%"></select>
                                                @Html.ValidationMessageFor(model => model.ProductServingUnitId, "", new { @class = "text-danger pull-right" })
                                                <input id="ServingUnitName" name="ServingUnitName" style="display:none" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Product Qty</label>
                                            <div class="col-md-5 col-sm-9">
                                                @Html.TextBoxFor(model => model.ProductQty, new { @class = "form-control", MaxLength = 20, onkeypress = "validateInputForNumbers(event)" })
                                            </div>
                                            <input id="UnitConvertion" type="text" style="display: none;" />
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Location</label>
                                            <div class="col-md-5 col-sm-9">
                                                <select id="LocationId" name="LocationId" class="form-control" style="width:100%"></select>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.CheckBoxFor(model => model.ApplyForAllLocation, new { @class = "" })
                                                <label class="control-label">Apply this recipe for all locations</label>
                                            </div>
                                        </div>
                                  
                                    <br />
                                    <div class="clearfix"></div>

                                    <div>
                                        <table id="buttons" class="table table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th style="width:50%">Material</th>
                                                    <th style="width:15%">Sub Unit</th>
                                                    <th style="width:15%">Cost</th>
                                                    <th style="width:10%">Quantity</th>
                                                    <th style="width:10%"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="width:50%">
                                                     @Html.DropDownList("ReceipeProductId", (IEnumerable<SelectListItem>)Session["RMs"], new
                                                    {
                                                        @class = "form-control select2",
                                                        @style = "width:100%",

                                                    })
                                                    @*<select id="ReceipeProductId" name="ReceipeProductId" class="form-control select2" style="width:100%"></select>*@
                                                    </td>
                                                    <td style="width:15%">
                                                        <input id='UOM' class='form-control' name='UOM' type='text' readonly value='' />
                                                    </td>
                                                    <td style="width:15%"><input type="number" step="0.0001" min="0" onkeypress='return event.charCode >= 46' id="CostPrice" class="form-control" readonly /></td>
                                                    <td style="width:10%"><input type="text" step="0.0001" min="0" onkeypress='validateInputForNumbers(event)' id="ProductQuantity" class="form-control" /></td>
                                                    <td style="width:10%"><input type="button" id="btnAdd" class="btn btn-round btn-info" value="+" /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <table class="table table table-striped table-bordered alignleft" style="width:50%;">
                                            <thead >
                                                <tr>
                                                    <th>Location</th>
                                                    <th>Cost Price</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbllocationprices">
                                               
                                            </tbody>
                                        </table>
                                        <div class="clearfix"></div>
                                        <br />

                                        <div class="text-info"><b>Recipe Items</b></div>
                                        <table id="tblRecepies" class="table table table-striped table-bordered bulk_action">
                                            <thead>
                                                <tr>
                                                    <th style='display:none'>Material Id</th>
                                                    <th>Code</th>
                                                    <th style="width:40%">Material</th>
                                                    <th>Sub Unit</th>
                                                    <th>Quantity</th>
                                                    <th>Cost Value</th>
                                                    <th style='display:none'>Selling Value</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="receipeitems">
                                                @if (Model != null)
                                                {
                                                    foreach (var receipes in Model.Receipes)
                                                    {
                                                        <tr id='@Model.Receipes.IndexOf(receipes)'>

                                                            <td style='display:none'><input name='Receipes.Index' id='Receipes[@Model.Receipes.IndexOf(receipes)]' type='hidden' value=@Model.Receipes.IndexOf(receipes) /></td>
                                                            <td style='display:none'><input id='Receipes[@Model.Receipes.IndexOf(receipes)]_MaterialId' class='form-control' name='Receipes[@Model.Receipes.IndexOf(receipes)].MaterialId' type='text' readonly value=@receipes.MaterialId /></td>
                                                            <td><input class='form-control' type='text' readonly value=@receipes.ProductCode /></td>
                                                            <td><input id='Receipes[@Model.Receipes.IndexOf(receipes)]_ProductName' class='form-control' name='Receipes[@Model.Receipes.IndexOf(receipes)].ProductName' type='text' readonly value='@receipes.ProductName' /></td>
                                                            <td><input id='Receipes[@Model.Receipes.IndexOf(receipes)]_UOM' class='form-control' name='Receipes[@Model.Receipes.IndexOf(receipes)].UOM' type='text' readonly value='@receipes.UOM' /></td>
                                                            <td><input id='Receipes[@Model.Receipes.IndexOf(receipes)]_Quantity' class='form-control' name='Receipes[@Model.Receipes.IndexOf(receipes)].Quantity' type='text' readonly value=@receipes.Quantity /></td>
                                                            <td><input id='Receipes[@Model.Receipes.IndexOf(receipes)]_CostPrice' class='form-control' name='Receipes[@Model.Receipes.IndexOf(receipes)].CostPrice' type='text' readonly value=@receipes.CostPrice /></td>
                                                            <td>
                                                                <input id='btnRemove' type='button' value='-' class='btn btn-round btn-info' onclick='removeRow(@Model.Receipes.IndexOf(receipes));' />
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <hr />
                                    <div id="summary" class="col-lg-12">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                   Total Cost Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    @Html.TextBoxFor(model => model.TotCostPrice, new { @class = "form-control", MaxLength = 20, @readonly = true })
                                                    @*<input id="TotCostPrice" name="TotCostPrice" type="number" readonly="readonly" value="0" class="form-control">*@

                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                    Total Selling Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    @Html.TextBoxFor(model => model.TotSellingPrice, new { @class = "form-control", MaxLength = 20, onkeypress = "validateInputForNumbers(event)" })
                                                    @Html.ValidationMessageFor(model => model.TotSellingPrice, "", new { @class = "text-danger pull-right" })
                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="control-label col-md-5 col-sm-6">
                                                    Item Cost Price <span class="required">*</span>
                                                </label>
                                                <div class="col-md-7 col-sm-6">
                                                    @Html.TextBoxFor(model => model.ActualTotalCost, new { @class = "form-control", MaxLength = 20, @readonly = true })
                                                   
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <br />
                                    <br />
                                    <div class="actionBar">
                                        <div class="msgBox">
                                            <div class="pull-left">
                                                <input type="button" class="btn btn-primary" value="Clear" onclick="location.href='@Url.Action("CreateReceipe", null, new { })'" />
                                            </div>
                                            <div class="pull-left">
                                                <input type="button" class="btn btn-info" value="View All" onclick="location.href='@Url.Action("ViewReceipes", null, new { })'" />
                                            </div>
                                            <button type="submit" class="btn btn-success">Submit</button>
                                        </div>
                                    </div>
                                @*</div>*@
                            </div>
                        </div>
                    </div>
                    <div class="se-pre-con"></div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    function validateInputForNumbers(evt) {
        var theEvent = evt || window.event;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        } else {

            var key = theEvent.keyCode || theEvent.which;
            key = String.fromCharCode(key);
        }
        var regex = /[0-9]|\./;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }
</script>

<script>

    var rowCount = document.getElementById('tblRecepies').rows.length;
    if (rowCount == 1) {
        document.getElementById("TotCostPrice").value = "0";
        document.getElementById("TotSellingPrice").value = "0";
        document.getElementById("ProductQty").value = "1";
    }
</script>

