<script>

    $(document).ready(function ()
    {

        $.getJSON("@Url.Action("GetActiveShowRoomLocations", "Location")", function (data)
        {
            var poLocationId = $("#LocationId");

            poLocationId.empty();
            poLocationId.append("<option value='0'>-- Select a Location --</option>");

            $.each(JSON.parse(data), function (index, optionaldata)
            {
                poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

            });

            if ('@ViewBag.poLocationId') {
                $('#LocationId').val(@ViewBag.poLocationId).trigger("change");
            } else {
                $('#LocationId').val(0).trigger("change");
            }
    });

    $("#LocationId").change(
      function ()
      {
          var loc = this.value;
          debugger;
          if (loc == 0)
          {
              document.getElementById("ApplyForAllLocation").disabled = false;
              document.getElementById("ApplyForAllLocation").checked = true;
              document.getElementById("LocationId").disabled = true;

          } else
          {
              document.getElementById("ApplyForAllLocation").disabled = true;
              document.getElementById("ApplyForAllLocation").checked = false;
              document.getElementById("LocationId").disabled = false;
          }
      });
        const checkbox = document.getElementById('ApplyForAllLocation');
        checkbox.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            document.getElementById("LocationId").disabled = true;
         
        } else {
            document.getElementById("LocationId").disabled = false;
        
        }
    });


        if(@Model.ProductId!=0)
        {
            $.getJSON("@Url.Action("GetServingUnits", "Product")", { id: @Model.ProductId },
           function (data)
           {
               var ProductServingUnitId = $("#ProductServingUnitId");

               ProductServingUnitId.empty();
               ProductServingUnitId.append("<option value='0'>-- Select Serving unit --</option>");

               $.each(JSON.parse(data), function (index, optionaldata) {
                   ProductServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
               });
           });
        }



        // Set option selected onchange
    $('#ProductId').change(function ()
    {
            var prdid = $(this).val();
            $.getJSON("@Url.Action("GetServingUnits", "Product")", { id: prdid },
            function (data)
            {
                var ProductServingUnitId = $("#ProductServingUnitId");

                ProductServingUnitId.empty();
                ProductServingUnitId.append("<option value='0'>-- Select Serving unit --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    ProductServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                });
            });

        });

        $("#ReceipeProductId").change(function ()
        {
            debugger;

            if ($("#ReceipeProductId").val() == 0) { return; }
            var productUOM = $("#ReceipeProductId option:selected").text().split(" (")[1].split(")")[0];
            $("#UOM").val(productUOM);


            if (document.getElementById("ApplyForAllLocation").checked == false)
            {

                if ($("#LocationId").val() == 0 || $("#LocationId").val() == null)
                {
                    alert("Select a Location !");
                    return;
                }

            }

            var Parent = document.getElementById('tbllocationprices');
            while (Parent.hasChildNodes())
            {
                Parent.removeChild(Parent.firstChild);
            }

            if ($("#LocationId").val() != 0)
            {

                $.ajax({
                    url: "@Url.Action("CostPriceByLocId", "Product")",
                    data: { id: $("#ReceipeProductId").val(), qty: 1, UnitConvertion: 1, locid: $("#LocationId").val() },
                    type: "GET",
                    dataType: "json",
                    success: function (data)
                    {
                        $("#CostPrice").val(parseFloat(data.CostPrice).toFixed(2));
                        $("#tbllocationprices").append("<tr><td>" + $("#LocationId option:selected").text() + "</td><td>" + data.CostPrice + "</td></tr>");
                    }
                });

            }
            else
            {
                debugger;        
                $("#CostPrice").val(0);
                $.getJSON("@Url.Action("CostPriceForAllLocations", "Product")", { productid: $("#ReceipeProductId").val(), qty: 1, UnitConvertion: 1},
                function (data)
                {
                    debugger;                                  
                    $.each(JSON.parse(data), function (index, optionaldata)
                    {                                         
                        $("#tbllocationprices").append("<tr><td>" + optionaldata.LocationName + "</td><td>" + optionaldata.CostPrice + "</td></tr>");
                      
                    });
                });

            }

            var UnitConvertionValue = $("#ReceipeProductId option:selected").text().split(" [")[1].split("]")[0];
            $("#UnitConvertion").val(UnitConvertionValue);
        });
    });



    $("#ProductServingUnitId").change(
     function ()
     {
         var loc = this.textContent;
         document.getElementById("ServingUnitName").value = "";
         document.getElementById("ServingUnitName").value = $("#ProductServingUnitId option:selected").text();

     });

</script>

@*Recepies Handling*@
<script type="text/javascript">
    $("body").on("click", "#btnAdd", function ()
    {
      

        if ($("#ProductId").val() == 0 || $("#ProductId").val() == null) {
            alert("Select a product !");
            return;
        }

        if ($("#ProductServingUnitId").val() == 0 || $("#ProductServingUnitId").val() == null) {
            alert("Select a serving unit !");
            return;
        }

        if (document.getElementById("ApplyForAllLocation").checked == false)
        {
            if ($("#LocationId").val() == 0 || $("#LocationId").val() == null)
            {
                alert("Select a Location !");
                return;
            }
        }

        if ($("#ReceipeProductId").val() == 0 || $("#ReceipeProductId").val() == null) {
            alert("Select a row item !");
            return;
        }

        if ($("#ProductQuantity").val() === "") {
            alert("Quantity required!");
            return;
        }
        if ($("#ProductQty").val() === "") {
            alert("Product Quantity required!");
            return;
        }
        if ($("#ProductQuantity").val() <= 0) {
            alert("Invalid row item quantity!");
            $("#ProductQuantity").val("");
            return;
        }
        var productId = $("#ReceipeProductId");

        var productName = $("#ReceipeProductId option:selected").text();
        var productQuantity = $("#ProductQuantity");
        var productUOM = $("#ReceipeProductId option:selected").text().split(" (")[1].split(")")[0];
        var productQty = $("#ProductQty");

        //Check duplicates
        var table = document.getElementById('receipeitems');
        for (var r = 0, n = table.rows.length; r < n; r++) {
            if (table.rows[r].cells[1].firstChild.value == productId.val()) {
                alert("Recipe item already Exists..! " + productName);
                $("#ProductQuantity").val("");
                $("#UnitConvertion").val("")
                return;
            }
        }
        $.ajax({
            url: "@Url.Action("ReceipeDet", "Product")",
            data: { id: $("#ReceipeProductId").val(), qty: $("#ProductQuantity").val(), UnitConvertion: $("#UnitConvertion").val(), locationid: $("#LocationId").val() },
            type: "GET",
            dataType: "json",
            success: function (data) {
                debugger;
                // var index = $("#receipeitems").children("tr").length;
                var index = productId.val();
                var indexCell = "<td style='display:none'><input name='Receipes.Index' type='hidden' value='" + index + "' /></td>";              
                var productIdCell = "<td style='display:none'><input id='Receipes[" + index + "]_MaterialId' class='form-control' name='Receipes[" + index + "].MaterialId' type='text' readonly value='" + productId.val() + "' /></td>";
                var productCodeCell = "<td><input class='form-control' type='text' readonly value='" + data.ProductCode + "' /></td>";
                var productNameCell = "<td><input id='Receipes[" + index + "]_ProductName'  class='form-control'  name='Receipes[" + index + "].ProductName' type='text' readonly value='" + productName + "' /></td>";
                var productQuantityCell = "<td><input id='Receipes[" + index + "]_Quantity'  class='form-control' readonly  name='Receipes[" + index + "].Quantity' type='number' min='0' step='0.01' value='" + productQuantity.val() + "' /></td>";
                var productUOMCell = "<td><input id='Receipes[" + index + "]_UOM'  class='form-control'  name='Receipes[" + index + "].UOM' type='text' readonly value='" + productUOM + "' /></td>";
                var productCostPriceCell = "<td><input id='Receipes[" + index + "]_CostPrice'  class='form-control'  name='Receipes[" + index + "].CostPrice' type='text' readonly value='" + parseFloat(data.CostPrice).toFixed(2) + "' /></td>";
                var productSellingPriceCell = "<td style='display:none'><input id='Receipes[" + index + "]_SellingPrice'  class='form-control'  name='Receipes[" + index + "].SellingPrice' type='text' readonly value='" + parseFloat(data.SellingPrice).toFixed(2) + "' /></td>";
                var UnitConversionCell = "<td style='display:none'><input id='Receipes[" + index + "]_UnitConvertion'  class='form-control'  name='Receipes[" + index + "].UnitConvertion' type='text' readonly value='" + $("#UnitConvertion").val() + "' /></td>";
                var removeCell = "<td><input id='btnRemove' type='button' value='-' class='btn btn-round btn-info'  onclick='removeRow(" + index + ");' /></td>";

                var newRow = "<tr id='trReceipe" + index + "'>" +
                   indexCell + productIdCell + productCodeCell + productNameCell + productUOMCell + productQuantityCell + productCostPriceCell + productSellingPriceCell + UnitConversionCell + removeCell + "</tr>";
                $("#receipeitems").append(newRow);

                //alert(data.CostPrice);
                //alert(data.SellingPrice);

                var cp = Number(document.getElementById("TotCostPrice").value);
                var sp = Number(document.getElementById("TotSellingPrice").value);
                var qt=Number(document.getElementById("ProductQty").value);
              
                //alert(cp);
                //alert(sp);

                document.getElementById("TotCostPrice").value = parseFloat(cp +( Number(data.CostPrice)/qt)).toFixed(2);
                document.getElementById("TotSellingPrice").value = parseFloat(sp + Number(data.SellingPrice)).toFixed(2);
                document.getElementById("ActualTotalCost").value = parseFloat((cp +( Number(data.CostPrice)/qt))*qt).toFixed(2);

                var rowCount = document.getElementById('tblRecepies').rows.length;

                if (rowCount == 1) {
                    document.getElementById("TotCostPrice").value = "0";
                    document.getElementById("TotSellingPrice").value = "0";
                    document.getElementById("ProductQty").value = "1";
                }
                $("#ProductQuantity").val("");
                $("#UnitConvertion").val("");
                $("#UOM").val("");
                $("#CostPrice").val("");
                $('#ReceipeProductId').val(0);
                $('#ReceipeProductId').select2().trigger('change');

                var Parent = document.getElementById('tbllocationprices');
                while (Parent.hasChildNodes()) {
                    Parent.removeChild(Parent.firstChild);
                }
            },
            error: function (error) {
                alert("Item data mapping error");
            }
        });
    });

    function removeRow(id) {
        var UnitConvertionValue = document.getElementById("Receipes[" + id + "]_ProductName").value.split(" [")[1].split("]")[0];

        $.ajax({
            url: "@Url.Action("ReceipeDet", "Product")",
            data: {
                id: document.getElementById("Receipes[" + id + "]_MaterialId").value,
                qty: document.getElementById("Receipes[" + id + "]_Quantity").value,
                UnitConvertion: UnitConvertionValue,
                locationid: $("#LocationId").val()
            },
            type: "GET",
            dataType: "json",
            success: function (data) {
                var totcp = Number(document.getElementById("TotCostPrice").value);
                var totsp = Number(document.getElementById("TotSellingPrice").value);

                document.getElementById("TotCostPrice").value = parseFloat(totcp - Number(data.CostPrice)).toFixed(2)
                document.getElementById("TotSellingPrice").value = parseFloat(totsp - Number(data.SellingPrice)).toFixed(2)

                debugger;
                var controlToBeRemoved = "#trReceipe" + id;
                $(controlToBeRemoved).remove();
                
                var controlToBeRemoved0 = "#" + id;
                $(controlToBeRemoved0).remove();

                var rowCountr = document.getElementById('tblRecepies').rows.length;

                if (rowCountr == 1) {
                    document.getElementById("TotCostPrice").value = "0";
                    document.getElementById("TotSellingPrice").value = "0";
                    document.getElementById("ProductQty").value = "1";
                }
            },
            error: function (error) {
                alert("Item data mapping error");
            }
        });
    }
</script>
