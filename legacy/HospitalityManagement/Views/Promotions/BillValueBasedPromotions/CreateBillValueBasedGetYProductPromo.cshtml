<script>
    $.getJSON("@Url.Action("GetActivePromos", "Promotion")", function (data) {

        var promotionMasterID = $("#PromotionMasterID");

        promotionMasterID.empty();
        promotionMasterID.append("<option value='0'>Select a Promotion</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            promotionMasterID.append($('<option />', { value: optionaldata.InvPromotionMasterID }).html(optionaldata.PromotionName+ " LocationID " + optionaldata.LocationID));

        });

        if ('@ViewBag.promotionMasterID') {
            $('#PromotionMasterID').val(@ViewBag.promotionMasterID).trigger("change");
        } else {
            $('#PromotionMasterID').val(0).trigger("change");
        }

    });
</script>

<script>
    $.getJSON("@Url.Action("GetPromotionItems", "ProductXYPromotions")", function (data) {

        var ProductId = $("#ProductId");

        ProductId.empty();
        ProductId.append("<option value='0'>-- Select a Product --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            ProductId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));
        });
    });


    $.getJSON("@Url.Action("GetPromotionItems", "ProductXYPromotions")", function (data) {

        var YProductId = $("#YProductId");

        YProductId.empty();
        YProductId.append("<option value='0'>-- Select a Product --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            YProductId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));
        });
    });




    $(document).ready(function () {

        $("#ProductId").change(function () {

            $.getJSON("@Url.Action("GetServingUnits", "ProductXYPromotions")", { id: $("#ProductId").val() },
               function (data) {
                   var ServingUnitId = $("#ServingUnitId");

                   ServingUnitId.empty();
                   ServingUnitId.append("<option value='0'>-- Select a Serving Unit / UOM --</option>");

                   $.each(JSON.parse(data), function (index, optionaldata) {
                       ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                   });
               });

        });


        $("#YProductId").change(function () {
            $.getJSON("@Url.Action("GetServingUnits", "ProductXYPromotions")", { id: $("#YProductId").val() },
               function (data) {
                   var YServingUnitId = $("#YServingUnitId");

                   YServingUnitId.empty();
                   YServingUnitId.append("<option value='0'>-- Select a Serving Unit / UOM --</option>");


                   var ln = JSON.parse(data).length;

                   if (ln > 1)
                   {
                       $.each(JSON.parse(data), function (index, optionaldata) {
                           YServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                       });

                   }
                   else
                   {
                       $.each(JSON.parse(data), function (index, optionaldata) {
                           YServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                           YServingUnitId.val(optionaldata.ProductServingUnitId).trigger("change");
                       });

                   }
                 
               });
        });


        $("#ServingUnitId").change(function ()
        {

            $.getJSON("@Url.Action("GetProductDetails", "ProductXYPromotions")", { id: $("#ProductId").val(), servingunitid: $("#ServingUnitId").val() },
            function (data)
            {
                   document.getElementById("sellingprice").value = data.SellingPrice;
            });
        });

        $("#YServingUnitId").change(function ()
        {
            $.getJSON("@Url.Action("GetProductDetails", "ProductXYPromotions")", { id: $("#YProductId").val(), servingunitid: $("#YServingUnitId").val() },
            function (data)
            {
                document.getElementById("freesellingprice").value = data.SellingPrice;
            });
        });

    });





</script>


@*HTML Tables Handling*@
@*Promotion Table*@
<script type="text/javascript">
    $("body").on("click",
        "#addpromotionitem",
        function () {
            debugger;


            if ($("#ProductId").val() == 0 || $("#ProductId").val() == null) {
                alert("Select an Item !");
                return;
            }

            if ($("#ServingUnitId").val() == 0 || $("#ServingUnitId").val() == null) {
                alert("Select a Serving Unit !");
                return;
            }
            if ($("#promotionqty").val() == 0 || $("#promotionqty").val() == null) {
                alert("Invalid Quantity!");
                return;
            }

            var itemId = $("#ProductId").val();

            $.ajax({
                url: "@Url.Action("GetProductDetails", "ProductXYPromotions")",
                data: { id: $("#ProductId").val(), servingunitid: $("#ServingUnitId").val() },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    var table = document.getElementById("promotiontable");
                    $(table).find('tbody').append("<tr><td style='display:none'>" + data.ProductId + "</td><td>" + data.ProductCode + "</td><td>" + data.ProductName + "</td><td style='display:none'>" + data.ServingUnitId + "</td><td>" + data.ServingUnit + "</td><td style='display:none'>" + data.UOMId + "</td><td>" + data.UOM + "</td><td>" + data.SellingPrice + "</td><td>" + $("#promotionqty").val() + "</td><td><button type='button' id='promotionrow' onclick='RemovePromotion(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
                    document.getElementById("promotionqty").value = "";
                },
                error: function (error) {
                    alert("Item data mapping error");
                }
            });
        });




    function RemovePromotion(button) {

        var row = $(button).closest("TR");
        var name = $("TD", row).eq(2).html();
        if (confirm("Do you want to delete: " + name+" ?")) {
            //Get the reference of the Table.
            var table = $("#promotiontable")[0];

            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        }
    };


</script>

