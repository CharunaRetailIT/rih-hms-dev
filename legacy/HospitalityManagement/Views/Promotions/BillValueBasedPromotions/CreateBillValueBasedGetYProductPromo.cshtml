@*Submit*@

<script>

    $(document).ready(function ()
    {
        $("body").on("click", "#btnSave", function ()
        {

            if ($('#promotiontable tr').length == 1 || $('#freeitem tr').length == 1)
            {
                return;
            }

                    debugger;
                    swal({
                        title: "Bill Value Based Get Product Promotion",
                        text: "Confirm?",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#DD6B55",
                        confirmButtonText: "Yes",
                        cancelButtonText: "No",
                        closeOnConfirm: false,
                        closeOnCancel: true
                    },
                       function (isConfirm)
                       {
                           if (isConfirm)
                           {

                               var promotions = new Array();
                               

                               $("#freeitem TBODY TR").each(function ()
                               {
                                   var row = $(this);
                                   var free = {};
                                   free.ProductId = row.find("TD").eq(0).html();
                                   free.ProductCode = row.find("TD").eq(1).html();
                                   free.ProductName = row.find("TD").eq(2).html();
                                   free.ServingUnitId = row.find("TD").eq(3).html();
                                   free.ServingUnit = row.find("TD").eq(4).html();
                                   free.SellingPrice = row.find("TD").eq(7).html();
                                   free.Quantity = row.find("TD").eq(8).html();
                                   free.UOM = row.find("TD").eq(6).html();
                                   free.UOMId = row.find("TD").eq(5).html();
                                  // free.PromotionItemType = 2;
                                   free.InvPromotionMasterID = $("#PromotionMasterID").val();
                                   free.ValueFrom = $("#ValueFrom").val();
                                   free.ValueTo = $("#ValueTo").val();
                                   promotions.push(free);
                               });



                               $.ajax({
                                   type: "POST",
                                   url: "@Url.Action("SubmitPromotions", "BillValueBasedPromotions")",
                                   data: JSON.stringify(promotions),
                                   contentType: "application/json; charset=utf-8",
                                   dataType: "json",
                                   success: function (res)
                                   {
                                       if (res != 0)
                                       {

                                           swal({
                                               title: "",
                                               text: "Promotion Saved Successfully!",
                                               type: "success",
                                               showCancelButton: false,
                                               confirmButtonClass: "btn-success",
                                               confirmButtonText: "Ok",
                                               closeOnConfirm: true
                                           },
                                            function () {
                                                window.location.href = "/BillValueBasedPromotions/CreateBillValueBasedGetYProductPromo";
                                            });

                                       }
                                       else
                                       {

                                           swal("Error", "Promotion save failed!", "error");
                                       }

                                   }
                           });
                           }
                       });
                });
    });
</script>


