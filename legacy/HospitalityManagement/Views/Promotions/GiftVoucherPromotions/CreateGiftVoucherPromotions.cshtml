<script>

    $.getJSON("@Url.Action("GetDiscountsPromotionMasters", "ProductXYPromotions")", function (data) {

        var PromotionMasterId = $("#PromotionMasterId");

        PromotionMasterId.empty();
        PromotionMasterId.append("<option value='0'>-- Select a Promotion --</option>");

        $.each(JSON.parse(data), function (index, optionaldata)
        {
            PromotionMasterId.append($('<option />', { value: optionaldata.InvPromotionMasterID }).html(optionaldata.PromotionName));
        });
    });

    $("#PromotionMasterId").change(function () {
        $.getJSON("@Url.Action("GetPromotionType", "ProductXYPromotions")", { promotionmasterid: $("#PromotionMasterId").val() },
           function (data)
           {
              // GetDiscountsPromotionType
               //document.getElementById("promotiondet").innerText = data.PromotionName;
               //document.getElementById("lblpromotiontype").innerText = data.PromotionTypeID;

               var tablepromo = document.getElementById("promotiontable");
               var tablefree = document.getElementById("freeitem");
               $("#promotiontable").find("tr:not(:first)").remove();
               $("#freeitem").find("tr:not(:first)").remove();

               $.each(JSON.parse(data), function (index, optionaldata) {

                   document.getElementById("promotiondet").innerText = optionaldata.PromotionName;
                   document.getElementById("lblpromotiontype").innerText = optionaldata.PromotionTypeId;
                   //if (optionaldata.ProductType == 1) {

                   //    $(tablepromo).find('tbody').append("<tr><td style='display:none'>" + optionaldata.ProductId + "</td><td>" + optionaldata.ProductCode + "</td><td>" + optionaldata.ProductName + "</td><td style='display:none'>" + optionaldata.ServingUnitId + "</td><td>" + optionaldata.ServingUnit + "</td><td style='display:none'>" + optionaldata.UOMId + "</td><td>" + optionaldata.UOM + "</td><td>" + optionaldata.SellingPrice + "</td><td>" + optionaldata.Quantity + "</td><td><button type='button' id='promotionrow' onclick='RemovePromotion(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
                   //} else if (optionaldata.ProductType == 2) {

                   //    $(tablefree).find('tbody').append("<tr><td style='display:none'>" + optionaldata.ProductId + "</td><td>" + optionaldata.ProductCode + "</td><td>" + optionaldata.ProductName + "</td><td style='display:none'>" + optionaldata.ServingUnitId + "</td><td>" + optionaldata.ServingUnit + "</td><td style='display:none'>" + optionaldata.UOMId + "</td><td>" + optionaldata.UOM + "</td><td>" + optionaldata.SellingPrice + "</td><td style='display:none'>" + optionaldata.DiscountType + "</td><td>" + optionaldata.DiscountAmt + "</td><td>" + optionaldata.Quantity + "</td><td><button type='button' id='freeitemrowrow' onclick='RemoveFreeItem(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
