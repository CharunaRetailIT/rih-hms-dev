
@{
    ViewBag.Title = "Remove Product XY Promotions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Scripts/SweetAlets/sweetalert.css" rel="stylesheet" />

<div class="right_col" role="main">
    <div class="clearfix"></div>
    <div class="container body">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2>Remove Promotion Items <small>@ViewBag.PromotionName</small><label hidden>@ViewBag.PromotionMasterId</label></h2>
                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">
                        <br />

                        <div class="col-md-6">
                            <h4>Promotion Item(s)</h4>
                            <div class="form-horizontal form-label-left input_mask">
                                <table id="promotiontable" class="mstable">
                                    <thead>
                                        <tr>
                                            <th>Group Id</th>
                                            <th style="display:none">Item Id</th>
                                            <th>Item Code</th>
                                            <th>Desc</th>
                                            <th style="display:none">Serving Unit Id</th>
                                            <th>Serving Unit</th>
                                            <th style="display:none">UOMId</th>
                                            <th  style="display:none">UOM</th>
                                            <th>Selling Price</th>
                                            <th>Qty</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>

                            </div>
                        </div>
                        <div class="col-md-6">
                            <h4>Free Item(s)</h4>
                            <div class="form-horizontal form-label-left input_mask">                                                         
                                <table id="freeitem" class="mstable">
                                    <thead>
                                        <tr>
                                            <th>Group Id</th>
                                            <th style="display:none">Item Id</th>
                                            <th>Item Code</th>
                                            <th>Desc</th>
                                            <th style="display:none">Serving Unit Id</th>
                                            <th>Serving Unit</th>
                                            <th style="display:none">UOMId</th>
                                            <th  style="display:none">UOM</th>
                                            <th>Selling Price</th>
                                            <th>Qty</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="ln_solid"></div>
                    <div class="form-group">
                        <div class="col-md-12 col-sm-12 col-xs-12 ">
                            <button class="btn btn-primary" id="btnReset" onclick='Reset();' type="reset">Reset</button>
                            <button type="submit" id="btnSave" onclick='Back();' class="btn btn-success">Back</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script src="~/Scripts/SweetAlets/sweetalert.js"></script>
<script>

    $.getJSON("@Url.Action("GetPromotions", "ProductXYPromotions")", { promotionmasterid: @ViewBag.PromotionMasterId },
        function (data)
        {
            debugger; 
            var tablepromo = document.getElementById("promotiontable");
            var tablefree = document.getElementById("freeitem");
            $("#promotiontable").find("tr:not(:first)").remove();
            $("#freeitem").find("tr:not(:first)").remove();

            $.each(JSON.parse(data), function (index, optionaldata)
            {
                 
                if (optionaldata.ProductType == 1)
                {
                    $(tablepromo).find('tbody').append("<tr><td>"+optionaldata.GroupId+"</td><td style='display:none'>" + optionaldata.ProductId + "</td><td>" + optionaldata.ProductCode + "</td><td>" + optionaldata.ProductName + "</td><td style='display:none'>" + optionaldata.ServingUnitId + "</td><td>" + optionaldata.ServingUnit + "</td><td style='display:none'>" + optionaldata.UOMId + "</td><td style='display:none'>" + optionaldata.UOM + "</td><td>" + optionaldata.SellingPrice + "</td><td>" + optionaldata.Quantity + "</td><td><button type='button' id='promotionrow' onclick='RemovePromotionItemGroupX(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
                } else if (optionaldata.ProductType == 2)
                {
                    $(tablefree).find('tbody').append("<tr><td>"+optionaldata.GroupId+"</td><td style='display:none'>" + optionaldata.ProductId + "</td><td>" + optionaldata.ProductCode + "</td><td>" + optionaldata.ProductName + "</td><td style='display:none'>" + optionaldata.ServingUnitId + "</td><td>" + optionaldata.ServingUnit + "</td><td style='display:none'>" + optionaldata.UOMId + "</td><td style='display:none'>" + optionaldata.UOM + "</td><td>" + optionaldata.SellingPrice + "</td><td>" + optionaldata.Quantity + "</td><td></td></tr>");
                }

            });
        });

</script>
<script>
    function RemovePromotionItemGroupX(button) 
    {
       
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(3).html();
        var productid = $("TD", row).eq(1).html();
        var groupid = $("TD", row).eq(0).html();
        if (confirm("Do you want to delete: " + name+" ?"))
        {
          

            debugger;                 
            swal({
                title: "Remove Promotion Item Group",
                text: "Confirm?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
               function (isConfirm)
               {
                   if (isConfirm)
                   {
                    debugger
                           var ItemGroupToRemove = {};
                           ItemGroupToRemove.InvPromotionMasterId = @ViewBag.PromotionMasterId;
                           ItemGroupToRemove.ProductId = productid;
                           ItemGroupToRemove.GroupId = groupid;
                        

                                  
                       $.ajax({
                           type: "POST",
                           url: "@Url.Action("RemovePromotionItemGroup", "ProductXYPromotions")",                       
                           data:JSON.stringify(ItemGroupToRemove),                                
                           contentType: "application/json; charset=utf-8",
                           dataType: "json",
                           success: function (res)
                           {
                               if (res != 0)
                               {

                                   swal({
                                       title: "",
                                       text: "Promotion Item Group Removed Successfully!",
                                       type: "success",
                                       showCancelButton: false,
                                       confirmButtonClass: "btn-success",
                                       confirmButtonText: "Ok",
                                       closeOnConfirm: true
                                   },
                                    function () 
                                    {
                                        window.location.href = "ViewPromotionItems?promotionmasterid=" + @ViewBag.PromotionMasterId + "&promotiontypeid=" +  @ViewBag.PromotionTypeId;
                                    });
                                       
                               }
                               else
                               {
                                   swal("Error", "Promotion save failed!", "error");
                               }                                    
                           }
                        });
                     }
                  });


            var table = $("#promotiontable")[0];        
            table.deleteRow(row[0].rowIndex);
        }
    };
   
</script>






@*Reset*@

<script>
    function Reset() {

        window.location.href = "ViewPromotionItems?promotionmasterid=" + @ViewBag.PromotionMasterId + "&promotiontypeid=" +  @ViewBag.PromotionTypeId;
    };
</script>

@*Back*@

<script>
    function Back() {

        window.location.href = "/ProductXYPromotions/CreateProductXYPromotions";
    };
</script>

