                                                    <tr>
                                                        <th style="display:none">Item Id</th>
                                                        <th>Item Code</th>
                                                        <th>Desc</th>
                                                        <th style="display:none">Serving Unit Id</th>
                                                        <th>Serving Unit</th>
                                                        <th style="display:none">UOMId</th>
                                                        <th>UOM</th>
                                                        <th>Selling Price</th>
                                                        <th>Qty</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @*<tr>
                                                        <td>1</td>
                                                        <td scope="row">1</td>
                                                        <td>Mark dfgf erg erg erg </td>
                                                        <td>Otto</td>
                                                        <td>Otto</td>
                                                        <td>1mdo</td>
                                                        <td><button type="button" id="promotionrow" class="btn btn-danger btn-xs"> Remove </button></td>
                                                    </tr>*@

                                                </tbody>
                                            </table>
                                                        
                                        </div>
                                

                                </div>
                                <div class="col-md-6">
                                    <h4>Free Item(s)</h4>
