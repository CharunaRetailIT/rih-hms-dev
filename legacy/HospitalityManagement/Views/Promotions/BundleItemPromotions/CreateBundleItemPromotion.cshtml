@model RIT.HMS.Domain.Promotions.InvBundleItemPrice
@{
    ViewBag.Title = "Create Item Bundle Promotions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Scripts/SweetAlets/sweetalert.css" rel="stylesheet" />

<div class="right_col" role="main">


    <div class="clearfix"></div>
    <div class="container body">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2>Item Bundle Promotions <small>Special Prices for Bundle Items</small></h2>
                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">
                        <br />
                        <div class="form-horizontal form-label-left input_mask">
                            <div class="col-md-12">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-12">Promotion Name</label>
                                        <div class="col-md-7 col-sm-7 col-xs-12">
                                            <select id="PromotionMasterId" name="PromotionMasterId" class="form-control"></select>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-12">Bundle Name</label>
                                        <div class="col-md-7 col-sm-7 col-xs-12">
                                            <input type="text" class="form-control"
                                                   id="BundleName" placeholder="Bundle Name">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 text-left" style="background-color:#ddd">
                                    <h4>Promotion Details:</h4>
                                    <label id="promotiondet"></label>
                                    <label id="lblpromotiontype" hidden>0</label>
                                    <div id="buttondiv">
                                        <button type='button' id='promoitems' class='btn btn-primary btn-xs'> View Promotion Items </button>
                                    </div>
                                </div>
                            </div>
                            </div>
                            <div class="clearfix"></div>
                            <hr />
                            <br />
                            <div class="clearfix"></div>
                            <div class="col-md-12">


                                <div class="form-horizontal form-label-left input_mask">
                                    <div class="col-md-7">

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Promotion Item </label>
                                            <div class="col-md-9 col-sm-9 col-xs-12">
                                                <select class="form-control select2 productid" id="ProductId" name="ProductId"> </select>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Serving Unit</label>
                                            <div class="col-md-9 col-sm-9 col-xs-12">
                                                <select class="form-control" id="ServingUnitId" name="ServingUnitId"> </select>
                                            </div>
                                        </div>

                                        <div class="col-md-6 col-sm-6 col-xs-12 form-group has-feedback">
                                            Selling Price
                                            <input type="number" class="form-control has-feedback-left text-right" value="0"
                                                   id="sellingprice" placeholder="Selling Price">

                                        </div>

                                        <div class="col-md-6 col-sm-6 col-xs-12 form-group has-feedback">
                                            Quantity
                                            <input type="number" min="1" value="0" class="form-control text-right" id="promotionqty" placeholder="Quantity">

                                        </div>

                                        <div class="col-md-6 col-sm-6 col-xs-12 form-group has-feedback">

                                        </div>

                                        <div class="col-md-6 col-sm-6 col-xs-12">
                                            <button type="button" id="addpromotionitem" class="btn btn-primary col-md-6 col-sm-6 col-xs-12 pull-right">Add Item</button>
                                        </div>

                                    </div>
                                    <div class="col-md-5">

                                        <div class="pull-left">
                                            <input type="radio" name="pricefor" id="priceforbundle" checked="checked" value="B" />
                                            Price For Bundle
                                        </div>
                                        <div class="">
                                            <input type="radio" name="pricefor" id="priceforitem" value="I" />
                                            Prices For Items
                                        </div>
                                        <div class="clearfix"></div>
                                        <br />
                                        <div class="form-group">
                                            <label class="control-label col-md-2 col-sm-2 col-xs-12">Bundle Price </label>
                                            <div class="col-md-5 col-sm-5 col-xs-12">
                                                <input type="number" class="form-control has-feedback-left text-right" value="0" id="bundleprice" placeholder="Bundle Price">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>


                                    <table id="promotiontable" class="mstable">
                                        <thead>
                                            <tr>
                                                <th style="display:none">Item Id</th>
                                                <th>Item Code</th>
                                                <th>Desc</th>
                                                <th style="display:none">Serving Unit Id</th>
                                                <th>Serving Unit</th>
                                                <th style="display:none">UOMId</th>
                                                <th>UOM</th>
                                                <th>Item Selling Price</th>
                                                <th>Qty</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    <div class="clearfix"></div>
                    <div class="ln_solid"></div>
                    <div class="form-group">
                        <div class="col-md-12 col-sm-12 col-xs-12 ">
                            <button class="btn btn-primary" id="btnReset" onclick='Reset();' type="reset">Reset</button>
                            <button type="submit" id="btnSave" class="btn btn-success">Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script src="~/Scripts/SweetAlets/sweetalert.js"></script>
<script>

    $.getJSON("@Url.Action("GetBundlePromotionMasters", "ProductXYPromotions")", function (data) {

        var PromotionMasterId = $("#PromotionMasterId");

        PromotionMasterId.empty();
        PromotionMasterId.append("<option value='0'>-- Select a Promotion --</option>");

        $.each(JSON.parse(data), function (index, optionaldata)
        {
            PromotionMasterId.append($('<option />', { value: optionaldata.InvPromotionMasterID }).html(optionaldata.PromotionName + " LocationID " + optionaldata.LocationID));
        });
    });

    $("#PromotionMasterId").change(function ()
    {
        $.getJSON("@Url.Action("GetPromotionType", "ProductXYPromotions")", { promotionmasterid: $("#PromotionMasterId").val() },
           function (data)
           {
               debugger;
               var tablepromo = document.getElementById("promotiontable");
              
               $("#promotiontable").find("tr:not(:first)").remove();
            
                   debugger;
                   document.getElementById("promotiondet").innerText = data.PromotionName;
                   document.getElementById("lblpromotiontype").innerText = data.PromotionTypeId;
                  
           });
    });

    $.getJSON("@Url.Action("GetPromotionItems", "ProductXYPromotions")", function (data) {

        var ProductId = $("#ProductId");

        ProductId.empty();
        ProductId.append("<option value='0'>-- Select a Product --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            ProductId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));
        });
    });

    $(document).ready(function () {

        $("#ProductId").change(function () {

            $.getJSON("@Url.Action("GetServingUnits", "ProductXYPromotions")", { id: $("#ProductId").val() },
               function (data) {
                   var ServingUnitId = $("#ServingUnitId");

                   ServingUnitId.empty();
                   ServingUnitId.append("<option value='0'>-- Select a Serving Unit / UOM --</option>");

                   var ln = JSON.parse(data).length;

                   if (ln > 1) {
                       $.each(JSON.parse(data), function (index, optionaldata) {
                           ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                       });

                   }
                   else {
                       $.each(JSON.parse(data), function (index, optionaldata) {
                           ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                           ServingUnitId.val(optionaldata.ProductServingUnitId).trigger("change");
                       });

                   }


                   //$.each(JSON.parse(data), function (index, optionaldata) {
                   //    ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                   //});
               });
        });

        $("#ServingUnitId").change(function ()
        {

            $.getJSON("@Url.Action("GetProductDetails", "ProductXYPromotions")", { id: $("#ProductId").val(), servingunitid: $("#ServingUnitId").val() },
            function (data)
            {
                   document.getElementById("sellingprice").value = data.SellingPrice;
            });
        });
    });
</script>


@*HTML Tables Handling*@
@*Promotion Table*@
<script type="text/javascript">
    $("body").on("click", "#addpromotionitem",
        function () {
            debugger;

            if ($("#PromotionMasterId").val() == 0 || $("#PromotionMasterId").val() == null) {
                alert("Select a Promotion !");
                return;
            }

            if ($("#BundleName").val() == 0 || $("#BundleName").val() == null) {
                alert("Bundle Name Required !");
                return;
            }

            if ($("#ProductId").val() == 0 || $("#ProductId").val() == null) {
                alert("Select an Item !");
                return;
            }

            if ($("#ServingUnitId").val() == 0 || $("#ServingUnitId").val() == null) {
                alert("Select a Serving Unit !");
                return;
            }

            if ($("#promotionqty").val() == 0 || $("#promotionqty").val() == null) {
                alert("Invalid Quantity!");
                return;
            }

            var itemId = $("#ProductId").val();
            var itemsellingprice = 0;

            if ($("#priceforbundle").prop("checked"))
            {
                itemsellingprice = 0;

            } else
            {
                itemsellingprice = $("#sellingprice").val();
            }

            $.ajax({
                url: "@Url.Action("GetComboPackProductDetails", "ProductXYPromotions")",
                data: { id: $("#ProductId").val(), servingunitid: $("#ServingUnitId").val() },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    var table = document.getElementById("promotiontable");
                    $(table).find('tbody').append("<tr><td style='display:none'>" + data.ProductId + "</td><td>" + data.ProductCode + "</td><td>" + data.ProductName + "</td><td style='display:none'>" + data.ServingUnitId + "</td><td>" + data.ServingUnit + "</td><td style='display:none'>" + data.UOMId + "</td><td>" + data.UOM + "</td><td>" + itemsellingprice + "</td><td>" + $("#promotionqty").val() + "</td><td><button type='button' id='promotionrow' onclick='RemovePromotion(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
                    document.getElementById("promotionqty").value = "";
                    $("#BundleName").prop("disabled", true);
                },
                error: function (error) {
                    alert("Item data mapping error");
                }
            });
        });


    $("body").on("click", "#promoitems",
     function ()
     {
         debugger;
         var promomasterid = $("#PromotionMasterId").val();
         var promotiontypeid = document.getElementById("lblpromotiontype").innerText;
         if (promomasterid == "0")
         {
             alert("Select a Promotion");
             return;
         }
         debugger;

         window.location.href = "ViewPromotionItems?promotionmasterid=" + promomasterid;

     });

    function RemovePromotion(button)
    {
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(2).html();
        if (confirm("Do you want to delete: " + name + " ?"))
        {

            var table = $("#promotiontable")[0];
            table.deleteRow(row[0].rowIndex);
        }
    };
</script>


@*Submit*@

<script>

    $(document).ready(function ()
    {

        debugger;

        if ('@Model.DifferentPricesForItems' == 'True')
        {
            $("#bundleprice").prop("disabled", true);
            $("#sellingprice").prop("disabled", false);
        }
        if ('@Model.SinglePriceForAllItems' == 'True')
        {
            $("#bundleprice").prop("disabled", false);
            $("#sellingprice").prop("disabled", true);
        }



        if ($("#priceforbundle").prop("checked"))
        {
            $("#bundleprice").prop("disabled", false);
            $("#sellingprice").prop("disabled", true);
        }

        debugger;
        $('input[type=radio][name=pricefor]').change(function ()
        {
            debugger;

            //if ($('#promotiontable TBODY TR').length > 0)
            //{
            //    alert("Bundle price and item price can not be granted to same bundle!");
            //    return;
            //}


            if (this.value == 'B')
            {
                $("#bundleprice").prop("disabled", false);
                $("#sellingprice").prop("disabled", true);
            }
            else if (this.value == 'I')
            {
                $("#bundleprice").prop("disabled", true);
                $("#sellingprice").prop("disabled", false);
              
            }

        });



        $("body").on("click", "#btnSave", function ()
        {

            if ($("#PromotionMasterId").val() == 0 || $("#PromotionMasterId").val()==null) {
                alert("Select A Promotion.!");
                return;
            }


            if ($("#priceforbundle").prop("checked") && $("#bundleprice").val() == 0)
            {
                alert("Bundle Price Required.!");
                return;
            }


            if ($('#promotiontable TBODY TR').length == 0)
            {
                alert("Add Items To Bundle.!");
                return;
            }
            
            var pb = false;
            var pi = false;
            if ($("#priceforbundle").prop("checked")) {
                pb = true;
            }
            if ($("#priceforitem").prop("checked")) {
                pi = true;
            }
            var promotype = document.getElementById("lblpromotiontype").innerText;
                    debugger;
                    swal({
                        title: "Item Bundle Promotion",
                        text: "Confirm?",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#DD6B55",
                        confirmButtonText: "Yes",
                        cancelButtonText: "No",
                        closeOnConfirm: false,
                        closeOnCancel: true
                    },
                       function (isConfirm)
                       {
                           if (isConfirm)
                           {

                               var promotions = new Array();
                               $("#promotiontable TBODY TR").each(function ()
                               {
                                   var row = $(this);
                                   var promotion = {};
                                   promotion.PromotionMasterId = $("#PromotionMasterId").val();
                                   promotion.SinglePriceForAllItems = pb;
                                   promotion.DifferentPricesForItems = pi;
                                   promotion.ProductId = row.find("TD").eq(0).html();
                                   promotion.ServingUnitId = row.find("TD").eq(3).html();
                                   promotion.Quantity = row.find("TD").eq(8).html();
                                   promotion.SellingPrice = row.find("TD").eq(7).html();
                                   promotion.BundleSellingPrice = $("#bundleprice").val();
                                   promotion.BundleName = $("#BundleName").val();
                                 
                                   promotions.push(promotion);
                               });

                              
                               $.ajax({
                                   type: "POST",
                                   url: "@Url.Action("SubmitBundleItemPromotion", "BundleItemPromotions")",
                                   data:JSON.stringify(promotions),
                                   contentType: "application/json; charset=utf-8",
                                   dataType: "json",
                                   success: function (res)
                                   {
                                       if (res != 0)
                                       {

                                           swal({
                                               title: "",
                                               text: "Promotion Saved Successfully!",
                                               type: "success",
                                               showCancelButton: false,
                                               confirmButtonClass: "btn-success",
                                               confirmButtonText: "Ok",
                                               closeOnConfirm: true
                                           },
                                            function () {
                                                window.location.href = "/BundleItemPromotions/BundleItemPromotion";
                                            });

                                       }
                                       else
                                       {

                                           swal("Error", "Promotion save failed!", "error");
                                       }

                                   }
                               });

                           }
                       });
                });
    });
</script>


@*Reset*@

<script>
    function Reset() {

        window.location.href = "/BundleItemPromotions/BundleItemPromotion";
    };
</script>

@*Check Promotion Type*@

<script>
   function CheckPromotionType ()
   {

           $.ajax({
               url: "@Url.Action("GetPromotionType", "ProductXYPromotions")",
               data: { id: $("#PromotionMasterId").val() },
               type: "GET",
               dataType: "json",
               success: function (resp) {
               data = resp;
              return data.InvPromotionTypeID;
           },
           error: function (error) {
               alert("Item data mapping error");
           }
       });
    }

</script>