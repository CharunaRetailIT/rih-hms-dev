<script>


    $.getJSON("@Url.Action("GetPromotionMasters", "ProductDiscountPromotions")", function (data) {

        var PromotionMasterId = $("#PromotionMasterId");

        PromotionMasterId.empty();
        PromotionMasterId.append("<option value='0'>-- Select a Promotion --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            PromotionMasterId.append($('<option />', { value: optionaldata.InvPromotionMasterID }).html(optionaldata.PromotionName));
        });
    });

    $("#PromotionMasterId").change(function ()
    {
        $.getJSON("@Url.Action("GetPromotionType", "ProductXYPromotions")", { promotionmasterid: $("#PromotionMasterId").val() },
           function (data)
           {
               debugger;
               var tablepromo = document.getElementById("promotiontable");
               var tablefree = document.getElementById("freeitem");
               $("#promotiontable").find("tr:not(:first)").remove();
               $("#freeitem").find("tr:not(:first)").remove();

              // $.each(JSON.parse(data), function (index, optionaldata)
              // {
                   debugger;
                   document.getElementById("promotiondet").innerText = data.PromotionName;
                   document.getElementById("lblpromotiontype").innerText = data.PromotionTypeId;
                   //document.getElementById("promotiondet").innerText = optionaldata.PromotionName;
                   //document.getElementById("lblpromotiontype").innerText = optionaldata.PromotionTypeId;



              // });

           });
    });



    $.getJSON("@Url.Action("GetActiveDepartments", "Department")", function (data) {

        var departmentGroupDropDown = $("#DepartmentId");

        departmentGroupDropDown.empty();
        departmentGroupDropDown.append("<option value='0'>-- Select a Department--</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            departmentGroupDropDown.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));

        });

        if ('@ViewBag.DepartmentId') {
            $('#DepartmentId').val(@ViewBag.DepartmentId).trigger("change");
        } else {
            $('#DepartmentId').val(0).trigger("change");
        }
    });


</script>

<script>


    $.getJSON("@Url.Action("GetActiveDepartments", "Department")", function (data) {

        var DepartmentId = $("#Department");
        var CategoryId = $("#Category");
        var subCategoryId = $("#SubCategory");

        DepartmentId.empty();
        DepartmentId.append("<option value='0'>-- Select a department --</option>");
        CategoryId.append("<option value='0'>-- Select All --</option>");
        subCategoryId.append("<option value='0'>-- Select All --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            DepartmentId.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));

        });

    });

    $("#Department").change(function () {
        var diptId = this.value;

        $.getJSON("@Url.Action("GetMenuByDeptId", "Product")", { id: diptId },
        function (data) {

            var itemId = $("#ProductID");


            itemId.empty();
            itemId.append("<option value='0'>-- Select All Products --</option>");


            $.each(JSON.parse(data), function (index, optionaldata) {
                itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));

            });

        }
     );
    });
    
    $("#Department").change(function () {
        var diptId = this.value;

        $.getJSON("@Url.Action("GetCategoriesByDepartmentId", "Category")", { id: diptId },
            function (data) {

                var CategoryId = $("#Category");

                CategoryId.empty();
                CategoryId.append("<option value='0'>-- Select All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    CategoryId.append($('<option />', { value: optionaldata.RstCategoryID }).html(optionaldata.RstCategoryName));
                });


            });
    });


    $("#Category").change(function () {
        var deptid = $("#Department").val();
        var catid = this.value;

        $.getJSON("@Url.Action("GetSubcatByCatId", "Product")", { id: catid },
            function (data) {

                var subCategoryId = $("#SubCategory");

                subCategoryId.empty();
                subCategoryId.append("<option value='0'>-- Select All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    subCategoryId.append($('<option />', { value: optionaldata.RstSubCategoryID }).html(optionaldata.RstSubCategoryName));
                });

            });

        $.getJSON("@Url.Action("GetMenuByDeptCatId", "Product")", { deptid: deptid, catid: catid },
         function (data) {

             var itemId = $("#ProductID");


             itemId.empty();
             itemId.append("<option value='0'>-- Select All Products --</option>");


             $.each(JSON.parse(data), function (index, optionaldata) {
                 itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));

             });

         }
       );


    });


    $("#SubCategory").change(function () {
        var deptid = $("#Department").val();
        var catid = $("#Category").val();
        var scatid = this.value;

        $(document).ready(function () {
           
       


        $.getJSON("@Url.Action("GetMenuByDeptCatScatId", "Product")", { deptid: deptid, catid: catid, scatid: scatid },
              function (data) {

                  var itemId = $("#ProductID");


                  itemId.empty();
                  itemId.append("<option value='0'>-- Select All Products --</option>");


                  $.each(JSON.parse(data), function (index, optionaldata) {
                      itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName));

                  });

              }
            );

        });

    });


    $(document).ready(function () {
        $("#ProductID").change(function () {

            $.getJSON("@Url.Action("GetServingUnits", "ProductXYPromotions")", { id: $("#ProductID").val() },
               function (data) {
                   var ServingUnitId = $("#ServingUnitId");

                   ServingUnitId.empty();
                   ServingUnitId.append("<option value='0'>-- Select a Serving Unit / UOM --</option>");



                   //$.each(JSON.parse(data), function (index, optionaldata) {
                   //    ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                   //});


                   var ln = JSON.parse(data).length;

                   if (ln > 1) {
                       $.each(JSON.parse(data), function (index, optionaldata) {
                           ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                       });

                   } else {
                       $.each(JSON.parse(data), function (index, optionaldata) {
                           ServingUnitId.append($('<option />', { value: optionaldata.ProductServingUnitId }).html(optionaldata.ServingUnit));
                           ServingUnitId.val(optionaldata.ProductServingUnitId).trigger("change");
                       });

                   }


               });

        });
    });


</script>


<script type="text/javascript">
    $("body").on("click",
        "#btnAddItem",
        function () {

            debugger;
            if ($("#Department").val() == 0 || $("#Department").val() == null)
            {
                alert("Select a Department !");
                return;
            }


            var Product = $("#ProductID").val();
            var Department = $("#Department").val();
            var Category = $("#Category").val();
            var SubCategory = $("#SubCategory").val();
            var ServingUnit;
            if ($("#ServingUnitId").val() == null || $("#ServingUnitId").val() == "")
            {
                ServingUnit = 0;
            } else
            {
                ServingUnit = $("#ServingUnitId").val();
            }

            var FromQty = $("#FromQty").val();
            var ToQty = $("#ToQty").val();
            var Rate = $("#Rate").val();
            var Points = $("#Points").val();
            var DiscountAmt = $("#DiscountAmount").val();
            var DiscountPrc = $("#DiscountPercentage").val();
            var PromoMasterId = $("#PromotionMasterId").val();

           
            swal({
                title: "Item TO Item Promotion",
                text: "Confirm?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
                       function (isConfirm)
                       {
                           if (isConfirm)
                           {

                         

                                    $.ajax({
                                        url: "@Url.Action("SubmitProductDiscouts", "ProductDiscountPromotions")",
                                        data: {
                                            deptid: Department, catid: Category, subcatid: SubCategory, productid: Product, servingunitid: ServingUnit,
                                            FromQty: FromQty, ToQty: ToQty, Rate: Rate, Points: Points, DiscountAmt: DiscountAmt, DiscountPrc: DiscountPrc,
                                            promomasterid: PromoMasterId
                                            },
                
                                        type: "GET",
                                        dataType: "json",
                                        success: function (data)
                                        {

                                            if (data != 0)
                                            {

                                                swal({
                                                    title: "",
                                                    text: "Promotion Saved Successfully!",
                                                    type: "success",
                                                    showCancelButton: false,
                                                    confirmButtonClass: "btn-success",
                                                    confirmButtonText: "Ok",
                                                    closeOnConfirm: true
                                                },
                                            function () {
                                                window.location.href = "/ProductDiscountPromotions/ProductDiscountPromotions";
                                            });

                                               
                                            }
                   

                                        }
               
                                    });
                           }
                       });



        });
    

</script>


<script>

    function RemoveItem(button)
    {

        var row = $(button).closest("TR");
        var name = $("TD", row).eq(3).html();

        var rowid = $("TD", row).eq(0).html();
        var productname = $("TD", row).eq(6).html();
        var servingunit = $("TD", row).eq(10).html();

        if (confirm("Do you want to delete: " + productname + "- "+ servingunit+" ?"))
        {

            $.ajax({
                type: "GET",
                url: "@Url.Action("RemoveProductDiscount", "ProductDiscountPromotions")",
                data: { rowid:rowid},
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res)
                {

                    var table = $("#datatable")[0];
                    table.deleteRow(row[0].rowIndex);

                }
        });




           
    }
    };

</script>