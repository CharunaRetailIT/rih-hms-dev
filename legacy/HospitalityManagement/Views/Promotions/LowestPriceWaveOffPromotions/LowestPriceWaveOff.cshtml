@model RIT.HMS.Domain.Promotions.InvPromoLowestPriceWaveOff
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Promotions.css" rel="stylesheet" />
<h2></h2>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>

</head>

<body class="nav-md">
    <div class="container body">
        <div class="main_container">
            @using (Html.BeginForm("LowestPriceWaveOff", "Promotion", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @*@Html.HiddenFor(model=>model.RstDepartmentID)*@
            <!-- page content -->
                <div class="right_col" role="main">
                    <div class="">

                        <div class="clearfix"></div>
                        @if (@ViewBag.Message == "1")
                        {
                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Lowest Price Wave Off</strong> @ViewBag.LowestPriceWaveOffCode saved successfully.
                            </div>
                        }
                        else if (@ViewBag.Message == "0")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Lowest Price Wave Off</strong> @ViewBag.LowestPriceWaveOffCode save failed.
                            </div>
                        }
                        else if (@ViewBag.Message == "3")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Lowest Price Wave Off</strong> @ViewBag.LowestPriceWaveOffCode already exists.
                            </div>
                        }

                        <div class="row">

                            <!-- form input mask -->
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="x_panel">

                                    <div class="x_title">
                                        <h2>Lowest Price Wave Off</h2>
                                        <br />

                                        <ul class="nav navbar-right panel_toolbox">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                           
                                            <li>
                                                <a class="close-link"><i class="fa fa-close"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>

                                    <div class="x_content">
                                        <br />
                                        <form class="form-horizontal form-label-left">


                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3"> Code</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.LowestPriceWaveOffCode, new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Code",
                                                   MaxLength = 50,
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })

                                                    @Html.ValidationMessageFor(model => model.LowestPriceWaveOffCode, "", new { @class = "text-danger" })

                                                </div>
                                            </div>


                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Promotion Name</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9"> 
                                                    <select id="PromotionMasterID" name="PromotionMasterID" class="form-control"></select>
                                                </div>
                                            </div>


                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Lowest Price</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.LowestPrice, new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Price",
                                                   MaxLength = 50,
                                                   Type= "number",
                                                   min = "0",
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.LowestPrice, "", new { @class = "text-danger", min = "0" })

                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Full Wave Off</label>
                                                <div class="checkbox col-xs-1 pull-left ">
                                                    @Html.CheckBoxFor(model => model.IsFullWaveOff, new { id = "IsFullWaveOff"})
                                                    @*<input type="checkbox" class = "flat checkbox" id="IsFullWaveOff" name="IsFullWaveOff" />*@
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Quantity</label>
                                                <div class="col-md-3 col-sm-9 col-xs-9">
                                                    @Html.TextBoxFor(model => model.Qty, new
                                               {
                                                   @class = "form-control",
                                                   Placeholder = "Quantity",
                                                   MaxLength = 50,
                                                   Type = "number",
                                                   min = "0",
                                                   oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                               })
                                                    @Html.ValidationMessageFor(model => model.Qty, "", new { @class = "text-danger", id= "Qty" })

                                                </div>
                                            </div>
                                            
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Remark</label>
                                                <div class="col-md-9 col-sm-9 col-xs-9">
                                                    @Html.TextAreaFor(model => model.Remark, new { @class = "form-control", Placeholder = "Remark" })
                                                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsActive</label>
                                                <div class="checkbox col-xs-1 pull-left ">
                                                    @Html.CheckBoxFor(model => model.Status, new {  id= "Status" })
                                                </div>
                                            </div>

                                            <div class="actionBar">
                                                <div class="msgBox">

                                                    <div class="btn btn-primary pl_add btn-small pull-left">
                                                        @Html.ActionLink("Clear", "LowestPriceWaveOff", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                    </div>
                                                    <button type="submit" formaction="CreateLowestPriceWaveOff" class="btn btn-success pull-left">Submit </button>

                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>


</body>
</html>

<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $.getJSON("@Url.Action("GetActivePromos", "Promotion")", function (data) {

        var promotionMasterID = $("#PromotionMasterID");

        promotionMasterID.empty();
        promotionMasterID.append("<option value='0'>Select a Promotion</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            promotionMasterID.append($('<option />', { value: optionaldata.InvPromotionMasterID }).html(optionaldata.PromotionName));

        });

        if ('@ViewBag.promotionMasterID') {
            $('#PromotionMasterID').val(@ViewBag.promotionMasterID).trigger("change");
        } else {
            $('#PromotionMasterID').val(0).trigger("change");
        }

    });
</script>

<script type="text/javascript">

    $("#IsFullWaveOff").click(function (e, parameters) {

        var nonUI = false;
        try {
            nonUI = parameters.nonUI;
        } catch (e) { }
        var checked = nonUI ? !this.checked : this.checked;
        //alert('Checked = ' + checked);
        if (checked)
        {
            $("#Qty").prop("disabled", true);
        } else
        {
            //alert(2);
            $("#Qty").prop("disabled", false);
        }
    });



</script>



