@*HTML Tables Handling*@
@*Promotion Table*@
<script type="text/javascript">
    $("body").on("click",
        "#addpromotionitem",
        function () {
            debugger;


            var crrrows = document.getElementById("promotiontable").rows.length - 1;
            var promotype = document.getElementById("lblpromotiontype").innerText;

            // Promotion type validations
            if (promotype == 2 && crrrows == 1)
            {
                alert("One promotion item can be added to this promotion!");
                return;
            }

            if (promotype == 4 && crrrows == 1) {
                alert("One promotion item can be added to this promotion!");
                return;
            }

            // end promotion type validations

            if ($("#ProductId").val() == 0 || $("#ProductId").val() == null) {
                alert("Select an Item !");
                return;
            }

            if ($("#ServingUnitId").val() == 0 || $("#ServingUnitId").val() == null) {
                alert("Select a Serving Unit !");
                return;
            }
            if ($("#promotionqty").val() == 0 || $("#promotionqty").val() == null) {
                alert("Invalid Quantity!");
                return;
            }

            var itemId = $("#ProductId").val();

            $.ajax({
                url: "@Url.Action("GetProductDetails", "ProductXYPromotions")",
                data: { id: $("#ProductId").val(), servingunitid: $("#ServingUnitId").val() },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    var table = document.getElementById("promotiontable");
                    $(table).find('tbody').append("<tr><td style='display:none'>" + data.ProductId + "</td><td>" + data.ProductCode + "</td><td>" + data.ProductName + "</td><td style='display:none'>" + data.ServingUnitId + "</td><td>" + data.ServingUnit + "</td><td style='display:none'>" + data.UOMId + "</td><td>" + data.UOM + "</td><td>" + data.SellingPrice + "</td><td>" + $("#promotionqty").val() + "</td><td><button type='button' id='promotionrow' onclick='RemovePromotion(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
                    document.getElementById("promotionqty").value = "";
                },
                error: function (error) {
                    alert("Item data mapping error");
                }
            });
        });




    function RemovePromotion(button) {

        var row = $(button).closest("TR");
        var name = $("TD", row).eq(2).html();
        if (confirm("Do you want to delete: " + name+" ?")) {
            //Get the reference of the Table.
            var table = $("#promotiontable")[0];

            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        }
    };


</script>

@*Free Item  Table*@
<script type="text/javascript">
    $("body").on("click",
        "#addfreeitem",
        function () {
            debugger;

            var crrrows = document.getElementById("freeitem").rows.length - 1;
            var promotype = document.getElementById("lblpromotiontype").innerText;

            // promotion type validations
            if (promotype == 2 && crrrows==1) {
                alert("One Free item can be added to this promotion!");
                return;
            }

            // end promotion type validations
            if ($("#YProductId").val() == 0 || $("#YProductId").val() == null) {
                alert("Select an Item !");
                return;
            }

            if ($("#YServingUnitId").val() == 0 || $("#YServingUnitId").val() == null) {
                alert("Select a Serving Unit !");
                return;
            }
            if ($("#freequantity").val() == 0 || $("#freequantity").val() == null) {
                alert("Invalid Quantity!");
                return;
            }



            //Discounts Calculations

            var finalsellingprice = 0;
            var discounttype = "";
            var discountamount = 0;
            var discountvalue = 0;
            if ($("#discountValue").val() != 0 || $("#discountValue").val() != null) {
                discountvalue = $("#discountValue").val();
                var sellingprice = $("#freesellingprice").val();

                if (document.getElementById('discountAmt').checked) {
                    discounttype = "Amt";
                    discountamount = discountvalue;
                }
                if (document.getElementById('discountPrc').checked) {
                    discounttype = "Prc";
                    discountamount = ((discountvalue / 100) * sellingprice).toFixed(2);

                    //alert(discountprc);
                }
                finalsellingprice = (sellingprice - discountamount).toFixed(2);
                //    discountamount.toFixed(2);
               // alert(discountamount);
               // alert(finalsellingprice);
            } else
            {
                finalsellingprice = $("#freesellingprice").val();
            }
            // end of discount calculations

            var itemId = $("#YProductId").val();

            $.ajax({
                url: "@Url.Action("GetProductDetails", "ProductXYPromotions")",
                data: { id: $("#YProductId").val(), servingunitid: $("#YServingUnitId").val() },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    var table = document.getElementById("freeitem");
                    $(table).find('tbody').append("<tr><td style='display:none'>" + data.ProductId + "</td><td>" + data.ProductCode + "</td><td>" + data.ProductName + "</td><td style='display:none'>" + data.ServingUnitId + "</td><td>" + data.ServingUnit + "</td><td style='display:none'>" + data.UOMId + "</td><td>" + data.UOM + "</td><td>" + finalsellingprice + "</td><td style='display:none'>" + discounttype + "</td><td>" + discountvalue + "</td><td>" + $("#freequantity").val() + "</td><td><button type='button' id='freeitemrowrow' onclick='RemoveFreeItem(this);' class='btn btn-danger btn-xs'> Remove </button></td></tr>");
                    document.getElementById("freequantity").value = "";
                    document.getElementById("discountValue").value = "";
                },
                error: function (error) {
                    alert("Item data mapping error");
                }
            });
        });


    function RemoveFreeItem(button) {

        var row = $(button).closest("TR");
        var name = $("TD", row).eq(2).html();
        if (confirm("Do you want to delete: " + name + " ?")) {
            var table = $("#freeitem")[0];
            table.deleteRow(row[0].rowIndex);
        }
    };
</script>

@*Submit*@

<script>

    $(document).ready(function () {
        $("body").on("click", "#btnSave", function () {

            if ($('#promotiontable tr').length == 1 || $('#freeitem tr').length == 1) {
                return;
            }

            var freetablelength = document.getElementById("freeitem").rows.length - 1;
            var promotype = document.getElementById("lblpromotiontype").innerText;

            if (promotype == 4 && freetablelength == 1) {
                alert("This promotion must have many free items");
                return;
            }




            debugger;
            swal({
                title: "Discounts Promotion",
                text: "Confirm?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
               function (isConfirm) {
                   if (isConfirm) {

                       var promotions = new Array();
                       $("#promotiontable TBODY TR").each(function () {
                           var row = $(this);
                           var promotion = {};
                           promotion.ProductId = row.find("TD").eq(0).html();
                           promotion.ProductCode = row.find("TD").eq(1).html();
                           promotion.ProductName = row.find("TD").eq(2).html();
                           promotion.ServingUnitId = row.find("TD").eq(3).html();
                           promotion.ServingUnit = row.find("TD").eq(4).html();
                           promotion.SellingPrice = row.find("TD").eq(7).html();
                           promotion.Quantity = row.find("TD").eq(10).html();
                           promotion.DiscountAmt = 0;
                           promotion.DiscountType = "N";
                           promotion.UOM = row.find("TD").eq(6).html();
                           promotion.UOMId = row.find("TD").eq(5).html();
                           promotion.PromotionItemType = 1;
                           promotion.PromotionMasterId = $("#PromotionMasterId").val();
                           promotions.push(promotion);
                       });

                       $("#freeitem TBODY TR").each(function () {
                           var row = $(this);
                           var free = {};
                           free.ProductId = row.find("TD").eq(0).html();
                           free.ProductCode = row.find("TD").eq(1).html();
                           free.ProductName = row.find("TD").eq(2).html();
                           free.ServingUnitId = row.find("TD").eq(3).html();
                           free.ServingUnit = row.find("TD").eq(4).html();
                           free.SellingPrice = row.find("TD").eq(7).html();
                           free.Quantity = row.find("TD").eq(10).html();
                           free.DiscountAmt = row.find("TD").eq(9).html();
                           free.DiscountType = row.find("TD").eq(8).html();
                           free.UOM = row.find("TD").eq(6).html();
                           free.UOMId = row.find("TD").eq(5).html();
                           free.PromotionItemType = 2;
                           free.PromotionMasterId = $("#PromotionMasterId").val();
                           promotions.push(free);
                       });



                       $.ajax({
                           type: "POST",
                           url: "@Url.Action("SubmitPromotions", "DiscountsPromotions")",
                           data: JSON.stringify(promotions),
                           contentType: "application/json; charset=utf-8",
                           dataType: "json",
                           success: function (res) {
                               if (res != 0) {

                                   swal({
                                       title: "",
                                       text: "Promotion Saved Successfully!",
                                       type: "success",
                                       showCancelButton: false,
                                       confirmButtonClass: "btn-success",
                                       confirmButtonText: "Ok",
                                       closeOnConfirm: true
                                   },
                                    function () {
                                        window.location.href = "/DiscountsPromotions/CreateDiscountsPromotion";
                                    });

                               }
                               else {

                                   swal("Error", "Promotion save failed!", "error");
                               }
                           }
                       });
                   }
               });
        });
    });
</script>


@*Reset*@

<script>
    function Reset() {

        window.location.href = "/DiscountsPromotions/CreateDiscountsPromotion";
    };
</script>
