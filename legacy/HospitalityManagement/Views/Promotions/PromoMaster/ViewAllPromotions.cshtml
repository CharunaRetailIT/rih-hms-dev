
@model IEnumerable< RIT.HMS.Domain.Promotions.InvPromotionMaster>
@{
    ViewBag.Title = "ViewAllPromotions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2></h2>
@using (Html.BeginForm("", "Promotion", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
<body class="nav-md">

    <div class="right_col" role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">
                <!-- form input mask -->
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">

                        <div class="x_content">
                            <br />

                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>View/ Edit Promotion Schedular<small></small></h2>
                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                       
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="form-group ">
                                    <div class="">

                                    </div>
                                    <div class="pull-right">
                                        <input type="submit" value="Download Data" formaction="HMSPromotions" class="btn btn-primary">
                                    </div>
                                </div><div class="clerfix"></div><br />
                                <div class="x_content"><br />
                                    @*<table id="datatable-responsive"
                                           class="table table-striped table-bordered dt-responsive nowrap">*@
                                    <table id="datatable-responsive" class="mstable">
                                        <thead>
                                            <tr>
                                                <th>Pomo Code</th>
                                                <th>Name</th>
                                                @*<th>Type</th>*@
                                                <th>Start Date</th>
                                                <th>End Date</th>
                                                @*<th></th>*@
                                                <th></th>

                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.PromotionCode)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.PromotionName)</td>
                                                    @*<td>@Html.DisplayFor(modelItem => item.PromotionTypeID)</td>*@
                                                    <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                                                    <td>@Html.ActionLink("Edit", "Edit", new { id = item.InvPromotionMasterID })</td>
                                                    @*<td>@Html.ActionLink("View Items", "ViewItems", new { id = item.PromotionTypeID })</td>*@

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>


                        </div>
                    </div>
                    <div class="clerfix">
                        <div class="btn btn-info pl_add btn-small pull-left">
                            @Html.ActionLink("Create New Promotion", "Index", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>


</body>
}