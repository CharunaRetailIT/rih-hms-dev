                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Document Date</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.DocumentDate, new
                                                        {
                                                            @id = "DocumentDate",
                                                            @class = "form-control pull-left",
                                                            Type = "date",
                                                            @Style = "width:50%",
                                                            Placeholder = "StartingDate",
