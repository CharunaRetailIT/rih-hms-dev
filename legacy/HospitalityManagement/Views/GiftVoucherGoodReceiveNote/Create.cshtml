                                        <div class="form-horizontal form-label-left col-md-12">
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">No of Vouchers *</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.GiftVoucherQty, new { id = "txtGiftVoucherCount", @class = "form-control", MaxLength = 50, Placeholder = "No of Vouchers", @readonly = "readonly" })
