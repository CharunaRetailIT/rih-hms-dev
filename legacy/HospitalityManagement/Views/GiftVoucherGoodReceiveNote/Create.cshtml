                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Serial Length *</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.SerialLength, new { id = "txtSerialLength", @class = "form-control", MaxLength = 50, Placeholder = "Serial Length", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Dispatch Date</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.DispatchDate, new
                                                        {
                                                            @id = "DispatchDate",
                                                            @class = "form-control pull-left",
                                                            Type = "date",
                                                            @Style = "width:50%",
                                                            Placeholder = "StartingDate",
                                                            @Value = string.Format("{0:yyyy-MM-dd}", DateTime.Now),
                                                        })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-12">
                                                <div class="form-horizontal form-label-left col-md-6">
                                                    <div class="form-group">
