                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Payment Terms</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.PaymentTerms, new { @class = "form-control", MaxLength = 50, Placeholder = "" })
                                                    </div>
                                                </div>
