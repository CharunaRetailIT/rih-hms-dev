<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        Giftvouchergroupload();
        GVsupplier();
        GVbookload();
        LoadLocation();
        PurchaseOrderload();
    });
    $(document).ready(function () {
        var textboxValue = $("#GVDocumentNo").val();
        $("#DocumentNohidden").val(textboxValue);
    });
    $('#LocationA').click(function (e) {
        e.preventDefault(); // Prevent form submission
        $('#LocationA').change(function () {
            var selectedValue = $(this).val();
            $('#LocationAhidden1').val(selectedValue);//value assign to the hidden variable
        });
    });
    $('#PaymentTerm').click(function (e) {
        e.preventDefault(); // Prevent form submission
        $('#PaymentTerm').change(function () {
            var selectedValue = $(this).val();
            $('#PaymentTermhidden1').val(selectedValue);//value assign to the hidden variable
        });
    });
    $('#SupplierID').click(function (e) {
        e.preventDefault(); // Prevent form submission
        $('#SupplierID').change(function () {
            var selectedValue = $(this).val();
            $('#SupplierIDhidden1').val(selectedValue);//value assign to the hidden variable
        });
    });
    $("#PurchaseOrderID").change(function () {
        var PODocNo = this.value;        
        $.getJSON("@Url.Action("GetViewGRNDetails", "GiftVoucherGoodReceiveNote")", { DocumentNO: PODocNo },
        function (data) {
            var giftvoucherBooks = JSON.parse(data);
            //console.log(giftvoucherBooks);        
            $('#BookCode1').val(giftvoucherBooks.giftvoucherBook[0].BookCode).trigger("change");
            $('#GiftVoucherGroupCode').val(giftvoucherBooks.GiftVoucherGroupCode);
            $("#txtVoucherSerial").val(giftvoucherBooks.giftvoucherBook[0].SerialFormat);
            $("#txtGiftVoucherValue").val(giftvoucherBooks.giftvoucherBook[0].GiftVoucherValue);
            $("#txtGiftVoucherCount").val(giftvoucherBooks.giftvoucherBook[0].PageCount);
            $("#txtSerialLength").val(giftvoucherBooks.giftvoucherBook[0].SerialLength);
            $("#txtStartingNo").val(giftvoucherBooks.giftvoucherBook[0].StartingNo);
            $("#txtVoucherPrefix").val(giftvoucherBooks.giftvoucherBook[0].BookPrefix);
            $("#txtGiftVoucherPercentage").val(giftvoucherBooks.giftvoucherBook[0].GiftVoucherPercentage);
            $("#txtPageCount").val(giftvoucherBooks.giftvoucherBook[0].PageCount);
        });
    });
    var PurchaseOrderload = function () {
        $.getJSON("@Url.Action("GetGiftvoucherPurchaseOrderload", "GiftVoucherGoodReceiveNote")", function (data) {
            var PurchaseOrderID = $("#PurchaseOrderID");
            PurchaseOrderID.empty();
            PurchaseOrderID.append("<option value='0'>-- Select a Purchase Order  --</option>");
            var ln = JSON.parse(data).length;
            $.each(JSON.parse(data), function (index, optionaldata) {
                // alert(optionaldata.InvGiftVoucherPurchaseOrderHeaderID);
                PurchaseOrderID.append($('<option />', { value: optionaldata.InvGiftVoucherPurchaseOrderHeaderID }).html(optionaldata.DocumentNo));
            });

        });
    }
    var Giftvouchergroupload = function () {
        $.getJSON("@Url.Action("GetGiftvoucherGroup", "GiftVoucherGoodReceiveNote")", function (data) {
            var GiftVoucherGroupCode = $("#GiftVoucherGroupCode");
            GiftVoucherGroupCode.empty();
            GiftVoucherGroupCode.append("<option value='0'>-- Select Group --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                GiftVoucherGroupCode.append($('<option />', { value: optionaldata.GiftVoucherGroupCode }).html(optionaldata.GiftVoucherGroupCode));
            });
        });
    }   
    var LoadLocation = function () {
        $.getJSON("@Url.Action("GetLocationAll", "GiftVoucherPurchaseOrder")", function (data) {
            var LocationA = $("#LocationA");
            LocationA.empty();
            LocationA.append("<option value='0'>-- Select --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                LocationA.append($('<option />', { value: optionaldata.LocationCode }).html(optionaldata.LocationName));
            });
            if ('@ViewBag.LocationA') {
                $('#LocationA').val(@ViewBag.LocationA).trigger("change");
            } else {
                $('#LocationA').val(0).trigger("change");
            }
        });
    }
    var GVsupplier = function () {
        $.getJSON("@Url.Action("GetGiftvoucherSupplier", "GiftVoucherPurchaseOrder")", function (data) {
            var SupplierID = $("#SupplierID");
            SupplierID.empty();
            SupplierID.append("<option value='0'>-- Select Supplier --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                SupplierID.append($('<option />', { value: optionaldata.SupplierCode }).html(optionaldata.SupplierName));
            });
            if ('@ViewBag.SupplierID') {
                $('#SupplierID').val(@ViewBag.SupplierID).trigger("change");
            } else {
                $('#SupplierID').val(0).trigger("change");
            }
        });
    }   
    var GVbookload = function () {
        $.getJSON("@Url.Action("GetGiftvoucherBook", "GiftVoucherMaster")", function (data) {
            var BookCode = $("#BookCode1");
            BookCode.empty();
            BookCode.append("<option value='0'>-- Select Book --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                BookCode.append($('<option />', { value: optionaldata.BookCode }).html(optionaldata.BookName));
            });          
        });
    } 
    $('#BookCode1').click(function (e) {
           var bokid = this.value;
            $.getJSON("@Url.Action("GetGiftvoucherBookDetails", "GiftVoucherMaster")", { GvBookCode: bokid },
                function (data) {
                    var giftvoucherBooks = JSON.parse(data);
                    $("#txtVoucherSerial").val(giftvoucherBooks.SerialFormat);
                    $("#txtGiftVoucherValue").val(giftvoucherBooks.giftvoucherBook[0].GiftVoucherValue);
                    $("#txtGiftVoucherCount").val(giftvoucherBooks.giftvoucherBook[0].PageCount);
                    $("#txtSerialLength").val(giftvoucherBooks.giftvoucherBook[0].SerialLength);
                    $("#txtStartingNo").val(giftvoucherBooks.giftvoucherBook[0].StartingNo);
                    $("#txtVoucherPrefix").val(giftvoucherBooks.giftvoucherBook[0].BookPrefix);
                    $("#txtGiftVoucherPercentage").val(giftvoucherBooks.giftvoucherBook[0].GiftVoucherPercentage);
                    $("#txtPageCount").val(giftvoucherBooks.giftvoucherBook[0].PageCount);
                });
    });
    var EnableDisable = function () {
        if ($("#DirectGRN").is(":checked")) {
            $('#PurchaseOrderID').prop('disabled', false);
            $('#GiftVoucherGroupCode').prop('disabled', 'disabled');
            $('#BookCode1').prop('disabled', 'disabled');
        }
        else {
            $('#PurchaseOrderID').prop('disabled', 'disabled');
            $('#GiftVoucherGroupCode').prop('disabled', false);
            $('#BookCode1').prop('disabled', false);
        }
    };
    $(EnableDisable);
    $("#DirectGRN").change(EnableDisable);
</script>

