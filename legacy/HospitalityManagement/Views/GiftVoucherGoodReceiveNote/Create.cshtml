@model  HospitalityManagement.Models.GiftVoucherGoodReceiveNote
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="container body">
        <div class="main_container">
            @using (Html.BeginForm("Create", "GiftVoucherGoodReceiveNote", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <!-- page content -->
                <div class="right_col" role="main">
                    <div class="">
                        <div class="clearfix"></div>
                        @if (@ViewBag.Message == "3")
                        {
                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Gift Voucher Good Receive Note</strong> @ViewBag.Gift Saved Successfully.
                            </div>
                        }
                        else if (@ViewBag.Message == "4")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Gift Voucher Good Receive Note</strong> @ViewBag.Gift Book Already Exisist.
                            </div>
                        }
                        else if (@ViewBag.Message == "0")
                        {
                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Gift Voucher Good Receive Note</strong> @ViewBag.Gift Save Failed.
                            </div>
                        }
                        else if (@ViewBag.Message == "5")
                        {
                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                <strong>Gift Voucher Good Receive Note</strong> @ViewBag.Gift Saved Successfully.
                            </div>
                        }
                        <div class="row">
                            <!-- form input mask -->

                            <div class="col-md-12 col-sm-12 col-xs-12">

                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Gift Voucher Good Receive Note</h2>
                                        <br />
                                        <div class="clearfix"></div>
                                    </div>
                                    <div class="form-horizontal form-label-left col-md-12">
                                        <div class="form-horizontal form-label-left col-md-6">
                                        </div>
                                        <div class="form-horizontal form-label-left col-md-6">
                                            @using (Html.BeginForm())
                                            {
                                                <input type="checkbox" id="DirectGRN" name="DirectGRN" value="yes">
                                                <label for="pizza">PO Base GRN</label>
                                            }
                                        </div>
                                    </div>
                                    <div class="form-horizontal form-label-left col-md-12">
                                        <div class="form-horizontal form-label-left col-md-6">
                                            <div class="form-group">
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">Document No</label>
                                                <div class="col-md-6 col-sm-6 col-xs-6 text-left">
                                                    @Html.TextBoxFor(model => model.DocumentNo, new { @Value = ViewBag.GVDocumentNo, @class = "form-control", @readonly = "readonly", id = "GVDocumentNo" })
                                                </div>
                                                <div class="col-md-3 col-sm-3 col-xs-3 text-left">
                                                    <span class="input-group-btn">
                                                        <input type="submit" value="New Code" formaction="GetNewGiftVoucherDocumentNo" class="btn btn-primary pull-right">
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-horizontal form-label-left col-md-6">
