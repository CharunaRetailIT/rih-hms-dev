                                                <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                    <select id="InvGiftVoucherGroupID" class="form-control" name="InvGiftVoucherGroupID"></select>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6"></div>
                                        </div>
                                        <div class="form-horizontal form-label-left col-md-12">
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Based on *</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        <select id="Basedon" name="Basedon" class="form-control">
