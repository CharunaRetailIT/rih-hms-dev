                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.ValidityPeriod, new { @class = "form-control", @type = "number", MaxLength = 50, Placeholder = "Validity Period(Days)" })
                                                        @Html.ValidationMessageFor(model => model.ValidityPeriod, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Precentage of Coupon</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        <div id="D">
                                                            @Html.TextBoxFor(model => model.GiftVoucherPercentage, new { @disabled = "disabled" })
                                                            @Html.ValidationMessageFor(model => model.GiftVoucherPercentage, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <br />

                                        <div class="clearfix"></div>
                                        <div class="form-group">
                                            <div class="btn btn-primary pl_add btn-small pull-left">
                                                @Html.ActionLink("Clear", "Create", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <div class="btn btn-info pl_add btn-small pull-left">
                                                @Html.ActionLink("View All", "ViewBookCode", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <div class="clearfix">
                                                <button type="submit" class="btn btn-primary pl_add btn-small pull-left">Submit</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        Giftvouchergroupload();
    });
    var Giftvouchergroupload = function () {
        $.getJSON("@Url.Action("GetGiftvoucherGroup", "GiftVoucherBookCode")", function (data) {
            var GiftVoucherGroupCode = $("#InvGiftVoucherGroupID");
            GiftVoucherGroupCode.empty();
            GiftVoucherGroupCode.append("<option value='0'>-- Select Group --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                GiftVoucherGroupCode.append($('<option />', { value: optionaldata.GiftVoucherGroupCode }).html(optionaldata.GiftVoucherGroupCode));
            });
            if ('@ViewBag.GiftVoucherGroupCode') {

                $('#InvGiftVoucherGroupID').val(@ViewBag.GiftVoucherGroupCode).trigger("change");
            } else {
                $('#InvGiftVoucherGroupID').val(0).trigger("change");
            }
        });
    }
    $("input[type='radio']").change(function () {

        if ($(this).val() == "other") {
            $("#otherAnswer").show();
        }
        else {
            $("#otherAnswer").hide();
        }
    });
</script>
<script type="text/javascript">
    function EnableDisable() {
        var others = document.getElementById();
        var otherCoupen = document.getElementById(model.GiftVoucherPercentage);
        otherCoupen.disabled = others.checked ? false : true;
        otherCoupen.value = "";
        if (!otherCoupen.disabled) {
            otherCoupen.focus();
        }
    }

    // Fire on radio button checked event
    $('input[type="radio"]').change(function () {

        // Get the value of currently clicked radio button
        var value = $(this).val();

        // Find the corresponding textbox inside the div that has the id same as radio button value and remove it disabled attribute
        $('#' + $(this).val())
            .children('input[type="text"]')
            .removeAttr('disabled');

        // Find all radio button and find its corresponding textbox and make it disable except the checked radio button.
        $('input[type="radio"]').each(function () {
            if (this.value != value) {
                $('#' + this.value)
                    .children('input[type="text"]')
                    .attr('disabled', 'disabled');
            }
        })
    });
</script>

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
