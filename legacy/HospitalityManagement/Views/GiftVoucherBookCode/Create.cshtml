                                                        </select>
                                                        @*@Html.TextBoxFor(model => model.InvGiftVoucherGroupID, new { @class = "form-control", MaxLength = 50, Placeholder = "Book Serial*" })
                                                            @Html.ValidationMessageFor(model => model.InvGiftVoucherBookCodeID, "", new { @class = "text-danger" })*@
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6"></div>
                                        </div>
                                        <div class="form-horizontal form-label-left col-md-12">
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Book Code *</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.BookCode, new { @class = "form-control", @readonly = "readonly", MaxLength = 50, Placeholder = "Book Code*" })
                                                        @Html.ValidationMessageFor(model => model.BookCode, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-horizontal form-label-left col-md-6"></div>
                                        </div>
                                        <div class="form-horizontal form-label-left col-md-12">
                                            <div class="form-horizontal form-label-left col-md-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Book Name *</label>
                                                    <div class="col-md-9 col-sm-9 col-xs-9 text-left">
                                                        @Html.TextBoxFor(model => model.BookName, new { @class = "form-control", MaxLength = 50, Placeholder = "Book Name*" })
                                                        @Html.ValidationMessageFor(model => model.BookName, "", new { @class = "text-danger" })
                                                    </div>
