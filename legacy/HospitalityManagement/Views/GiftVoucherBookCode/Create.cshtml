@model RIT.HMS.Domain.Transactions.InvGiftVoucherBookCode
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="container body">
        <div class="main_container">
            @using (Html.BeginForm("Create", "GiftVoucherBookCode", FormMethod.Post, new { @class = "form-horizontal" }))
