@model IEnumerable<RIT.HMS.Domain.Vehicle>
    @{
        ViewBag.Title = "ViewVehicles";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
                      <link href="~/Content/MasterFile.css" rel="stylesheet" />
        <body class="nav-md">

            <div class="right_col" role="main">
                <div class="">
                    <div class="clearfix"></div>

                    <div class="row">
                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">

                                <div class="x_content">
                                    <br />

                                    <div class="x_panel">
                                        <div class="x_title">
                                            <h2>Vehicle<small>Existing</small></h2>
                                            <ul class="nav navbar-right panel_toolbox">
                                                <li>
                                                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                                </li>
                                                @*<li class="dropdown">
                                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                                                    <ul class="dropdown-menu" role="menu">
                                                        <li>
                                                            <a href="#">Settings 1</a>
                                                        </li>
                                                        <li>
                                                            <a href="#">Settings 2</a>
                                                        </li>
                                                    </ul>
                                                </li>*@
                                                <li>
                                                    <a class="close-link"><i class="fa fa-close"></i></a>
                                                </li>
                                            </ul>
                                            <div class="clearfix"></div>
                                        </div>
                                        <div class="x_content">
                                            @*<table id="datatable-responsive"
                                                   class="table table-striped table-bordered dt-responsive nowrap">*@
                                            <table id="datatable-responsive" class="mstable col-xs-12 col-lg-12 col-md-12 col-sm-12">
                                                <thead>
                                                    <tr>
                                                        <th>Registration No</th>
                                                        <th>Name</th>
                                                        <th>Vehicle Type</th>
                                                        <th>Fuel Type</th>
                                                        <th>Seating Capacity</th>
                                                        <th></th>
                                                        @*<th></th>*@
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@Html.DisplayFor(modelItem => item.RegistrationNo)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.VehicleName)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.VehicleType)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.FuelType)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.SeatingCapacity)</td>
                                                            <td>@Html.ActionLink("Edit", "Edit", new { id = item.VehicleID })</td>
                                                            @*<td>@Html.ActionLink("View", "Details", new { id = item.SysGroupOfCompanyId })</td>*@
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="clerfix">
                                <div class="btn btn-info pl_add btn-small pull-left">
                                    @Html.ActionLink("Add Vehicle", "Index", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>


        </body>

