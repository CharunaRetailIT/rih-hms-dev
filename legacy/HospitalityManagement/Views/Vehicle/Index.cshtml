@model RIT.HMS.Domain.Vehicle
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
@*<html lang="en">*@
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>


</head>

<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Create", "Vehicle", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">



                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Vehicle</strong> @ViewBag.RegistrationNo saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Vehicle</strong> @ViewBag.RegistrationNo save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Vehicle</strong> @ViewBag.RegistrationNo already exists.
                        </div>
                    }


                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Vehicle</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                        @*<li class="dropdown">
                                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                                            <ul class="dropdown-menu" role="menu">
                                                <li>
                                                    <a href="#">Settings 1</a>
                                                </li>
                                                <li>
                                                    <a href="#">Settings 2</a>
                                                </li>
                                            </ul>
                                        </li>*@
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />

                                    <div class="form-horizontal form-label-left col-md-6">

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Registration No</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                
                                                @Html.TextBoxFor(model => model.RegistrationNo, new
                                            {
                                                @class = "form-control",
                                                Placeholder = "Registration No",
                                                MaxLength = 50,
                                                oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                            })
                                                @Html.ValidationMessageFor(model => model.RegistrationNo, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Vehicle Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.VehicleName, new { @class = "form-control", Placeholder = "Vehicle Name" })
                                                @Html.ValidationMessageFor(model => model.VehicleName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Engine No</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">

                                                @Html.TextBoxFor(model => model.EngineNo, new { @class = "form-control", Placeholder = "Engine No" })
                                                @Html.ValidationMessageFor(model => model.EngineNo, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Chassis No</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.ChassesNo, new { @class = "form-control", MaxLength = 50, Placeholder = "Chassis No" })
                                                @Html.ValidationMessageFor(model => model.ChassesNo, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Vehicle Type</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.VehicleType, new { @class = "form-control", MaxLength = 50, Placeholder = "Vehicle Type" })
                                                @Html.ValidationMessageFor(model => model.VehicleType, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Fuel Type</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.FuelType, new { @class = "form-control", Placeholder = "Fuel Type" })
                                                @Html.ValidationMessageFor(model => model.FuelType, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Make</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Make, new { @class = "form-control", MininumLength = 20, Placeholder = "Make" })
                                                @Html.ValidationMessageFor(model => model.Make, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <br />

                                    </div>

                                    <div class="form-horizontal form-label-left col-md-6">

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Model</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Model, new { @class = "form-control", Placeholder = "Model" })
                                                @Html.ValidationMessageFor(model => model.Model, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Engine Capacity</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.EngineCapacity, new { @class = "form-control", Placeholder = "Engine Capacity" })
                                                @Html.ValidationMessageFor(model => model.EngineCapacity, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Seating Capacity</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.SeatingCapacity, new
                                            {
                                                @class = "form-control",
                                                Placeholder = "Seating Capacity",
                                                MaxLength = 10,
                                                oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                            })
                                                @Html.ValidationMessageFor(model => model.SeatingCapacity, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Weight</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Weight, new { @class = "form-control", Placeholder = "Weight" })
                                                @Html.ValidationMessageFor(model => model.Weight, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Remark</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Remark, new { @class = "form-control", Placeholder = "Remark" })
                                                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="col-md-9">

                                                @*<label class="control-label col-md-3 col-sm-3 col-xs-3">Delete</label>
                                                <div class="checkbox col-xs-1">
                                                    @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                                </div>*@
                                            </div>
                                            <br />
                                        </div>

                                        <div class="clearfix"></div>

                                    </div>
                                </div>
                                <div class="actionBar">
                                    <div class="msgBox">

                                        <div class="btn btn-primary pl_add btn-small pull-left">
                                            @Html.ActionLink("Clear", "Index", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                        </div>
                                        <div class="btn btn-info pl_add btn-small pull-left">
                                            @Html.ActionLink("View All", "ViewVehicles", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                        </div>
                                        <button type="submit" class="btn btn-success">Submit</button>

                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

            </div>

        }
    </div>

</div>

