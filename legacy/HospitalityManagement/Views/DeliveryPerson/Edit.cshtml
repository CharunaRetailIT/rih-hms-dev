@model RIT.HMS.Domain.DeliveryPerson
@{
    ViewBag.Title = "Delivery Person";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
@*<html lang="en">*@
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hospitality Management System!</title>

    @*aa*@
</head>

@if (ViewBag.Message != null)
{
    <script>

$(document).ready(function(){

alert('@ViewBag.ErrorMessage');

});

    </script>

}
<div class="container body">
    <div class="main_container">
        @using (Html.BeginForm("Edit", "DeliveryPerson", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model=>model.DeliveryPersonId)
            <!-- page content -->
            <div class="right_col" role="main">
                <div class="">



                    <div class="clearfix"></div>
                    @if (@ViewBag.Message == "1")
                    {
                        <div class="alert alert-success alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Delivery Person</strong> for emp no  @ViewBag.Empcode saved successfully.
                        </div>
                    }
                    else if (@ViewBag.Message == "2")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Delivery Person</strong> for emp no @ViewBag.EmpCode save failed.
                        </div>
                    }
                    else if (@ViewBag.Message == "3")
                    {
                        <div class="alert alert-danger alert-dismissible fade in" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                            <strong>Delivery Person</strong> for emp no  @ViewBag.EmpCode is already exists.
                        </div>
                    }


                    <div class="row">

                        <!-- form input mask -->
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="x_panel">
                                <div class="x_title">
                                    <h2>Edit Delivery Person</h2>
                                    <br />

                                    <ul class="nav navbar-right panel_toolbox">
                                        <li>
                                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                        </li>
                                       
                                        <li>
                                            <a class="close-link"><i class="fa fa-close"></i></a>
                                        </li>
                                    </ul>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="x_content">
                                    <br />

                                    <div class="form-horizontal form-label-left col-md-6">

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Employee Number</label>
                                            <div class="col-md-3 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.EmployeeId, new { @class = "form-control", MaxLength = 5, Placeholder = "Emp.No", @readonly = true })
                                                @Html.ValidationMessageFor(model => model.EmployeeId, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Title</label>
                                            <div class="col-md-3 col-sm-9 col-xs-9">
                                                <select id="Title" name="Title" class="form-control">
                                                    <option value="0">-Title-</option>
                                                    <option value="Mr">Mr.</option>
                                                    <option value="Mrs">Mrs.</option>
                                                    <option value="Miss">Miss.</option>

                                                </select>
                                                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Full Name</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", Placeholder = "Full Name" })
                                                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Address</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">

                                                @Html.TextAreaFor(model => model.Address, new { @class = "form-control", Placeholder = "Address" })
                                                @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Designation</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">

                                                @Html.TextBoxFor(model => model.Designation, new { @class = "form-control", MaxLength = 20, Placeholder = "Eg : senior" })
                                                @Html.ValidationMessageFor(model => model.Designation, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">DOB</label>
                                            <div class="col-md-9 col-sm-9">
                                                @Html.TextBoxFor(model => model.DOB, new
                                            {
                                                @class = "form-control pull-left",
                                                Type = "date",
                                                @Value = Model.DOB.ToString("yyyy-MM-dd"),
                                                @Style = "width:50%",
                                                Placeholder = "DOB"
                                            })
                                                @Html.ValidationMessageFor(model => model.DOB, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Driving License No</label>
                                            <div class="col-md-9 col-sm-9">
                                                @Html.TextBoxFor(model => model.DrivingLicence, new { @class = "form-control pull-left", })
                                                @Html.ValidationMessageFor(model => model.DrivingLicence, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>

                                        <br />

                                    </div>
                                    <div class="form-horizontal form-label-left col-md-6">


                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Photograph</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                <input type="file" id="Photograph" name="Photograph" class="flat pull-left" />
                                                <div class="pull-left">
                                                    @ViewBag.FileName
                                                </div>

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">NIC</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.NIC, new { @class = "form-control", MininumLength = 10, Placeholder = "NIC" })
                                                @Html.ValidationMessageFor(model => model.NIC, "", new { @class = "text-danger pull-left" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Telephone</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Telephone, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "Telephone",
                                               type = "number",
                                               MaxLength = 50,
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">Mobile</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Mobile, new
                                           {
                                               @class = "form-control",
                                               Placeholder = "Mobile",
                                               type = "number",
                                               MaxLength = 50,
                                               oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                           })
                                                @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">E Mail</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", Placeholder = "E Mail", MaxLength = 100,
                                                oninput = "javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" })
                                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3 col-sm-3 col-xs-3">In case of Emergency</label>
                                            <div class="col-md-9 col-sm-9 col-xs-9">
                                                @Html.TextAreaFor(model => model.InCaseOfEmergency, new { @class = "form-control", Placeholder = "Eg: Tel/Address etc" })
                                                @Html.ValidationMessageFor(model => model.InCaseOfEmergency, "", new { @class = "text-danger pull-left" })

                                            </div>
                                        </div>
                                        <br /><br />
                                        <div class="form-group">
                                            <div class="col-md-9">

                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsDelete</label>
                                                <div class="checkbox col-xs-1">
                                                    @Html.CheckBoxFor(model => model.IsDelete, new { @class = "flat" })
                                                </div>
                                                <label class="control-label col-md-3 col-sm-3 col-xs-3">IsActive</label>
                                                <div class="checkbox col-xs-1">
                                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "flat" })
                                                </div>                                        
                                            </div>
                                        </div>
                                        <br />

                                    </div>

                                    <div class="clearfix"></div>

                                    <div class="actionBar">
                                        <div class="msgBox">

                                            <div class="btn btn-primary pl_add btn-small pull-left">
                                                @Html.ActionLink("Clear", "Edit", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <div class="btn btn-info pl_add btn-small pull-left">
                                                @Html.ActionLink("View All", "ViewDeliveryPersons", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                            </div>
                                            <button type="submit" class="btn btn-success">Modify</button>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>




<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>

document.getElementById("Title").selectedIndex = @ViewBag.sel;

</script>
