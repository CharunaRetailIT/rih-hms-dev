<script>

    debugger;
    $("body").on("click",
      "#btnFilter",
      function () {
          RevenueAndCost('s');
          OrderTypesVariation('s');
      });

    $("body").on("click",
     "#backKotBotNone",
     function () {
       //  RevenueAndCost('s');
         OrderTypesVariation('s');

     });




    // for on load
    RevenueAndCost('f');


    function RevenueAndCost(mood)  // Graph Revenue VS Cost
    {
        debugger;

        var locationid;
        var customercategoryid = 0;
        if (mood == 'f') {
            locationid = 0;
            customercategoryid = 0;
        } else if(mood=='s')
        {
            locationid = $("#LocationId").val();
            customercategoryid = $("#CustomerGroupId").val();
        }

        var df = $("#DateFrom").val();
        var dt = $("#DateTo").val();
        var t = $("#TypeId").val();

            $.ajax({
            url: "@Url.Action("RevenueAndCost", "Home")",
                data: {
                    locationid: locationid, datefrom: $("#DateFrom").val(), dateto: $("#DateTo").val(),
                    customergroupid:customercategoryid, selectiontypeid: $("#TypeId").val()
                },
            type: "GET",
            dataType: "json",
            success: function (resp)
            {

                var days = [];
                var nett = [];
                var cost = [];

                $.each(resp, function (i, item) {

                    days.push(item.day);
                    nett.push(item.Nett);
                    cost.push(item.Cost);
                });


                Highcharts.chart('revenueandcost', {
                    chart: {
                        type: 'line'
                    },
                    title: {
                        text: 'Revenue And Cost Variation'
                    },
                    subtitle: {
                        // text: 'Source: WorldClimate.com'
                    },
                    xAxis: {

                        categories: days
                    },
                    yAxis: {
                        title: {
                            text: 'Rs'
                        }
                    },
                    plotOptions: {
                        line: {
                            dataLabels: {
                                enabled: true
                            },
                            enableMouseTracking: false
                        }
                    },
                    series: [{
                        name: 'Revenue',
                        data: nett
                    }, {
                        name: 'Cost',
                        data: cost
                    }]
                });

            },
            error: function (error)
            {
                //  alert(error);
            }
        });

    }


</script>


<script>

    debugger;
    OrderTypesVariation('f');
    function OrderTypesVariation(mood)
    {

        debugger;

        var locationid;
        var customercategoryid = 0;
        if (mood == 'f') {
            locationid = 0;
            customercategoryid = 0;
        } else if(mood=='s')
        {
            locationid = $("#LocationId").val();
            customercategoryid = $("#CustomerGroupId").val();
        }

        var df = $("#DateFrom").val();
        var dt = $("#DateTo").val();
        var t = $("#TypeId").val();

        $.ajax({
            url: "@Url.Action("OrderTypesVariation", "Home")",
            data: {
            locationid: locationid, datefrom: $("#DateFrom").val(), dateto: $("#DateTo").val(),
            customergroupid:customercategoryid, selectiontypeid: $("#TypeId").val()
            },
        type: "GET",
        dataType: "json",
        success: function (resp)
        {

            var days = [];
            var kotcount = [];
            var botcount = [];
            var nonecount = [];

            $.each(resp, function (i, item) {

                days.push(item.recdate);
                kotcount.push(item.KOTCount);
                botcount.push(item.BOTCount);
                nonecount.push(item.NoneCount);
            });



        Highcharts.chart('kotbotnone', {
            chart: {
                type: 'column'
            },
            title: {
                text: 'Order Types Variation'
            },
            subtitle: {
                text: 'KOT BOT & None'
            },
            xAxis: {
                categories: days
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Orders'
                },
                stackLabels: {
                    enabled: true,
                    style: {
                        fontWeight: 'bold',
                        color: ( // theme
                            Highcharts.defaultOptions.title.style &&
                            Highcharts.defaultOptions.title.style.color
                        ) || 'gray'
                    }
                }
            },
            legend: {
                align: 'right',
                x: -30,
                verticalAlign: 'top',
                y: 25,
                floating: true,
                backgroundColor:
                    Highcharts.defaultOptions.legend.backgroundColor || 'white',
                borderColor: '#CCC',
                borderWidth: 1,
                shadow: false
            },
            tooltip: {
                headerFormat: '<b>{point.x}</b><br/>',
                pointFormat: '{series.name}: {point.y}<br/>Total: {point.stackTotal}'
            },
            plotOptions: {
                column: {
                    stacking: 'normal',
                    dataLabels: {
                        enabled: true
                    }
                }
            },
            series: [{
                name: 'KOT',
                data: kotcount
            }, {
                name: 'BOT',
                data: botcount
            }, {
                name: 'None',
                data: nonecount
            }]
        });

    },
   error: function (error) {
            //  alert(error);
  }
});

    }
</script>


