@model RIT.HMS.Domain.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}


<body>
    <div class="right_col" role="main">
        <div><span class="pull-left">Filters ttt</span></div>
        <div class="clearfix"></div>
        <br />
        <div class="col-md-12 col-lg-12 col-sm-12">
            <div class="form-row">
                <div class="col-md-4">
                    <label class="pull-left">Location</label>
                    <select class="form-control" id="LocationId" name="LocationId"></select>
                </div>
                <div class="col-md-4">
                    <label class="pull-left">Date From</label>
                    <input type="date" class="form-control" id="DateFrom" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-4">
                    <label class="pull-left">Date To</label>
                    <input type="date" class="form-control" id="DateTo" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
            </div><br /><div class="clearfix"></div><br />
            <div class="form-row">
                <div class="col-md-4">
                    <label class="pull-left">Customer Group</label>
                    <select class="form-control" id="CustomerGroupId" name="CustomerGroupId"></select>
                </div>
                <div class="col-md-4">
                    <label class="pull-left">Selection Type</label>
                    <select class="form-control" id="TypeId" name="TypeId">
                        <option>Daily</option>
                        <option>Weekly</option>
                        <option>Monthly</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="col-md-4 pull-right">
                        <label>.</label>
                        <button class="btn btn-primary form-control" id="btnFilter" type="submit">Filter</button>
                    </div>
                </div>
            </div>
        </div>
        <br /><div class="clearfix"></div><br /><br />
        <div class="col-md-12 col-lg-12 col-sm-12 row">
            <div class="form-row">
                <div class="col-md-4">
                    <select class="form-control" id="RevCostDeptId" name="RevCostDeptId"></select>
                </div>
            </div> <div class="clearfix"></div>
            <div id="revenueandcost">

            </div>
        </div>
        <div class="clearfix"></div><br />
        <br />

        <div class="col-md-12 col-lg-12 col-sm-12 row">
            @*KOT BOT None*@

            <div class="form-row">
                <div class="col-md-3">
                    <select class="form-control" id="KotBotNoneId" name="KotBotNoneId">
                        <option>None</option>
                        <option>KOT</option>
                        <option>BOT</option>
                    </select>
                </div> 
                <div class="clearfix"></div>
                <div class="col-md-9">
                    <button id="backKotBotNone" class="fa fa-close pull-right"></button>
                </div><div class="clearfix"></div>
            </div>
            <div id="kotbotnone">

            </div>


            <div id="kotbotnonea">

            </div>

        </div>
        <div class="clearfix"></div>

    </div>
</body>




