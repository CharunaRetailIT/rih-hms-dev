<script>
    $.getJSON("@Url.Action("GetActiveCustomerCategories", "Customer")", function (data) {

        var CustomerCategoryId = $("#CustomerGroupId");
        CustomerCategoryId.empty();
        CustomerCategoryId.append("<option value='0'>-- All Customer Groups --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            CustomerCategoryId.append($('<option />', { value: optionaldata.CustomerCategoryID }).html(optionaldata.CustomerCategoryName));

        });

        if ('@ViewBag.CustomerCategoryId') {
            $('#CustomerGroupId').val(@ViewBag.CustomerCategoryId).trigger("change");
        } else {
            $('#CustomerGroupId').val(0).trigger("change");
        }
    });

    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var locationId = $("#LocationId");

        locationId.empty();
        locationId.append("<option value='0'>-- All Locations --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            locationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.LocationId') {
            $('#LocationId').val(@ViewBag.LocationId).trigger("change");
        } else {
            $('#LocationId').val(0).trigger("change");
        }
    });

    $.getJSON("@Url.Action("GetActiveDepartments", "Department")", function (data) {

        var departmentDropDown = $("#RevCostDeptId");

        departmentDropDown.empty();
        departmentDropDown.append("<option value='0'>-- Select a department for view row data --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            departmentDropDown.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));
        });

        if ('@ViewBag.RevCostDeptId') {
            $('#RevCostDeptId').val(@ViewBag.RevCostDeptId).trigger("change");
        } else {
            $('#RevCostDeptId').val(0).trigger("change");
        }
    });

