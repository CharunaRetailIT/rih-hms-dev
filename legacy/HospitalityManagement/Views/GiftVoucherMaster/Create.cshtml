    var GVbookload = function () {

        $.getJSON("@Url.Action("GetGiftvoucherBook", "GiftVoucherMaster")", function (data) {
            var BookCode = $("#BookCode");
            BookCode.empty();
            BookCode.append("<option value='0'>-- Select Book --</option>");
            $.each(JSON.parse(data), function (index, optionaldata) {
                BookCode.append($('<option />', { value: optionaldata.BookCode }).html(optionaldata.BookName));
            });
            if ('@ViewBag.BookCode') {
                $('#BookCode').val(@ViewBag.BookCode).trigger("change");
            } else {
                $('#BookCode').val(0).trigger("change");
            }
        });
    }

    $("#BookCode").change(function () {
        var bokid = this.value;

        $.getJSON("@Url.Action("GetGiftvoucherBookDetails", "GiftVoucherMaster")", { GvBookCode: bokid },
            function (data) {

                //var txtGiftVoucherValue = $("#txtGiftVoucherValue");
                //$.each(JSON.parse(data), function (index, optionaldata) {
                //    txtGiftVoucherValue.append($('<option />', { value: optionaldata.BookCode }).html(optionaldata.GiftVoucherValue));
                //});
                //$("#txtGiftVoucherValue").val(giftvoucherBook.GiftVoucherValue);
                var giftvoucherBooks = JSON.parse(data);

                $("#txtVoucherSerial").val(giftvoucherBooks.SerialFormat);
                $("#txtGiftVoucherValue").val(giftvoucherBooks.giftvoucherBook[0].GiftVoucherValue);
                $("#txtGiftVoucherCount").val(giftvoucherBooks.giftvoucherBook[0].PageCount);
                $("#txtSerialLength").val(giftvoucherBooks.giftvoucherBook[0].SerialLength);
                $("#txtStartingNo").val(giftvoucherBooks.giftvoucherBook[0].StartingNo);
                $("#txtVoucherPrefix").val(giftvoucherBooks.giftvoucherBook[0].BookPrefix);
                $("#txtGiftVoucherPercentage").val(giftvoucherBooks.giftvoucherBook[0].GiftVoucherPercentage);
                $("#txtPageCount").val(giftvoucherBooks.giftvoucherBook[0].PageCount);

                $.each(giftvoucherBooks, function (index, giftvoucherBook) {



                });

            });
    });


</script>
