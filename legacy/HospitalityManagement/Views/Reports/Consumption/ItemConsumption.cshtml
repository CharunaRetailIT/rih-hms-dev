@model RIT.HMS.Domain.ViewModels.Reports.FoodCostingViewModel
@{
    ViewBag.Title = "Item Consumption";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Report.css" rel="stylesheet" />
@using (Html.BeginForm("ItemConsumption", "Report", FormMethod.Post, new { @class = "" }))
{
    @Html.AntiForgeryToken()

    <div class="container body">
        <div class="main_container">
            <div class="right_col" role="main">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>Item Consumption<small></small></h2>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />
                            <div class="col-md-12">
                                <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-3">Date From </label>
                                        <div class="col-md-6 col-sm-6 col-xs-6">
                                            <input type="date" class="form-control" id="DateFrom" name="DateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-3">Date To </label>
                                        <div class="col-md-6 col-sm-6 col-xs-6">
                                            <input type="date" class="form-control" id="DateTo" name="DateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                        </div>
                                    </div>

                                </div>
                                <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-3">Location </label>
                                        <div class="col-md-6 col-sm-6 col-xs-6">
                                            <select id="LocationId" name="LocationId" class="form-control"></select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-3">Department</label>
                                        <div class="col-md-6 col-sm-6 col-xs-6">
                                            <select id="DepartmentId" name="DepartmentId" class="form-control"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                                <div class="actionBar">
                                    <div class="msgBox">
                                        <button type="submit" class="btn btn-success pull-right">Submit</button>
                                        <div class="btn-group">
                                            <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i> Export Data</button>
                                            <ul class="dropdown-menu">

                                                <li>
                                                    <a href="#" onclick="$('#datatable-responsive').tableExport({ type: 'excel', escape: 'false' });">
                                                        <img src='~/Content/Images/icons/xls.png' width="10" /> XLS
                                                    </a>
                                                </li>
                                                <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" /> PDF</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <br />
                            <div class="table-responsive">
                                @if (Model != null)
                                {
                                    <div id="printcontent">
                                        <table id="datatable-responsive" class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr class="headings">
                                                    <th></th>
                                                    <th class="column-title">Product Code</th>
                                                    <th class="column-title">Description</th>
                                                    <th class="column-title">Unit</th>
                                                    <th class="column-title">Quantity</th>
                                                    <th class="column-title">Value</th>
                                                   
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.FoodCostDetails)
                                                {
                                                    <tr class="even pointer">
                                                        <td>@(Model.FoodCostDetails.ToList().IndexOf(item) + 1)</td>
                                                        <td class="">@item.ProductCode</td>
                                                        <td class="">@item.productdesc</td>
                                                        <td class="">@item.Unit</td>
                                                        <td style="text-align:right">@item.Qty.ToString("n2")</td>
                                                        <td style="text-align:right">@item.Value.ToString("n2")</td>
                                                       
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr class="even pointer">
                                                    <td></td>
                                                    <td class="">Total</td>
                                                    <td class=""></td>
                                                    <td style="text-align:right"></td>
                                                    <td style="text-align:right"></td>
                                                    <td style="text-align:right">@Model.FoodCostDetails.Sum(s => s.Value).ToString("n2")</td>
                                                   
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>


}

<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#datatable-responsive').dataTable({
            "bPaginate": false
        });
    });
</script>

<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {
        var poLocationId = $("#LocationId");
        poLocationId.empty();
        poLocationId.append("<option value='0'>-- All Locations --</option>");
        $.each(JSON.parse(data), function (index, optionaldata) {
            poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));
        });
        if ('@Model.LocationId') {
            $('#LocationId').val(@Model.LocationId).trigger("change");
        } else {
            $('#LocationId').val(0).trigger("change");
        }
    });


    $("#LocationId").change(
    function () {
        var loc = this.value;
        $.getJSON("@Url.Action("GetDocNoByLocId", "GRN")", { locid: loc, from: $("#DateFrom").val(), to: $("#DateTo").val() },
            function (data) {
                var DocNo = $("#DocumentId");
                DocNo.empty();
                DocNo.append("<option value='0'>-- Select a Document --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    DocNo.append($('<option />', { value: optionaldata.PurchaseHeaderId }).html(optionaldata.DocumentNo));
                });
            });
    });
    // Departments
    $.getJSON("@Url.Action("GetActiveDepartments", "Department")", function (data) {
        var DepartmentId = $("#DepartmentId");
        DepartmentId.empty();
        DepartmentId.append("<option value='0'>-- All Departments --</option>");
        $.each(JSON.parse(data), function (index, optionaldata) {
            DepartmentId.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));
        });
        if ('@Model.DepartmentId') {
            $('#DepartmentId').val(@Model.DepartmentId).trigger("change");
        } else {
            $('#DepartmentId').val(0).trigger("change");
        }
    });
    $("#LocationId").change(
    function () {
        var loc = this.value;
        $.getJSON("@Url.Action("GetActiveDepartmentsByLocationId", "Department")", { locationid: loc, },
            function (data) {
                var DepartmentId = $("#DepartmentId");
                DepartmentId.empty();
                DepartmentId.append("<option value='0'>-- All Departments --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    DepartmentId.append($('<option />', { value: optionaldata.RstDepartmentID }).html(optionaldata.DepartmentName));
                });
            });
    });
</script>


<script type="text/javascript">
    function PrintDiv() {
        var divToPrint = document.getElementById("datatable-responsive");
        newWin = window.open("");
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();
    }
</script>

