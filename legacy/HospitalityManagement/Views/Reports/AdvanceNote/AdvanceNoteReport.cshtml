@model IEnumerable<RIT.HMS.Domain.InvAdvanceNoteHed>

@{
    ViewBag.Title = "Advance Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Report.css" rel="stylesheet" />

@using (Html.BeginForm("AdvanceNote", "AdvanceNote", FormMethod.Post, new { @class = "" }))
{
    @Html.AntiForgeryToken()

    <div class="container body">
        <div class="main_container">
            <div class="right_col" role="main">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>Advance Notes Report<small></small></h2>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">

                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date From </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <input type="date" class="form-control" id="DateFrom" name="DateFrom" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date To </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <input type="date" class="form-control" id="DateTo" name="DateTo" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <div class="form-group">
                                   
                                </div>

                            </div>
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Process Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="ProcessLoc" name="ProcessLoc" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Pickup Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="PickupLoc" name="PickupLoc" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Request Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="LocationID" name="LocationID" class="form-control"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="clearfix"></div>
                            <div class="actionBar">
                                <div class="msgBox">
                                    <button type="submit" class="btn btn-success pull-right">Submit</button>
                                    <div class="btn-group">
                                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                                        <ul class="dropdown-menu">

                                            <li>
                                                <a href="#" onclick="$('#tblstock').tableExport({ type: 'excel', escape: 'false' });">
                                                    <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                                </a>
                                            </li>
                                            <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" />PDF</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <br />
                            <div class="clearfix"></div>

                            <div id="tblstock">
                                <div style="text-align:left; background-color:silver">
                                    <br />
                                    @ViewBag.Selection
                                </div>
                                <div class="clearfix"></div>
                                <div class="table-responsive">
                                    <table id="tblstock1" class="table table-striped jambo_table bulk_action">
                                        <thead>
                                            <tr class="headings">
                                                <th></th>
                                                <th class="column-title">Product Code</th>
                                                <th class="column-title">Product</th>
                                                <th class="column-title">Product Qty</th>
                                                <th class="column-title">Cost</th>
                                                <th class="column-title">Amount</th>
                                               
                                                @*<th class="column-title">Cost Value (Material)</th>*@
                                                @*<th class="column-title">Selling Price</th>*@
                                            </tr>
                                        </thead>
                                        @if (Model != null)
                                        {
                                            foreach (var head in Model)
                                            {
                                                @*<thead>*@
                                                <tr style="background-color:lightgray; width:200%" class="headings">
                                                    <td>@(Model.ToList().IndexOf(head) + 1)</td>
                                                    <td>Doc #:@Html.DisplayFor(modelItem => head.AdNoteNo)</td>
                                                    <td>Date :@Html.DisplayFor(modelItem => head.Date)</td>
                                                    @if (head.IsProduction)
                                                    {
                                                    <td>Production Status: Done</td>
                                                    }
                                                    else
                                                    {
                                                    <td>Production Status: Pending</td>
                                                    }
                                                    @if (head.RecallFromInvoice==1)
                                                    {
                                                        <td>Invoice Status: Done</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Invoice Status: Pending</td>
                                                    }
                                                    <td>Remark :@Html.DisplayFor(modelItem => head.Remark)</td>

                                                </tr>
                                                        @*</thead>*@

                                                        <tbody>

                                                            @foreach (var item in head.InvAdvanceNoteDet)
                                                            {
                                                                <tr class="even pointer">
                                                                    <td>
                                                                        @HospitalityManagement.Common.HMSExtensions.IntToRoman((head.InvAdvanceNoteDet.ToList().IndexOf(item) + 1))
                                                                    </td>
                                                                    <td class=""> @Html.DisplayFor(k => item.ProductCode)</td>
                                                                    <td class=""> @Html.DisplayFor(k => item.ProductName)</td>
                                                                    <td style="text-align:right">@item.Qty.ToString("n2")</td>                                                                  
                                                                    <td style="text-align:right">@item.Cost.ToString("n2")</td>
                                                                    <td style="text-align:right">@item.Amount.ToString("n2")</td>
                                                                    
                                                                </tr>
                                                            }

                                                        </tbody>
                                            }
                                        }
                                    </table>
                                </div>
                            </div>

                        </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>


}

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var ProcessLoc = $("#ProcessLoc");

        ProcessLoc.empty();
        ProcessLoc.append("<option value='0'>-- All Locations --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            ProcessLoc.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.ProcessLoc') {
            $('#ProcessLoc').val(@ViewBag.ProcessLoc).trigger("change");
        } else {
            $('#ProcessLoc').val(0).trigger("change");
        }
    });

    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var PickupLoc = $("#PickupLoc");

        PickupLoc.empty();
        PickupLoc.append("<option value='0'>-- All Locations --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            PickupLoc.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.PickupLoc') {
            $('#PickupLoc').val(@ViewBag.PickupLoc).trigger("change");
        } else {
            $('#PickupLoc').val(0).trigger("change");
        }
    });

    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var LocationID = $("#LocationID");

        LocationID.empty();
        LocationID.append("<option value='0'>-- All Locations --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            LocationID.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.LocationID') {
            $('#LocationID').val(@ViewBag.LocationID).trigger("change");
        } else {
            $('#LocationID').val(0).trigger("change");
        }
    });

</script>


<script type="text/javascript">
    function PrintDiv() {
        var divToPrint = document.getElementById("tblstock");
        newWin = window.open("");
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();
    }
</script>

