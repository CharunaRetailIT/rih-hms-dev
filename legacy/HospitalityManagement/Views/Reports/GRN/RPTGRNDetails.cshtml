@model IEnumerable<RIT.HMS.Domain.ViewModels.Reports.GRNDetailViewModel>

@{
    ViewBag.Title = "RPTGRNDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Report.css" rel="stylesheet" />

@using (Html.BeginForm("GetGRNDetailReport", "GRN", FormMethod.Post, new { @class = "" }))
{
    @Html.AntiForgeryToken()

    <div class="container body">
        <div class="main_container">
            <div class="right_col" role="main">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>Good Received Note Detail Report<small></small></h2>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date From </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <input type="date" class="form-control" id="DateFrom" name="DateFrom" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date To </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <input type="date" class="form-control" id="DateTo" name="DateTo" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="LocationId" name="LocationId" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Doc No </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="DocumentId" name="DocumentId" class="form-control select2"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Supplier </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="SupplierId" name="SupplierId" class="form-control"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="clearfix"></div>
                            <div class="actionBar">
                                <div class="msgBox">
                                    <button type="submit" class="btn btn-success pull-right">Submit</button>
                                    <div class="btn-group">
                                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                                        <ul class="dropdown-menu">

                                            <li>
                                                <a href="#" onclick="$('#tblstock').tableExport({ type: 'excel', escape: 'false' });">
                                                    <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                                </a>
                                            </li>
                                            <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" />PDF</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <br />
                            <div class="clearfix"></div>

                            <div id="printcontent">

                                <div class="clearfix"></div>
                                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                    @if (Model != null)
                                    {
                                        <table id="tblstock" class="table table-striped jambo_table bulk_action">
                                            <thead style="position: sticky; top: 0; z-index: 10;">
                                                <tr class="headings">
                                                    <th></th>
                                                    <th class="column-title">Product Code</th>
                                                    <th class="column-title">Product</th>
                                                    <th class="column-title">Quantity</th>
                                                    <th class="column-title">Free Quantity</th>
                                                    <th class="column-title">Discount Amt.</th>
                                                    <th class="column-title">Discount %.</th>
                                                    <th class="column-title">Cost Price</th>
                                                    @*<th class="column-title">Selling Price</th>*@
                                                </tr>
                                            </thead>
                                            @foreach (var head in Model)
                                            {
                                                @*<thead>*@
                                                <tr style="background-color:lightgray; width:200%" class="headings">
                                                    <td>@(Model.ToList().IndexOf(head) + 1)</td>
                                                    <td>Location:@Html.DisplayFor(modelItem => head.Location)</td>
                                                    <td>Date:@Html.DisplayFor(modelItem => head.DocumentDate)</td>
                                                    <td>Document No:@Html.DisplayFor(modelItem => head.DocumentNo)</td>
                                                    <td>Status:@Html.DisplayFor(modelItem => head.Status)</td>
                                                </tr>
                                                            @*</thead>*@

                                                            <tbody>

                                                                @foreach (var item in head.Detail)
                                                                {
                                                                    <tr class="even pointer">
                                                                        <td>
                                                                            @HospitalityManagement.Common.HMSExtensions.IntToRoman((head.Detail.IndexOf(item) + 1))
                                                                        </td>
                                                                        <td class="">@Html.DisplayFor(k => item.ProductCode)</td>
                                                                        <td class="">@Html.DisplayFor(k => item.ProductName)</td>
                                                                        <td style="text-align:right">@item.OrderQty.ToString("n2")</td>
                                                                        <td style="text-align:right">@item.FreeQty.ToString("n2")</td>
                                                                        <td style="text-align:right">@item.DiscountAmt.ToString("n2")</td>
                                                                        <td style="text-align:right">@item.DiscountPrc.ToString("n2")</td>
                                                                        <td style="text-align:right">@item.CostPrice.ToString("n2")</td>
                                                                        @*<td style="text-align:right">@item.SellingPrice.ToString("n2")</td>*@
                                                                    </tr>
                                                                }

                                                            </tbody>
                                            }
                                        </table>
                                    }
                                </div>

                            </div>

                        </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>


}

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var poLocationId = $("#LocationId");

        poLocationId.empty();
        poLocationId.append("<option value='0'>-- All Locations --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@ViewBag.poLocationId') {
            $('#LocationId').val(@ViewBag.poLocationId).trigger("change");
        } else {
            $('#LocationId').val(0).trigger("change");
        }


    });


    $("#LocationId").change(
      function () {
          var loc = this.value;

          $.getJSON("@Url.Action("GetDocNoByLocId", "GRN")", { locid: loc, from: $("#DateFrom").val(), to: $("#DateTo").val() },

           function (data) {

               var DocNo = $("#DocumentId");

               DocNo.empty();
               DocNo.append("<option value='0'>-- Select a Document --</option>");

               $.each(JSON.parse(data), function (index, optionaldata) {
                   DocNo.append($('<option />', { value: optionaldata.PurchaseHeaderId }).html(optionaldata.DocumentNo));

               });

           });
      });

    $.getJSON("@Url.Action("GetSuppliers", "Supplier")", function (data) {
        var poSupplierId = $("#SupplierId");
        poSupplierId.empty();
        poSupplierId.append("<option value='0'>-- All Suppliers --</option>");
        $.each(JSON.parse(data), function (index, optionaldata) {
            poSupplierId.append($('<option />', { value: optionaldata.SupplierID }).html(optionaldata.SupplierName));
        });
        if ('@ViewBag.poSupplierId') {
            $('#SupplierId').val(@ViewBag.poSupplierId).trigger("change");
        } else {
            $('#SupplierId').val(0).trigger("change");
        }
    });


</script>


<script type="text/javascript">
    function PrintDiv() {


        var divToPrint = document.getElementById("tblstock");
        newWin = window.open("");
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();

    }
</script>

