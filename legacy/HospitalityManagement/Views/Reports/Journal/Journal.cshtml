<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var LocationID = $("#LocationId");

        LocationID.empty();
        LocationID.append("<option value='0'>-- Select A Location --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            LocationID.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@Model.LocationId') {
            $('#LocationId').val(@Model.LocationId).trigger("change");
        } else {
            $('#LocationId').val(0).trigger("change");
        }
    });

    $("#LocationId").change(
   function () {
       var loc = this.value;

       $.getJSON("@Url.Action("GetReciptsByLocId", "Report")", { locid: loc, },
           function (data) {
               var Recipt = $("#ReciptNo");
               Recipt.empty();

               $.each(JSON.parse(data), function (index, optionaldata) {
                   Recipt.append($('<option />', { value: optionaldata.Receipt }).html(optionaldata.Receipt));
               });
           });

       $.getJSON("@Url.Action("GetUnitNumbersByLocId", "Report")", { locid: loc, },
           function (data) {
               var UnitNo = $("#UnitNo");
               UnitNo.empty();
               UnitNo.append("<option value='0'>-- All Units --</option>");
               $.each(JSON.parse(data), function (index, optionaldata) {
                   UnitNo.append($('<option />', { value: optionaldata.UnitNo }).html(optionaldata.UnitNo));
               });
           });
   });



    $.getJSON("@Url.Action("GetUnitNumbers", "Report")", function (data) {

        var UnitNo = $("#UnitNo");

        UnitNo.empty();
        UnitNo.append("<option value='0'>-- All Units --</option>");

        $.each(JSON.parse(data), function (index, optionaldata) {
            UnitNo.append($('<option />', { value: optionaldata.UnitNo }).html(optionaldata.UnitNo));

        });

        if ('@Model.UnitNo') {
            $('#UnitNo').val(@Model.UnitNo).trigger("change");
        } else {
            $('#UnitNo').val(0).trigger("change");
        }


    });



</script>
