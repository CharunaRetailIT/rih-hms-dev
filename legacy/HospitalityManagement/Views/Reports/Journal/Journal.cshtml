<script>
    var TeamDetailPostBackURL = '/Report/Print';

    $(function () {
        $(".anchorDetail").click(function () {
            var $buttonClicked = $(this);

            // Extract all required data attributes
            var reciptNo = $buttonClicked.data('reciptno');
            var date = $buttonClicked.data('date');
            var unitNo = $buttonClicked.data('unitno');
            var zno = $buttonClicked.data('zno');
            var locationId = $buttonClicked.data('locationid'); // corrected: case-sensitive

            var options = { backdrop: "static", keyboard: true };

            $.ajax({
                type: "GET",
                url: TeamDetailPostBackURL,
                contentType: "application/json; charset=utf-8",
                data: {
                    id: 0,
                    reciptNo: reciptNo,
                    date: date,
                    unitNo: unitNo,
                    zno: zno,
                    LocationId: locationId
                },
                dataType: "html", // important if returning a partial view/modal
                success: function (data) {
                    $('#myModalContent').html(data);
                    $('#myModal').modal(options);
                    $('#myModal').modal('show');
                },
                error: function () {
                    alert("Dynamic content load failed.");
                }
            });
        });

        $("#closbtn").click(function () {
            $('#myModal').modal('hide');
        });
    });
</script>



