@model RIT.HMS.Domain.ViewModels.Reports.JournalViewModel
@{
    ViewBag.Title = "Print Jurnal";
    Layout = null;
    // Layout =null;
}


<body>

    @using (Html.BeginForm("RPTJournal", "Report", FormMethod.Get, new { @class = "form-horizontal", }))
    {

        <div class="col-md-12 col-sm-12 col-xs-12">

            <div class="modal-header col-md-12">

                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title" id="myModalLabel">...</h4>
            </div>


            <div class="x_panel">

                <div id="printcontent">
                    <div class="title" style="text-align:center">
                       
                        <div class="small text-left" style="text-align:right">@DateTime.Now</div>
                        <div style="font-size:large">@Model.CompanyName</div>
                        <div style="font-size:medium">@Model.CompanyAddress1,@Model.CompanyAddress2,@Model.CompanyAddress3</div><br />
                        <div style="font-size:large">Sales Journal</div>
                        <br />
                        <hr />

                    </div>

                    <div class="x_content">
                        <div>

                            <table align="center" style="width:100%">
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">VAT Reg No: @Model.VatRegNo </label>
                                    </td>
                                    <td width="10%"></td>
                                    <td style="text-align:right">
                                        <label class="control-label">Recipt No: @Model.ReciptNo </label>

                                    </td>

                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Guests: @Model.NoOfGuests </label>
                                    </td>
                                    <td width="10%"></td>
                                    <td style="text-align:right">
                                        <label class="control-label">Cashier: @Model.Cashier </label>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Catering Mode: @Model.CateringMode </label>
                                    </td>
                                    <td width="10%"></td>
                                    <td style="text-align:right">
                                        <label class="control-label">Unit No: @Model.UnitNo</label>
                                    </td>
                                </tr>
                                @*<tr>
                                    <td style="text-align:left">
                                        <label class="control-label">Payment Term: @Model.PaymentTerm </label>
                                    </td>
                                    <td width="10%"> </td>
                                    <td style="text-align:right">
                                        <label class="control-label">Create User: @Model.CreatedUser </label>
                                    </td>
                                </tr>*@

                            </table>
                        </div>
                        <br />
                        <div class="clearfix"></div>


                        <br />
                        <div class="table-responsive">
                            @if (Model.InvProducts != null)
                            {
                                <table id="tblstock" border="1" style="width:100%;border:none" class="table table-striped jambo_table bulk_action">
                                    <thead>
                                        <tr class="headings">

                                            <th>Product</th>
                                            <th>Price</th>
                                            <th>Quantity </th>
                                            <th>Amount</th>
                                           

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.InvProducts)
                                        {
                                            <tr class="even pointer">

                                                <td>@item.ProductName</td>
                                                <td style="text-align:right">@item.Price.ToString("n2")</td>
                                                <td style="text-align:right">@item.Qty.ToString("n2")</td>
                                                <td style="text-align:right">@item.Amount.ToString("n2")</td>
                                               

                                            </tr>
                                        }

                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>Sub Total</td>
                                            <td></td>
                                            <td></td>                                          
                                            <td style="text-align:right">@Model.SubTotal.ToString("n2")</td>                                           
                                        </tr>
                                        <tr>
                                            <td>Advance Note No</td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align:right">@Model.AdvanceNoteNo</td>
                                        </tr>
                                        <tr>
                                            <td>Net Total</td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align:right">@Model.NetTotal.ToString("n2")</td>
                                        </tr>
                                        <tr>
                                            <td>Cash</td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align:right">@Model.Cash.ToString("n2")</td>
                                        </tr>
                                        <tr>
                                            <td>Balance</td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align:right">@Model.Balance.ToString("n2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <br />

                                <table id="tblNet" style="width:50%" align="right">
                                    <tr>
                                        <td style="text-align:left">
                                            <label class="control-label">No Of Items:@Model.InvProducts.Count().ToString("n2")</label>
                                        </td>
                                        <td style="text-align:right">
                                            <label class="control-label">Date:@Model.Date.ToShortDateString()</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <label class="control-label">No Of Pices:@Model.InvProducts.Sum(i => i.Qty).ToString("n2")</label>
                                        </td>
                                        <td style="text-align:right">
                                            <label class="control-label">Time:@Model.Time </label>
                                        </td>
                                    </tr>

                                </table>

                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                                <br />
                              
                            }

                        </div>
                    </div>
                </div>
            </div>

            <div class="actionBar">
                <div class="msgBox">
                    <button type="submit" class="btn btn-primary pull-right">Back</button>
                    <div class="btn-group">
                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#" onclick="$('#tblstock').tableExport({ type: 'excel', escape: 'false' });">
                                    <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                </a>
                            </li>
                            <li>
                                <a href="#" id="btnPrint" onclick="PrintDiv();">
                                    <img src='~/Content/Images/icons/pdf.png' width="10" />
                                    Print/PDF
                                </a>

                                @*<button type="button"  id="btnPrint"  value="Print" />*@
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>

    }

</body>


