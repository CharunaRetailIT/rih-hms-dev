@model RIT.HMS.Domain.Receipe

@{
    ViewBag.Title = "Receipes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Report.css" rel="stylesheet" />

@using (Html.BeginForm("RPTReceipe", "Receipe", FormMethod.Post, new { @class = "" }))
{
    @Html.AntiForgeryToken()

    <div class="right_col" role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">

                <!-- form input mask -->
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">

                        <div class="x_title">
                            <h2>Receipe Report</h2>
                            <br />

                            <ul class="nav navbar-right panel_toolbox">
                                <li>
                                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                </li>

                                <li>
                                    <a class="close-link"><i class="fa fa-close"></i></a>
                                </li>
                            </ul>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />
                            <div class="form-horizontal form-label-left col-md-8 col-sm-8 col-xs-8">

                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="LocationId" name="LocationId" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Product </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="ProductId" name="ProductId" class="form-control select2"></select>
                                    </div>
                                </div>

                                <br />

                            </div>

                            <div class="form-horizontal form-label-left col-md-4 col-sm-4 col-xs-4">

                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3"></label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3"></label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                    </div>
                                </div>
                                <div class="clearfix"></div>

                            </div>
                            <div class="clearfix"></div>
                            <div class="actionBar">
                                <div class="msgBox">
                                    <div class="btn-group">
                                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                                        <ul class="dropdown-menu">

                                            <li>
                                                @*<a href="#" onclick="$('#tblstock').tableExport({ type: 'excel', escape: 'false' });">
                                                    <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                                </a>*@
                                                <div class="btn btn-primary pl_add btn-small pull-left">
                                                    @Html.ActionLink("Export to Excel", "ExportToExcel", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                            </li>
                                            <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" />PDF</a></li>
                                        </ul>
                                    </div>
                                    <button type="submit" class="btn btn-success pull-right">Submit</button>                                 
                                </div>
                            </div>
                        </div>

                    </div>

                    <div id="printcontent">

                        <div id="summary" class="pull-left text-info">
                            @ViewBag.ReportSummary
                        </div>

                        <div class="clearfix"></div>
                        <br />

                        <div class="table-responsive">

                            @if (Model!=null)
                            {

                                <table id="tblstock" class="table table-striped jambo_table bulk_action">
                                    <thead>
                                        <tr class="headings">
                                            <th class="column-title">Material Code</th>
                                            <th class="column-title">Material Name </th>
                                            <th class="column-title">Quantity</th>                                          
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.ReceipeReport)
                                        {
                                            <tr class="even pointer">
                                                <td class="">@Html.DisplayFor(modelItem => item.MatCode)</td>
                                                <td class="">@Html.DisplayFor(modelItem => item.MatName)</td>
                                                <td class="">@Html.DisplayFor(modelItem => item.Quantity) </td>
                                               
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


}





<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
        $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

            var poLocationId = $("#LocationId");

            poLocationId.empty();
            poLocationId.append("<option value='0'>-- All Locations --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

            });

            @*if ('@ViewBag.poLocationId') {
                $('#LocationId').val(@ViewBag.poLocationId).trigger("change");
            } else {
                $('#LocationId').val(0).trigger("change");
            }*@

            if ('@Model.LocationId') {
                $('#LocationId').val(@Model.LocationId).trigger("change");
            } else {
                $('#LocationId').val(0).trigger("change");
            }

        });
</script>

<script>

        $.getJSON("@Url.Action("ViewAllReceipes", "Receipe")", function (data) {

            var itemId = $("#ProductId");


            itemId.empty();
            itemId.append("<option value='0'>-- All Receipes --</option>");


            $.each(JSON.parse(data), function (index, optionaldata) {
                itemId.append($('<option />', { value: optionaldata.ProductId }).html(optionaldata.ProductName+"("+optionaldata.ProductCode+")"));

            });

            @*if ('@ViewBag.itemIdselect') {
                $('#ProductId').val(@ViewBag.itemIdselect).trigger("change");
            } else {
                $('#ProductId').val(0).trigger("change");
            }*@

            if ('@Model.ProductId') {
                $('#ProductId').val(@Model.ProductId).trigger("change");
            } else {
                $('#ProductId').val(0).trigger("change");
            }
        });
</script>

<script type="text/javascript">
        function PrintDiv() {
            var divContents = document.getElementById("printcontent").innerHTML;
            var printWindow = window.open('', '', 'height=200,width=400');
            printWindow.document.write('<html><head><title></title>');
            printWindow.document.write('</head><body >');
            printWindow.document.write(divContents);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            printWindow.print();

            $(document).ready(function () {
                $('#printcontent').DataTable();
            });
        }
</script>
