<script type="text/javascript">
    function PrintDiv() {

        var divToPrint = document.getElementById("printcontent");
        newWin = window.open("");
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();

        }
</script>


<script>
    function SummerizeTable()
    {
        var table = document.getElementById("datatable-responsive");
        $(table).each(function () {
            $(table).find('td').each(function () {
                var $this = $(this);
                var col = $this.index();
                var html = $this.html();
                var row = $(this).parent()[0].rowIndex;
                var span = 1;
                var cell_above = $($this.parent().prev().children()[col]);
                while (cell_above.html() === html) {
                    span += 1;
                    cell_above_old = cell_above;
                    cell_above = $(cell_above.parent().prev().children()[col]);
                }
                if (span > 1) {
                    // console.log(span);
                    $(cell_above_old).attr('rowspan', span);
                    $this.hide();
                }

            });
        });
    }
</script>