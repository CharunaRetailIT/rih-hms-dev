@model  RIT.HMS.Domain.ViewModels.Reports.StockBinCardViewModel
@{
    ViewBag.Title = "RPT As At Stock Balance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@*<link href="~/Content/Report.css" rel="stylesheet" />*@
@using (Html.BeginForm("AsAtStockBalance", "Report", FormMethod.Post, new { @class = "" }))
{

    @Html.AntiForgeryToken()

    <div class="container body">
        <div class="main_container">
            <div class="right_col" role="main">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>As At Stock Balance<small></small></h2>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date To </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <input type="date" class="form-control" value="@Model.DateTo.ToString("yyyy-MM-dd")" id="DateTo" name="DateTo" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="LocationId" name="LocationId" class="form-control"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">                              
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Department </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        @Html.DropDownList("DepartmentId", (IEnumerable<SelectListItem>)Session["Departments"], new
                                   {
                                       @class = "form-control",
                                       @style = "width:100%"
                                   })
                                    </div>

                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Product </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        @Html.DropDownList("ProductId", (IEnumerable<SelectListItem>)Session["AllItemsToPO"], new
                                   {
                                       @class = "form-control select2",
                                       @style = "width:100%"
                                   })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3"></label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        @Html.CheckBoxFor(model => model.WithZeroBalances, new {@class="flat" })
                                        <label class="control-label">With 0 balances</label>
                                    </div>
                                </div>
                            </div>

                            <div class="clearfix"></div>
                            <div class="actionBar">
                                <div class="msgBox">
                                    <button type="submit" class="btn btn-success pull-right">Submit</button>
                                    <div class="btn-group">
                                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                                        <ul class="dropdown-menu">

                                            <li>
                                                @*<a href="#" onclick="$('#datatable-responsive').tableExport({ type: 'excel', escape: 'false' });">
                                                    <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                                </a>*@
                                                <div class="btn btn-primary pl_add btn-small pull-left">
                                                    @Html.ActionLink("Export to Excel", "ExportToExcel", null, new { @style = "font-size: 12px;color:white;font-family: 'Lucida Sans Unicode', 'Lucida Grande', Sans-Serif;text-decoration: none" })
                                                </div>
                                            </li>
                                            <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" />PDF</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <br />
                            <div class="clearfix"></div>

                            <div id="printcontent">

                                <div class="clearfix"></div>
                                <div class="col-md-12"></div>
                                <div class="clearfix"></div>
                                <div class="table-responsive">

                                    @if (Model != null)
                                    {
                                        <table id="datatable-responsive" class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr class="headings">
                                                    <th class="column-title">Location</th>
                                                    <th class="column-title">Department</th>
                                                    <th class="column-title">Product Code</th>
                                                    <th class="column-title">Produc Name</th>
                                                    <th class="column-title"></th>
                                                    <th class="column-title">Stock</th>
                                                    <th class="column-title">Cost Price</th>
                                                    <th class="column-title">Cost Value</th>


                                                </tr>
                                            </thead>

                                            <tbody>
                                               
                                                @foreach (var item in Model.Details)

                                                {
                                                   
                                                    <tr>
                                                        <td>@item.Location </td>
                                                        <td>@item.Department</td>
                                                        <td>@item.ProductCode</td> 
                                                        <td>@item.ProductName</td>
                                                        <td></td>
                                                        <td>@item.Stock</td>
                                                        <td>@item.CostPrice</td>
                                                        <td>@item.CostValue</td>
                                                       
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot style="font-weight:bold; background-color:#ecf0f5;">
                                                <tr>
                                                    <td colspan="7">Total Cost value : </td>
                                                    <td style="text-align:left">@ViewBag.TotalCost</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                      }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


                                                    }

<script src="~/vendors/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function ()
    {
        $('#datatable-responsive').dataTable({
            "bPaginate": false,
            "scrollY": "500px",
            "scrollCollapse": true,
            "scrollX": true,  // Enable horizontal scrolling
            "fixedHeader": false, // Disable fixed header for horizontal scrolling
            "autoWidth": false 
        });
      //  SummerizeTable();
    });
</script>
<script>
    $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

        var poLocationId = $("#LocationId");
        poLocationId.empty();
        poLocationId.append("<option value='0'>-- All Locations --</option>");
        $.each(JSON.parse(data), function (index, optionaldata) {
            poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

        });

        if ('@Model.LocationId')
        {
            $('#LocationId').val(@Model.LocationId).trigger("change");
        } else {
            $('#LocationId').val(0).trigger("change");
        }
    });
</script>

