@model RIT.HMS.Domain.ViewModels.Reports.CustomerStatementViewModel
@{
    ViewBag.Title = "RPTCustomerDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Report.css" rel="stylesheet" />
<h2></h2>


@using (Html.BeginForm("Statement", "CardMaster", FormMethod.Post, new { @class = "" }))
{
    @Html.AntiForgeryToken()

    <div class="container body">
        <div class="main_container">
            <div class="right_col" role="main">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>Customer Statement<small></small></h2>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />

                            <div class="form-horizontal form-label-left col-md-8 col-sm-8 col-xs-8">

                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Customer </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="CustomerId" name="CustomerId" class="form-control"></select>
                                    </div>
                                </div>
                                @*<div class="form-group">
                                        <label class="control-label col-md-3 col-sm-3 col-xs-3">Product </label>
                                        <div class="col-md-6 col-sm-6 col-xs-6">

                                            <select id="ProductId" name="ProductId" class="form-control select2"></select>


                                        </div>
                                    </div>*@

                                <br />

                            </div>

                            <div class="form-horizontal form-label-left col-md-4 col-sm-4 col-xs-4">

                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3"></label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3"></label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                    </div>
                                </div>
                                <div class="clearfix"></div>

                            </div>
                            <div class="clearfix"></div>
                            <div class="actionBar">
                                <div class="msgBox">
                                    <button type="submit" class="btn btn-success pull-right">Submit</button>
                                    <div class="btn-group">
                                        <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i> Export Data</button>
                                        <ul class="dropdown-menu">

                                            <li>
                                                <a href="#" onclick="$('#datatable-responsive').tableExport({ type: 'excel', escape: 'false' });">
                                                    <img src='~/Content/Images/icons/xls.png' width="10" /> XLS
                                                </a>
                                            </li>
                                            <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" /> PDF</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="clearfix"></div>

                            <div id="printcontent">

                                <div id="summary" class="pull-left text-info">
                                    @ViewBag.ReportSummary
                                </div>

                                <div class="clearfix"></div>
                                <br />

                                <div class="table-responsive">

                                    @if (Model != null)
                                    {


                                        <table id="datatable-responsive" class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr class="headings">
                                                    <th></th>                                                    
                                                    <th class="column-title">Customer Name </th>
                                                    <th class="column-title">Recipt </th>
                                                    <th class="column-title">Amount </th>
                                                    <th class="column-title">Card Number </th>
                                                    <th class="column-title">Points </th>
                                                   
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var item in Model.Detail)
                                                {
                                                    <tr class="even pointer">
                                                        <td>@(Model.Detail.ToList().IndexOf(item) + 1)</td>
                                                        <td class="">@item.CustomerName</td>
                                                        <td class="">@item.Recipt</td>
                                                        <td style="text-align:right">@item.Amount</td>
                                                        <td class="">@item.CardNumber</td>
                                                        <td style="text-align:right">@item.Points</td>                                                                                                        
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }

                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
        $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

            var poLocationId = $("#LocationId");

            poLocationId.empty();
            poLocationId.append("<option value='0'>-- All Locations --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

            });

            if ('@ViewBag.poLocationId') {
                $('#LocationId').val(@ViewBag.poLocationId).trigger("change");
            } else {
                $('#LocationId').val(0).trigger("change");
            }


        });

        $.getJSON("@Url.Action("GetCustomers", "Customer")", function (data) {

            var CustomerId = $("#CustomerId");

            CustomerId.empty();
            CustomerId.append("<option value='0'>-- Select A Customer --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                CustomerId.append($('<option />', { value: optionaldata.CustomerID }).html(optionaldata.CustomerName));

            });

            if ('@Model.CustomerId') {
                $('#CustomerId').val(@Model.CustomerId).trigger("change");
            } else {
                $('#CustomerId').val(0).trigger("change");
            }


        });


</script>


<script type="text/javascript">
           function PrintDiv() {

           var divToPrint = document.getElementById("datatable-responsive");
           newWin = window.open("");
           newWin.document.write(divToPrint.outerHTML);
           newWin.print();
           newWin.close();

                          }
</script>
