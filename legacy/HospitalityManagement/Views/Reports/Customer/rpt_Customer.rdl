        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CompanyID">
            <Value>=Parameters!CompanyID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select SysCompanyID, CompanyName, Address1,Address2,Address3,Telephone,Mobile from SysCompanies where IsDelete = 0 and syscompanyid=@CompanyID</CommandText>
      </Query>
