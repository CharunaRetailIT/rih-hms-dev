  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Customer">
            <Value>=Parameters!Customer.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CustomerCategory">
            <Value>=Parameters!CustomerCategory.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CompanyID">
            <Value>=Parameters!CompanyID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT [CustomerID]
      ,[CustomerCode]
      ,[CustomerTitle]
      ,[CustomerName]
      ,[CustomerType]
      ,[DOB]
      ,[NIC]
      ,[Passport]
      ,C.[Telephone]
      ,C.[Mobile]
      ,C.[Fax]
      ,C.[Email]
      ,[VehicleNo]
      ,[Profession]
      ,[WeddingAnniversary]
      ,[IsActiveForLoyalty]
      ,C.[IsActive]
      ,C.[IsDelete]
	  ,L.LocationName
  FROM [Customers] AS C
  INNER JOIN SysLocations AS L ON C.LocationId = L.SysLocationID
 WHERE C.IsActive = 1 AND (CustomerID IN (@Customer)) AND (C.CustomerCategoryId IN (@CustomerCategory)) 
and L.companyid=@CompanyID</CommandText>
      </Query>
