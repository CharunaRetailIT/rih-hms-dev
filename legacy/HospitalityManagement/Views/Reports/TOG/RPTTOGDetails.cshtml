@model IEnumerable<RIT.HMS.Domain.ViewModels.Reports.TOGDetailViewModel>
@{
    ViewBag.Title = "RPTTOGDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Report.css" rel="stylesheet" />
@using (Html.BeginForm("GetTOGDetailReport", "TOG", FormMethod.Post, new { @class = "" }))
{
    @Html.AntiForgeryToken()

    <div class="container body">
        <div class="main_container">
            <div class="right_col" role="main">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>Transfer of Goods Detail Report<small></small></h2>

                            <div class="clearfix"></div>
                        </div>

                        <div class="x_content">
                            <br />
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">

                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date From </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                        <input type="date" class="form-control" id="DateFrom" name="DateFrom" value="@DateTime.Now.ToString("yyyy-MM-dd")" />


                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Date To </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                        <input type="date" class="form-control" id="DateTo" name="DateTo" value="@DateTime.Now.ToString("yyyy-MM-dd")" />


                                    </div>
                                </div>

                                                       
                            </div>  
                            <div class="form-horizontal form-label-left col-md-6 col-sm-6 col-xs-6">
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">From Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                        <select id="LocationId" name="LocationId" class="form-control"></select>


                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">To Location </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">
                                        <select id="ToLocationId" name="ToLocationId" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3 col-sm-3 col-xs-3">Doc No </label>
                                    <div class="col-md-6 col-sm-6 col-xs-6">

                                        <select id="DocumentId" name="DocumentId" class="form-control select2"></select>


                                    </div>
                                </div>
                            </div>
                                <div class="clearfix"></div>
                                <div class="actionBar">
                                    <div class="msgBox">
                                        <button type="submit" class="btn btn-success pull-right">Submit</button>
                                        <div class="btn-group">
                                            <button class="btn btn-danger dropdown-toggle pull-right" data-toggle="dropdown"><i class="fa fa-bars"></i>Export Data</button>
                                            <ul class="dropdown-menu">

                                                <li>
                                                    <a href="#" onclick="$('#datatable-responsive1').tableExport({ type: 'excel', escape: 'false' });">
                                                        <img src='~/Content/Images/icons/xls.png' width="10" />XLS
                                                    </a>
                                                </li>
                                                <li><a href="#" onclick="PrintDiv();"><img src='~/Content/Images/icons/pdf.png' width="10" />PDF</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <br />
                                <div class="clearfix"></div>

                                <div id="printcontent">

                                    <div class="clearfix"></div>
                                    <br />
                                    <div class="col-md-12">


                                    </div>
                                    <div class="clearfix"></div>
                                    <br /><br />

                                    <div class="table-responsive">

                                        @if (Model != null)
                                    {


                                        <table id="datatable-responsive1" class="table table-striped jambo_table bulk_action">
                                            <thead>
                                            <tr class="headings">
                                                <th></th>
                                                <th class="column-title">Product Code</th>
                                                <th class="column-title">Product Name</th>
                                                <th class="column-title">Quantity</th>
                                                <th class="column-title">Cost Price</th>

                                            </tr>
                                        </thead>



                                            @foreach (var head in Model.OrderByDescending(head => head.DocumentDate))
                                            {
                                                @*<thead>*@
                                                <tr style="background-color:darkblue; width:200%" class="headings">
                                                    <td style="color: white; font-weight: bold;">@(Model.ToList().IndexOf(head)+1)</td>
                                                    <td style="color: white; font-weight: bold;">From :@Html.DisplayFor(modelItem => head.Location)</td>
                                                    <td style="color: white; font-weight: bold;">To :@Html.DisplayFor(modelItem => head.ToLocation)</td>
                                                    <td style="color: white; font-weight: bold;">Date:@Html.DisplayFor(modelItem => head.DocumentDate)</td>
                                                    <td style="color: white; font-weight: bold;">
                                                        Document No:@Html.DisplayFor(modelItem => head.DocumentNo)
                                                        <br /> Status:@Html.DisplayFor(modelItem => head.Status)
                                                    </td>

                                                </tr>
                                                @*</thead>*@

                                                


                                                    @*<thead>*@
                                                        <tr style="background-color:lightgoldenrodyellow; width:200%" class="headings">
                                                            <th></th>
                                                            <th style="color: black; font-weight: bold;">Product Code</th>
                                                            <th  style="color: black; font-weight: bold;">Product Name</th>
                                                            <th  style="color: black; font-weight: bold;">Quantity</th>
                                                            <th  style="color: black; font-weight: bold;" >Cost Price</th>

                                                        </tr>
                                                    @*</thead>*@
                                                    
                                                    <tbody>
                                                    @foreach (var item in head.Detail)
                                                    {
                                                        <tr class="even pointer">
                                                            <td>@HospitalityManagement.Common.HMSExtensions.IntToRoman(head.Detail.IndexOf(item) + 1)</td>
                                                            <td class="">@Html.DisplayFor(k => item.ProductCode)</td>
                                                            <td class="">@Html.DisplayFor(k => item.ProductName)</td>
                                                            <td class="">@Html.DisplayFor(k => item.OrderQty) </td>
                                                            <td class="">@Html.DisplayFor(k => item.CostPrice)</td>

                                                        </tr>
                                                    }
                                               





                                                    </tbody>
                                                }
                                        </table>
                                    }
                                    </div>
                                </div>
                            </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>


}

<script src="~/vendors/jquery/dist/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        if ('@ViewBag.DateFrom') {
            document.getElementById('DateFrom').value = '@ViewBag.DateFrom';
        }
        if ('@ViewBag.DateTo') {
            document.getElementById('DateTo').value = '@ViewBag.DateTo';
        }

        $.getJSON("@Url.Action("GetActiveLocations", "Location")", function (data) {

            var poLocationId = $("#LocationId");

            poLocationId.empty();
            poLocationId.append("<option value='0'>-- All Locations --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                poLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

            });

            if ('@ViewBag.LocationId') {
                $('#LocationId').val(@ViewBag.LocationId).trigger("change");
            } else {
                $('#LocationId').val(0).trigger("change");
            }

            var poToLocationId = $("#ToLocationId");

            poToLocationId.empty();
            poToLocationId.append("<option value='0'>-- All Locations --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                poToLocationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

            });

            if ('@ViewBag.ToLocationId') {
                $('#ToLocationId').val(@ViewBag.ToLocationId).trigger("change");
            } else {
                $('#ToLocationId').val(0).trigger("change");
            }

        });


        $("#LocationId, #ToLocationId").change(
            function () {
                var loc = $("#LocationId").val();
                var toloc = $("#ToLocationId").val();

                $.getJSON("@Url.Action("GetDocNoByLocId", "TOG")", { locid: loc, tolocid: toloc, from: $("#DateFrom").val(), to: $("#DateTo").val() },

                    function (data) {

                        var DocNo = $("#DocumentId");

                        DocNo.empty();
                        DocNo.append("<option value='0'>-- Select a Document --</option>");

                        $.each(JSON.parse(data), function (index, optionaldata) {
                            DocNo.append($('<option />', { value: optionaldata.TransferNoteHeaderId }).html(optionaldata.DocumentNo));

                        });

                    

                        if ('@ViewBag.DocumentId') {
                            document.getElementById('DocumentId').value = '@ViewBag.DocumentId';
                        }
                        else {
                            document.getElementById('DocumentId').value = '0';
                                }

                    });
            });

    });

</script>


<script type="text/javascript">
    function PrintDiv() {

        var divToPrint = document.getElementById("datatable-responsive1");
        newWin = window.open("");
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();

    }
</script>

