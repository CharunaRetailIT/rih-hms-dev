<script type="text/javascript">
    $("body").on("click",
        "#btnRefresh",
        function () {

            if ($("#SysYearsId").val() == 0 || $("#SysYearsId").val() == null) {
                alert("Select the year!");
                return;
            }

            $.ajax({
                url: "@Url.Action("GetMonthEndDataByYear", "MonthEnd")",
                data: {
                    year: $("#SysYearsId").val(), loc: $("#StockLocationId").val()
                },
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    data = resp;

                    $("#grdMonthEnd tr").remove();
                    $.each(data, function (i, item) {

                        var unitindex = $("#grdMonthEnd").children("tr").length;

                        var unitLocDescCell = "<td id='MDet" + unitindex + "_MonthEndId' name='MDet[" +
                            unitindex + "].LocDesc'>" + item.LocDesc + "</td>";

                        var unitLocMonthDescCell = "<td id='MDet" + unitindex + "_MonthEndId' name='MDet[" +
                            unitindex + "].LocMonthDesc'>" + item.LocMonthDesc + "</td>";

                        var unitLocStatusDescCell = "<td id='MDet" + unitindex + "_MonthEndId' name='MDet[" +
                            unitindex + "].LocStatusDesc'>" + item.LocStatusDesc + "</td>";

                        var newUnitRow = "<tr id='trAddons" + unitindex + "'>" +
                            unitLocMonthDescCell +
                            unitLocDescCell +
                            unitLocStatusDescCell +
                             "</tr>";

                        $("#grdMonthEnd").append(newUnitRow);

                    });

                },

                error: function (error) {
                    alert("Item data mapping error");
                }
            });

        });
</script>
