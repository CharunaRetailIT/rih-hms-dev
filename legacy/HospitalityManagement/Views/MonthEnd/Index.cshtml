    var yearsviewload = function () {
        $.getJSON("@Url.Action("GetYears", "MonthEnd")", function (data) {

            var sysyear = $("#SysYearsId");
            sysyear.empty();
            sysyear.append("<option value='0'>-- Select a Year --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                sysyear.append($('<option />', { value: optionaldata.SysYear }).html(optionaldata.SysYear));

            });

            if ('@ViewBag.SysYearsId') {
                $('#SysYearsId').val(@ViewBag.SysYearsId).trigger("change");
            } else {
                $('#SysYearsId').val(0).trigger("change");
            }
        });
    }

    var locationViewload = function () {

        $.getJSON("@Url.Action("GetActiveLocations", "MonthEnd")", function (data) {

            var locationId = $("#StockLocationId");
            locationId.empty();
            locationId.append("<option value='0'>-- Select a Location --</option>");

            $.each(JSON.parse(data), function (index, optionaldata) {
                locationId.append($('<option />', { value: optionaldata.SysLocationID }).html(optionaldata.LocationName));

            });

            if ('@ViewBag.StockLocationId') {
                $('#StockLocationId').val(@ViewBag.StockLocationId).trigger("change");
            } else {
                $('#StockLocationId').val(0).trigger("change");
            }
        });

