# ── RIT HMS — test/staging environment (Docker Compose) ─────────────────────
# Copy to the REPO ROOT as `.env` (gitignored, auto-loaded by docker compose),
# or just run ./infra/gen-secrets.sh to create it with fresh secret values.
#   cp infra/.env.example .env   &&   edit .env
#   # or:  ./infra/gen-secrets.sh
# NEVER commit the real .env. The dev defaults are intentionally NOT reused here —
# the API refuses to boot in Production (SecurityStartup.AssertProductionSecrets)
# if Jwt__SigningKey / Secrets__MasterKey still match the repo dev values.

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED.  gen: openssl rand -base64 24
POSTGRES_PASSWORD=
CONTROL_DB=hms_control

# --- API secrets (MUST be freshly generated — not the dev values) ------------
# JWT HMAC signing key, >= 32 chars.                gen: openssl rand -base64 48
JWT_SIGNING_KEY=
# AES-256-GCM master key (encrypts aggregator creds), base64 of 32 bytes.
#                                                    gen: openssl rand -base64 32
SECRETS_MASTER_KEY=
# Issuer/audience are validated against the same config that signs the JWT; any
# consistent values work. Defaults are fine for a test box.
JWT_ISSUER=rit-hms
JWT_AUDIENCE=rit-hms-api

# --- Platform admin ----------------------------------------------------------
# Email allowlisted for cross-tenant control-plane ops (e.g. GET /api/v1/tenants).
# There is NO platform-admin DB row — this is a config allowlist. Make it the
# owner email of your first test tenant so the same magic-link login also works.
PLATFORM_ADMIN_EMAIL=admin@rit-hms.test

# --- Public URL / reverse proxy ----------------------------------------------
# Externally reachable base URL. Used to build the magic-link AND as the browser
# origin.   e.g.  http://<vps-ip>   or   https://hms.example.com
PUBLIC_BASE_URL=http://localhost
# Caddy site address:
#   http://          listen on :80 for any host, HTTP only (no TLS) — IP test box
#   hms.example.com  automatic HTTPS via Let's Encrypt (DNS must point here)
SITE_ADDRESS=http://
# Used only for automatic HTTPS (when SITE_ADDRESS is a domain).
ACME_EMAIL=admin@example.com
# Host ports Caddy binds.
HTTP_PORT=80
HTTPS_PORT=443
